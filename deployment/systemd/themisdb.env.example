# ThemisDB environment variables template
# ================================================
# Copy this file to /etc/themisdb/themisdb.env and fill in the values.
#
#   sudo cp deploy/systemd/themisdb.env.example /etc/themisdb/themisdb.env
#   sudo chmod 600 /etc/themisdb/themisdb.env
#   sudo chown root:themisdb /etc/themisdb/themisdb.env
#
# The service account (themisdb) needs read access.
# Never store this file in source control once it contains real secrets.
#
# For guidance on each variable and production hardening, see:
#   docs/production/RUNBOOKS/CORE_MODULE_RUNBOOK.md
#   docs/production/SECURITY_POSTURE.md
# ================================================

# -----------------------------------------------------------------------
# REQUIRED: Admin API bearer token
# Generate with: openssl rand -base64 32
# -----------------------------------------------------------------------
THEMIS_TOKEN_ADMIN=

# -----------------------------------------------------------------------
# REQUIRED: TLS private key passphrase (if the key is encrypted)
# Leave empty if the key is stored unencrypted (not recommended).
# -----------------------------------------------------------------------
THEMIS_PKI_KEY_PASSPHRASE=

# -----------------------------------------------------------------------
# Key management — fill in EITHER Vault OR HSM, not both.
#
# Option A: HashiCorp Vault
# Prefer AppRole / Kubernetes auth (Vault agent) over a static token.
# If using Vault agent, you can leave THEMIS_VAULT_TOKEN empty.
# -----------------------------------------------------------------------
THEMIS_VAULT_TOKEN=

# Option B: Hardware HSM (PKCS#11)
# THEMIS_HSM_ENABLED=1 is already set in the production drop-in.
# Fill in the PKCS#11 user PIN for the HSM partition.
THEMIS_HSM_PIN=

# -----------------------------------------------------------------------
# WAL gRPC shared / HMAC secrets
# Only needed if mTLS is not used for WAL replication (not recommended).
# When THEMIS_WAL_GRPC_ENABLE_MTLS=1 these are not required.
# -----------------------------------------------------------------------
# THEMIS_WAL_SHARED_SECRET=
# THEMIS_WAL_HMAC_SECRET=

# -----------------------------------------------------------------------
# Apache Ranger bearer token (only if using Ranger for policy management)
# -----------------------------------------------------------------------
# THEMIS_RANGER_BEARER=
