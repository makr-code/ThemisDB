execute_process(
    COMMAND "${CMAKE_COMMAND}" -S "${SOURCE_DIR}" -B "${BUILD_DIR}"
        -G "Unix Makefiles" "-DCASE=${CASE}"
        "-DCMAKE_C_COMPILER=${CC}" "-DCMAKE_CXX_COMPILER=${CXX}"
    RESULT_VARIABLE _result OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr)
if(NOT _result EQUAL 0)
    message(FATAL_ERROR "Configure failed:\n${_stdout}\n${_stderr}")
endif()

file(READ "${BUILD_DIR}/compile_commands.json" _commands)
string(JSON _count LENGTH "${_commands}")
math(EXPR _last "${_count} - 1")
foreach(_index RANGE ${_last})
    string(JSON _command GET "${_commands}" ${_index} command)
    string(JSON _file GET "${_commands}" ${_index} file)
    get_filename_component(_name "${_file}" NAME)
    set(_include "")
    set(_enum FALSE)
    if(NOT CASE MATCHES "^(NonApple|MissingMemory|MissingEnumException)$")
        if(_name STREQUAL "base.cpp")
            set(_include cerrno)
        elseif(_name STREQUAL "metal.cpp")
            set(_include memory)
        elseif(_name STREQUAL "cpu.cpp" AND
               NOT CASE MATCHES "^(OtherCompiler|AppleClangID|Unsupported)$")
            set(_enum TRUE)
        endif()
    endif()
    if(_include)
        if(NOT _command MATCHES "-include ${_include}( |$)")
            message(FATAL_ERROR "Missing ${_include} include: ${_command}")
        endif()
    elseif(_command MATCHES "-include")
        message(FATAL_ERROR "Force include escaped C++/target/platform scope: ${_command}")
    endif()
    if(_enum)
        if(NOT _command MATCHES "-Wno-error=elaborated-enum-base")
            message(FATAL_ERROR "Missing scoped enum exception: ${_command}")
        endif()
    elseif(_command MATCHES "-Wno-error")
        message(FATAL_ERROR "Warning exception escaped scope: ${_command}")
    endif()
    if(NOT _command MATCHES " -Werror ")
        message(FATAL_ERROR "General -Werror was lost: ${_command}")
    endif()
endforeach()

execute_process(COMMAND "${CMAKE_COMMAND}" --build "${BUILD_DIR}"
    RESULT_VARIABLE _result OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr)
if(CASE MATCHES "^(MissingMemory|MissingEnumException|UnrelatedWarning)$")
    if(_result EQUAL 0)
        message(FATAL_ERROR "Negative control unexpectedly compiled")
    endif()
    if(CASE STREQUAL "MissingMemory")
        set(_diagnostic "unique_ptr")
    elseif(CASE STREQUAL "MissingEnumException")
        set(_diagnostic "elaborated-enum-base")
    else()
        set(_diagnostic "unused-variable")
    endif()
    if(NOT "${_stdout}\n${_stderr}" MATCHES "${_diagnostic}")
        message(FATAL_ERROR "Expected ${_diagnostic} failure:\n${_stdout}\n${_stderr}")
    endif()
elseif(NOT _result EQUAL 0)
    message(FATAL_ERROR "Build failed:\n${_stdout}\n${_stderr}")
endif()
