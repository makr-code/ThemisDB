find_package(Git REQUIRED)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef run_id)
set(FIXTURE "${FIXTURE}-${run_id}")

function(git_run directory)
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${directory}" ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Fixture Git command failed: ${output}${error}")
    endif()
endfunction()

file(MAKE_DIRECTORY "${FIXTURE}")
if(NOT CASE STREQUAL "missing")
    file(MAKE_DIRECTORY "${FIXTURE}/llama.cpp/include")
    file(WRITE "${FIXTURE}/llama.cpp/CMakeLists.txt" "# Test-only source fixture\n")
    if(CASE STREQUAL "unpatched")
        file(WRITE "${FIXTURE}/llama.cpp/include/llama.h" "#define LLAMA_VERSION 1\n")
    else()
        file(WRITE "${FIXTURE}/llama.cpp/include/llama.h" "#define LLAMA_THEMIS_TRAINABLE_LORA 1\n")
    endif()
endif()

if(CASE STREQUAL "pinned" OR CASE STREQUAL "mismatch")
    git_run("${FIXTURE}" init --quiet)
    git_run("${FIXTURE}/llama.cpp" init --quiet)
    git_run("${FIXTURE}/llama.cpp" add -- CMakeLists.txt include/llama.h)
    git_run("${FIXTURE}/llama.cpp" -c user.name=Fixture -c user.email=fixture@example.invalid
        commit --quiet -m "Test fixture base")
    git_run("${FIXTURE}" add -- llama.cpp)
    if(CASE STREQUAL "mismatch")
        git_run("${FIXTURE}/llama.cpp" -c user.name=Fixture -c user.email=fixture@example.invalid
            commit --quiet --allow-empty -m "Unpinned fixture revision")
    endif()
endif()

execute_process(
    COMMAND "${CMAKE_COMMAND}" "-DPROJECT_SOURCE_DIR=${FIXTURE}" -P "${CHECK}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)

if(CASE STREQUAL "pinned" OR CASE STREQUAL "snapshot")
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Valid ${CASE} rejected: ${output}${error}")
    endif()
else()
    if(result EQUAL 0)
        message(FATAL_ERROR "Invalid ${CASE} accepted")
    endif()
    if(CASE STREQUAL "missing")
        set(expected "submodule is missing")
    elseif(CASE STREQUAL "unpatched")
        set(expected "lacks the Themis trainable-LoRA API")
    else()
        set(expected "differs from[ \r\n]+pinned gitlink")
    endif()
    if(NOT "${output}${error}" MATCHES "${expected}")
        message(FATAL_ERROR "Wrong ${CASE} failure: ${output}${error}")
    endif()
endif()
