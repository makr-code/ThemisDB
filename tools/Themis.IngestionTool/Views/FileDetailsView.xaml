<UserControl x:Class="Themis.IngestionTool.Views.FileDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="15">
            <!-- Header mit Dateinamen -->
            <Border Background="#007ACC" Padding="12" CornerRadius="4" Margin="0,0,0,15">
                <TextBlock Text="{Binding FileName}" FontSize="16" FontWeight="Bold" 
                          Foreground="White" TextWrapping="Wrap" />
            </Border>

            <!-- Tabs für verschiedene Metadaten-Bereiche -->
            <TabControl>
                <!-- Tab: Übersicht -->
                <TabItem Header="Übersicht">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10">
                            <!-- Basis-Informationen -->
                            <TextBlock Text="Basis-Informationen" FontSize="14" FontWeight="Bold" 
                                      Foreground="#333" Margin="0,0,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Dateipfad:" FontWeight="SemiBold" Margin="0,5"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding FilePath}" TextWrapping="Wrap" Margin="0,5"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Dateigröße:" FontWeight="SemiBold" Margin="0,5"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FileSize, StringFormat={}{0:N0} Bytes}" Margin="0,5"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Dateityp:" FontWeight="SemiBold" Margin="0,5"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding FileType}" Margin="0,5"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Content Hash:" FontWeight="SemiBold" Margin="0,5"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ContentHash}" 
                                          FontFamily="Consolas" FontSize="10" TextWrapping="Wrap" Margin="0,5"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Sprache:" FontWeight="SemiBold" Margin="0,5"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Language}" Margin="0,5"/>

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Verarbeitungszeit:" FontWeight="SemiBold" Margin="0,5"/>
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding ProcessingTime, StringFormat={}{0:mm\\:ss\\.fff}}" Margin="0,5"/>
                            </Grid>

                            <!-- Scores -->
                            <TextBlock Text="Bewertungen" FontSize="14" FontWeight="Bold" 
                                      Foreground="#333" Margin="0,20,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Relevanz-Score:" FontWeight="SemiBold" Margin="0,5"/>
                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,5">
                                    <ProgressBar Value="{Binding RelevanceScore}" Maximum="1" Width="200" Height="20" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding RelevanceScore, StringFormat=F3}" FontWeight="Bold"/>
                                </StackPanel>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Impact-Score:" FontWeight="SemiBold" Margin="0,5"/>
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,5">
                                    <ProgressBar Value="{Binding ImpactScore}" Maximum="1" Width="200" Height="20" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding ImpactScore, StringFormat=F3}" FontWeight="Bold"/>
                                </StackPanel>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Qualitäts-Score:" FontWeight="SemiBold" Margin="0,5"/>
                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,5">
                                    <ProgressBar Value="{Binding QualityScore}" Maximum="1" Width="200" Height="20" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding QualityScore, StringFormat=F3}" FontWeight="Bold"/>
                                </StackPanel>
                            </Grid>

                            <!-- Graph-Informationen -->
                            <TextBlock Text="Graph-Metriken" FontSize="14" FontWeight="Bold" 
                                      Foreground="#333" Margin="0,20,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Knoten:" FontWeight="SemiBold" Margin="0,5"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding GraphNodeCount}" Margin="0,5"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Beziehungen:" FontWeight="SemiBold" Margin="0,5"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RelationshipCount}" Margin="0,5"/>
                            </Grid>

                            <!-- Status -->
                            <TextBlock Text="Verarbeitungs-Status" FontSize="14" FontWeight="Bold" 
                                      Foreground="#333" Margin="0,20,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Verarbeitet:" FontWeight="SemiBold" Margin="0,5"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding IsProcessed}" Margin="0,5"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Duplikat:" FontWeight="SemiBold" Margin="0,5"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding IsDuplicate}" Margin="0,5"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Zeitstempel:" FontWeight="SemiBold" Margin="0,5"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AnalysisTimestamp, StringFormat=G}" Margin="0,5"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Fehler:" FontWeight="SemiBold" Margin="0,5"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ErrorMessage}" 
                                          TextWrapping="Wrap" Foreground="Red" Margin="0,5"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Tab: Keywords & Topics -->
                <TabItem Header="Keywords &amp; Topics">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10">
                            <!-- Keywords -->
                            <TextBlock Text="Keywords" FontSize="14" FontWeight="Bold" 
                                      Foreground="#333" Margin="0,0,0,10" />
                            <Border BorderBrush="#E0E0E0" BorderThickness="1" Padding="10" 
                                   Background="#F9F9F9" CornerRadius="4" Margin="0,0,0,15">
                                <ItemsControl ItemsSource="{Binding Keywords}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#007ACC" CornerRadius="12" Padding="10,5" Margin="3">
                                                <TextBlock Text="{Binding}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>

                            <!-- Topics -->
                            <TextBlock Text="Topics" FontSize="14" FontWeight="Bold" 
                                      Foreground="#333" Margin="0,10,0,10" />
                            <Border BorderBrush="#E0E0E0" BorderThickness="1" Padding="10" 
                                   Background="#F9F9F9" CornerRadius="4">
                                <ItemsControl ItemsSource="{Binding Topics}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#28A745" CornerRadius="4" Padding="8,4" Margin="2">
                                                <TextBlock Text="{Binding}" Foreground="White" FontSize="10"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Tab: Entities -->
                <TabItem Header="Entities">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10">
                            <TextBlock Text="Extrahierte Entities" FontSize="14" FontWeight="Bold" 
                                      Foreground="#333" Margin="0,0,0,10" />
                            <Border BorderBrush="#E0E0E0" BorderThickness="1" Padding="10" 
                                   Background="#F9F9F9" CornerRadius="4">
                                <ItemsControl ItemsSource="{Binding ExtractedEntities}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="White" BorderBrush="#DDD" BorderThickness="1" 
                                                   CornerRadius="4" Padding="10" Margin="0,0,0,5">
                                                <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="11"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Tab: Zusammenfassung -->
                <TabItem Header="Zusammenfassung">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10">
                            <TextBlock Text="Text-Zusammenfassung" FontSize="14" FontWeight="Bold" 
                                      Foreground="#333" Margin="0,0,0,10" />
                            <Border BorderBrush="#E0E0E0" BorderThickness="1" Padding="15" 
                                   Background="#F9F9F9" CornerRadius="4">
                                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" 
                                          FontSize="12" LineHeight="20" Foreground="#333"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Tab: Metadaten -->
                <TabItem Header="Metadaten">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10">
                            <TextBlock Text="Zusätzliche Metadaten" FontSize="14" FontWeight="Bold" 
                                      Foreground="#333" Margin="0,0,0,10" />
                            <Border BorderBrush="#E0E0E0" BorderThickness="1" Padding="10" 
                                   Background="#F9F9F9" CornerRadius="4">
                                <ItemsControl ItemsSource="{Binding Metadata}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Key}" FontWeight="SemiBold" 
                                                          Foreground="#666" FontSize="11"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" 
                                                          FontSize="11" Foreground="#333"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
