      "owner": "ThemisDB CI Maintainers",
      "expires": "2027-03-31"
    },
    {
      "workflow": ".github/workflows/reusable-cmake-build.yml",
      "job": "build",
      "step": "Validate candidate Mainline package identity",
      "kind": "continue-on-error",
      "match": "True",
      "count": 1,
      "rationale": "An invalid reused package falls back to the required source build; package validation itself is not a gate pass.",
      "owner": "ThemisDB CI Maintainers",
      "expires": "2027-03-31"
    },
    {
      "workflow": ".github/workflows/reusable-cmake-build.yml",
      "job": "build",
      "step": "Print vcpkg cache resolution",
      "kind": "shell-or-true",
      "match": "du -sh \"${VCPKG_DEFAULT_BINARY_CACHE}\" \"${VCPKG_DOWNLOADS}\" 2>/dev/null || true",
      "count": 1,
      "rationale": "Disk-usage output is diagnostic only; missing cache directories do not affect the required build or validation steps.",
      "owner": "ThemisDB CI Maintainers",
      "expires": "2027-03-31"
    },
    {
      "workflow": ".github/workflows/reusable-cmake-build.yml",
      "job": "build",
      "step": "Install sccache",
      "kind": "continue-on-error",
      "match": "True",
      "count": 1,
      "rationale": "Compiler caching is optional; configure, build, and validation remain required and blocking.",
      "owner": "ThemisDB CI Maintainers",
      "expires": "2027-03-31"
    },
    {
      "workflow": ".github/workflows/reusable-cmake-build.yml",
      "job": "build",
      "step": "Save dependency snapshot before ThemisDB compile",
      "kind": "continue-on-error",
      "match": "True",
      "count": 1,
      "rationale": "Cache persistence is an optimization after dependency preparation; it does not determine build or validation success.",
      "owner": "ThemisDB CI Maintainers",
      "expires": "2027-03-31"
    },
    {
      "workflow": ".github/workflows/reusable-cmake-build.yml",
      "job": "build",
