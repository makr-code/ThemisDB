      "count": 1,
      "rationale": "Listing pre-existing build-directory contents is best-effort diagnostics; configure's actual command status remains blocking.",
      "owner": "ThemisDB CI Maintainers",
      "expires": "2027-03-31"
    },
    {
      "workflow": ".github/workflows/reusable-cmake-build.yml",
