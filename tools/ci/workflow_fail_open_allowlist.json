      "owner": "ThemisDB CI Maintainers",
      "expires": "2027-03-31"
    },
    {
      "workflow": ".github/workflows/gate-pr-doc-metadata.yml",
      "job": "doc-metadata-gate",
      "step": "Clear stale metadata failure labels on PASS",
      "kind": "continue-on-error",
      "match": "True",
      "count": 1,
