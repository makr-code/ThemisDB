      "kind": "shell-or-true",
      "match": "sccache --stop-server >/dev/null 2>&1 || true",
      "count": 1,
      "rationale": "Stopping an unavailable or failed optional cache server is cleanup before the required configure retry.",
      "owner": "ThemisDB CI Maintainers",
      "expires": "2027-03-31"
    },
    {
      "workflow": ".github/workflows/reusable-cmake-build.yml",
      "job": "build",
      "step": "Build",
      "kind": "continue-on-error",
      "match": "${{ inputs.build_continue_on_error }}",
      "count": 1,
      "rationale": "This input defaults to false; gate callers must not enable it, and the checker rejects non-false gate-call values.",
      "owner": "ThemisDB CI Maintainers",
      "expires": "2027-03-31"
    },
    {
      "workflow": ".github/workflows/reusable-cmake-build.yml",
      "job": "build",
      "step": "Build",
      "kind": "shell-or-true",
      "match": "sccache --stop-server >/dev/null 2>&1 || true",
      "count": 1,
      "rationale": "Stopping an unavailable or failed optional cache server is cleanup before the required build retry.",
      "owner": "ThemisDB CI Maintainers",
      "expires": "2027-03-31"
    },
    {
      "workflow": ".github/workflows/reusable-cmake-build.yml",
      "job": "build",
      "step": "Detect active compiler cache backend",
      "kind": "shell-or-true",
      "match": "stats=\"$(sccache --show-stats 2>&1 || true)\"",
      "count": 1,
      "rationale": "Cache statistics are diagnostic only; cache backend failure does not alter required build and validation outcomes.",
      "owner": "ThemisDB CI Maintainers",
      "expires": "2027-03-31"
    },
    {
      "workflow": ".github/workflows/reusable-cmake-build.yml",
      "job": "build",
      "step": "Validation",
      "kind": "continue-on-error",
      "match": "${{ inputs.validation_continue_on_error }}",
      "count": 1,
      "rationale": "This input defaults to false; gate callers must not enable it, and the checker rejects non-false gate-call values.",
      "owner": "ThemisDB CI Maintainers",
      "expires": "2027-03-31"
    },
    {
      "workflow": ".github/workflows/reusable-cmake-build.yml",
      "job": "build",
      "step": "Validation",
      "kind": "shell-or-true",
      "match": "done < <(grep -E '^THEMIS_METRIC_(CTEST|INSTALL|PACKAGING)_SECONDS=' \"$LOG_FILE\" || true)",
      "count": 1,
      "rationale": "Optional metrics may be absent from the log; the explicit saved validation exit code remains the step result.",
      "owner": "ThemisDB CI Maintainers",
      "expires": "2027-03-31"
    },
    {
      "workflow": ".github/workflows/reusable-cmake-build.yml",
      "job": "build",
