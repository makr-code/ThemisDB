<Application x:Class="Themis.GISViewer.ControlPanel.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Themis Color Scheme -->
        <Color x:Key="ThemisPrimary">#1E88E5</Color>
        <Color x:Key="ThemisSecondary">#FFC107</Color>
        <Color x:Key="ThemisBackground">#F5F5F5</Color>
        <Color x:Key="ThemisText">#212121</Color>
        
        <SolidColorBrush x:Key="ThemisPrimaryBrush" Color="{StaticResource ThemisPrimary}"/>
        <SolidColorBrush x:Key="ThemisSecondaryBrush" Color="{StaticResource ThemisSecondary}"/>
        <SolidColorBrush x:Key="ThemisBackgroundBrush" Color="{StaticResource ThemisBackground}"/>
        <SolidColorBrush x:Key="ThemisTextBrush" Color="{StaticResource ThemisText}"/>
        
        <!-- Base Styles -->
        <Style TargetType="Window">
            <Setter Property="Background" Value="{StaticResource ThemisBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource ThemisTextBrush}"/>
        </Style>
        
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ThemisPrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.8"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="{StaticResource ThemisPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
    </Application.Resources>
</Application>
