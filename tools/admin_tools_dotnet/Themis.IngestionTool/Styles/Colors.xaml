<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Themis.IngestionTool.Converters">

    <!-- Value Converters -->
    <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    <local:BoolToColorConverter x:Key="BoolToColorConverter" />
    <local:BoolToStatusConverter x:Key="BoolToStatusConverter" />

    <!-- Colors -->
    <Color x:Key="PrimaryColor">#007ACC</Color>
    <Color x:Key="SuccessColor">#28A745</Color>
    <Color x:Key="DangerColor">#DC3545</Color>
    <Color x:Key="WarningColor">#FFC107</Color>
    <Color x:Key="InfoColor">#17A2B8</Color>
    <Color x:Key="LightGray">#F5F5F5</Color>
    <Color x:Key="DarkGray">#333333</Color>

</ResourceDictionary>
