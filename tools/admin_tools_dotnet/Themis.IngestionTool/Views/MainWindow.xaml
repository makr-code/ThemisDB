<Window x:Class="Themis.IngestionTool.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ThemisDB Ingestion Tool" Height="700" Width="1300"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">
    <DockPanel>
        <!-- Menüzeile -->
        <Menu DockPanel.Dock="Top" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <MenuItem Header="Datei">
                <MenuItem Header="Beenden" Click="OnExit" />
            </MenuItem>
            <MenuItem Header="Bearbeiten">
                <MenuItem Header="Einstellungen" Click="OnOpenSettings" />
            </MenuItem>
            <MenuItem Header="Hilfe">
                <MenuItem Header="Über..." Click="OnAbout" />
            </MenuItem>
        </Menu>

        <!-- Toolbar mit Schnellzugriffen und Icons -->
        <ToolBarTray DockPanel.Dock="Top" Background="White" Margin="0,0,0,1">
            <ToolBar Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="6">
                <ToggleButton x:Name="SidebarToggle" Content="☰ Menu" Width="70" Height="28" Margin="0,0,6,0" Click="OnToggleSidebar" FontSize="12" FontWeight="Bold" ToolTip="Seitenleiste ein/ausblenden" />
                <Separator />
                <Button Content="📁 Quelle" Width="110" Height="28" Margin="6,0,0,0" Click="OnBrowseSource" ToolTip="Quellordner wählen" FontSize="11" />
                <Button Width="120" Height="28" Margin="6,0,0,0" Click="OnToggleIngestion" FontSize="11">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Content" Value="▶ Start" />
                            <Setter Property="ToolTip" Value="Analyse / Ingestion starten" />
                            <Setter Property="Background" Value="#28A745" />
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="IsEnabled" Value="False" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                    <Setter Property="Content" Value="⏹ Stop" />
                                    <Setter Property="ToolTip" Value="Aktuellen Lauf abbrechen" />
                                    <Setter Property="Background" Value="#DC3545" />
                                    <Setter Property="IsEnabled" Value="True" />
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsRunning}" Value="False" />
                                        <Condition Binding="{Binding IsConnected}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="IsEnabled" Value="True" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="⚡ Real Ingestion" Width="150" Height="28" Margin="6,0,0,0" Click="OnStartRealIngestion" ToolTip="Direkte Speicherung in ThemisDB" FontSize="11">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="IsEnabled" Value="False" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsRunning}" Value="False" />
                                        <Condition Binding="{Binding IsConnected}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="IsEnabled" Value="True" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Separator />
                <Button Content="⚙ Einstellungen" Width="130" Height="28" Margin="6,0,0,0" Click="OnOpenSettings" ToolTip="Einstellungen öffnen" FontSize="11" />
            </ToolBar>
        </ToolBarTray>

        <!-- Statuszeile -->
        <StatusBar DockPanel.Dock="Bottom" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <StatusBarItem FlowDirection="LeftToRight">
                <StackPanel Orientation="Horizontal" Margin="10,0">
                    <TextBlock Text="Status: " FontWeight="Bold" Foreground="#333" />
                    <TextBlock Text="{Binding Status}" Foreground="#666" Margin="5,0,0,0" />
                </StackPanel>
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <StackPanel Orientation="Horizontal" Margin="10,0">
                    <Ellipse Width="10" Height="10" 
                            Fill="{Binding IsConnected, Converter={StaticResource BoolToColorConverter}}"
                            VerticalAlignment="Center" />
                    <TextBlock Text="Themis:" Margin="8,0,5,0" VerticalAlignment="Center" 
                              Foreground="#666" FontWeight="SemiBold" FontSize="11" />
                    <TextBlock VerticalAlignment="Center" FontSize="11" FontWeight="Bold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Text" Value="Online" />
                                        <Setter Property="Foreground" Value="#28A745" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                        <Setter Property="Text" Value="Offline" />
                                        <Setter Property="Foreground" Value="#DC3545" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <StackPanel Orientation="Horizontal" Margin="10,0" Visibility="{Binding ShowLlmStatusInStatusBar, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Ellipse Width="10" Height="10" 
                            Fill="{Binding LlmStatusColor}"
                            VerticalAlignment="Center" />
                    <TextBlock Text="LLM:" Margin="8,0,5,0" VerticalAlignment="Center" 
                              Foreground="#666" FontWeight="SemiBold" FontSize="11" />
                    <TextBlock Text="{Binding LlmStatusText}" VerticalAlignment="Center" FontSize="11" FontWeight="Bold"
                              Foreground="{Binding LlmStatusColor}" />
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <!-- Hauptinhalt -->
        <Grid DockPanel.Dock="Top" Background="White" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumn" Width="380"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Linke Spalte: Steuerung -->
            <Border Grid.Column="0" Margin="10" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel VerticalAlignment="Top" Margin="10">
                <!-- Header -->
                <TextBlock Text="Datei-Ingestion" FontSize="20" FontWeight="Bold" Foreground="#333" Margin="0,0,0,8" />
                <TextBlock Text="{Binding CurrentStage}" FontSize="11" Foreground="#666" Margin="0,0,0,15" />

                <!-- Ordner-Auswahl -->
                <TextBlock Text="Quellordner:" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,5" FontSize="11" />
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding SourceFolder}" Grid.Column="0" 
                            IsReadOnly="True" Padding="8" Background="#F9F9F9" 
                            BorderBrush="#DDD" BorderThickness="1" FontSize="11" />
                    <Button Click="OnBrowseSource" Grid.Column="1" 
                           Content="..." Margin="5,0,0,0" Width="30"
                           Padding="5" Background="#007ACC" Foreground="White" 
                           FontWeight="Bold" Cursor="Hand" />
                </Grid>

                <!-- Ausgabe-Datei -->
                <TextBlock Text="Ausgabedatei:" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,5" FontSize="11" />
                <TextBox Text="{Binding OutputFile, UpdateSourceTrigger=PropertyChanged}" 
                        Padding="8" Background="#F9F9F9" Margin="0,0,0,10"
                        BorderBrush="#DDD" BorderThickness="1" FontSize="11" />

                <!-- DryRun Option -->
                <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                    <CheckBox IsChecked="{Binding IsDryRun}" VerticalAlignment="Center" />
                    <TextBlock Text="DryRun" Margin="8,0,0,0" 
                              FontWeight="SemiBold" Foreground="#666" VerticalAlignment="Center" FontSize="11" />
                </StackPanel>

                <!-- Fortschrittsanzeige -->
                <TextBlock Text="Fortschritt:" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,5" FontSize="11" />
                <ProgressBar Value="{Binding ProcessedCount}" Maximum="{Binding FileCount}" 
                            Height="18" Background="#E0E0E0" Margin="0,0,0,5" />
                <TextBlock FontSize="11" Foreground="#666" Margin="0,0,0,10">
                    <Run Text="{Binding ProcessedCount, Mode=OneWay}"/>
                    <Run Text=" / "/>
                    <Run Text="{Binding FileCount, Mode=OneWay}"/>
                    <Run Text=" Dateien"/>
                </TextBlock>

                <!-- Buttons -->
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <Button Click="OnToggleIngestion" 
                           Padding="20,10" Foreground="White" 
                           FontWeight="Bold" FontSize="12" Cursor="Hand" MinWidth="140">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Content" Value="▶ Start" />
                                <Setter Property="ToolTip" Value="Datei-Analyse starten" />
                                <Setter Property="Background" Value="#28A745" />
                                <Setter Property="IsEnabled" Value="False" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter Property="Content" Value="⏹ Stop" />
                                        <Setter Property="ToolTip" Value="Analyse abbrechen" />
                                        <Setter Property="Background" Value="#DC3545" />
                                        <Setter Property="IsEnabled" Value="True" />
                                    </DataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsRunning}" Value="False" />
                                            <Condition Binding="{Binding IsConnected}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="IsEnabled" Value="True" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            
            <!-- Rechte Spalte: TabControl für Live-Analyse und Details -->
            <Border Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="1,0,0,0" Background="White" Margin="10,10,10,10">
                <TabControl x:Name="MainTabControl">
                    <!-- Tab 1: Live-Analyse -->
                    <TabItem Header="Live-Analyse-Ergebnisse">
                        <DockPanel>
                            <DataGrid x:Name="ResultsDataGrid" ItemsSource="{Binding LiveResults}" AutoGenerateColumns="False" 
                                     IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                     BorderThickness="0" Background="White" RowBackground="White" 
                                     AlternatingRowBackground="#F9F9F9" FontSize="10" Margin="5"
                                     SelectionChanged="OnResultSelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Datei" Binding="{Binding FileName}" Width="*" />
                                    <DataGridTextColumn Header="Relevanz" Binding="{Binding RelevanceScore, StringFormat=F2}" Width="70" />
                                    <DataGridTextColumn Header="Impact" Binding="{Binding ImpactScore, StringFormat=F2}" Width="60" />
                                    <DataGridTextColumn Header="Qualität" Binding="{Binding QualityScore, StringFormat=F2}" Width="65" />
                                    <DataGridTextColumn Header="Keywords" Binding="{Binding Keywords.Count}" Width="70" />
                                    <DataGridTextColumn Header="Knoten" Binding="{Binding GraphNodeCount}" Width="55" />
                                    <DataGridTextColumn Header="Sprache" Binding="{Binding Language}" Width="60" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>

                    <!-- Tab 2: Datei-Details -->
                    <TabItem x:Name="DetailsTab" Header="Datei-Details">
                        <DockPanel>
                            <Border x:Name="DetailsPlaceholder" BorderBrush="#E0E0E0" BorderThickness="1" 
                                   Background="#F9F9F9" CornerRadius="4" Margin="10">
                                <TextBlock Text="Wählen Sie eine Datei aus der Live-Analyse aus" 
                                          FontSize="13" Foreground="#999" 
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ContentControl x:Name="DetailsContent" Visibility="Collapsed" Margin="5" />
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </DockPanel>
</Window>
