<Window x:Class="Themis.ImpactAnalysisViewer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Themis.ImpactAnalysisViewer.ViewModels"
        mc:Ignorable="d"
        Title="ThemisDB - Impact Analysis Viewer" 
        Height="900" Width="1600"
        Background="{StaticResource PrimaryBackground}">
    
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Toolbar -->
            <RowDefinition Height="Auto"/>  <!-- Connection Bar -->
            <RowDefinition Height="*"/>     <!-- Main Content -->
            <RowDefinition Height="Auto"/>  <!-- Status Bar -->
        </Grid.RowDefinitions>
        
        <!-- Toolbar -->
        <Border Grid.Row="0" Background="{StaticResource SecondaryBackground}" 
                BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1"
                Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="ThemisDB Impact Analysis" 
                              FontSize="18" 
                              FontWeight="Bold"
                              Foreground="{StaticResource PrimaryText}"
                              VerticalAlignment="Center"/>
                </StackPanel>
                
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button Content="2D View" 
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding SwitchViewCommand}"
                            CommandParameter="2D"/>
                    <Button Content="3D View" 
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding SwitchViewCommand}"
                            CommandParameter="3D"/>
                    <Button Content="Export" 
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding ExportResultsCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Connection Bar -->
        <Border Grid.Row="1" Background="{StaticResource SecondaryBackground}" 
                Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Server:" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding ServerUrl}" Width="300" Padding="4"/>
                    <Button Content="Connect" 
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding ConnectCommand}"/>
                    <Ellipse Width="12" Height="12" 
                            Fill="{Binding IsConnected, Converter={StaticResource BoolToColorConverter}}"/>
                </StackPanel>
                
                <TextBlock Grid.Column="2" 
                          Text="{Binding StatusMessage}"
                          Foreground="{StaticResource SecondaryText}"
                          VerticalAlignment="Center"/>
            </Grid>
        </Border>
        
        <!-- Main Content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>  <!-- Left Panel -->
                <ColumnDefinition Width="*"/>     <!-- Visualization -->
            </Grid.ColumnDefinitions>
            
            <!-- Left Panel: Configuration -->
            <Border Grid.Column="0" 
                    Background="{StaticResource SecondaryBackground}"
                    BorderBrush="{StaticResource BorderColor}" 
                    BorderThickness="0,0,1,0"
                    Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16">
                        
                        <!-- Document Change -->
                        <GroupBox Header="Document Change">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Document ID:"/>
                                <TextBox Text="{Binding CurrentChange.DocumentId}"/>
                                
                                <TextBlock Text="Change Type:"/>
                                <ComboBox SelectedItem="{Binding CurrentChange.ChangeType}">
                                    <ComboBoxItem Content="breaking_change"/>
                                    <ComboBoxItem Content="price_update"/>
                                    <ComboBoxItem Content="schema_change"/>
                                    <ComboBoxItem Content="api_deprecation"/>
                                </ComboBox>
                                
                                <TextBlock Text="Magnitude:"/>
                                <Slider Value="{Binding CurrentChange.Magnitude}" 
                                       Minimum="0" Maximum="1" 
                                       TickFrequency="0.1"/>
                                <TextBlock Text="{Binding CurrentChange.Magnitude, StringFormat=F2}"/>
                                
                                <TextBlock Text="Source Layer:"/>
                                <ComboBox SelectedItem="{Binding CurrentChange.SourceLayer}">
                                    <ComboBoxItem Content="document"/>
                                    <ComboBoxItem Content="process"/>
                                    <ComboBoxItem Content="api"/>
                                    <ComboBoxItem Content="database"/>
                                    <ComboBoxItem Content="ui"/>
                                </ComboBox>
                            </StackPanel>
                        </GroupBox>
                        
                        <!-- Analysis Options -->
                        <GroupBox Header="Analysis Options">
                            <StackPanel Spacing="8">
                                <CheckBox Content="Enable Hybrid Search" 
                                         IsChecked="{Binding EnableHybridSearch}"/>
                                
                                <TextBlock Text="Target Layers:" FontWeight="Bold" Margin="0,8,0,4"/>
                                <CheckBox Content="Document" IsChecked="True"/>
                                <CheckBox Content="Process" IsChecked="True"/>
                                <CheckBox Content="API" IsChecked="True"/>
                                <CheckBox Content="Database" IsChecked="True"/>
                                <CheckBox Content="UI" IsChecked="True"/>
                            </StackPanel>
                        </GroupBox>
                        
                        <!-- Actions -->
                        <Button Content="Analyze Impact" 
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding AnalyzeImpactCommand}"
                                IsEnabled="{Binding IsConnected}"/>
                        
                        <Button Content="Clear Results" 
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding ClearAnalysisCommand}"/>
                        
                        <!-- Results Summary -->
                        <GroupBox Header="Results" Visibility="{Binding CurrentResult, Converter={StaticResource NullToVisibilityConverter}}">
                            <StackPanel Spacing="4">
                                <TextBlock>
                                    <Run Text="Affected Nodes: "/>
                                    <Run Text="{Binding CurrentResult.TotalAffectedCount}" FontWeight="Bold"/>
                                </TextBlock>
                                <TextBlock>
                                    <Run Text="Max Impact: "/>
                                    <Run Text="{Binding CurrentResult.MaxImpactScore, StringFormat=F3}" FontWeight="Bold"/>
                                </TextBlock>
                                <TextBlock>
                                    <Run Text="Layers: "/>
                                    <Run Text="{Binding CurrentResult.LayersInvolved.Count}" FontWeight="Bold"/>
                                </TextBlock>
                                <TextBlock>
                                    <Run Text="Cross-Layer: "/>
                                    <Run Text="{Binding CurrentResult.CrossLayerTransitions}" FontWeight="Bold"/>
                                </TextBlock>
                                <TextBlock>
                                    <Run Text="Computation: "/>
                                    <Run Text="{Binding CurrentResult.ComputationTimeMs}" FontWeight="Bold"/>
                                    <Run Text=" ms"/>
                                </TextBlock>
                            </StackPanel>
                        </GroupBox>
                        
                    </StackPanel>
                </ScrollViewer>
            </Border>
            
            <!-- Right Panel: Visualization -->
            <Border Grid.Column="1" Background="White" Padding="16">
                <Grid>
                    <!-- 2D View -->
                    <Border Visibility="{Binding ViewMode, Converter={StaticResource ViewModeToVisibilityConverter}, ConverterParameter=2D}">
                        <TextBlock Text="2D Graph Visualization (MSAGL)"
                                  FontSize="24"
                                  Foreground="{StaticResource SecondaryText}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        <!-- Graph control would be added here -->
                    </Border>
                    
                    <!-- 3D View -->
                    <Border Visibility="{Binding ViewMode, Converter={StaticResource ViewModeToVisibilityConverter}, ConverterParameter=3D}">
                        <TextBlock Text="3D Multi-Layer Visualization (DirectX)"
                                  FontSize="24"
                                  Foreground="{StaticResource SecondaryText}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        <!-- 3D viewport would be added here -->
                    </Border>
                </Grid>
            </Border>
        </Grid>
        
        <!-- Status Bar -->
        <Border Grid.Row="3" 
                Background="{StaticResource SecondaryBackground}"
                BorderBrush="{StaticResource BorderColor}" 
                BorderThickness="0,1,0,0"
                Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" 
                          Text="{Binding StatusMessage}"
                          Foreground="{StaticResource SecondaryText}"/>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16">
                    <TextBlock Text="ThemisDB Enterprise - GPU Impact Analysis Plugin v1.0"
                              Foreground="{StaticResource SecondaryText}"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Loading Overlay -->
        <Border Grid.RowSpan="4" 
                Background="#80000000"
                Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                <TextBlock Text="Analyzing Impact..." 
                          FontSize="24" 
                          Foreground="White"
                          HorizontalAlignment="Center"/>
                <ProgressBar IsIndeterminate="True" Width="300" Height="8"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
