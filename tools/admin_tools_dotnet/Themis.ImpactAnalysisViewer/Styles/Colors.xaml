<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- Impact Score Colors (Heat Map) -->
    <SolidColorBrush x:Key="ImpactVeryLow" Color="#4CAF50"/>      <!-- Green -->
    <SolidColorBrush x:Key="ImpactLow" Color="#8BC34A"/>          <!-- Light Green -->
    <SolidColorBrush x:Key="ImpactMedium" Color="#FFC107"/>       <!-- Amber -->
    <SolidColorBrush x:Key="ImpactHigh" Color="#FF9800"/>         <!-- Orange -->
    <SolidColorBrush x:Key="ImpactVeryHigh" Color="#F44336"/>     <!-- Red -->
    <SolidColorBrush x:Key="ImpactCritical" Color="#D32F2F"/>     <!-- Dark Red -->
    
    <!-- Layer Colors -->
    <SolidColorBrush x:Key="LayerDocument" Color="#4A90E2"/>      <!-- Blue -->
    <SolidColorBrush x:Key="LayerProcess" Color="#F5A623"/>       <!-- Orange -->
    <SolidColorBrush x:Key="LayerApi" Color="#7ED321"/>           <!-- Green -->
    <SolidColorBrush x:Key="LayerDatabase" Color="#BD10E0"/>      <!-- Purple -->
    <SolidColorBrush x:Key="LayerUI" Color="#50E3C2"/>            <!-- Cyan -->
    <SolidColorBrush x:Key="LayerInfrastructure" Color="#B8E986"/><!-- Light Green -->
    <SolidColorBrush x:Key="LayerCustom" Color="#9013FE"/>        <!-- Violet -->
    
    <!-- UI Colors -->
    <SolidColorBrush x:Key="PrimaryBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SecondaryBackground" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="PrimaryText" Color="#212121"/>
    <SolidColorBrush x:Key="SecondaryText" Color="#757575"/>
    <SolidColorBrush x:Key="AccentColor" Color="#2196F3"/>
    <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>
    
    <!-- Status Colors -->
    <SolidColorBrush x:Key="SuccessColor" Color="#4CAF50"/>
    <SolidColorBrush x:Key="WarningColor" Color="#FF9800"/>
    <SolidColorBrush x:Key="ErrorColor" Color="#F44336"/>
    <SolidColorBrush x:Key="InfoColor" Color="#2196F3"/>
    
</ResourceDictionary>
