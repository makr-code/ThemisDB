<Window x:Class="Themis.GISViewer.ControlPanel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Themis GIS Viewer - Control Panel" 
        Height="800" Width="1200"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource ThemisPrimaryBrush}" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Themis GIS Viewer" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               Foreground="White"/>
                    <TextBlock Text="3D Geospatial Analysis with Unreal Engine 5" 
                               FontSize="12" 
                               Foreground="White" 
                               Opacity="0.9"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="{Binding ConnectionStatus}" 
                               VerticalAlignment="Center" 
                               Foreground="White" 
                               Margin="0,0,10,0"/>
                    <Ellipse Width="12" Height="12" 
                             Fill="{Binding ConnectionStatusColor}" 
                             VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Main Content -->
        <TabControl Grid.Row="1" Margin="10">
            <!-- Overview Tab -->
            <TabItem Header="Übersicht">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <GroupBox Grid.Row="0" Header="Verbindungen">
                        <StackPanel>
                            <Grid Margin="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Grid.Column="0" Text="Unreal Engine:" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding UnrealEngineStatus}" VerticalAlignment="Center"/>
                                <Button Grid.Column="2" Content="Verbinden" Command="{Binding ConnectToUnrealCommand}" Width="100"/>
                            </Grid>
                            
                            <Grid Margin="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Grid.Column="0" Text="ThemisDB:" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding ThemisDBStatus}" VerticalAlignment="Center"/>
                                <Button Grid.Column="2" Content="Testen" Command="{Binding TestThemisDBCommand}" Width="100"/>
                            </Grid>
                        </StackPanel>
                    </GroupBox>
                    
                    <GroupBox Grid.Row="1" Header="Geladene Plugins" Margin="0,10,0,0">
                        <ListBox ItemsSource="{Binding LoadedPlugins}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="5">
                                        <CheckBox IsChecked="{Binding IsEnabled}" Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding Version}" Foreground="Gray"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </GroupBox>
                </Grid>
            </TabItem>
            
            <!-- Wind Simulation Tab -->
            <TabItem Header="Wind-Simulation">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <GroupBox Header="Parameter">
                            <StackPanel>
                                <StackPanel Margin="5">
                                    <TextBlock Text="Wind-Geschwindigkeit (m/s)" FontWeight="Bold"/>
                                    <Slider Value="{Binding WindSpeed, Mode=TwoWay}" 
                                            Minimum="0" Maximum="50" 
                                            TickFrequency="5" 
                                            IsSnapToTickEnabled="True"
                                            Margin="0,5"/>
                                    <TextBlock Text="{Binding WindSpeed, StringFormat='{}{0:F1} m/s'}"/>
                                </StackPanel>
                                
                                <StackPanel Margin="5">
                                    <TextBlock Text="Wind-Richtung (Azimut °)" FontWeight="Bold"/>
                                    <Slider Value="{Binding WindDirection, Mode=TwoWay}" 
                                            Minimum="0" Maximum="360" 
                                            TickFrequency="45" 
                                            IsSnapToTickEnabled="True"
                                            Margin="0,5"/>
                                    <TextBlock Text="{Binding WindDirection, StringFormat='{}{0:F0}°'}"/>
                                </StackPanel>
                                
                                <StackPanel Margin="5">
                                    <TextBlock Text="Visualisierung" FontWeight="Bold"/>
                                    <ComboBox SelectedItem="{Binding VisualizationMode}" Margin="0,5">
                                        <ComboBoxItem Content="Partikel"/>
                                        <ComboBoxItem Content="Vektorfeld"/>
                                        <ComboBoxItem Content="Heatmap"/>
                                    </ComboBox>
                                </StackPanel>
                                
                                <Button Content="Simulation starten" 
                                        Command="{Binding StartSimulationCommand}" 
                                        Margin="5"/>
                            </StackPanel>
                        </GroupBox>
                        
                        <GroupBox Header="Echtzeit-Daten" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding MaxWindSpeed, StringFormat='Max: {0:F1} m/s'}" Margin="5"/>
                                <TextBlock Text="{Binding AverageWindSpeed, StringFormat='Durchschnitt: {0:F1} m/s'}" Margin="5"/>
                                <TextBlock Text="{Binding ParticleCount, StringFormat='Partikel: {0:N0}'}" Margin="5"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            
            <!-- Water Flow Tab -->
            <TabItem Header="Wasser-Simulation">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <GroupBox Header="Parameter">
                            <StackPanel>
                                <StackPanel Margin="5">
                                    <TextBlock Text="Niederschlag (mm/h)" FontWeight="Bold"/>
                                    <Slider Value="{Binding RainfallIntensity, Mode=TwoWay}" 
                                            Minimum="0" Maximum="100" 
                                            TickFrequency="10" 
                                            Margin="0,5"/>
                                    <TextBlock Text="{Binding RainfallIntensity, StringFormat='{}{0:F1} mm/h'}"/>
                                </StackPanel>
                                
                                <StackPanel Margin="5">
                                    <TextBlock Text="Dauer (Minuten)" FontWeight="Bold"/>
                                    <Slider Value="{Binding SimulationDuration, Mode=TwoWay}" 
                                            Minimum="1" Maximum="120" 
                                            TickFrequency="15" 
                                            Margin="0,5"/>
                                    <TextBlock Text="{Binding SimulationDuration, StringFormat='{}{0:F0} min'}"/>
                                </StackPanel>
                                
                                <Button Content="Simulation starten" 
                                        Command="{Binding StartWaterSimulationCommand}" 
                                        Margin="5"/>
                            </StackPanel>
                        </GroupBox>
                        
                        <GroupBox Header="Ergebnisse" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding FloodedAreaKm2, StringFormat='Überflutete Fläche: {0:F2} km²'}" Margin="5"/>
                                <TextBlock Text="{Binding MaxWaterDepth, StringFormat='Max. Wassertiefe: {0:F2} m'}" Margin="5"/>
                                <TextBlock Text="{Binding AffectedBuildings, StringFormat='Betroffene Gebäude: {0}'}" Margin="5"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            
            <!-- Disaster Simulation Tab -->
            <TabItem Header="Katastrophen-Simulation">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <GroupBox Header="Katastrophen-Typ">
                            <ComboBox SelectedItem="{Binding DisasterType}" Margin="5">
                                <ComboBoxItem Content="Erdbeben"/>
                                <ComboBoxItem Content="Hochwasser"/>
                                <ComboBoxItem Content="Feuer"/>
                                <ComboBoxItem Content="Explosion"/>
                            </ComboBox>
                        </GroupBox>
                        
                        <GroupBox Header="Parameter" Margin="0,10,0,0">
                            <StackPanel>
                                <StackPanel Margin="5">
                                    <TextBlock Text="Intensität" FontWeight="Bold"/>
                                    <Slider Value="{Binding DisasterIntensity, Mode=TwoWay}" 
                                            Minimum="1" Maximum="10" 
                                            TickFrequency="1" 
                                            IsSnapToTickEnabled="True"
                                            Margin="0,5"/>
                                    <TextBlock Text="{Binding DisasterIntensity, StringFormat='Stufe {0}'}"/>
                                </StackPanel>
                                
                                <Button Content="Simulation starten" 
                                        Command="{Binding StartDisasterSimulationCommand}" 
                                        Margin="5"/>
                            </StackPanel>
                        </GroupBox>
                        
                        <GroupBox Header="Schadensanalyse" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding TotalDamageEuro, StringFormat='Geschätzter Schaden: {0:C0}'}" Margin="5"/>
                                <TextBlock Text="{Binding CollapsedBuildings, StringFormat='Eingestürzte Gebäude: {0}'}" Margin="5"/>
                                <TextBlock Text="{Binding CasualtiesEstimate, StringFormat='Geschätzte Betroffene: {0}'}" Margin="5"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            
            <!-- Plugin Manager Tab -->
            <TabItem Header="Plugin-Manager">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Plugin laden..." Command="{Binding LoadPluginCommand}" Width="120" Margin="0,0,10,0"/>
                        <Button Content="Aktualisieren" Command="{Binding RefreshPluginsCommand}" Width="120"/>
                    </StackPanel>
                    
                    <DataGrid Grid.Row="1" 
                              ItemsSource="{Binding AvailablePlugins}" 
                              AutoGenerateColumns="False"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="200"/>
                            <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="100"/>
                            <DataGridTextColumn Header="Beschreibung" Binding="{Binding Description}" Width="*"/>
                            <DataGridCheckBoxColumn Header="Geladen" Binding="{Binding IsLoaded}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
        
        <!-- Status Bar -->
        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding CurrentTime, StringFormat='HH:mm:ss'}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
