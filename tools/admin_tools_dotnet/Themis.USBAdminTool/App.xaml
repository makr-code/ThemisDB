<Application x:Class="Themis.USBAdminTool.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <!-- Global colour palette -->
        <SolidColorBrush x:Key="HeaderBrush" Color="#2C3E50"/>
        <SolidColorBrush x:Key="AccentBrush"  Color="#27AE60"/>
        <SolidColorBrush x:Key="DangerBrush"  Color="#E74C3C"/>
        <SolidColorBrush x:Key="WarnBrush"    Color="#F39C12"/>
        <SolidColorBrush x:Key="InfoBrush"    Color="#2980B9"/>
        <SolidColorBrush x:Key="PanelBrush"   Color="#ECF0F1"/>

        <!-- Shared button style -->
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin"  Value="4"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Status badge styles -->
        <Style x:Key="OkBadge" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#27AE60"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="ErrorBadge" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#E74C3C"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Application.Resources>
</Application>
