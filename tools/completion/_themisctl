#compdef themisctl
# Zsh completion script for themisctl
#
# Installation:
#   # Place in a directory on your $fpath, e.g.:
#   mkdir -p ~/.zfunc
#   cp tools/completion/_themisctl ~/.zfunc/_themisctl
#   # Then add to ~/.zshrc (before compinit):
#   #   fpath=(~/.zfunc $fpath)
#   #   autoload -Uz compinit && compinit
#
#   # Or for oh-my-zsh custom completions:
#   cp tools/completion/_themisctl ~/.oh-my-zsh/completions/_themisctl

_themisctl() {
    local context state state_descr line
    typeset -A opt_args

    local -a global_opts=(
        '(--host)--host[ThemisDB host]:host:_hosts'
        '(--port)--port[ThemisDB port]:port:'
        '(--token)--token[Bearer auth token]:token:'
        '(--timeout)--timeout[Request timeout in seconds]:seconds:'
        '(--json)--json[Print raw JSON responses]'
        '(--no-color)--no-color[Disable ANSI colour output]'
        '(-h --help)'{-h,--help}'[Print help]'
    )

    _arguments -s -S \
        ${global_opts[@]} \
        '1: :_themisctl_commands' \
        '*:: :->args' && return 0

    case ${state} in
        args)
            case ${words[1]} in
                config)
                    _arguments \
                        '1:sub-command:(get set)' \
                        '*:key=value pair:_themisctl_config_keys'
                    ;;
                branch)
                    _arguments '1:sub-command:(list create switch delete)'
                    ;;
                snapshot)
                    _arguments '1:sub-command:(list create)'
                    ;;
                admin)
                    _arguments '1:sub-command:(stats cache)'
                    ;;
                index)
                    _arguments '1:sub-command:(recommend)' '*:table-name:'
                    ;;
                get|delete)
                    _message 'entity-id'
                    ;;
                put)
                    case ${#words[@]} in
                        2) _message 'entity-id' ;;
                        3) _message 'json-body' ;;
                    esac
                    ;;
                query)
                    _message 'aql-statement'
                    ;;
                schema)
                    _message 'table-name (optional)'
                    ;;
                *)
                    ;;
            esac
            ;;
    esac
}

_themisctl_commands() {
    local -a commands=(
        'health:Check server liveness and readiness'
        'version:Print server version information'
        'query:Execute an AQL query'
        'get:Retrieve an entity by key'
        'put:Create or update an entity'
        'delete:Delete an entity'
        'schema:Show schema'
        'config:Read or hot-reload server config'
        'branch:Branch management'
        'snapshot:Snapshot management'
        'admin:Show observability/cache statistics'
        'index:Automatic index recommendations'
        'repl:Start interactive REPL'
    )
    _describe 'command' commands
}

_themisctl_config_keys() {
    local -a keys=(
        'logging.level=:Log level (trace|debug|info|warn|error)'
        'logging.format=:Log format (text|json)'
        'request_timeout_ms=:Request timeout in milliseconds (1000-300000)'
        'features.semantic_cache=:Enable/disable semantic cache (true|false)'
        'features.llm_store=:Enable/disable LLM store (true|false)'
        'features.cdc=:Enable/disable CDC (true|false)'
        'features.timeseries=:Enable/disable timeseries (true|false)'
        'cdc_retention_hours=:CDC retention in hours (1-8760)'
    )
    _describe 'config key' keys
}

_themisctl "$@"
