<mah:MetroWindow x:Class="RailwayMonitor.WPF.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                 xmlns:mapsui="clr-namespace:Mapsui.UI.Wpf;assembly=Mapsui.UI.Wpf"
                 xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
                 xmlns:vm="clr-namespace:RailwayMonitor.WPF.ViewModels"
                 Title="🚂 Railway Monitoring System - Deutsche Bahn" 
                 Height="900" Width="1600"
                 WindowState="Maximized"
                 Background="{DynamicResource MaterialDesignPaper}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource PrimaryHueMidBrush}" Padding="15,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="Train" Width="32" Height="32" 
                                            Foreground="White" Margin="0,0,10,0"/>
                    <TextBlock Text="Railway Monitoring System" 
                              FontSize="24" FontWeight="Bold" 
                              Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Stats -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Active Trains -->
                    <Border Background="#2C3E50" Padding="15,8" Margin="5,0" CornerRadius="5">
                        <StackPanel>
                            <TextBlock Text="{Binding ActiveTrains}" FontSize="20" 
                                      FontWeight="Bold" Foreground="#3498DB" TextAlignment="Center"/>
                            <TextBlock Text="Active Trains" FontSize="11" 
                                      Foreground="#BDC3C7" TextAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Delays -->
                    <Border Background="#2C3E50" Padding="15,8" Margin="5,0" CornerRadius="5">
                        <StackPanel>
                            <TextBlock Text="{Binding DelaysOver5Min}" FontSize="20" 
                                      FontWeight="Bold" Foreground="#E74C3C" TextAlignment="Center"/>
                            <TextBlock Text="Delays > 5min" FontSize="11" 
                                      Foreground="#BDC3C7" TextAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Avg Delay -->
                    <Border Background="#2C3E50" Padding="15,8" Margin="5,0" CornerRadius="5">
                        <StackPanel>
                            <TextBlock Text="{Binding AverageDelay, StringFormat={}{0:F1} min}" 
                                      FontSize="20" FontWeight="Bold" Foreground="#F39C12" TextAlignment="Center"/>
                            <TextBlock Text="Avg Delay" FontSize="11" 
                                      Foreground="#BDC3C7" TextAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Connection Status -->
                    <Border Background="#2C3E50" Padding="15,8" Margin="5,0" CornerRadius="5">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CircleSmall" 
                                                    Foreground="{Binding ConnectionStatusColor}" 
                                                    Width="20" Height="20"/>
                            <TextBlock Text="{Binding ConnectionStatus}" 
                                      Foreground="White" VerticalAlignment="Center" Margin="5,0,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="1*" MinWidth="350" MaxWidth="450"/>
            </Grid.ColumnDefinitions>

            <!-- Map View -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="200"/>
                </Grid.RowDefinitions>

                <!-- Map -->
                <Border Grid.Row="0" BorderBrush="{DynamicResource PrimaryHueMidBrush}" BorderThickness="1">
                    <Grid>
                        <mapsui:MapControl x:Name="MapControl" 
                                          Background="#1E1E1E"/>
                        
                        <!-- Map Controls -->
                        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Right" Margin="10">
                            <!-- Layer Toggle -->
                            <Border Background="#2C3E50AA" Padding="10" CornerRadius="5" Margin="0,5">
                                <StackPanel>
                                    <TextBlock Text="Layers" FontWeight="Bold" Foreground="White" Margin="0,0,0,5"/>
                                    <CheckBox Content="Trains" IsChecked="{Binding ShowTrains}" 
                                             Foreground="White" Margin="0,2"/>
                                    <CheckBox Content="Stations" IsChecked="{Binding ShowStations}" 
                                             Foreground="White" Margin="0,2"/>
                                    <CheckBox Content="Tracks" IsChecked="{Binding ShowTracks}" 
                                             Foreground="White" Margin="0,2"/>
                                    <CheckBox Content="Signals" IsChecked="{Binding ShowSignals}" 
                                             Foreground="White" Margin="0,2"/>
                                </StackPanel>
                            </Border>

                            <!-- Zoom Controls -->
                            <Border Background="#2C3E50AA" Padding="5" CornerRadius="5" Margin="0,5">
                                <StackPanel>
                                    <Button Content="+" Command="{Binding ZoomInCommand}" 
                                           Style="{StaticResource MaterialDesignFlatButton}" 
                                           Foreground="White" Padding="10,5"/>
                                    <Button Content="−" Command="{Binding ZoomOutCommand}" 
                                           Style="{StaticResource MaterialDesignFlatButton}" 
                                           Foreground="White" Padding="10,5"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Charts -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <!-- Delay Chart -->
                    <Border Grid.Column="0" BorderBrush="{DynamicResource PrimaryHueMidBrush}" 
                           BorderThickness="1" Margin="0,5,2.5,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Verspätungen (letzte Stunde)" 
                                      FontWeight="Bold" Margin="10,5"/>
                            <lvc:CartesianChart Grid.Row="1" Series="{Binding DelaySeries}" 
                                               Margin="5"/>
                        </Grid>
                    </Border>

                    <!-- Train Category Chart -->
                    <Border Grid.Column="1" BorderBrush="{DynamicResource PrimaryHueMidBrush}" 
                           BorderThickness="1" Margin="2.5,5,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Züge nach Kategorie" 
                                      FontWeight="Bold" Margin="10,5"/>
                            <lvc:PieChart Grid.Row="1" Series="{Binding CategorySeries}" 
                                         Margin="5"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" 
                         Background="{DynamicResource PrimaryHueMidBrush}"/>

            <!-- Right Panel -->
            <Grid Grid.Column="2">
                <TabControl Style="{StaticResource MaterialDesignTabControl}">
                    <!-- Train List -->
                    <TabItem Header="Züge">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Search -->
                            <TextBox Grid.Row="0" 
                                    materialDesign:HintAssist.Hint="Zug suchen..." 
                                    Text="{Binding TrainSearchText, UpdateSourceTrigger=PropertyChanged}"
                                    Margin="10"/>

                            <!-- List -->
                            <ListBox Grid.Row="1" ItemsSource="{Binding FilteredTrains}" 
                                    SelectedItem="{Binding SelectedTrain}"
                                    Margin="10,0,10,10">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="10,5" Margin="0,2" 
                                               Background="{Binding DelayColor}" 
                                               CornerRadius="5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Category Icon -->
                                                <Ellipse Grid.Column="0" 
                                                        Fill="{Binding CategoryColor}" 
                                                        Width="10" Height="10" 
                                                        VerticalAlignment="Center" Margin="0,0,10,0"/>

                                                <!-- Train Info -->
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding TrainNumber}" 
                                                              FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding Route}" 
                                                              FontSize="11" Opacity="0.7"/>
                                                </StackPanel>

                                                <!-- Delay -->
                                                <TextBlock Grid.Column="2" 
                                                          Text="{Binding DelayText}" 
                                                          FontWeight="Bold" 
                                                          Foreground="{Binding DelayTextColor}"
                                                          VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </TabItem>

                    <!-- Delay Analysis (LLM) -->
                    <TabItem Header="KI-Analyse">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Query Input -->
                            <TextBox Grid.Row="0" 
                                    materialDesign:HintAssist.Hint="Frage an KI (z.B. 'Warum hat ICE 508 Verspätung?')"
                                    Text="{Binding LlmQuery}"
                                    AcceptsReturn="False"
                                    Margin="0,0,0,10"/>

                            <!-- Answer -->
                            <ScrollViewer Grid.Row="1">
                                <TextBlock Text="{Binding LlmAnswer}" 
                                          TextWrapping="Wrap"
                                          Margin="0,0,0,10"/>
                            </ScrollViewer>

                            <!-- Actions -->
                            <Button Grid.Row="2" 
                                   Content="Analysieren" 
                                   Command="{Binding AnalyzeWithLlmCommand}"
                                   Style="{StaticResource MaterialDesignRaisedButton}"
                                   HorizontalAlignment="Stretch"/>
                        </Grid>
                    </TabItem>

                    <!-- Network Status -->
                    <TabItem Header="Netzstatus">
                        <ScrollViewer Margin="10">
                            <StackPanel>
                                <!-- ThemisDB -->
                                <materialDesign:Card Margin="0,5">
                                    <StackPanel Margin="15">
                                        <TextBlock Text="ThemisDB" FontWeight="Bold" FontSize="16"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,5">
                                            <materialDesign:PackIcon Kind="CircleSmall" 
                                                                    Foreground="{Binding ThemisDbStatusColor}"/>
                                            <TextBlock Text="{Binding ThemisDbStatus}" Margin="5,0"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding ThemisDbUrl}" Opacity="0.7" FontSize="11"/>
                                    </StackPanel>
                                </materialDesign:Card>

                                <!-- Ollama -->
                                <materialDesign:Card Margin="0,5">
                                    <StackPanel Margin="15">
                                        <TextBlock Text="Ollama LLM" FontWeight="Bold" FontSize="16"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,5">
                                            <materialDesign:PackIcon Kind="CircleSmall" 
                                                                    Foreground="{Binding OllamaStatusColor}"/>
                                            <TextBlock Text="{Binding OllamaStatus}" Margin="5,0"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding OllamaUrl}" Opacity="0.7" FontSize="11"/>
                                    </StackPanel>
                                </materialDesign:Card>

                                <!-- Simulator -->
                                <materialDesign:Card Margin="0,5">
                                    <StackPanel Margin="15">
                                        <TextBlock Text="Train Simulator" FontWeight="Bold" FontSize="16"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,5">
                                            <materialDesign:PackIcon Kind="CircleSmall" 
                                                                    Foreground="{Binding SimulatorStatusColor}"/>
                                            <TextBlock Text="{Binding SimulatorStatus}" Margin="5,0"/>
                                        </StackPanel>
                                        <Button Content="Start Simulator" 
                                               Command="{Binding StartSimulatorCommand}"
                                               Margin="0,10,0,0"
                                               Visibility="{Binding SimulatorNotRunning, Converter={StaticResource BoolToVis}}"/>
                                        <Button Content="Stop Simulator" 
                                               Command="{Binding StopSimulatorCommand}"
                                               Margin="0,10,0,0"
                                               Style="{StaticResource MaterialDesignFlatButton}"
                                               Visibility="{Binding SimulatorRunning, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </materialDesign:Card>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>

        <!-- Status Bar -->
        <StatusBar Grid.Row="2" Background="{DynamicResource PrimaryHueMidBrush}">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" Foreground="White"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding LastUpdateTime, StringFormat='Last Update: {0:HH:mm:ss}'}" 
                          Foreground="White"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Updates: " Foreground="White"/>
                    <TextBlock Text="{Binding TotalUpdates}" Foreground="White" FontWeight="Bold"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>

</mah:MetroWindow>
