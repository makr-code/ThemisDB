<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>railway.ico</ApplicationIcon>
    <AssemblyName>RailwayMonitor</AssemblyName>
    <RootNamespace>RailwayMonitor.WPF</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Company>ThemisDB</Company>
    <Product>Railway Monitoring System</Product>
    <Description>Echtzeit-Überwachungssystem für Zugverkehr der Deutschen Bahn</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF UI Libraries -->
    <PackageReference Include="MaterialDesignThemes" Version="5.0.0" />
    <PackageReference Include="MaterialDesignColors" Version="3.0.0" />
    <PackageReference Include="MahApps.Metro" Version="2.4.10" />
    
    <!-- MVVM -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    
    <!-- HTTP Client -->
    <PackageReference Include="Refit" Version="7.2.22" />
    <PackageReference Include="System.Net.Http.Json" Version="8.0.0" />
    
    <!-- JSON -->
    <PackageReference Include="System.Text.Json" Version="8.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    
    <!-- Maps -->
    <PackageReference Include="Mapsui" Version="4.1.4" />
    <PackageReference Include="Mapsui.Wpf" Version="4.1.4" />
    
    <!-- Charts -->
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.0-rc2" />
    
    <!-- WebSocket -->
    <PackageReference Include="Websocket.Client" Version="5.1.1" />
    
    <!-- Logging -->
    <PackageReference Include="Serilog" Version="3.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="5.0.1" />
    
    <!-- Geo-Spatial -->
    <PackageReference Include="NetTopologySuite" Version="2.5.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\**\*" />
  </ItemGroup>

</Project>
