{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/giuf/schemas/recipe.schema.json",
  "title": "GIUF Install/Uninstall Recipe",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "recipe_id", "actions"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "recipe_id": { "type": "string", "minLength": 1 },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "type"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "minLength": 1 },
          "when_os": { "type": "string", "enum": ["windows", "linux", "macos"] }
        }
      }
    }
  }
}
