# RESPO - RAG-Enhanced Software Programming Optimizer
# Environment Configuration Template
# This is a STANDALONE project - no specific database dependency required

# =============================================================================
# Vector Store Configuration (choose one)
# =============================================================================
VECTOR_STORE=chroma                    # Options: chroma, qdrant, weaviate, themis

# ChromaDB (default, local embedded)
CHROMA_PERSIST_DIR=./data/chroma

# Qdrant (optional)
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# Weaviate (optional)
# WEAVIATE_URL=http://localhost:8080
# WEAVIATE_API_KEY=

# ThemisDB (optional)
# THEMIS_URL=http://localhost:8765
# THEMIS_AUTH_TOKEN=

# =============================================================================
# vLLM Configuration
# =============================================================================
VLLM_URL=http://localhost:8000
VLLM_MODEL=codellama/CodeLlama-13b-Instruct-hf
VLLM_API_KEY=

# LoRA Adapters (comma-separated: name=path)
VLLM_LORA_MODULES=respo-python=/models/lora/respo-python

# Model Configuration
VLLM_MAX_TOKENS=2048
VLLM_TEMPERATURE=0.1
VLLM_TOP_P=0.95

# =============================================================================
# Embedding Configuration
# =============================================================================
EMBEDDING_MODEL=microsoft/codebert-base
EMBEDDING_DEVICE=cuda  # cuda, cpu, or mps
EMBEDDING_BATCH_SIZE=32

# =============================================================================
# RAG Configuration
# =============================================================================
RAG_TOP_K=50
RAG_RERANK_TOP_K=10
RAG_MIN_SCORE=0.5

# Reranking Model
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# =============================================================================
# API Server Configuration
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8080
API_WORKERS=1

# CORS
CORS_ORIGINS=*

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json  # json or text

# =============================================================================
# Feature Flags
# =============================================================================
ENABLE_STREAMING=true
ENABLE_RERANKING=true
ENABLE_GRAPH_RETRIEVAL=true
ENABLE_CACHE=true

# =============================================================================
# Cache Configuration
# =============================================================================
CACHE_TTL=3600  # seconds
CACHE_MAX_SIZE=1000

# =============================================================================
# GitHub Scraper (for data collection)
# =============================================================================
GITHUB_TOKEN=                          # Optional: for higher rate limits
GITHUB_CLONE_DEPTH=1                   # Shallow clone depth
