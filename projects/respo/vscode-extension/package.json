{
  "name": "respo-vscode",
  "displayName": "RESPO - RAG LLM Coding Assistant",
  "description": "On-premise RAG-based coding assistant with MCP integration",
  "version": "0.1.0",
  "publisher": "respo",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Machine Learning",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "respo.chat",
        "title": "RESPO: Chat"
      },
      {
        "command": "respo.explain",
        "title": "RESPO: Explain Code"
      },
      {
        "command": "respo.review",
        "title": "RESPO: Review Code"
      },
      {
        "command": "respo.complete",
        "title": "RESPO: Complete Code"
      },
      {
        "command": "respo.research",
        "title": "RESPO: Deep Research"
      },
      {
        "command": "respo.setServer",
        "title": "RESPO: Set Server URL"
      }
    ],
    "configuration": {
      "title": "RESPO",
      "properties": {
        "respo.serverUrl": {
          "type": "string",
          "default": "http://localhost:8080",
          "description": "RESPO server URL"
        },
        "respo.enableMcp": {
          "type": "boolean",
          "default": true,
          "description": "Enable MCP integration"
        }
      }
    },
    "menus": {
      "editor/context": [
        {
          "command": "respo.explain",
          "group": "respo",
          "when": "editorHasSelection"
        },
        {
          "command": "respo.review",
          "group": "respo",
          "when": "editorHasSelection"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.55.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "node-fetch": "^3.3.2"
  }
}
