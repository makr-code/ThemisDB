{
  "id": "pdv-vis5-document",
  "name": "PDV VIS 5 Dokumentenverwaltung",
  "description": "Umfassende Dokumentenverwaltungsmaske basierend auf PDV VIS 5 Standard",
  "version": "5.0",
  "metadata": {
    "category": "DocumentManagement",
    "system": "PDV VIS 5",
    "organization": "Öffentliche Verwaltung",
    "createdDate": "2025-01-01T00:00:00Z",
    "modifiedDate": "2025-12-09T00:00:00Z"
  },
  "sections": [
    {
      "id": "grunddaten",
      "title": "📋 Grunddaten",
      "description": "Basisdaten des Dokumentes",
      "order": 1,
      "isCollapsible": true,
      "isExpanded": true,
      "fields": [
        {
          "id": "document-number",
          "name": "document_number",
          "label": "Dokumentennummer",
          "type": "Text",
          "isRequired": true,
          "isReadOnly": true,
          "placeholder": "z.B. MU123456",
          "helpText": "Eindeutige Dokumentenidentifikation",
          "pattern": "^[A-Z]{2}\\d{6}$",
          "order": 1
        },
        {
          "id": "document-title",
          "name": "document_title",
          "label": "Dokumententitel",
          "type": "Text",
          "isRequired": true,
          "placeholder": "Titel des Dokumentes eingeben",
          "maxLength": 255,
          "order": 2
        },
        {
          "id": "document-type",
          "name": "document_type",
          "label": "Dokumenttyp",
          "type": "DropDown",
          "isRequired": true,
          "order": 3,
          "options": [
            {
              "value": "letter",
              "label": "Schreiben"
            },
            {
              "value": "report",
              "label": "Bericht"
            },
            {
              "value": "protocol",
              "label": "Protokoll"
            },
            {
              "value": "contract",
              "label": "Vertrag"
            },
            {
              "value": "decision",
              "label": "Bescheid"
            },
            {
              "value": "other",
              "label": "Sonstiges"
            }
          ]
        },
        {
          "id": "classification",
          "name": "classification",
          "label": "Klassifikation (VS-NfD)",
          "type": "DropDown",
          "defaultValue": "vs-nfd",
          "order": 4,
          "options": [
            {
              "value": "public",
              "label": "Veröffentlichung"
            },
            {
              "value": "internal",
              "label": "Nur für den Dienstgebrauch"
            },
            {
              "value": "vs-nfd",
              "label": "Verschlusssache - Nur für den Dienstgebrauch"
            },
            {
              "value": "vs-restricted",
              "label": "Verschlusssache - Geheim"
            }
          ]
        },
        {
          "id": "document-date",
          "name": "document_date",
          "label": "Dokumentdatum",
          "type": "Date",
          "isRequired": true,
          "order": 5
        },
        {
          "id": "description",
          "name": "description",
          "label": "Beschreibung",
          "type": "TextArea",
          "placeholder": "Ausführliche Beschreibung des Dokumentes",
          "maxLength": 2000,
          "order": 6
        }
      ]
    },
    {
      "id": "administration",
      "title": "⚙️ Verwaltungsdaten",
      "description": "Verwaltungs- und Organisationsdaten",
      "order": 2,
      "isCollapsible": true,
      "isExpanded": true,
      "fields": [
        {
          "id": "department",
          "name": "department",
          "label": "Abteilung",
          "type": "ComboBox",
          "isRequired": true,
          "order": 1,
          "options": [
            {
              "value": "hr",
              "label": "Personalwesen"
            },
            {
              "value": "finance",
              "label": "Finanzen"
            },
            {
              "value": "legal",
              "label": "Rechtswesen"
            },
            {
              "value": "operations",
              "label": "Betrieb"
            }
          ]
        },
        {
          "id": "responsible-person",
          "name": "responsible_person",
          "label": "Verantwortliche Person",
          "type": "Text",
          "isRequired": true,
          "order": 2
        },
        {
          "id": "cost-center",
          "name": "cost_center",
          "label": "Kostenstelle",
          "type": "Text",
          "pattern": "^\\d{6}$",
          "order": 3
        },
        {
          "id": "priority",
          "name": "priority",
          "label": "Priorität",
          "type": "RadioButton",
          "defaultValue": "normal",
          "order": 4,
          "options": [
            {
              "value": "low",
              "label": "Niedrig"
            },
            {
              "value": "normal",
              "label": "Normal"
            },
            {
              "value": "high",
              "label": "Hoch"
            },
            {
              "value": "urgent",
              "label": "Dringend"
            }
          ]
        }
      ]
    },
    {
      "id": "metadata",
      "title": "🏷️ Metadaten & Archivierung",
      "description": "Metadaten und Archivierungsinformationen",
      "order": 3,
      "isCollapsible": true,
      "isExpanded": false,
      "fields": [
        {
          "id": "keywords",
          "name": "keywords",
          "label": "Schlagworte",
          "type": "TextArea",
          "helpText": "Durch Komma getrennte Schlagworte für die Suche",
          "order": 1
        },
        {
          "id": "retention-period",
          "name": "retention_period",
          "label": "Aufbewahrungsfrist (Jahre)",
          "type": "Number",
          "defaultValue": 10,
          "minValue": 0,
          "maxValue": 99,
          "order": 2
        },
        {
          "id": "archive-status",
          "name": "archive_status",
          "label": "Archivierungsstatus",
          "type": "DropDown",
          "defaultValue": "pending",
          "order": 3,
          "options": [
            {
              "value": "active",
              "label": "Aktiv"
            },
            {
              "value": "pending",
              "label": "Ausstehend"
            },
            {
              "value": "archived",
              "label": "Archiviert"
            },
            {
              "value": "deleted",
              "label": "Gelöscht"
            }
          ]
        },
        {
          "id": "is-confidential",
          "name": "is_confidential",
          "label": "Vertraulich",
          "type": "Checkbox",
          "defaultValue": false,
          "order": 4
        }
      ]
    },
    {
      "id": "approval",
      "title": "✅ Freigabe & Genehmigung",
      "description": "Freigabe- und Genehmigungsprozess",
      "order": 4,
      "isCollapsible": true,
      "isExpanded": false,
      "fields": [
        {
          "id": "approver",
          "name": "approver",
          "label": "Freigegeben durch",
          "type": "Text",
          "order": 1
        },
        {
          "id": "approval-date",
          "name": "approval_date",
          "label": "Freigabedatum",
          "type": "DateTime",
          "order": 2
        },
        {
          "id": "approval-status",
          "name": "approval_status",
          "label": "Status der Freigabe",
          "type": "DropDown",
          "defaultValue": "pending",
          "order": 3,
          "options": [
            {
              "value": "pending",
              "label": "Ausstehend"
            },
            {
              "value": "approved",
              "label": "Genehmigt"
            },
            {
              "value": "rejected",
              "label": "Abgelehnt"
            },
            {
              "value": "revision",
              "label": "Überarbeitung erforderlich"
            }
          ]
        },
        {
          "id": "approval-comment",
          "name": "approval_comment",
          "label": "Kommentar zur Genehmigung",
          "type": "TextArea",
          "maxLength": 1000,
          "order": 4
        }
      ]
    }
  ]
}
