<UserControl x:Class="Themis.DocumentManager.Features.TaskBasket.Views.TaskCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="350">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        
        <!-- Priority Colors -->
        <SolidColorBrush x:Key="LowPriorityBrush" Color="#22c55e"/>
        <SolidColorBrush x:Key="NormalPriorityBrush" Color="#3b82f6"/>
        <SolidColorBrush x:Key="HighPriorityBrush" Color="#f97316"/>
        <SolidColorBrush x:Key="UrgentPriorityBrush" Color="#dc2626"/>
        
        <!-- Status Colors -->
        <SolidColorBrush x:Key="PendingBrush" Color="#eab308"/>
        <SolidColorBrush x:Key="InProgressBrush" Color="#3b82f6"/>
        <SolidColorBrush x:Key="CompletedBrush" Color="#22c55e"/>
        <SolidColorBrush x:Key="OverdueBrush" Color="#dc2626"/>
    </UserControl.Resources>
    
    <Grid Background="#FFF8FAFC">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Search and Filters -->
            <RowDefinition Height="*"/>
            <!-- Task List -->
        </Grid.RowDefinitions>
        
        <!-- Search and Quick Filters -->
        <Border Grid.Row="0" Background="White" BorderBrush="#FFE2E8F0" BorderThickness="0,0,0,1" Padding="8">
            <StackPanel>
                <!-- Search Box -->
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                         Margin="0,0,0,8"
                         BorderBrush="#FFE2E8F0"
                         Padding="8,6">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="Foreground" Value="#FF64748B"/>
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <VisualBrush Stretch="None" AlignmentX="Left" AlignmentY="Center">
                                                <VisualBrush.Visual>
                                                    <TextBlock Text="🔍 Aufgaben durchsuchen..." 
                                                               Foreground="#FFA0AEC0" 
                                                               Margin="4,0,0,0"/>
                                                </VisualBrush.Visual>
                                            </VisualBrush>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                
                <!-- Quick Filters -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <ComboBox SelectedItem="{Binding SortBy}" Width="100" Margin="0,0,4,0" FontSize="11">
                        <ComboBoxItem Content="Fälligkeit" Tag="DueDate"/>
                        <ComboBoxItem Content="Priorität" Tag="Priority"/>
                        <ComboBoxItem Content="Titel" Tag="Title"/>
                    </ComboBox>
                    
                    <ComboBox SelectedItem="{Binding StatusFilter}" Width="100" Margin="0,0,4,0" FontSize="11">
                        <ComboBoxItem Content="Alle" Tag="{x:Null}"/>
                        <ComboBoxItem Content="Offen" Tag="Pending"/>
                        <ComboBoxItem Content="Läuft" Tag="InProgress"/>
                        <ComboBoxItem Content="Erledigt" Tag="Completed"/>
                    </ComboBox>
                    
                    <Button Content="↻" Command="{Binding LoadTasksCommand}" 
                            Width="30" Height="26" FontSize="14" 
                            ToolTip="Aktualisieren"/>
                </StackPanel>
            </StackPanel>
        </Border>
        
        <!-- Task Cards List -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="8">
            <ItemsControl ItemsSource="{Binding Tasks}" AllowDrop="True">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Task Card -->
                        <Border Background="White" 
                                CornerRadius="6" 
                                Margin="0,0,0,8" 
                                BorderThickness="1"
                                Padding="0"
                                Cursor="Hand"
                                MouseDown="TaskCard_MouseDown"
                                AllowDrop="True"
                                DragEnter="TaskCard_DragEnter"
                                DragLeave="TaskCard_DragLeave"
                                Drop="TaskCard_Drop"
                                Tag="{Binding}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="#FFE2E8F0"/>
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.1" Color="Black"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="BorderBrush" Value="#FF3b82f6"/>
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.15" Color="#FF3b82f6"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                        <!-- Highlight related tasks -->
                                        <DataTrigger Binding="{Binding IsRelatedToCurrentEntity}" Value="True">
                                            <Setter Property="BorderBrush" Value="#FFf59e0b"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <!-- Priority Indicator Bar -->
                                <Border Grid.Row="0" Height="4" CornerRadius="6,6,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Priority}" Value="Low">
                                                    <Setter Property="Background" Value="{StaticResource LowPriorityBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Priority}" Value="Normal">
                                                    <Setter Property="Background" Value="{StaticResource NormalPriorityBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Priority}" Value="High">
                                                    <Setter Property="Background" Value="{StaticResource HighPriorityBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Priority}" Value="Urgent">
                                                    <Setter Property="Background" Value="{StaticResource UrgentPriorityBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                
                                <!-- Task Content -->
                                <StackPanel Grid.Row="1" Margin="12,8">
                                    <!-- Title -->
                                    <TextBlock Text="{Binding Title}" 
                                               FontWeight="SemiBold" 
                                               FontSize="13" 
                                               TextWrapping="Wrap"
                                               Foreground="#FF1e293b"
                                               Margin="0,0,0,4"/>
                                    
                                    <!-- Description (truncated) -->
                                    <TextBlock Text="{Binding Description}" 
                                               FontSize="11" 
                                               Foreground="#FF64748B"
                                               TextTrimming="CharacterEllipsis" 
                                               MaxHeight="32"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,8"/>
                                    
                                    <!-- Metadata Row -->
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Category Badge -->
                                        <Border Grid.Column="0" 
                                                Background="#FFe0e7ff" 
                                                Padding="6,2" 
                                                CornerRadius="4"
                                                HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Category}" 
                                                       FontSize="10" 
                                                       FontWeight="SemiBold"
                                                       Foreground="#FF3730a3"/>
                                        </Border>
                                        
                                        <!-- Due Date -->
                                        <TextBlock Grid.Column="1" 
                                                   Text="{Binding DueDate, StringFormat='📅 {0:dd.MM}'}" 
                                                   FontSize="10" 
                                                   Foreground="#FF64748B"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding DueDate, Converter={StaticResource BoolToVisibility}}"/>
                                    </Grid>
                                </StackPanel>
                                
                                <!-- Quick Actions Footer -->
                                <Border Grid.Row="2" 
                                        Background="#FFF8FAFC" 
                                        BorderBrush="#FFE2E8F0" 
                                        BorderThickness="0,1,0,0"
                                        Padding="8,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Status Badge -->
                                        <Border Grid.Column="0" 
                                                Padding="6,2" 
                                                CornerRadius="10"
                                                HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                            <Setter Property="Background" Value="{StaticResource PendingBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="InProgress">
                                                            <Setter Property="Background" Value="{StaticResource InProgressBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                            <Setter Property="Background" Value="{StaticResource CompletedBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Overdue">
                                                            <Setter Property="Background" Value="{StaticResource OverdueBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Status}" 
                                                       Foreground="White" 
                                                       FontSize="9" 
                                                       FontWeight="Bold"/>
                                        </Border>
                                        
                                        <!-- Quick Actions -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Content="✓" 
                                                    Command="{Binding DataContext.MarkTaskCompletedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Width="24" Height="24" 
                                                    FontSize="12"
                                                    Margin="0,0,4,0"
                                                    ToolTip="Erledigt markieren"
                                                    Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"/>
                                            <Button Content="▶" 
                                                    Command="{Binding DataContext.OpenTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Width="24" Height="24" 
                                                    FontSize="10"
                                                    ToolTip="Öffnen"
                                                    Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        
        <!-- Loading Overlay -->
        <Border Grid.Row="1" 
                Background="#E0FFFFFF" 
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="⏳" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="Lade Aufgaben..." 
                           Foreground="#FF64748B"
                           FontSize="13" 
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
        
        <!-- Empty State -->
        <Border Grid.Row="1" 
                Background="Transparent"
                Visibility="{Binding HasNoTasks, Converter={StaticResource BoolToVisibility}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                <TextBlock Text="📋" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                <TextBlock Text="Keine Aufgaben vorhanden" 
                           FontWeight="SemiBold"
                           FontSize="14" 
                           Foreground="#FF64748B"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,4"/>
                <TextBlock Text="Alle Aufgaben sind erledigt!" 
                           FontSize="12" 
                           Foreground="#FF94a3b8"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
