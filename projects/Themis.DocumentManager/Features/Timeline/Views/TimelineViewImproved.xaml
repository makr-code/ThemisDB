<UserControl x:Class="Themis.DocumentManager.Features.Timeline.Views.TimelineViewImproved"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:Themis.DocumentManager.Converters"
             Background="White">
    
    <UserControl.Resources>
        <converters:ScaleToStringConverter x:Key="ScaleToStringConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:DateToXConverter x:Key="DateToXConverter"/>
        <converters:SwimlaneToYConverter x:Key="SwimlaneToYConverter"/>
        <converters:DurationToWidthConverter x:Key="DurationToWidthConverter"/>
        <converters:ProgressToWidthConverter x:Key="ProgressToWidthConverter"/>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Compact Toolbar -->
            <RowDefinition Height="*"/>
            <!-- Content -->
        </Grid.RowDefinitions>

        <!-- Compact Toolbar: Search Icon, Filter, Scale, Zoom, Settings -->
        <Grid Grid.Row="1" Margin="16,4,16,4" Background="#f0f4f8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <!-- Search -->
            <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                     Margin="8" Padding="8,4" VerticalContentAlignment="Center">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Setter Property="Foreground" Value="#475569"/>
                        <Style.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <VisualBrush Stretch="None" AlignmentX="Left">
                                            <VisualBrush.Visual>
                                                <TextBlock Text="🔍 Suche..." Foreground="#94a3b8" 
                                                           Margin="10,0,0,0" FontSize="12"/>
                                            </VisualBrush.Visual>
                                        </VisualBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>
            
            <!-- Filter Button -->
            <Button Grid.Column="1" Content="🎯 Filter" Margin="0,8,8,8" Padding="12,6"
                    Command="{Binding ShowFilterDialogCommand}"/>
            
            <!-- Scale Selector -->
            <ComboBox Grid.Column="2" Margin="0,8,8,8" Padding="8,6"
                      SelectedItem="{Binding CurrentScale}"
                      ItemsSource="{Binding AvailableScales}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource ScaleToStringConverter}}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            
            <!-- Zoom Controls -->
            <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="0,0,8,0" VerticalAlignment="Center">
                <Button Content="➖" Padding="8,4" Margin="0,0,2,0"
                        Command="{Binding ZoomOutCommand}" ToolTip="Zoom Out"/>
                <Button Content="➕" Padding="8,4" Margin="0,0,2,0"
                        Command="{Binding ZoomInCommand}" ToolTip="Zoom In"/>
                <Button Content="📅" Padding="8,4" 
                        Command="{Binding JumpToTodayCommand}" ToolTip="Heute"/>
            </StackPanel>
            
            <!-- Settings -->
            <Button Grid.Column="4" Content="⚙️" Margin="0,0,4,0" Padding="8,4"
                    ToolTip="Einstellungen" VerticalAlignment="Center">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Gantt-Overlay anzeigen" 
                                  IsCheckable="True" 
                                  IsChecked="{Binding ShowGanttOverlay}"/>
                        <MenuItem Header="Milestones anzeigen" 
                                  IsCheckable="True" 
                                  IsChecked="{Binding ShowMilestones}"/>
                        <MenuItem Header="Phasen in Balken" 
                                  IsCheckable="True" 
                                  IsChecked="{Binding ShowPhasesInBars}"/>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
        </Grid>

        <!-- Timeline Ruler (Time Scale) with realistic tick marks -->
        <Border Grid.Row="1" Background="White" BorderBrush="#e2e8f0" BorderThickness="0,0,0,1"
                Height="35" VerticalAlignment="Top" Margin="8,0,8,0"
                x:Name="TimelineRulerBorder">
            <ItemsControl ItemsSource="{Binding TimeRulerMarks}" Background="Transparent"
                          SizeChanged="TimelineRuler_SizeChanged">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas Height="35" ClipToBounds="False"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Vertical">
                            <!-- Tick Mark with variable height -->
                            <Rectangle Width="1" Height="{Binding TickHeight}" Fill="#cbd5e1"
                                       Canvas.Left="{Binding PositionX}" Canvas.Top="0"/>
                            <!-- Label (only for major ticks) -->
                            <TextBlock Text="{Binding Label}" Foreground="#64748b" FontSize="9"
                                       Canvas.Left="{Binding LabelPositionX}"
                                       Canvas.Top="{Binding TickHeight}" FontWeight="Normal"
                                       Visibility="{Binding IsMajor, Converter={StaticResource BoolToVisibilityConverter}}"
                                       Cursor="Hand">
                                <TextBlock.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding DataContext.JumpToDateCommand, 
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding Date}"/>
                                </TextBlock.InputBindings>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- Timeline -->
        <ListBox Grid.Row="1" ItemsSource="{Binding FilteredItems}" Margin="8,40,8,8" Background="White">
            <ListBox.Template>
                <ControlTemplate TargetType="ListBox">
                    <Grid>
                        <!-- Gantt Overlay (Background Layer) -->
                        <Canvas x:Name="GanttOverlayCanvas" 
                                Visibility="{Binding ShowGanttOverlay, Converter={StaticResource BoolToVisibilityConverter}}"
                                Background="Transparent"
                                IsHitTestVisible="False">
                            <ItemsControl ItemsSource="{Binding GanttBars}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <!-- Swimlane Background -->
                                            <Rectangle Width="2000" Height="50" 
                                                       Fill="#f8fafc" Opacity="0.5"
                                                       Canvas.Left="0"
                                                       Canvas.Top="{Binding SwimlaneIndex, Converter={StaticResource SwimlaneToYConverter}}"/>
                                            
                                            <!-- Gantt Bar with Phases -->
                                            <Border BorderBrush="{Binding Color}" BorderThickness="2"
                                                    CornerRadius="4" Height="36"
                                                    Canvas.Left="{Binding StartDate, Converter={StaticResource DateToXConverter}}"
                                                    Canvas.Top="{Binding SwimlaneIndex, Converter={StaticResource SwimlaneToYConverter}}"
                                                    Width="{Binding Duration, Converter={StaticResource DurationToWidthConverter}}"
                                                    ToolTip="{Binding ProcessName}">
                                                <Grid>
                                                    <!-- Progress Bar -->
                                                    <Rectangle Fill="{Binding Color}" Opacity="0.3" 
                                                               RadiusX="2" RadiusY="2"/>
                                                    <Rectangle Fill="{Binding Color}" Opacity="0.8"
                                                               Width="{Binding Progress, Converter={StaticResource ProgressToWidthConverter}}"
                                                               HorizontalAlignment="Left"
                                                               RadiusX="2" RadiusY="2"/>
                                                    
                                                    <!-- Phases Overlay -->
                                                    <ItemsControl ItemsSource="{Binding Phases}"
                                                                  Visibility="{Binding DataContext.ShowPhasesInBars, 
                                                                             RelativeSource={RelativeSource AncestorType=UserControl},
                                                                             Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <Canvas/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Rectangle Fill="{Binding Color}" Height="4"
                                                                           Canvas.Left="{Binding StartDate, Converter={StaticResource DateToXConverter}}"
                                                                           Width="{Binding Duration, Converter={StaticResource DurationToWidthConverter}}"
                                                                           ToolTip="{Binding Name}"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    
                                                    <!-- Process Name Label -->
                                                    <TextBlock Text="{Binding ProcessName}" 
                                                               FontSize="10" FontWeight="SemiBold"
                                                               Foreground="White"
                                                               VerticalAlignment="Center"
                                                               Margin="8,0"/>
                                                </Grid>
                                            </Border>
                                            
                                            <!-- Milestones -->
                                            <ItemsControl ItemsSource="{Binding Milestones}"
                                                          Visibility="{Binding DataContext.ShowMilestones, 
                                                                     RelativeSource={RelativeSource AncestorType=UserControl},
                                                                     Converter={StaticResource BoolToVisibilityConverter}}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <Canvas/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Canvas.Left="{Binding Date, Converter={StaticResource DateToXConverter}}"
                                                              Canvas.Top="{Binding SwimlaneIndex, Converter={StaticResource SwimlaneToYConverter}}">
                                                            <!-- Milestone Diamond -->
                                                            <Path Fill="{Binding Color}" Stroke="#1e293b" StrokeThickness="2"
                                                                  Data="M 0,-10 L 10,0 L 0,10 L -10,0 Z"
                                                                  ToolTip="{Binding Name}"/>
                                                            <!-- Checkmark if completed -->
                                                            <TextBlock Text="✓" FontSize="10" FontWeight="Bold"
                                                                       Foreground="White" HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Canvas>
                        
                        <!-- Timeline Items (Foreground Layer) -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </ListBox.Template>
            
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="#ffffff" BorderBrush="#e2e8f0" BorderThickness="1" Margin="0,0,0,8">
                        <Grid Margin="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="📄" FontSize="16"/>
                            <Grid Grid.Column="1" Margin="12,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="#1e293b"/>
                                <TextBlock Grid.Row="1" Text="{Binding Description}" Foreground="#64748b" FontSize="11" Margin="0,4,0,0"/>
                                <TextBlock Grid.Row="2" Text="{Binding CreatedAt, StringFormat='📅 {0:yyyy-MM-dd HH:mm}'}" Foreground="#94a3b8" FontSize="10" Margin="0,6,0,0"/>
                            </Grid>
                            <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="#059669" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Top"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>