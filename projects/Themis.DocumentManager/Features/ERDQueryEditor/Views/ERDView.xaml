<UserControl x:Class="Themis.DocumentManager.Features.ERDQueryEditor.Views.ERDView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000"
             Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#f8fafc" BorderBrush="#e2e8f0" BorderThickness="0,0,0,1" Padding="10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🗂️ Entity-Relationship Diagram" FontSize="16" FontWeight="Bold" Foreground="#334155" VerticalAlignment="Center"/>
                <Separator Margin="15,0" Background="#e2e8f0" Width="1"/>
                
                <Button Content="🔄 Aktualisieren" Command="{Binding RefreshSchemaCommand}" Padding="8,4" Margin="0,0,5,0" ToolTip="Schema aktualisieren"/>
                <Button Content="📐 Auto-Layout" Command="{Binding AutoLayoutCommand}" Padding="8,4" Margin="0,0,5,0" ToolTip="Entitäten automatisch anordnen"/>
                <Separator Margin="10,0" Background="#e2e8f0" Width="1"/>
                
                <Button Content="➕" Command="{Binding ZoomInCommand}" Padding="8,4" Width="30" Margin="0,0,2,0" ToolTip="Vergrößern"/>
                <TextBlock Text="{Binding ZoomPercentage}" VerticalAlignment="Center" Margin="5,0" FontWeight="SemiBold" Foreground="#64748b"/>
                <Button Content="➖" Command="{Binding ZoomOutCommand}" Padding="8,4" Width="30" Margin="2,0,5,0" ToolTip="Verkleinern"/>
                <Button Content="⊡" Command="{Binding ResetZoomCommand}" Padding="8,4" Width="30" Margin="0,0,5,0" ToolTip="Zoom zurücksetzen"/>
                
                <Separator Margin="10,0" Background="#e2e8f0" Width="1"/>
                <Button Content="💾 Exportieren" Command="{Binding ExportDiagramCommand}" Padding="8,4" ToolTip="Diagramm exportieren"/>
            </StackPanel>
        </Border>

        <!-- Main Canvas Area -->
        <Border Grid.Row="1" Grid.Column="0" Background="White" BorderBrush="#e2e8f0" BorderThickness="0,0,1,0" ClipToBounds="True">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Canvas x:Name="DiagramCanvas" Width="2000" Height="1500">
                    <Canvas.RenderTransform>
                        <ScaleTransform ScaleX="{Binding ZoomLevel}" ScaleY="{Binding ZoomLevel}"/>
                    </Canvas.RenderTransform>

                    <!-- Grid Background -->
                    <Canvas.Background>
                        <DrawingBrush TileMode="Tile" Viewport="0,0,20,20" ViewportUnits="Absolute">
                            <DrawingBrush.Drawing>
                                <GeometryDrawing>
                                    <GeometryDrawing.Geometry>
                                        <GeometryGroup>
                                            <RectangleGeometry Rect="0,0,20,20"/>
                                        </GeometryGroup>
                                    </GeometryDrawing.Geometry>
                                    <GeometryDrawing.Pen>
                                        <Pen Brush="#f1f5f9" Thickness="0.5"/>
                                    </GeometryDrawing.Pen>
                                </GeometryDrawing>
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                    </Canvas.Background>

                    <!-- Relationships (drawn first, so they appear behind entities) -->
                    <ItemsControl ItemsSource="{Binding Relationships}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Line X1="0" Y1="0" X2="100" Y2="100" 
                                      Stroke="#94a3b8" StrokeThickness="2"
                                      StrokeDashArray="5,3"
                                      ToolTip="{Binding Name}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Entities -->
                    <ItemsControl ItemsSource="{Binding Entities}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style>
                                <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White" BorderBrush="#3b82f6" BorderThickness="2" 
                                        CornerRadius="8" Padding="0" MinWidth="200" MaxWidth="300"
                                        Cursor="Hand">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#64748b" BlurRadius="8" ShadowDepth="2" Opacity="0.3"/>
                                    </Border.Effect>
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" 
                                                     Command="{Binding DataContext.SelectEntityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                     CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    
                                    <StackPanel>
                                        <!-- Entity Header -->
                                        <Border Background="#3b82f6" Padding="10,8" CornerRadius="6,6,0,0">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="White"/>
                                                <TextBlock Text="{Binding Type}" FontSize="10" Foreground="#e0f2fe" Opacity="0.8"/>
                                            </StackPanel>
                                        </Border>
                                        
                                        <!-- Attributes -->
                                        <ItemsControl ItemsSource="{Binding Attributes}" Padding="8" Background="#f8fafc">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="4,2" Margin="0,1">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="🔑" FontSize="10" Margin="0,0,4,0" 
                                                                      Visibility="{Binding IsPrimaryKey, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                            <TextBlock Text="{Binding Name}" FontSize="11" Foreground="#334155" FontWeight="{Binding IsPrimaryKey, Converter={StaticResource BoolToFontWeightConverter}}"/>
                                                            <TextBlock Text=":" Margin="4,0" FontSize="10" Foreground="#94a3b8"/>
                                                            <TextBlock Text="{Binding DataType}" FontSize="10" Foreground="#64748b" FontStyle="Italic"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        
                                        <!-- Description -->
                                        <Border Padding="8,4" Background="#f1f5f9" CornerRadius="0,0,6,6" 
                                               Visibility="{Binding Description, Converter={StaticResource StringToVisibilityConverter}}">
                                            <TextBlock Text="{Binding Description}" FontSize="9" Foreground="#64748b" 
                                                      TextWrapping="Wrap" FontStyle="Italic"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Loading Overlay -->
                    <Border Background="#80FFFFFF" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                            Width="2000" Height="1500">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <ProgressBar IsIndeterminate="True" Width="200" Height="4" Foreground="#3b82f6"/>
                            <TextBlock Text="Lade Schema..." Margin="0,10,0,0" FontSize="14" Foreground="#64748b"/>
                        </StackPanel>
                    </Border>
                </Canvas>
            </ScrollViewer>
        </Border>

        <!-- Right Sidebar - Entity Details -->
        <Border Grid.Row="1" Grid.Column="1" Background="#f8fafc" Padding="15">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Details" FontSize="14" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,10"/>
                    
                    <!-- Entity Details -->
                    <Border Background="White" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="6" Padding="12"
                            Visibility="{Binding HasSelectedEntity, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="Entität" FontSize="12" FontWeight="Bold" Foreground="#64748b" Margin="0,0,0,8"/>
                            
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="Name:" FontSize="10" Foreground="#94a3b8"/>
                                <TextBlock Text="{Binding SelectedEntity.Name}" FontSize="12" FontWeight="SemiBold" Foreground="#334155"/>
                            </StackPanel>
                            
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="Typ:" FontSize="10" Foreground="#94a3b8"/>
                                <TextBlock Text="{Binding SelectedEntity.Type}" FontSize="12" Foreground="#334155"/>
                            </StackPanel>
                            
                            <StackPanel Margin="0,0,0,8" Visibility="{Binding SelectedEntity.Description, Converter={StaticResource StringToVisibilityConverter}}">
                                <TextBlock Text="Beschreibung:" FontSize="10" Foreground="#94a3b8"/>
                                <TextBlock Text="{Binding SelectedEntity.Description}" FontSize="11" Foreground="#334155" TextWrapping="Wrap"/>
                            </StackPanel>
                            
                            <TextBlock Text="{Binding SelectedEntity.Attributes.Count, StringFormat='Attribute: {0}'}" 
                                      FontSize="11" Foreground="#64748b" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Relationship Details -->
                    <Border Background="White" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="6" Padding="12"
                            Visibility="{Binding HasSelectedRelationship, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="Beziehung" FontSize="12" FontWeight="Bold" Foreground="#64748b" Margin="0,0,0,8"/>
                            
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="Name:" FontSize="10" Foreground="#94a3b8"/>
                                <TextBlock Text="{Binding SelectedRelationship.Name}" FontSize="12" FontWeight="SemiBold" Foreground="#334155"/>
                            </StackPanel>
                            
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="Typ:" FontSize="10" Foreground="#94a3b8"/>
                                <TextBlock Text="{Binding SelectedRelationship.Type}" FontSize="12" Foreground="#334155"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Schema Statistics -->
                    <Border Background="White" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,15,0,0">
                        <StackPanel>
                            <TextBlock Text="Statistik" FontSize="12" FontWeight="Bold" Foreground="#64748b" Margin="0,0,0,8"/>
                            
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="Entitäten:" FontSize="11" Foreground="#94a3b8" Width="100"/>
                                <TextBlock Text="{Binding Entities.Count}" FontSize="11" FontWeight="SemiBold" Foreground="#334155"/>
                            </StackPanel>
                            
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="Beziehungen:" FontSize="11" Foreground="#94a3b8" Width="100"/>
                                <TextBlock Text="{Binding Relationships.Count}" FontSize="11" FontWeight="SemiBold" Foreground="#334155"/>
                            </StackPanel>
                            
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="Aktualisiert:" FontSize="11" Foreground="#94a3b8" Width="100"/>
                                <TextBlock Text="{Binding Schema.LastUpdated, StringFormat='{}{0:HH:mm:ss}'}" FontSize="11" Foreground="#334155"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Legend -->
                    <Border Background="White" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,15,0,0">
                        <StackPanel>
                            <TextBlock Text="Legende" FontSize="12" FontWeight="Bold" Foreground="#64748b" Margin="0,0,0,8"/>
                            
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="🔑" FontSize="11" Margin="0,0,8,0"/>
                                <TextBlock Text="Primärschlüssel" FontSize="10" Foreground="#334155"/>
                            </StackPanel>
                            
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <Border Width="16" Height="2" Background="#94a3b8" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Border.OpacityMask>
                                        <LinearGradientBrush>
                                            <GradientStop Color="Black" Offset="0"/>
                                            <GradientStop Color="Transparent" Offset="0.5"/>
                                            <GradientStop Color="Black" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.OpacityMask>
                                </Border>
                                <TextBlock Text="Beziehung" FontSize="10" Foreground="#334155"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Status Bar -->
        <Border Grid.Row="2" Grid.ColumnSpan="2" Background="#f8fafc" BorderBrush="#e2e8f0" BorderThickness="0,1,0,0" Padding="10,5">
            <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="#64748b"/>
        </Border>
    </Grid>
</UserControl>
