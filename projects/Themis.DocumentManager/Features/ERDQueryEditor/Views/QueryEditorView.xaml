<UserControl x:Class="Themis.DocumentManager.Features.ERDQueryEditor.Views.QueryEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000"
             Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#f8fafc" BorderBrush="#e2e8f0" BorderThickness="0,0,0,1" Padding="10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🔍 Query Editor" FontSize="16" FontWeight="Bold" Foreground="#334155" VerticalAlignment="Center"/>
                <Separator Margin="15,0" Background="#e2e8f0" Width="1"/>
                
                <Button Content="▶ Ausführen" Command="{Binding ExecuteQueryCommand}" Padding="12,4" Margin="0,0,5,0" 
                        Background="#10b981" Foreground="White" FontWeight="Bold" ToolTip="Abfrage ausführen (F5)"/>
                <Button Content="✓ Validieren" Command="{Binding ValidateQueryCommand}" Padding="8,4" Margin="0,0,5,0" ToolTip="Abfrage validieren"/>
                <Button Content="💾 Speichern" Command="{Binding SaveCurrentQueryCommand}" Padding="8,4" Margin="0,0,5,0" ToolTip="Abfrage speichern"/>
                <Button Content="📄 Neu" Command="{Binding NewQueryCommand}" Padding="8,4" Margin="0,0,5,0" ToolTip="Neue Abfrage"/>
                
                <Separator Margin="10,0" Background="#e2e8f0" Width="1"/>
                
                <Button Content="⚡ Formatieren" Command="{Binding FormatQueryCommand}" Padding="8,4" Margin="0,0,5,0" ToolTip="Abfrage formatieren"/>
                <Button Content="🗑️ Löschen" Command="{Binding ClearResultsCommand}" Padding="8,4" ToolTip="Ergebnisse löschen"/>
                
                <Separator Margin="10,0" Background="#e2e8f0" Width="1"/>
                
                <TextBlock Text="Sprache:" VerticalAlignment="Center" Foreground="#64748b" Margin="0,0,5,0"/>
                <ComboBox SelectedItem="{Binding SelectedLanguage}" Width="80" VerticalAlignment="Center">
                    <ComboBoxItem Content="AQL" IsSelected="True"/>
                    <ComboBoxItem Content="SQL" IsEnabled="False"/>
                    <ComboBoxItem Content="GraphQL" IsEnabled="False"/>
                </ComboBox>
            </StackPanel>
        </Border>

        <!-- Left Sidebar - Saved Queries -->
        <Border Grid.Row="1" Grid.Column="0" Background="#f8fafc" BorderBrush="#e2e8f0" BorderThickness="0,0,1,0" Padding="10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Gespeicherte Abfragen" FontSize="12" FontWeight="Bold" 
                          Foreground="#334155" Margin="0,0,0,10"/>
                
                <ListBox ItemsSource="{Binding SavedQueries}" 
                        SelectedItem="{Binding SelectedSavedQuery}"
                        Background="White" BorderBrush="#e2e8f0" BorderThickness="1">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8,6" Margin="0,2" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftDoubleClick" 
                                                 Command="{Binding DataContext.LoadQueryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                 CommandParameter="{Binding}"/>
                                </Border.InputBindings>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Foreground="#334155"/>
                                    <Button Grid.Row="0" Grid.Column="1" Content="🗑️" Padding="4,2" FontSize="10"
                                           Command="{Binding DataContext.DeleteQueryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}"
                                           ToolTip="Löschen"/>
                                    
                                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" 
                                              Text="{Binding Description}" FontSize="9" Foreground="#64748b" 
                                              TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Main Area -->
        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*" MinHeight="200"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="3*" MinHeight="200"/>
            </Grid.RowDefinitions>

            <!-- Query Editor -->
            <Border Grid.Row="0" Background="White" BorderBrush="#e2e8f0" BorderThickness="0,0,0,1" Padding="15">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Query" FontSize="12" FontWeight="Bold" Foreground="#334155" VerticalAlignment="Center"/>
                        
                        <!-- Validation Status -->
                        <Border Background="#fef3c7" Padding="8,4" CornerRadius="4" Margin="15,0,0,0"
                               Visibility="{Binding ValidationMessage, Converter={StaticResource StringToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚠️" FontSize="11" Margin="0,0,4,0"/>
                                <TextBlock Text="{Binding ValidationMessage}" FontSize="10" Foreground="#92400e"/>
                            </StackPanel>
                        </Border>
                        
                        <Border Background="#d1fae5" Padding="8,4" CornerRadius="4" Margin="15,0,0,0"
                               Visibility="{Binding IsQueryValid, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✓" FontSize="11" Margin="0,0,4,0" Foreground="#065f46"/>
                                <TextBlock Text="Abfrage ist gültig" FontSize="10" Foreground="#065f46"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    
                    <TextBox x:Name="QueryTextBox" 
                            Text="{Binding QueryText, UpdateSourceTrigger=PropertyChanged}" 
                            AcceptsReturn="True" 
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Auto"
                            FontFamily="Consolas, Courier New"
                            FontSize="12"
                            Background="#fafafa"
                            Foreground="#1e293b"
                            Padding="10">
                        <TextBox.InputBindings>
                            <KeyBinding Key="F5" Command="{Binding ExecuteQueryCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                </DockPanel>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" Background="#e2e8f0" Cursor="SizeNS"/>

            <!-- Results Area -->
            <Border Grid.Row="2" Background="White" Padding="15">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Ergebnisse" FontSize="12" FontWeight="Bold" Foreground="#334155" VerticalAlignment="Center"/>
                        
                        <!-- Result Count -->
                        <Border Background="#eff6ff" Padding="8,4" CornerRadius="4" Margin="15,0,0,0"
                               Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock FontSize="10" Foreground="#1e40af">
                                <Run Text="{Binding ResultCount, Mode=OneWay}"/>
                                <Run Text="Zeilen"/>
                            </TextBlock>
                        </Border>
                        
                        <!-- Execution Time -->
                        <Border Background="#f0fdf4" Padding="8,4" CornerRadius="4" Margin="5,0,0,0"
                               Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock FontSize="10" Foreground="#166534">
                                <Run Text="{Binding LastResult.ExecutionTime.TotalMilliseconds, StringFormat='{}{0:F2}', Mode=OneWay}"/>
                                <Run Text="ms"/>
                            </TextBlock>
                        </Border>
                        
                        <!-- Error Message -->
                        <Border Background="#fee2e2" Padding="8,4" CornerRadius="4" Margin="15,0,0,0"
                               Visibility="{Binding LastResult.ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="❌" FontSize="11" Margin="0,0,4,0"/>
                                <TextBlock Text="{Binding LastResult.ErrorMessage}" FontSize="10" Foreground="#991b1b" MaxWidth="400" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    
                    <!-- Results DataGrid -->
                    <DataGrid ItemsSource="{Binding LastResult.Results}" 
                             AutoGenerateColumns="True"
                             IsReadOnly="True"
                             CanUserAddRows="False"
                             CanUserDeleteRows="False"
                             GridLinesVisibility="Horizontal"
                             HeadersVisibility="Column"
                             Background="White"
                             BorderBrush="#e2e8f0"
                             BorderThickness="1"
                             Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibilityConverter}}">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#f8fafc"/>
                                <Setter Property="Foreground" Value="#334155"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="BorderBrush" Value="#e2e8f0"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="8,4"/>
                                <Setter Property="BorderBrush" Value="#f1f5f9"/>
                            </Style>
                        </DataGrid.CellStyle>
                    </DataGrid>
                    
                    <!-- Empty State -->
                    <Border Background="#fafafa" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="8" Padding="40"
                           Visibility="{Binding HasResults, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="📊" FontSize="48" HorizontalAlignment="Center" Opacity="0.3"/>
                            <TextBlock Text="Keine Ergebnisse" FontSize="14" Foreground="#94a3b8" HorizontalAlignment="Center" Margin="0,10,0,5"/>
                            <TextBlock Text="Führen Sie eine Abfrage aus, um Ergebnisse anzuzeigen" 
                                      FontSize="11" Foreground="#cbd5e1" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Loading Overlay -->
                    <Border Background="#80FFFFFF" Visibility="{Binding IsExecuting, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <ProgressBar IsIndeterminate="True" Width="200" Height="4" Foreground="#3b82f6"/>
                            <TextBlock Text="Führe Abfrage aus..." Margin="0,10,0,0" FontSize="14" Foreground="#64748b"/>
                        </StackPanel>
                    </Border>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Grid.ColumnSpan="2" Background="#f8fafc" BorderBrush="#e2e8f0" BorderThickness="0,1,0,0" Padding="10,5">
            <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="#64748b"/>
        </Border>
    </Grid>
</UserControl>
