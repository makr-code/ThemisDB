<UserControl x:Class="Themis.DocumentManager.Features.Favorites.Views.FavoritesPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.modernwpf.com/2019"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="300">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>
    
    <Grid Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,0,0,1" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="⭐" FontSize="20" Margin="0,0,8,0"/>
                    <TextBlock Text="Favoriten" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                
                <Button Grid.Column="1" Command="{Binding LoadFavoritesCommand}"
                        ToolTip="Aktualisieren" Padding="8,4">
                    <TextBlock Text="↻" FontSize="16"/>
                </Button>
            </Grid>
        </Border>
        
        <!-- Search & Filter Bar -->
        <Border Grid.Row="1" Padding="16,8" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ui:ControlHelper.PlaceholderText="Favoriten durchsuchen..."
                         Margin="0,0,0,8"/>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <ComboBox Grid.Column="0" SelectedItem="{Binding SortBy}" 
                              Margin="0,0,8,0">
                        <ComboBoxItem Content="Zuletzt hinzugefügt" Tag="RecentlyAdded"/>
                        <ComboBoxItem Content="Zuletzt verwendet" Tag="RecentlyAccessed"/>
                        <ComboBoxItem Content="Am häufigsten" Tag="MostAccessed"/>
                        <ComboBoxItem Content="Alphabetisch" Tag="Alphabetical"/>
                    </ComboBox>
                    
                    <ToggleButton Grid.Column="1" IsChecked="{Binding GroupByType}"
                                  ToolTip="Nach Typ gruppieren" Padding="8,4">
                        <TextBlock Text="📑" FontSize="14"/>
                    </ToggleButton>
                </Grid>
            </StackPanel>
        </Border>
        
        <!-- Favorites List -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="8">
                <!-- Grouped View -->
                <ItemsControl ItemsSource="{Binding FavoriteGroups}"
                              Visibility="{Binding GroupByType, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Expander IsExpanded="True" Margin="0,4">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Icon}" FontSize="16" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding GroupName}" FontWeight="SemiBold" FontSize="14"/>
                                        <TextBlock Text="{Binding Items.Count, StringFormat='({0})'}" 
                                                   FontSize="12" Opacity="0.7" Margin="4,0,0,0"/>
                                    </StackPanel>
                                </Expander.Header>
                                
                                <ItemsControl ItemsSource="{Binding Items}" Margin="24,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource SystemControlBackgroundAltMediumLowBrush}"
                                                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                                    BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,4"
                                                    Cursor="Hand">
                                                <Border.InputBindings>
                                                    <MouseBinding Gesture="LeftClick" 
                                                                  Command="{Binding DataContext.NavigateToFavoriteCommand,
                                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                  CommandParameter="{Binding}"/>
                                                </Border.InputBindings>
                                                
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <TextBlock Grid.Column="0" Text="{Binding Icon}" 
                                                               FontSize="16" Margin="0,0,8,0"/>
                                                    
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding EntityName}" 
                                                                   FontWeight="SemiBold" FontSize="13"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Category}" 
                                                                   FontSize="11" Opacity="0.6"
                                                                   Visibility="{Binding Category, 
                                                                              Converter={StaticResource BoolToVisibility}}"/>
                                                    </StackPanel>
                                                    
                                                    <Button Grid.Column="2" 
                                                            Command="{Binding DataContext.RemoveFromFavoritesCommand,
                                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding EntityId}"
                                                            ToolTip="Aus Favoriten entfernen"
                                                            Background="Transparent" BorderThickness="0"
                                                            Padding="4">
                                                        <TextBlock Text="×" FontSize="18" Opacity="0.5"/>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                
                <!-- Flat View -->
                <ItemsControl ItemsSource="{Binding AllFavorites}"
                              Visibility="{Binding GroupByType, Converter={StaticResource BoolToVisibility}, 
                                         ConverterParameter=Inverse}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource SystemControlBackgroundAltMediumLowBrush}"
                                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="4"
                                    Cursor="Hand">
                                <Border.InputBindings>
                                    <MouseBinding Gesture="LeftClick" 
                                                  Command="{Binding DataContext.NavigateToFavoriteCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}"/>
                                </Border.InputBindings>
                                
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <TextBlock Grid.Column="0" Text="{Binding Icon}" 
                                               FontSize="16" Margin="0,0,8,0"/>
                                    
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding EntityName}" 
                                                   FontWeight="SemiBold" FontSize="13"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Category}" 
                                                       FontSize="11" Opacity="0.6"
                                                       Margin="0,0,8,0"
                                                       Visibility="{Binding Category, 
                                                                  Converter={StaticResource BoolToVisibility}}"/>
                                            <TextBlock FontSize="11" Opacity="0.5"
                                                       Visibility="{Binding LastAccessedAt, 
                                                                  Converter={StaticResource BoolToVisibility}}">
                                                <Run Text="Zuletzt: "/>
                                                <Run Text="{Binding LastAccessedAt, StringFormat='{}{0:dd.MM.yyyy}'}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                    
                                    <Button Grid.Column="2" 
                                            Command="{Binding DataContext.RemoveFromFavoritesCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding EntityId}"
                                            ToolTip="Aus Favoriten entfernen"
                                            Background="Transparent" BorderThickness="0"
                                            Padding="4">
                                        <TextBlock Text="×" FontSize="18" Opacity="0.5"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                
                <!-- Empty State -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Margin="0,40,0,0"
                            Visibility="{Binding AllFavorites.Count, Converter={StaticResource BoolToVisibility},
                                       ConverterParameter=Inverse}">
                    <TextBlock Text="⭐" FontSize="48" HorizontalAlignment="Center" Opacity="0.3"/>
                    <TextBlock Text="Keine Favoriten" FontSize="16" HorizontalAlignment="Center" 
                               Opacity="0.6" Margin="0,8,0,4"/>
                    <TextBlock Text="Markieren Sie Entitäten mit dem ⭐-Badge" 
                               FontSize="12" HorizontalAlignment="Center" Opacity="0.5"
                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="200"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        
        <!-- Loading Overlay -->
        <Border Grid.Row="2" Background="#80000000"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ui:ProgressRing IsActive="True" Width="50" Height="50"/>
                <TextBlock Text="Lade Favoriten..." Foreground="White" 
                           FontSize="14" Margin="0,16,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
