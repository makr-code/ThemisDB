<Window x:Class="Themis.DocumentManager.Views.TestDataGeneratorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Themis.DocumentManager.ViewModels"
        Title="Testdaten-Generator" Height="550" Width="650"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <!-- Converters -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        
        <!-- NullToBooleanConverter -->
        <vm:NullToBooleanConverter x:Key="NullToBooleanConverter"/>
        
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="MinWidth" Value="120"/>
        </Style>

        <Style TargetType="Label">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,5,10,5"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="28"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,5"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2196F3" CornerRadius="5" Padding="15,10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="🔧 Testdaten-Generator" FontSize="20" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Generiert repräsentative Verwaltungsdaten für ThemisDB" FontSize="12" Foreground="White" Opacity="0.9" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Einstellungen -->
        <GroupBox Grid.Row="1" Header="⚙️ Einstellungen">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Content="Anzahl Dokumente:"/>
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding DocumentCount, UpdateSourceTrigger=PropertyChanged}" Width="100" HorizontalAlignment="Left"/>

                <Label Grid.Row="1" Grid.Column="0" Content="Export-Format:"/>
                <ComboBox Grid.Row="1" Grid.Column="1" 
                          ItemsSource="{Binding ExportModes}"
                          SelectedValue="{Binding SelectedExportMode}"
                          SelectedValuePath="Mode"
                          DisplayMemberPath="DisplayName"
                          Width="200" HorizontalAlignment="Left" Height="28"/>

                <CheckBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" 
                          Content="Spezialisierte Datensätze inkludieren (Baugenehmigungen, BImSchG, etc.)"
                          IsChecked="{Binding IncludeSpecialized}"/>

                <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,5,0,0">
                    <Label Content="Anzahl spezialisiert:" IsEnabled="{Binding IncludeSpecialized}"/>
                    <TextBox Text="{Binding SpecializedCount, UpdateSourceTrigger=PropertyChanged}" 
                             Width="80" IsEnabled="{Binding IncludeSpecialized}"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Quick Actions -->
        <GroupBox Grid.Row="2" Header="⚡ Schnellaktionen">
            <StackPanel Orientation="Vertical">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                    <Button Style="{StaticResource IconButton}" Command="{Binding GenerateQuickCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🚀" FontSize="18" Margin="0,0,8,0"/>
                            <TextBlock Text="Quick-Seed" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource IconButton}" Command="{Binding GenerateBImSchGCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚗️" FontSize="18" Margin="0,0,8,0"/>
                            <TextBlock Text="BImSchG (30)" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource IconButton}" Command="{Binding GenerateWithContentCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📝" FontSize="18" Margin="0,0,8,0"/>
                            <TextBlock Text="Mit Inhalten" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                
                <!-- Ollama Status -->
                <TextBlock Text="🤖 Ollama-Integration: ✓ Aktiviert" Foreground="Green" FontSize="11" Margin="0,5" TextAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding OllamaAvailable}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                
                <TextBlock Text="⚠️ Ollama nicht verfügbar (Fallback-Modus)" Foreground="Orange" FontSize="11" Margin="0,5" TextAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding OllamaAvailable}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                
                <!-- LLM Checkbox -->
                <CheckBox Content="Ollama LLM für authentische Inhalte verwenden" 
                         IsChecked="{Binding UseLlm}" 
                         IsEnabled="{Binding OllamaAvailable}"
                         Margin="0,5,0,0"/>
            </StackPanel>
        </GroupBox>

        <!-- Statistik -->
        <GroupBox Grid.Row="3" Header="📊 Status &amp; Fortschritt">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>

                    <!-- Fortschrittsleiste -->
                    <StackPanel Margin="0,0,0,10">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGenerating}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        
                        <TextBlock Margin="0,0,0,5">
                            <TextBlock.Inlines>
                                <Run Text="Fortschritt: "/>
                                <Run Text="{Binding ProgressCurrent}"/>
                                <Run Text=" / "/>
                                <Run Text="{Binding ProgressTotal}"/>
                            </TextBlock.Inlines>
                        </TextBlock>
                        
                        <ProgressBar Height="25" Background="#E0E0E0" 
                                   Foreground="#4CAF50" 
                                   Minimum="0" 
                                   Maximum="{Binding ProgressTotal}" 
                                   Value="{Binding ProgressCurrent}"
                                   Margin="0,0,0,5"/>
                        
                        <ProgressBar Height="6" Background="#E0E0E0" 
                                   Foreground="#2196F3" 
                                   IsIndeterminate="True"
                                   Margin="0,0,0,5"/>
                        
                        <TextBlock Text="⏳ Verarbeitung läuft..." 
                                  Foreground="#666" 
                                  FontSize="12" 
                                  TextAlignment="Center"/>
                    </StackPanel>

                    <Border Background="#F5F5F5" CornerRadius="5" Padding="10" Margin="0,5">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LastStatistics, Converter={StaticResource NullToBooleanConverter}}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="Letzte Generierung:" FontWeight="Bold" Margin="0,0,0,5"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Dokumente:" Margin="0,2"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding LastStatistics.TotalDocuments}" FontWeight="Bold" Margin="10,2"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Felder gesamt:" Margin="0,2"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LastStatistics.TotalFields}" Margin="10,2"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Ausgefüllte Felder:" Margin="0,2"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LastStatistics.FilledFields}" Margin="10,2"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Befüllungsrate:" Margin="0,2"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Margin="10,2">
                                    <Run Text="{Binding LastStatistics.AverageFillRate, StringFormat='{}{0:F1}%'}"/>
                                </TextBlock>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Vorgangsarten:" Margin="0,2"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding LastStatistics.UniqueProcessTypes}" Margin="10,2"/>

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Abteilungen:" Margin="0,2"/>
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding LastStatistics.UniqueDepartments}" Margin="10,2"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </GroupBox>

        <!-- Progress -->
        <Border Grid.Row="4" Background="#FFF9C4" CornerRadius="5" Padding="10" Margin="0,5" 
                Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⏳" FontSize="18" Margin="0,0,10,0"/>
                <TextBlock Text="Generiere Daten, bitte warten..." VerticalAlignment="Center" FontWeight="Bold"/>
            </StackPanel>
        </Border>

        <!-- Buttons -->
        <Grid Grid.Row="5" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="🗑️ Statistik löschen" Command="{Binding ClearCommand}" 
                    HorizontalAlignment="Left" Background="#FFF3E0"/>

            <Button Grid.Column="1" Content="📄 Generieren" Command="{Binding GenerateCommand}" 
                    Background="#4CAF50" Foreground="White" FontWeight="Bold" MinWidth="120"/>

            <Button Grid.Column="2" Content="Schließen" IsCancel="True" Background="#E0E0E0"/>
        </Grid>
    </Grid>
</Window>
