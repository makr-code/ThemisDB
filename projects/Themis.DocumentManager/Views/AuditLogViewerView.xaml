<UserControl x:Class="Themis.DocumentManager.Views.AuditLogViewerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#f8fafc">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header / Filter Bar -->
        <Border Grid.Row="0" Background="White" BorderBrush="#e2e8f0" BorderThickness="0,0,0,1" Padding="16">
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Von" FontSize="11" Opacity="0.7"/>
                    <DatePicker SelectedDate="{Binding From}"/>
                </StackPanel>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Bis" FontSize="11" Opacity="0.7"/>
                    <DatePicker SelectedDate="{Binding To}"/>
                </StackPanel>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="UserId" FontSize="11" Opacity="0.7"/>
                    <TextBox Text="{Binding UserIdFilter, UpdateSourceTrigger=PropertyChanged}" MinWidth="140"/>
                </StackPanel>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Entity Type" FontSize="11" Opacity="0.7"/>
                    <ComboBox ItemsSource="{Binding EntityTypeOptions}"
                              SelectedItem="{Binding EntityTypeFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              IsEditable="False" MinWidth="160"/>
                </StackPanel>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Entity Id" FontSize="11" Opacity="0.7"/>
                    <TextBox Text="{Binding EntityIdFilter, UpdateSourceTrigger=PropertyChanged}" MinWidth="140"/>
                </StackPanel>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Action" FontSize="11" Opacity="0.7"/>
                    <ComboBox ItemsSource="{Binding ActionTypeOptions}"
                              SelectedItem="{Binding ActionTypeFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              IsEditable="False" MinWidth="160"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="16,0,0,0">
                    <Button Content="Filter anwenden" Command="{Binding LoadCommand}" Padding="12,6" Margin="0,0,8,0"/>
                    <Button Content="Filter löschen" Command="{Binding ClearFiltersCommand}" Padding="12,6" Margin="0,0,16,0"/>
                    <Button Content="CSV exportieren" Click="ExportCsv_Click" Padding="12,6" Margin="0,0,8,0"/>
                    <Button Content="JSON exportieren" Click="ExportJson_Click" Padding="12,6"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Logs Table -->
        <Border Grid.Row="1" Margin="16" Background="White" BorderBrush="#e2e8f0" BorderThickness="1">
            <DataGrid ItemsSource="{Binding Logs}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All"
                      GridLinesVisibility="Horizontal" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Zeit" Binding="{Binding Timestamp, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="160"/>
                    <DataGridTextColumn Header="User" Binding="{Binding UserId}" Width="*"/>
                    <DataGridTextColumn Header="Aktion" Binding="{Binding ActionType}" Width="*"/>
                    <DataGridTextColumn Header="EntityType" Binding="{Binding EntityType}" Width="*"/>
                    <DataGridTextColumn Header="EntityId" Binding="{Binding EntityId}" Width="2*"/>
                    <DataGridTextColumn Header="Ergebnis" Binding="{Binding Result}" Width="*"/>
                    <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="3*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Status / Stats -->
        <Border Grid.Row="2" Background="#f1f5f9" BorderBrush="#e2e8f0" BorderThickness="1,1,1,0" Padding="12,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="SpaceBetween">
                <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#334155"/>
                <StackPanel Orientation="Horizontal" Margin="16,0,0,0">
                    <TextBlock Text="Gesamt:" FontSize="12" Opacity="0.7" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding Statistics.TotalLogCount}" FontSize="12" Margin="0,0,12,0"/>
                    <TextBlock Text="User:" FontSize="12" Opacity="0.7" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding Statistics.UniqueUsers}" FontSize="12" Margin="0,0,12,0"/>
                    <TextBlock Text="Entities:" FontSize="12" Opacity="0.7" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding Statistics.UniqueEntities}" FontSize="12"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
