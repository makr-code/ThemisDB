<UserControl x:Class="Themis.DocumentManager.Views.Settings.TreeViewSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Themis.DocumentManager.ViewModels.Settings"
             xmlns:model="clr-namespace:Themis.DocumentManager.Models"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:TreeViewSettingsViewModel}"
             d:DesignHeight="600" d:DesignWidth="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="TreeView Navigation Konfiguration" 
                   FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

        <!-- Options -->
        <StackPanel Grid.Row="1" Margin="0,0,0,20">
            <CheckBox Content="Icons anzeigen" IsChecked="{Binding ShowIcons}" Margin="0,0,0,8"/>
            <CheckBox Content="Bei Klick erweitern" IsChecked="{Binding ExpandOnClick}" Margin="0,0,0,8"/>
            <CheckBox Content="Erweiterungszustand merken" IsChecked="{Binding RememberExpansionState}"/>
        </StackPanel>

        <!-- Editor -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- TreeView Preview & Editor -->
            <Border Grid.Column="0" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#f8fafc" BorderBrush="#e2e8f0" 
                            BorderThickness="0,0,0,1" Padding="12,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Navigation Struktur" FontWeight="SemiBold" 
                                       VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <Button Content="+ Hauptelement" Command="{Binding AddRootItemCommand}" 
                                    Padding="8,4" Margin="0,0,8,0"/>
                            <Button Content="+ Unterelement" Command="{Binding AddChildItemCommand}" 
                                    Padding="8,4" Margin="0,0,8,0"/>
                            <Button Content="Löschen" Command="{Binding DeleteItemCommand}" 
                                    Padding="8,4" Margin="0,0,8,0"/>
                            <Button Content="↑" Command="{Binding MoveUpCommand}" 
                                    Padding="8,4" Margin="0,0,4,0"/>
                            <Button Content="↓" Command="{Binding MoveDownCommand}" 
                                    Padding="8,4"/>
                        </StackPanel>
                    </Border>

                    <TreeView Grid.Row="1" ItemsSource="{Binding Items}" 
                              SelectedItemChanged="TreeView_SelectedItemChanged"
                              Margin="8">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                <Setter Property="Padding" Value="4"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type vm:TreeViewItemConfigViewModel}" 
                                                      ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Icon}" Margin="0,0,8,0" FontSize="16"/>
                                    <TextBlock Text="{Binding Header}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ItemType, StringFormat=' [{0}]'}" 
                                               Foreground="Gray" FontSize="10" VerticalAlignment="Center" 
                                               Margin="8,0,0,0"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.Resources>
                    </TreeView>
                </Grid>
            </Border>

            <!-- Property Editor -->
            <Border Grid.Column="2" BorderBrush="#e2e8f0" BorderThickness="1" 
                    CornerRadius="4" Padding="16">
                <StackPanel>
                    <TextBlock Text="Element bearbeiten" FontWeight="SemiBold" 
                               FontSize="14" Margin="0,0,0,16"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Titel:" 
                                   VerticalAlignment="Center" Margin="0,0,8,12"/>
                        <TextBox Grid.Row="0" Grid.Column="1" 
                                 Text="{Binding SelectedItem.Header, UpdateSourceTrigger=PropertyChanged}" 
                                 Margin="0,0,0,12"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Icon:" 
                                   VerticalAlignment="Center" Margin="0,0,8,12"/>
                        <TextBox Grid.Row="1" Grid.Column="1" 
                                 Text="{Binding SelectedItem.Icon, UpdateSourceTrigger=PropertyChanged}" 
                                 Margin="0,0,0,12"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Typ:" 
                                   VerticalAlignment="Center" Margin="0,0,8,12"/>
                        <ComboBox Grid.Row="2" Grid.Column="1" 
                                  SelectedItem="{Binding SelectedItem.ItemType}" 
                                  Margin="0,0,0,12">
                            <ComboBox.ItemsSource>
                                <x:Array Type="{x:Type model:TreeViewItemType}">
                                    <model:TreeViewItemType>Dashboard</model:TreeViewItemType>
                                    <model:TreeViewItemType>Documents</model:TreeViewItemType>
                                    <model:TreeViewItemType>Tasks</model:TreeViewItemType>
                                    <model:TreeViewItemType>Inbox</model:TreeViewItemType>
                                    <model:TreeViewItemType>Favorites</model:TreeViewItemType>
                                    <model:TreeViewItemType>Projects</model:TreeViewItemType>
                                    <model:TreeViewItemType>Reminders</model:TreeViewItemType>
                                    <model:TreeViewItemType>Cosigning</model:TreeViewItemType>
                                    <model:TreeViewItemType>Classification</model:TreeViewItemType>
                                    <model:TreeViewItemType>Collaboration</model:TreeViewItemType>
                                    <model:TreeViewItemType>Custom</model:TreeViewItemType>
                                    <model:TreeViewItemType>Folder</model:TreeViewItemType>
                                    <model:TreeViewItemType>Link</model:TreeViewItemType>
                                </x:Array>
                            </ComboBox.ItemsSource>
                        </ComboBox>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Ziel-View:" 
                                   VerticalAlignment="Center" Margin="0,0,8,12"/>
                        <TextBox Grid.Row="3" Grid.Column="1" 
                                 Text="{Binding SelectedItem.TargetView, UpdateSourceTrigger=PropertyChanged}" 
                                 Margin="0,0,0,12"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Pfad:" 
                                   VerticalAlignment="Center" Margin="0,0,8,12"/>
                        <TextBox Grid.Row="4" Grid.Column="1" 
                                 Text="{Binding SelectedItem.NavigationPath, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>

                    <TextBlock Text="Icon-Vorschläge:" FontWeight="SemiBold" 
                               Margin="0,24,0,8"/>
                    <WrapPanel>
                        <Button Content="📊" Click="IconButton_Click" Margin="2"/>
                        <Button Content="📄" Click="IconButton_Click" Margin="2"/>
                        <Button Content="📁" Click="IconButton_Click" Margin="2"/>
                        <Button Content="📂" Click="IconButton_Click" Margin="2"/>
                        <Button Content="📝" Click="IconButton_Click" Margin="2"/>
                        <Button Content="📥" Click="IconButton_Click" Margin="2"/>
                        <Button Content="📅" Click="IconButton_Click" Margin="2"/>
                        <Button Content="✍️" Click="IconButton_Click" Margin="2"/>
                        <Button Content="⭐" Click="IconButton_Click" Margin="2"/>
                        <Button Content="✅" Click="IconButton_Click" Margin="2"/>
                        <Button Content="📦" Click="IconButton_Click" Margin="2"/>
                        <Button Content="🕐" Click="IconButton_Click" Margin="2"/>
                        <Button Content="🔍" Click="IconButton_Click" Margin="2"/>
                        <Button Content="⚙️" Click="IconButton_Click" Margin="2"/>
                        <Button Content="📊" Click="IconButton_Click" Margin="2"/>
                        <Button Content="🌐" Click="IconButton_Click" Margin="2"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Actions -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" 
                    Margin="0,20,0,0">
            <Button Content="Standard wiederherstellen" Command="{Binding ResetToDefaultCommand}" 
                    Padding="12,6" Margin="0,0,12,0"/>
            <Button Content="Speichern" Click="SaveButton_Click" 
                    Padding="12,6" Background="#3b82f6" Foreground="White"/>
        </StackPanel>
    </Grid>
</UserControl>
