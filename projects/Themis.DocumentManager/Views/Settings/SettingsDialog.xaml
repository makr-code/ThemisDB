<Window x:Class="Themis.DocumentManager.Views.Settings.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Einstellungen - ThemisDB Document Manager" 
        Height="600" Width="800"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- Animation Storyboards -->
        <Storyboard x:Key="FadeInAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                           From="0" To="1" Duration="0:0:0.3"/>
        </Storyboard>
        
        <Storyboard x:Key="SlideInAnimation">
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                           From="20" To="0" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Navigation Panel -->
        <Border Grid.Column="0" 
                Background="{DynamicResource SystemControlBackgroundListMediumBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,0,1,0">
            <StackPanel Margin="0,16,0,0">
                <TextBlock Text="Kategorien" 
                          FontSize="16" 
                          FontWeight="SemiBold"
                          Margin="16,0,16,12"
                          Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                
                <RadioButton x:Name="ThemeSettingsButton"
                           Content="🎨 Theme &amp; Darstellung"
                           Style="{StaticResource NavigationRadioButtonStyle}"
                           IsChecked="True"
                           Click="ThemeSettings_Click"/>
                
                <RadioButton x:Name="GeneralSettingsButton"
                           Content="⚙️ Allgemein"
                           Style="{StaticResource NavigationRadioButtonStyle}"
                           Click="GeneralSettings_Click"/>
                
                <RadioButton x:Name="PerformanceSettingsButton"
                           Content="⚡ Performance"
                           Style="{StaticResource NavigationRadioButtonStyle}"
                           Click="PerformanceSettings_Click"/>
                
                <RadioButton x:Name="AccessibilitySettingsButton"
                           Content="♿ Barrierefreiheit"
                           Style="{StaticResource NavigationRadioButtonStyle}"
                           Click="AccessibilitySettings_Click"/>
            </StackPanel>
        </Border>

        <!-- Right Content Panel -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <Grid x:Name="ContentGrid" Margin="32,24">
                <Grid.RenderTransform>
                    <TranslateTransform X="0" Y="0"/>
                </Grid.RenderTransform>
                
                <!-- Theme Settings Panel -->
                <StackPanel x:Name="ThemeSettingsPanel" Visibility="Visible">
                    <TextBlock Text="Theme &amp; Darstellung" 
                              FontSize="24" 
                              FontWeight="Bold"
                              Margin="0,0,0,24"/>

                    <!-- Theme Mode Selection -->
                    <TextBlock Text="Farbschema" 
                              FontSize="16" 
                              FontWeight="SemiBold"
                              Margin="0,0,0,12"/>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                        <RadioButton x:Name="LightModeRadio"
                                   Content="☀️ Hell"
                                   GroupName="ThemeMode"
                                   Margin="0,0,16,0"
                                   Checked="ThemeMode_Changed"/>
                        
                        <RadioButton x:Name="DarkModeRadio"
                                   Content="🌙 Dunkel"
                                   GroupName="ThemeMode"
                                   Margin="0,0,16,0"
                                   Checked="ThemeMode_Changed"/>
                        
                        <RadioButton x:Name="SystemModeRadio"
                                   Content="💻 System"
                                   GroupName="ThemeMode"
                                   IsChecked="True"
                                   Checked="ThemeMode_Changed"/>
                    </StackPanel>

                    <!-- High Contrast Mode -->
                    <CheckBox x:Name="HighContrastCheckBox"
                            Content="Hoher Kontrast aktivieren"
                            Margin="0,0,0,24"
                            Checked="HighContrast_Changed"
                            Unchecked="HighContrast_Changed"/>

                    <!-- Preview Section -->
                    <TextBlock Text="Vorschau" 
                              FontSize="16" 
                              FontWeight="SemiBold"
                              Margin="0,0,0,12"/>
                    
                    <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                           BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                           BorderThickness="1"
                           CornerRadius="8"
                           Padding="16"
                           Margin="0,0,0,24">
                        <StackPanel>
                            <TextBlock Text="Beispieltext" 
                                      FontSize="14"
                                      Margin="0,0,0,8"/>
                            <Button Content="Beispiel-Button" 
                                   Style="{StaticResource ElevatedButtonStyle}"
                                   Margin="0,0,0,8"/>
                            <TextBox Text="Eingabefeld" 
                                    Margin="0,0,0,8"/>
                        </StackPanel>
                    </Border>

                    <!-- Custom Colors -->
                    <TextBlock Text="Benutzerdefinierte Farben" 
                              FontSize="16" 
                              FontWeight="SemiBold"
                              Margin="0,0,0,12"/>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Grid.Row="0" Grid.Column="0" 
                                  Text="Primärfarbe:"
                                  VerticalAlignment="Center"
                                  Margin="0,0,0,12"/>
                        <Border Grid.Row="0" Grid.Column="1"
                               x:Name="PrimaryColorPreview"
                               Background="#4287F5"
                               Height="32"
                               CornerRadius="4"
                               Margin="0,0,0,12"
                               ToolTip="Klicken zum Ändern"
                               Cursor="Hand"/>
                        
                        <TextBlock Grid.Row="1" Grid.Column="0"
                                  Text="Akzentfarbe:"
                                  VerticalAlignment="Center"
                                  Margin="0,0,0,12"/>
                        <Border Grid.Row="1" Grid.Column="1"
                               x:Name="AccentColorPreview"
                               Background="#FF9800"
                               Height="32"
                               CornerRadius="4"
                               Margin="0,0,0,12"
                               ToolTip="Klicken zum Ändern"
                               Cursor="Hand"/>
                        
                        <Button Grid.Row="2" Grid.Column="1"
                               Content="Standardfarben wiederherstellen"
                               Style="{StaticResource TextButtonStyle}"
                               HorizontalAlignment="Left"
                               Click="ResetColors_Click"/>
                    </Grid>
                </StackPanel>

                <!-- General Settings Panel -->
                <StackPanel x:Name="GeneralSettingsPanel" Visibility="Collapsed">
                    <TextBlock Text="Allgemeine Einstellungen" 
                              FontSize="24" 
                              FontWeight="Bold"
                              Margin="0,0,0,24"/>

                    <CheckBox Content="Beim Start automatisch öffnen"
                            Margin="0,0,0,12"/>
                    
                    <CheckBox Content="Benachrichtigungen anzeigen"
                            Margin="0,0,0,12"
                            IsChecked="True"/>
                    
                    <CheckBox Content="Zuletzt verwendete Dokumente speichern"
                            Margin="0,0,0,24"
                            IsChecked="True"/>

                    <TextBlock Text="Sprache" 
                              FontSize="16" 
                              FontWeight="SemiBold"
                              Margin="0,0,0,12"/>
                    
                    <ComboBox Width="200" 
                             HorizontalAlignment="Left"
                             Margin="0,0,0,24">
                        <ComboBoxItem Content="Deutsch" IsSelected="True"/>
                        <ComboBoxItem Content="English"/>
                    </ComboBox>
                </StackPanel>

                <!-- Performance Settings Panel -->
                <StackPanel x:Name="PerformanceSettingsPanel" Visibility="Collapsed">
                    <TextBlock Text="Performance-Einstellungen" 
                              FontSize="24" 
                              FontWeight="Bold"
                              Margin="0,0,0,24"/>

                    <CheckBox x:Name="EnableAnimationsCheckBox"
                            Content="Animationen aktivieren"
                            Margin="0,0,0,12"
                            IsChecked="True"
                            Checked="EnableAnimations_Changed"
                            Unchecked="EnableAnimations_Changed"/>
                    
                    <CheckBox Content="Hardware-Beschleunigung nutzen"
                            Margin="0,0,0,12"
                            IsChecked="True"/>
                    
                    <TextBlock Text="Cache-Größe" 
                              FontSize="16" 
                              FontWeight="SemiBold"
                              Margin="0,12,0,12"/>
                    
                    <StackPanel Orientation="Horizontal">
                        <Slider x:Name="CacheSizeSlider"
                               Width="300"
                               Minimum="100"
                               Maximum="1000"
                               Value="500"
                               TickFrequency="100"
                               TickPlacement="BottomRight"
                               VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ElementName=CacheSizeSlider, Path=Value, StringFormat={}{0:F0} MB}"
                                  Margin="12,0,0,0"
                                  VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- Accessibility Settings Panel -->
                <StackPanel x:Name="AccessibilitySettingsPanel" Visibility="Collapsed">
                    <TextBlock Text="Barrierefreiheit" 
                              FontSize="24" 
                              FontWeight="Bold"
                              Margin="0,0,0,24"/>

                    <CheckBox Content="Screen Reader Support aktivieren"
                            Margin="0,0,0,12"/>
                    
                    <CheckBox Content="Tastatur-Navigation optimieren"
                            Margin="0,0,0,12"
                            IsChecked="True"/>
                    
                    <TextBlock Text="Schriftgröße" 
                              FontSize="16" 
                              FontWeight="SemiBold"
                              Margin="0,12,0,12"/>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                        <RadioButton Content="Klein" 
                                   GroupName="FontSize"
                                   Margin="0,0,16,0"/>
                        <RadioButton Content="Normal" 
                                   GroupName="FontSize"
                                   IsChecked="True"
                                   Margin="0,0,16,0"/>
                        <RadioButton Content="Groß" 
                                   GroupName="FontSize"
                                   Margin="0,0,16,0"/>
                        <RadioButton Content="Sehr groß" 
                                   GroupName="FontSize"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Bottom Action Bar -->
        <Border Grid.Column="0" Grid.ColumnSpan="2"
               VerticalAlignment="Bottom"
               Background="{DynamicResource SystemControlBackgroundAltMediumBrush}"
               BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
               BorderThickness="0,1,0,0"
               Padding="16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Abbrechen"
                       Style="{StaticResource TextButtonStyle}"
                       Click="Cancel_Click"
                       Margin="0,0,8,0"
                       MinWidth="100"/>
                
                <Button Content="Übernehmen"
                       Style="{StaticResource ElevatedButtonStyle}"
                       Click="Apply_Click"
                       MinWidth="100"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
