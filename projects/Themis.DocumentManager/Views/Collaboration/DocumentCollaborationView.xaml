<UserControl x:Class="Themis.DocumentManager.Views.Collaboration.DocumentCollaborationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.modernwpf.com/2019"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="400">
    
    <UserControl.Resources>
        <!-- Converter für Lock Status Icons -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        
        <!-- Farben für verschiedene Lock Types -->
        <SolidColorBrush x:Key="ReadLockBrush" Color="#4CAF50"/>
        <SolidColorBrush x:Key="WriteLockBrush" Color="#F44336"/>
        <SolidColorBrush x:Key="OptimisticLockBrush" Color="#FF9800"/>
    </UserControl.Resources>
    
    <Grid Background="{DynamicResource SystemControlPageBackgroundChromeLowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header mit Lock Status -->
        <Border Grid.Row="0" 
                Background="{DynamicResource SystemControlBackgroundAccentBrush}"
                Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Lock Icon -->
                <ui:FontIcon Grid.Column="0"
                            x:Name="LockIcon"
                            Glyph="&#xE72E;"
                            FontSize="20"
                            Foreground="White"
                            Margin="0,0,12,0"
                            Visibility="{Binding IsDocumentLocked, Converter={StaticResource BoolToVis}}"/>
                
                <!-- Lock Status Text -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="LockStatusText"
                              Text="Dokument entsperrt"
                              FontWeight="SemiBold"
                              Foreground="White"
                              FontSize="14"/>
                    <TextBlock x:Name="LockDetailsText"
                              Text=""
                              FontSize="12"
                              Foreground="#E0E0E0"
                              Visibility="Collapsed"/>
                </StackPanel>
                
                <!-- Action Button -->
                <Button Grid.Column="2"
                       x:Name="LockActionButton"
                       Content="Auschecken"
                       Click="LockActionButton_Click"
                       Style="{StaticResource AccentButtonStyle}"
                       Height="32"
                       Padding="16,0"/>
            </Grid>
        </Border>
        
        <!-- Main Content: Comments & Presence -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Active Users Panel -->
            <Border Grid.Row="0"
                   Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                   BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                   BorderThickness="0,0,0,1"
                   Padding="16,12">
                <StackPanel>
                    <TextBlock Text="Aktive Benutzer"
                              FontWeight="SemiBold"
                              FontSize="13"
                              Margin="0,0,0,8"/>
                    
                    <ItemsControl x:Name="ActiveUsersControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- User Avatar/Icon -->
                                    <Border Grid.Column="0"
                                           Width="32" Height="32"
                                           CornerRadius="16"
                                           Margin="0,0,8,0">
                                        <Border.Background>
                                            <SolidColorBrush Color="{Binding Color}"/>
                                        </Border.Background>
                                        <TextBlock Text="{Binding Initials}"
                                                  Foreground="White"
                                                  FontSize="12"
                                                  FontWeight="SemiBold"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                    </Border>
                                    
                                    <!-- User Name & Status -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding UserName}"
                                                  FontSize="13"
                                                  FontWeight="Medium"/>
                                        <TextBlock Text="{Binding StatusText}"
                                                  FontSize="11"
                                                  Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                                    </StackPanel>
                                    
                                    <!-- Active Indicator -->
                                    <Ellipse Grid.Column="2"
                                            Width="8" Height="8"
                                            Fill="#4CAF50"
                                            Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    
                    <!-- No Active Users Message -->
                    <TextBlock x:Name="NoActiveUsersText"
                              Text="Keine weiteren aktiven Benutzer"
                              FontSize="12"
                              Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                              Visibility="Collapsed"
                              Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
            
            <!-- Comments Section -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- Comments Header -->
                <Border Grid.Row="0"
                       Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                       BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                       BorderThickness="0,0,0,1"
                       Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0"
                                  FontWeight="SemiBold"
                                  FontSize="13"
                                  VerticalAlignment="Center">
                            <Run Text="Kommentare"/>
                            <Run x:Name="CommentCountText" Text="(0)" 
                                 Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                        </TextBlock>
                        
                        <Button Grid.Column="1"
                               Content="Aktualisieren"
                               Click="RefreshComments_Click"
                               Style="{StaticResource DefaultButtonStyle}"
                               Height="28"
                               Padding="12,0"
                               FontSize="12"/>
                    </Grid>
                </Border>
                
                <!-- Comments List -->
                <ScrollViewer Grid.Row="1"
                             VerticalScrollBarVisibility="Auto"
                             Padding="16">
                    <ItemsControl x:Name="CommentsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,12"
                                       Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                                       BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                       BorderThickness="1"
                                       CornerRadius="4"
                                       Padding="12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        
                                        <!-- Comment Header -->
                                        <Grid Grid.Row="0" Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding AuthorName}"
                                                          FontWeight="SemiBold"
                                                          FontSize="13"/>
                                                <TextBlock Text="{Binding CreatedAtText}"
                                                          FontSize="11"
                                                          Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                                            </StackPanel>
                                            
                                            <!-- Edited Badge -->
                                            <Border Grid.Column="1"
                                                   Background="{DynamicResource SystemControlBackgroundAccentBrush}"
                                                   CornerRadius="2"
                                                   Padding="6,2"
                                                   Visibility="{Binding IsEdited, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="Bearbeitet"
                                                          FontSize="10"
                                                          Foreground="White"/>
                                            </Border>
                                        </Grid>
                                        
                                        <!-- Comment Content -->
                                        <TextBlock Grid.Row="1"
                                                  Text="{Binding Content}"
                                                  TextWrapping="Wrap"
                                                  FontSize="13"
                                                  Margin="0,0,0,8"/>
                                        
                                        <!-- Comment Footer (Reactions, Reply) -->
                                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                                            <Button Content="❤️ Reagieren"
                                                   Style="{StaticResource TextButtonStyle}"
                                                   FontSize="11"
                                                   Height="24"
                                                   Padding="8,0"
                                                   Margin="0,0,8,0"/>
                                            <Button Content="💬 Antworten"
                                                   Style="{StaticResource TextButtonStyle}"
                                                   FontSize="11"
                                                   Height="24"
                                                   Padding="8,0"/>
                                            
                                            <!-- Reaction Count -->
                                            <TextBlock Text="{Binding ReactionCount}"
                                                      FontSize="11"
                                                      Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                      VerticalAlignment="Center"
                                                      Margin="8,0,0,0"
                                                      Visibility="{Binding HasReactions, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
        
        <!-- Comment Input Area -->
        <Border Grid.Row="2"
               Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
               BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
               BorderThickness="0,1,0,0"
               Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Text Input -->
                <TextBox Grid.Row="0"
                        x:Name="CommentInputBox"
                        TextWrapping="Wrap"
                        AcceptsReturn="True"
                        MinHeight="60"
                        MaxHeight="120"
                        Padding="8"
                        Margin="0,0,0,8"/>
                
                <!-- Placeholder Text -->
                <TextBlock Grid.Row="0"
                          Text="Kommentar hinzufügen..."
                          Foreground="#CCCCCC"
                          Padding="12,12"
                          IsHitTestVisible="False"
                          FontSize="14"
                          Margin="0,0,0,8"/>
                
                
                <!-- Action Buttons -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Abbrechen"
                           x:Name="CancelCommentButton"
                           Click="CancelComment_Click"
                           Style="{StaticResource DefaultButtonStyle}"
                           Height="32"
                           Padding="16,0"
                           Margin="0,0,8,0"/>
                    <Button Content="Kommentieren"
                           x:Name="AddCommentButton"
                           Click="AddComment_Click"
                           Style="{StaticResource AccentButtonStyle}"
                           Height="32"
                           Padding="16,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
