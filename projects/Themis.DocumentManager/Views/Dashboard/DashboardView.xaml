<UserControl x:Class="Themis.DocumentManager.Views.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.modernwpf.com/2019"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200">
    
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Welcome Section -->
            <StackPanel Grid.Row="0" Margin="0,0,0,32">
                <TextBlock Text="Willkommen im ThemisDB Document Manager" 
                           FontSize="32" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBlock Text="Schnellstart und wichtigste Funktionen" 
                           FontSize="16" Opacity="0.7" Margin="0,0,0,16"/>
                
                <Border Background="{DynamicResource SystemControlBackgroundAccentBrush}"
                        Padding="16,12" CornerRadius="6" Margin="0,0,0,8">
                    <TextBlock Foreground="White" FontSize="14">
                        <Run Text="{Binding TotalDocuments, Mode=OneWay, FallbackValue=0}"/>
                        <Run Text="Dokumente • "/>
                        <Run Text="{Binding PendingTasks, Mode=OneWay, FallbackValue=0}"/>
                        <Run Text="offene Aufgaben • "/>
                        <Run Text="{Binding OverdueReminders, Mode=OneWay, FallbackValue=0}"/>
                        <Run Text="überfällige Fristen"/>
                    </TextBlock>
                </Border>
            </StackPanel>
            
            <!-- Quick Start Actions -->
            <StackPanel Grid.Row="1" Margin="0,0,0,32">
                <TextBlock Text="Schnellstart" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16"/>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- New Document -->
                    <Border Grid.Column="0" Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="24" Cursor="Hand">
                        <Border.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding NewDocumentCommand}"/>
                        </Border.InputBindings>
                        <StackPanel>
                            <TextBlock Text="📄" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock Text="Neues Dokument" FontSize="16" FontWeight="SemiBold" 
                                       HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock Text="Dokument erstellen oder hochladen" FontSize="12" Opacity="0.7"
                                       HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- My Tasks -->
                    <Border Grid.Column="2" Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="24" Cursor="Hand">
                        <Border.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding OpenTaskBasketCommand}"/>
                        </Border.InputBindings>
                        <StackPanel>
                            <TextBlock Text="✓" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock Text="Meine Aufgaben" FontSize="16" FontWeight="SemiBold" 
                                       HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock FontSize="12" Opacity="0.7" HorizontalAlignment="Center">
                                <Run Text="{Binding PendingTasks, Mode=OneWay, FallbackValue=0}"/>
                                <Run Text="offene Aufgaben"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    
                    <!-- Search -->
                    <Border Grid.Column="4" Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="24" Cursor="Hand">
                        <Border.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding OpenSearchCommand}"/>
                        </Border.InputBindings>
                        <StackPanel>
                            <TextBlock Text="🔍" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock Text="Suche" FontSize="16" FontWeight="SemiBold" 
                                       HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock Text="Dokumente durchsuchen" FontSize="12" Opacity="0.7"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Inbox -->
                    <Border Grid.Column="6" Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="24" Cursor="Hand">
                        <Border.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding OpenInboxCommand}"/>
                        </Border.InputBindings>
                        <StackPanel>
                            <TextBlock Text="📥" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock Text="Posteingang" FontSize="16" FontWeight="SemiBold" 
                                       HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock FontSize="12" Opacity="0.7" HorizontalAlignment="Center">
                                <Run Text="{Binding UnreadInbox, Mode=OneWay, FallbackValue=0}"/>
                                <Run Text="ungelesen"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
            
            <!-- Recent Activity -->
            <StackPanel Grid.Row="2" Margin="0,0,0,32">
                <TextBlock Text="Letzte Aktivitäten" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16"/>
                
                <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                        BorderThickness="1" CornerRadius="8">
                    <ListView ItemsSource="{Binding RecentActivities}" 
                              BorderThickness="0" Background="Transparent"
                              MaxHeight="300">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,8" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20" 
                                                Background="{DynamicResource SystemControlBackgroundAccentBrush}"
                                                Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Icon}" FontSize="20" 
                                                       Foreground="White" HorizontalAlignment="Center" 
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"/>
                                            <TextBlock Text="{Binding Description}" FontSize="12" Opacity="0.7"/>
                                        </StackPanel>
                                        
                                        <TextBlock Grid.Column="2" Text="{Binding TimeAgo}" FontSize="11" Opacity="0.6"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
            </StackPanel>
            
            <!-- Quick Links -->
            <StackPanel Grid.Row="3">
                <TextBlock Text="Module" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16"/>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Timeline -->
                    <Border Grid.Column="0" Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="20" Cursor="Hand">
                        <Border.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding OpenTimelineCommand}"/>
                        </Border.InputBindings>
                        <StackPanel>
                            <TextBlock Text="📅" FontSize="32" Margin="0,0,0,8"/>
                            <TextBlock Text="Timeline" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock Text="Zeitliche Visualisierung" FontSize="12" Opacity="0.7"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Geo View -->
                    <Border Grid.Column="2" Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="20" Cursor="Hand">
                        <Border.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding OpenGeoViewCommand}"/>
                        </Border.InputBindings>
                        <StackPanel>
                            <TextBlock Text="🗺️" FontSize="32" Margin="0,0,0,8"/>
                            <TextBlock Text="Geo-Ansicht" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock Text="Geografische Visualisierung" FontSize="12" Opacity="0.7"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Graph View -->
                    <Border Grid.Column="4" Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="20" Cursor="Hand">
                        <Border.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding OpenGraphViewCommand}"/>
                        </Border.InputBindings>
                        <StackPanel>
                            <TextBlock Text="🔗" FontSize="32" Margin="0,0,0,8"/>
                            <TextBlock Text="Graph-Ansicht" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock Text="Beziehungsvisualisierung" FontSize="12" Opacity="0.7"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
