<Window x:Class="Themis.DocumentManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:local="clr-namespace:Themis.DocumentManager.Views"
        xmlns:Dashboard="clr-namespace:Themis.DocumentManager.Views.Dashboard"
        xmlns:Timeline="clr-namespace:Themis.DocumentManager.Views.Timeline"
        xmlns:Tasks="clr-namespace:Themis.DocumentManager.Views.Tasks"
        xmlns:Inbox="clr-namespace:Themis.DocumentManager.Views.Inbox"
        xmlns:Favorites="clr-namespace:Themis.DocumentManager.Views.Favorites"
        xmlns:Collaboration="clr-namespace:Themis.DocumentManager.Views.Collaboration"
        xmlns:Gantt="clr-namespace:Themis.DocumentManager.Views.Gantt"
        xmlns:Preview="clr-namespace:Themis.DocumentManager.Views.Preview"
        mc:Ignorable="d"
        Title="ThemisDB Document Manager" 
        Height="900" Width="1600"
        MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        ui:WindowHelper.UseModernWindowStyle="True">

    <Window.InputBindings>
        <!-- Settings -->
        <KeyBinding Key="OemComma" Modifiers="Control" Command="{Binding OpenSettingsCommand}"/>
        <!-- Navigation -->
        <KeyBinding Key="Tab" Modifiers="Control" Command="{Binding NextTabCommand}"/>
        <KeyBinding Key="Tab" Modifiers="Control+Shift" Command="{Binding PreviousTabCommand}"/>
        <!-- Search -->
        <KeyBinding Key="F" Modifiers="Control" Command="{Binding OpenSearchCommand}"/>
        <!-- Theme Toggle -->
        <KeyBinding Key="T" Modifiers="Control+Shift" Command="{Binding ToggleThemeCommand}"/>
    </Window.InputBindings>

    <Grid Background="{DynamicResource SystemControlBackgroundAltMediumLowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- MEN�LEISTE -->
        <Menu Grid.Row="0" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" Padding="0" Height="30">
            <MenuItem Header="Datei">
                <MenuItem Header="Neu" InputGestureText="Strg+N"/>
                <MenuItem Header="�ffnen" InputGestureText="Strg+O"/>
                <MenuItem Header="Speichern" InputGestureText="Strg+S"/>
                <Separator/>
                <MenuItem Header="Beenden" InputGestureText="Strg+Q"/>
            </MenuItem>
            <MenuItem Header="Ansicht">
                <MenuItem Header="Vollbild" x:Name="MenuFullscreen" Click="ToggleFullscreen_Click"/>
                <MenuItem Header="Fensterformat" x:Name="MenuWindowMode" Click="ToggleWindowMode_Click"/>
                <Separator/>
                <MenuItem Header="Linke Seitenleiste" IsCheckable="True" IsChecked="True" x:Name="MenuLeftSidebar" Click="ToggleSidebar_Click"/>
                <MenuItem Header="Rechte Seitenleiste" IsCheckable="True" IsChecked="True" x:Name="MenuRightSidebar" Click="ToggleSidebar_Click"/>
            </MenuItem>
            <MenuItem Header="Extras">
                <MenuItem Header="Einstellungen..." InputGestureText="Strg+," Click="OpenSettings_Click"/>
                <Separator/>
                <MenuItem Header="Theme">
                    <MenuItem Header="☀️ Hell" x:Name="MenuThemeLight" Click="SetThemeLight_Click"/>
                    <MenuItem Header="🌙 Dunkel" x:Name="MenuThemeDark" Click="SetThemeDark_Click"/>
                    <MenuItem Header="💻 System" x:Name="MenuThemeSystem" Click="SetThemeSystem_Click" IsChecked="True"/>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="Hilfe">
                <MenuItem Header="Dokumentation" InputGestureText="F1"/>
                <MenuItem Header="Tastenkombinationen"/>
                <Separator/>
                <MenuItem Header="Über ThemisDB"/>
            </MenuItem>
        </Menu>

        <!-- RIBBON TOOLBAR (Office-Style) -->
        <Grid Grid.Row="1" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Ribbon Tabs -->
                <RowDefinition Height="Auto"/>
                <!-- Ribbon Content -->
            </Grid.RowDefinitions>

            <!-- Ribbon Tab Bar -->
            <Border Grid.Row="0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Ribbon Tabs (Left) -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="10,0,0,0">
                        <RadioButton Content="Start" GroupName="RibbonTabs" IsChecked="True" 
                                    Style="{StaticResource {x:Type ToggleButton}}" 
                                    Padding="15,8" FontSize="13" x:Name="TabStart" Click="RibbonTab_Click"/>
                        <RadioButton Content="Einfügen" GroupName="RibbonTabs" 
                                    Style="{StaticResource {x:Type ToggleButton}}" 
                                    Padding="15,8" FontSize="13" x:Name="TabInsert" Click="RibbonTab_Click"/>
                        <RadioButton Content="Ansicht" GroupName="RibbonTabs" 
                                    Style="{StaticResource {x:Type ToggleButton}}" 
                                    Padding="15,8" FontSize="13" x:Name="TabView" Click="RibbonTab_Click"/>
                        <RadioButton Content="Module" GroupName="RibbonTabs" 
                                    Style="{StaticResource {x:Type ToggleButton}}" 
                                    Padding="15,8" FontSize="13" x:Name="TabModules" Click="RibbonTab_Click"/>
                    </StackPanel>
                    
                    <!-- User Switcher (Right) -->
                    <Border Grid.Column="1" BorderBrush="#e0e0e0" BorderThickness="1,0,0,0" Padding="12,4" Margin="0,4,10,4"
                            DataContext="{Binding UserSwitcherViewModel}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👤" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Button x:Name="UserSplitButton" 
                                    Background="Transparent" 
                                    BorderBrush="#d0d0d0" 
                                    BorderThickness="1"
                                    Padding="8,4"
                                    MinWidth="180"
                                    Height="28"
                                    Click="UserSplitButton_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Grid.Column="0" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding CurrentUser.DisplayName, FallbackValue='Benutzer wählen'}" 
                                                   FontSize="11" FontWeight="SemiBold" Foreground="#333"/>
                                        <TextBlock Text="{Binding CurrentUser.Role, FallbackValue='Rolle'}" 
                                                   FontSize="9" Foreground="#999"/>
                                    </StackPanel>
                                    
                                    <TextBlock Grid.Column="1" Text="▼" FontSize="8" Foreground="#666" 
                                              VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                                
                                <!-- Dropdown Menu -->
                                <Button.ContextMenu>
                                    <ContextMenu x:Name="UserContextMenu">
                                        <MenuItem Header="BENUTZER WECHSELN" IsEnabled="False" FontWeight="Bold" FontSize="10"/>
                                        <Separator/>
                                        <MenuItem Header="Max Mustermann (Admin)" 
                                                 Command="{Binding PlacementTarget.DataContext.SwitchUserCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                 CommandParameter="{Binding PlacementTarget.DataContext.AvailableUsers[0], RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                            <MenuItem.Icon>
                                                <TextBlock Text="👤" FontSize="12"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Anna Schmidt (Editor)" 
                                                 Command="{Binding PlacementTarget.DataContext.SwitchUserCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                 CommandParameter="{Binding PlacementTarget.DataContext.AvailableUsers[1], RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                            <MenuItem.Icon>
                                                <TextBlock Text="👤" FontSize="12"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Thomas Mueller (Editor)" 
                                                 Command="{Binding PlacementTarget.DataContext.SwitchUserCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                 CommandParameter="{Binding PlacementTarget.DataContext.AvailableUsers[2], RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                            <MenuItem.Icon>
                                                <TextBlock Text="👤" FontSize="12"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Lisa Weber (Viewer)" 
                                                 Command="{Binding PlacementTarget.DataContext.SwitchUserCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                 CommandParameter="{Binding PlacementTarget.DataContext.AvailableUsers[3], RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                            <MenuItem.Icon>
                                                <TextBlock Text="👤" FontSize="12"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Michael Braun (Viewer)" 
                                                 Command="{Binding PlacementTarget.DataContext.SwitchUserCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                 CommandParameter="{Binding PlacementTarget.DataContext.AvailableUsers[4], RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                            <MenuItem.Icon>
                                                <TextBlock Text="👤" FontSize="12"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Ribbon Content Area -->
            <Border Grid.Row="1" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" 
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,0,1" 
                    Padding="10,8" MinHeight="100">
                <Grid>
                    <!-- START TAB CONTENT -->
                    <Grid x:Name="RibbonStartContent" Visibility="Visible">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal">
                            
                            <!-- Zwischenablage Group -->
                            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" 
                                    BorderThickness="0,0,1,0" Padding="10,0" Margin="0,0,5,0">
                                <StackPanel>
                                    <TextBlock Text="Zwischenablage" FontSize="10" Opacity="0.7" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Width="60" Height="60" Margin="2">
                                            <StackPanel>
                                                <TextBlock Text="??" FontSize="24" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Einf�gen" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Button>
                                        <StackPanel>
                                            <Button Height="28" Margin="2,2,2,1" Padding="8,4">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="??" FontSize="14" Margin="0,0,5,0"/>
                                                    <TextBlock Text="Ausschneiden" FontSize="10"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Height="28" Margin="2,1,2,2" Padding="8,4">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="??" FontSize="14" Margin="0,0,5,0"/>
                                                    <TextBlock Text="Kopieren" FontSize="10"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Datei Group -->
                            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" 
                                    BorderThickness="0,0,1,0" Padding="10,0" Margin="0,0,5,0">
                                <StackPanel>
                                    <TextBlock Text="Datei" FontSize="10" Opacity="0.7" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Width="60" Height="60" Margin="2">
                                            <StackPanel>
                                                <TextBlock Text="??" FontSize="24" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Neu" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Width="60" Height="60" Margin="2">
                                            <StackPanel>
                                                <TextBlock Text="??" FontSize="24" HorizontalAlignment="Center"/>
                                                <TextBlock Text="�ffnen" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Width="60" Height="60" Margin="2">
                                            <StackPanel>
                                                <TextBlock Text="??" FontSize="24" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Speichern" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Bearbeiten Group -->
                            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" 
                                    BorderThickness="0,0,1,0" Padding="10,0" Margin="0,0,5,0">
                                <StackPanel>
                                    <TextBlock Text="Bearbeiten" FontSize="10" Opacity="0.7" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Width="50" Height="60" Margin="2">
                                            <StackPanel>
                                                <TextBlock Text="?" FontSize="24" HorizontalAlignment="Center"/>
                                                <TextBlock Text="R�ckg�ngig" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Width="50" Height="60" Margin="2">
                                            <StackPanel>
                                                <TextBlock Text="?" FontSize="24" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Wieder-herstellen" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Suche Group -->
                            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" 
                                    BorderThickness="0,0,1,0" Padding="10,0" Margin="0,0,5,0">
                                <StackPanel>
                                    <TextBlock Text="Suche" FontSize="10" Opacity="0.7" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox Width="200" Height="30" Padding="8,5" VerticalContentAlignment="Center" Margin="2"/>
                                        <Button Width="50" Height="30" Margin="2">
                                            <TextBlock Text="🔍" FontSize="16"/>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Ansichten Group -->
                            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" 
                                    BorderThickness="0,0,1,0" Padding="10,0" Margin="0,0,5,0">
                                <StackPanel>
                                    <TextBlock Text="Ansichten" FontSize="10" Opacity="0.7" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Width="60" Height="60" Margin="2" Click="OpenAIChat_Click">
                                            <StackPanel>
                                                <TextBlock Text="🤖" FontSize="24" HorizontalAlignment="Center"/>
                                                <TextBlock Text="AI Chat" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Width="60" Height="60" Margin="2" Click="OpenTimeline_Click">
                                            <StackPanel>
                                                <TextBlock Text="📅" FontSize="24" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Timeline" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Width="60" Height="60" Margin="2" Click="OpenTasks_Click">
                                            <StackPanel>
                                                <TextBlock Text="✓" FontSize="24" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Aufgaben" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Width="60" Height="60" Margin="2" Click="OpenPDVForm_Click">
                                            <StackPanel>
                                                <TextBlock Text="📝" FontSize="24" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Formular" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- INSERT TAB CONTENT -->
                <Grid x:Name="RibbonInsertContent" Visibility="Collapsed">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal">
                            
                            <!-- Office Dokumente Group -->
                            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" 
                                    BorderThickness="0,0,1,0" Padding="10,0" Margin="0,0,5,0">
                                <StackPanel>
                                    <TextBlock Text="Office Dokumente" FontSize="10" Opacity="0.7" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Width="60" Height="60" Margin="2">
                                            <StackPanel>
                                                <TextBlock Text="??" FontSize="24" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Word" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Width="60" Height="60" Margin="2">
                                            <StackPanel>
                                                <TextBlock Text="??" FontSize="24" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Excel" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Width="60" Height="60" Margin="2">
                                            <StackPanel>
                                                <TextBlock Text="??" FontSize="24" HorizontalAlignment="Center"/>
                                                <TextBlock Text="PowerPoint" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Width="60" Height="60" Margin="2">
                                            <StackPanel>
                                                <TextBlock Text="??" FontSize="24" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Outlook" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Tabellen & Charts Group -->
                            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" 
                                    BorderThickness="0,0,1,0" Padding="10,0" Margin="0,0,5,0">
                                <StackPanel>
                                    <TextBlock Text="Tabellen &amp; Diagramme" FontSize="10" Opacity="0.7" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Width="60" Height="60" Margin="2">
                                            <StackPanel>
                                                <TextBlock Text="??" FontSize="24" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Tabelle" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Width="60" Height="60" Margin="2">
                                            <StackPanel>
                                                <TextBlock Text="??" FontSize="24" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Diagramm" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- VIEW TAB CONTENT -->
                <Grid x:Name="RibbonViewContent" Visibility="Collapsed">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal">
                            
                            <!-- Layout Group -->
                            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" 
                                    BorderThickness="0,0,1,0" Padding="10,0" Margin="0,0,5,0">
                                <StackPanel>
                                    <TextBlock Text="Layout" FontSize="10" Opacity="0.7" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Width="70" Height="60" Margin="2">
                                            <StackPanel>
                                                <TextBlock Text="?" FontSize="24" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Vollbild" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Width="70" Height="60" Margin="2">
                                            <StackPanel>
                                                <TextBlock Text="?" FontSize="24" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Maximieren" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Sidebars Group -->
                            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" 
                                    BorderThickness="0,0,1,0" Padding="10,0" Margin="0,0,5,0">
                                <StackPanel>
                                    <TextBlock Text="Sidebars" FontSize="10" Opacity="0.7" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal">
                                        <ToggleButton Width="70" Height="60" Margin="2" IsChecked="True" x:Name="ToggleLeftSidebar">
                                            <StackPanel>
                                                <TextBlock Text="??" FontSize="24" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Links" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </ToggleButton>
                                        <ToggleButton Width="70" Height="60" Margin="2" IsChecked="True" x:Name="ToggleRightSidebar">
                                            <StackPanel>
                                                <TextBlock Text="??" FontSize="24" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Rechts" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </ToggleButton>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- MODULES TAB CONTENT -->
                <Grid x:Name="RibbonModulesContent" Visibility="Collapsed">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal">
                            
                            <!-- Visualisierung Group -->
                            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" 
                                    BorderThickness="0,0,1,0" Padding="10,0" Margin="0,0,5,0">
                                <StackPanel>
                                    <TextBlock Text="Visualisierung" FontSize="10" Opacity="0.7" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal">
                                        <ToggleButton Width="70" Height="60" Margin="2" x:Name="ToggleGantt">
                                            <StackPanel>
                                                <TextBlock Text="??" FontSize="24" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Gantt" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </ToggleButton>
                                        <ToggleButton Width="70" Height="60" Margin="2" x:Name="ToggleTimeline">
                                            <StackPanel>
                                                <TextBlock Text="??" FontSize="24" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Timeline" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </ToggleButton>
                                        <ToggleButton Width="70" Height="60" Margin="2" x:Name="ToggleMap">
                                            <StackPanel>
                                                <TextBlock Text="???" FontSize="24" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Karte" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </ToggleButton>
                                        <ToggleButton Width="70" Height="60" Margin="2" x:Name="ToggleGraph">
                                            <StackPanel>
                                                <TextBlock Text="??" FontSize="24" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Graph" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </ToggleButton>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Analyse Group -->
                            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" 
                                    BorderThickness="0,0,1,0" Padding="10,0" Margin="0,0,5,0">
                                <StackPanel>
                                    <TextBlock Text="Analyse" FontSize="10" Opacity="0.7" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Width="70" Height="60" Margin="2">
                                            <StackPanel>
                                                <TextBlock Text="??" FontSize="24" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Dashboard" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Width="70" Height="60" Margin="2">
                                            <StackPanel>
                                                <TextBlock Text="??" FontSize="24" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Berichte" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                </Grid>
            </Border>
        </Grid>

        <!-- MAIN CONTENT WITH TIMELINE & SIDEBARS -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Timeline Row -->
                <RowDefinition Height="*"/>    <!-- Content Row -->
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" x:Name="LeftSidebarColumn"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="350" x:Name="RightSidebarColumn"/>
            </Grid.ColumnDefinitions>

            <!-- DYNAMIC TIMELINE RULER (Full Width, Collapsible with Gantt) -->
            <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" 
                    Background="White" 
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" 
                    BorderThickness="0,0,0,1" 
                    Padding="0">
                <Grid x:Name="TimelineContainer">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Compact Controls -->
                        <RowDefinition Height="Auto"/> <!-- Compact Timeline -->
                        <RowDefinition x:Name="DetailTimelineRow" Height="0"/> <!-- Expandable Detail Timeline -->
                    </Grid.RowDefinitions>

                    <!-- COMPACT TIMELINE CONTROLS (Horizontal Compact Bar) -->
                    <Border Grid.Row="0" Background="#fafafa" BorderBrush="#e0e0e0" BorderThickness="0,0,0,1" Padding="8,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Expand/Collapse Button for Detail View -->
                            <Button x:Name="ExpandTimelineButton" Grid.Column="0" Content="▶" Width="24" Height="22" FontSize="10" Padding="0" Margin="0,0,4,0" ToolTip="Timeline Details anzeigen" Click="ExpandTimeline_Click"/>
                            
                            <!-- Timeline Label -->
                            <TextBlock Grid.Column="1" Text="📅" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            
                            <!-- Zoom Controls (Compact) -->
                            <Button Grid.Column="2" x:Name="ZoomOutButton" Content="−" Width="22" Height="22" FontSize="11" Padding="0" Margin="0,0,2,0" ToolTip="Zoom −" Click="ZoomOutButton_Click"/>
                            <Button Grid.Column="2" x:Name="ZoomInButton" Content="+" Width="22" Height="22" FontSize="11" Padding="0" Margin="24,0,0,0" ToolTip="Zoom +" Click="ZoomInButton_Click"/>
                            
                            <!-- Scale ComboBox -->
                            <ComboBox Grid.Column="3" x:Name="TimelineScaleComboBox" Width="80" FontSize="9" Padding="4,2" Margin="6,0,0,0" ToolTip="Zeitskala" SelectionChanged="TimelineScaleComboBox_SelectionChanged">
                                <ComboBoxItem>1 Tag</ComboBoxItem>
                                <ComboBoxItem>1 Woche</ComboBoxItem>
                                <ComboBoxItem IsSelected="True">1 Monat</ComboBoxItem>
                                <ComboBoxItem>3 Monate</ComboBoxItem>
                                <ComboBoxItem>6 Monate</ComboBoxItem>
                                <ComboBoxItem>1 Jahr</ComboBoxItem>
                            </ComboBox>

                            <!-- Date Range & Today (Space Filler) -->
                            <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10,0,0,0">
                                <TextBlock x:Name="DateRangeTextBlock" Text="01.11 - 01.12" FontSize="8" Foreground="#999" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Button x:Name="TodayButton" Content="📍" Width="22" Height="22" FontSize="10" Padding="0" ToolTip="Heute" Click="TodayButton_Click"/>
                            </StackPanel>

                            <!-- Gantt Toggle (Right) -->
                            <CheckBox Grid.Column="6" x:Name="ShowGanttCheckBox" Content="Gantt" FontSize="9" VerticalAlignment="Center" Margin="8,0,0,0" ToolTip="Gantt-Balken anzeigen" Click="ShowGantt_Click"/>
                        </Grid>
                    </Border>

                    <!-- COMPACT TIMELINE RULER (Minimal Height) -->
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden" Padding="0" x:Name="TimelineScroller" Height="50">
                        <Grid Background="White">
                            <Canvas x:Name="TimelineCanvas" Background="White" Height="50">
                                <!-- Dynamically filled mit Zeitmarkierungen und Event-Badges -->
                            </Canvas>
                        </Grid>
                    </ScrollViewer>

                    <!-- DETAIL TIMELINE (Expandable, Hidden by Default) -->
                    <Border Grid.Row="2" Background="#f5f5f5" BorderBrush="#e0e0e0" BorderThickness="0,1,0,0">
                        <Expander Header="Gantt-Diagramm Details" IsExpanded="False" Margin="8" Padding="0,8">
                            <Grid Height="250">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Timeline Ruler for Detail View -->
                                <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden" Height="40" Margin="0,0,0,4">
                                    <Grid Background="White">
                                        <Canvas x:Name="DetailTimelineRuler" Background="White" Height="40"/>
                                    </Grid>
                                </ScrollViewer>

                                <!-- Gantt Bars Container -->
                                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                    <Canvas x:Name="GanttCanvas" Background="White" Height="200" MinWidth="2000">
                                        <!-- Gantt bars will be drawn here -->
                                    </Canvas>
                                </ScrollViewer>
                            </Grid>
                        </Expander>
                    </Border>
                </Grid>
            </Border>

            <!-- LEFT SIDEBAR WITH MINI-WINDOWS -->
            <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" 
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- NAVIGATION MINI-WINDOW WITH TREEVIEW -->
                    <Border Grid.Row="0" Background="White" BorderBrush="#e0e0e0" BorderThickness="1" Margin="0,0,0,4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Mini-Window Title Bar -->
                            <Grid Grid.Row="0" Background="#f5f5f5" Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="📁 Navigation" FontSize="11" FontWeight="Bold" Margin="8,4" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="_" Width="24" Height="20" FontSize="10" Margin="4,0" ToolTip="Minimieren"/>
                                <Button Grid.Column="2" Content="X" Width="24" Height="20" FontSize="10" ToolTip="Schließen"/>
                            </Grid>

                            <!-- Navigation TreeView (Outlook-ähnlich) -->
                            <TreeView Grid.Row="1" Background="White" Margin="0" x:Name="NavigationTreeView" 
                                     PreviewMouseLeftButtonDown="NavigationTreeView_PreviewMouseLeftButtonDown"
                                     PreviewMouseDoubleClick="NavigationTreeView_PreviewMouseDoubleClick"
                                     PreviewMouseRightButtonDown="NavigationTreeView_PreviewMouseRightButtonDown">
                                <TreeView.ContextMenu>
                                    <ContextMenu x:Name="TreeViewContextMenu">
                                        <MenuItem Header="📄 Öffnen" Click="TreeViewContext_Open"/>
                                        <MenuItem Header="📄 In neuem Tab öffnen" Click="TreeViewContext_OpenNewTab"/>
                                        <Separator/>
                                        <MenuItem Header="✏️ Umbenennen" Click="TreeViewContext_Rename"/>
                                        <MenuItem Header="📋 Kopieren" Click="TreeViewContext_Copy"/>
                                        <MenuItem Header="✂️ Ausschneiden" Click="TreeViewContext_Cut"/>
                                        <MenuItem Header="📁 Einfügen" Click="TreeViewContext_Paste"/>
                                        <Separator/>
                                        <MenuItem Header="🗑 Löschen" Click="TreeViewContext_Delete"/>
                                        <Separator/>
                                        <MenuItem Header="⚙️ Eigenschaften" Click="TreeViewContext_Properties"/>
                                    </ContextMenu>
                                </TreeView.ContextMenu>
                                <!-- Dashboard Link -->
                                <TreeViewItem Header="📊 Dashboard" Tag="doc_dashboard" IsExpanded="False"/>
                                
                                <!-- Dokumentbereich -->
                                <TreeViewItem Header="📄 Dokumente" IsExpanded="True">
                                    <TreeViewItem Header="📂 Meine Dokumente" Tag="folder_mydocs"/>
                                    <TreeViewItem Header="⏱ Zuletzt verwendet" Tag="folder_recent">
                                        <TreeViewItem Header="Baugenehmigung_2024.pdf" Tag="doc_001"/>
                                        <TreeViewItem Header="Kostenschätzung.xlsx" Tag="doc_002"/>
                                        <TreeViewItem Header="Rechnungsproof.docx" Tag="doc_003"/>
                                    </TreeViewItem>
                                    <TreeViewItem Header="⭐ Favoriten" Tag="folder_favorites">
                                        <TreeViewItem Header="Grundriss_Entwurf.pdf" Tag="doc_004"/>
                                    </TreeViewItem>
                                </TreeViewItem>

                                <!-- Projekte -->
                                <TreeViewItem Header="📂 Projekte" IsExpanded="True">
                                    <TreeViewItem Header="🔨 Aktive Projekte" Tag="folder_active">
                                        <TreeViewItem Header="Bauproject München" Tag="proj_001">
                                            <TreeViewItem Header="Planung" Tag="phase_planning"/>
                                            <TreeViewItem Header="Genehmigung" Tag="phase_approval"/>
                                            <TreeViewItem Header="Ausführung" Tag="phase_execution"/>
                                        </TreeViewItem>
                                        <TreeViewItem Header="Digitalisierung Akte" Tag="proj_002"/>
                                    </TreeViewItem>
                                    <TreeViewItem Header="📦 Abgelossene Projekte" Tag="folder_completed">
                                        <TreeViewItem Header="Projekt 2023" Tag="proj_2023"/>
                                    </TreeViewItem>
                                </TreeViewItem>

                                <!-- Wiedervorlagen / Aufgaben -->
                                <TreeViewItem Header="📅 Wiedervorlagen" Tag="folder_reminders" IsExpanded="False"/>
                                
                                <!-- Mitzeichnungen / Genehmigungen -->
                                <TreeViewItem Header="✍️ Mitzeichnungen" Tag="folder_signoffs" IsExpanded="False">
                                    <TreeViewItem Header="Wartend (3)" Tag="folder_pending">
                                        <TreeViewItem Header="Baugenehmigung ABC" Tag="doc_sign_001"/>
                                        <TreeViewItem Header="Umweltbericht XYZ" Tag="doc_sign_002"/>
                                        <TreeViewItem Header="Kostenberechnung" Tag="doc_sign_003"/>
                                    </TreeViewItem>
                                    <TreeViewItem Header="Abgeschlossen (12)" Tag="folder_completed_signoffs"/>
                                </TreeViewItem>

                                <!-- Papierkorb -->
                                <TreeViewItem Header="🗑 Papierkorb" Tag="folder_trash" IsExpanded="False"/>
                            </TreeView>
                        </Grid>
                    </Border>

                    <!-- SPACER -->
                    <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" 
                                 Background="Transparent" ResizeBehavior="PreviousAndNext"/>

                    <!-- PLACEHOLDER FOR ADDITIONAL MINI-WINDOW -->
                    <Border Grid.Row="2" Background="White" BorderBrush="#e0e0e0" BorderThickness="1" Margin="0,4,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Mini-Window Title Bar -->
                            <Grid Grid.Row="0" Background="#f5f5f5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="⭐ Favoriten" FontSize="11" FontWeight="Bold" Margin="8,4" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="_" Width="24" Height="20" FontSize="10" Margin="4,0" ToolTip="Minimieren"/>
                                <Button Grid.Column="2" Content="X" Width="24" Height="20" FontSize="10" ToolTip="Schließen"/>
                            </Grid>

                            <!-- Favorites Content -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="10">
                                <StackPanel>
                                    <TextBlock Text="Keine Favoriten" FontSize="10" Foreground="#999" 
                                              HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,20"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- CENTER CONTENT WITH TAB MANAGEMENT -->
            <Grid Grid.Row="1" Grid.Column="1" Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- BREADCRUMB NAVIGATION -->
                <local:BreadcrumbView Grid.Row="0" DataContext="{Binding BreadcrumbViewModel}"/>

                <!-- TAB BAR WITH CLOSE BUTTONS AND CONTEXT MENU -->
                <Border Grid.Row="1" Background="#f5f5f5" BorderBrush="#e0e0e0" BorderThickness="0,0,0,1" Padding="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- TAB SCROLLVIEWER -->
                        <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden" Height="32">
                            <StackPanel x:Name="TabBar" Orientation="Horizontal" VerticalAlignment="Center"/>
                        </ScrollViewer>

                        <!-- TAB MANAGEMENT BUTTONS -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                            <!-- Search Button -->
                            <Button x:Name="TabSearchButton" Width="28" Height="28" Margin="2,0" 
                                    Background="Transparent" BorderBrush="#e0e0e0" BorderThickness="1"
                                    ToolTip="Tabs durchsuchen" Click="TabSearch_Click">
                                <TextBlock Text="🔍" FontSize="14"/>
                            </Button>

                            <!-- Sort/Filter Button (Context Menu) -->
                            <Button x:Name="TabContextMenuButton" Width="28" Height="28" Margin="2,0" 
                                    Background="Transparent" BorderBrush="#e0e0e0" BorderThickness="1"
                                    ToolTip="Sortierung &amp; Filter" Click="TabContextMenu_Click">
                                <TextBlock Text="⋮" FontSize="14"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- CONTEXT MENU FOR TABS (Attached as Resource) -->
                    <Border.ContextMenu>
                        <ContextMenu x:Name="TabContextMenu" StaysOpen="True">
                            <MenuItem Header="📊 Sortierung" IsEnabled="True">
                                <MenuItem Header="Nach Name (A-Z)" Click="SortTabsBy_Name"/>
                                <MenuItem Header="Nach Öffnungsreihenfolge" Click="SortTabsBy_OpenOrder"/>
                                <MenuItem Header="Nach Zuletzt verwendet" Click="SortTabsBy_LastUsed"/>
                                <Separator/>
                                <MenuItem Header="Absteigend" Click="SortTabsBy_Reverse"/>
                            </MenuItem>

                            <MenuItem Header="🔽 Filter" IsEnabled="True">
                                <MenuItem Header="Nur aktuelle Kategorie" Click="FilterTabs_CurrentCategory"/>
                                <MenuItem Header="Nach Typ..." Click="FilterTabs_ByType"/>
                                <MenuItem Header="Favoriten anzeigen" Click="FilterTabs_Favorites"/>
                                <Separator/>
                                <MenuItem Header="Alle anzeigen" Click="FilterTabs_ShowAll"/>
                            </MenuItem>

                            <Separator/>

                            <MenuItem Header="⚙️ Tab-Verwaltung" IsEnabled="True">
                                <MenuItem Header="Alle bis auf aktuelle schließen" Click="TabManagement_CloseOthers"/>
                                <MenuItem Header="Alle Tabs schließen (außer Dashboard)" Click="TabManagement_CloseAll"/>
                                <Separator/>
                                <MenuItem Header="Duplikat erstellen" Click="TabManagement_Duplicate"/>
                                <MenuItem Header="In neuem Fenster öffnen" Click="TabManagement_NewWindow"/>
                            </MenuItem>

                            <Separator/>

                            <MenuItem Header="📌 Favoriten" IsEnabled="True">
                                <MenuItem Header="Als Favorit speichern" Click="TabFavorite_Add"/>
                                <MenuItem Header="Aus Favoriten entfernen" Click="TabFavorite_Remove"/>
                                <Separator/>
                                <MenuItem Header="Favoriten anpassen..." Click="TabFavorite_Manage"/>
                            </MenuItem>
                        </ContextMenu>
                    </Border.ContextMenu>
                </Border>

                <!-- CONTENT AREA -->
                <TabControl Grid.Row="2" x:Name="CenterContent" Background="White">
                    <!-- Dashboard Tab (always visible, not closeable) -->
                    <TabItem Header="📊 Dashboard" IsSelected="True">
                        <Dashboard:DashboardView DataContext="{Binding DashboardViewModel}"/>
                    </TabItem>
                </TabControl>
            </Grid>

            <!-- RIGHT SIDEBAR WITH PLUGABLE MINI-WINDOWS -->
            <Border Grid.Row="1" Grid.Column="2" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1,0,0,0">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- GRAPH & MAP MINI-WINDOW WITH TABS -->
                    <Border Grid.Row="0" Background="White" BorderBrush="#e0e0e0" BorderThickness="1" Margin="0,0,0,4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Mini-Window Title Bar -->
                            <Grid Grid.Row="0" Background="#f5f5f5" Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Visualisierungen" FontSize="11" FontWeight="Bold" Margin="8,4" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="_" Width="24" Height="20" FontSize="10" Margin="4,0" ToolTip="Minimieren"/>
                                <Button Grid.Column="2" Content="X" Width="24" Height="20" FontSize="10" ToolTip="Schliessen"/>
                            </Grid>

                            <!-- Tab Bar -->
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Background="#fafafa" Margin="0" Height="28">
                                <RadioButton x:Name="VisualizationTabGraph" Content="Graph" GroupName="VisualizationTabs" IsChecked="True" 
                                            Style="{StaticResource {x:Type ToggleButton}}" Padding="12,4" FontSize="10" Margin="4,0,0,0" Click="VisualizationTab_Click"/>
                                <RadioButton x:Name="VisualizationTabMap" Content="OSM-Map" GroupName="VisualizationTabs" 
                                            Style="{StaticResource {x:Type ToggleButton}}" Padding="12,4" FontSize="10" Margin="2,0,0,0" Click="VisualizationTab_Click"/>
                            </StackPanel>

                            <!-- Content Area with Tab Switching -->
                            <Grid Grid.Row="2">
                                <!-- GRAPH TAB -->
                                <ScrollViewer x:Name="GraphContent" Margin="10" VerticalScrollBarVisibility="Auto" Visibility="Visible">
                                    <StackPanel>
                                        <Border Background="#f0f0f0" BorderBrush="#ddd" BorderThickness="1" Height="150" Margin="0,0,0,8">
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock Text="3D" FontSize="40" HorizontalAlignment="Center" Opacity="0.3"/>
                                                <TextBlock Text="3D Graph Rendering" HorizontalAlignment="Center" Foreground="#999" FontSize="10"/>
                                            </StackPanel>
                                        </Border>

                                        <GroupBox Header="Verbindungs-Statistik" Margin="0,0,0,8">
                                            <StackPanel Margin="6,4">
                                                <TextBlock Text="Knoten: 15" FontSize="9" Margin="0,2"/>
                                                <TextBlock Text="Kanten: 28" FontSize="9" Margin="0,2"/>
                                                <TextBlock Text="Zentral: Doc_001" FontSize="9" Margin="0,2" Foreground="#2196f3"/>
                                            </StackPanel>
                                        </GroupBox>

                                        <TextBlock Text="Verbundene Elemente:" FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                                        <Border Background="White" BorderBrush="#ddd" BorderThickness="1" Height="80">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="6">
                                                <StackPanel>
                                                    <Border Padding="3,2" Background="#f9f9f9" Margin="0,1">
                                                        <TextBlock Text="Doc_002" FontSize="9"/>
                                                    </Border>
                                                    <Border Padding="3,2" Background="#f9f9f9" Margin="0,1">
                                                        <TextBlock Text="Max Mustermann" FontSize="9"/>
                                                    </Border>
                                                    <Border Padding="3,2" Background="#f9f9f9" Margin="0,1">
                                                        <TextBlock Text="Prozess_ABC" FontSize="9"/>
                                                    </Border>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- MAP TAB -->
                                <Border x:Name="MapContent" Background="White" Visibility="Collapsed" Margin="0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- OSM Map Area -->
                                        <Border Grid.Row="0" Background="#e0e0e0" BorderBrush="#bbb" BorderThickness="1" Margin="10">
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock Text="🗺" FontSize="48" HorizontalAlignment="Center" Opacity="0.3"/>
                                                <TextBlock Text="OpenStreetMap Integration" HorizontalAlignment="Center" Foreground="#666" FontSize="11" Margin="0,8,0,0"/>
                                                <TextBlock Text="(Leaflet / GeoJSON Support)" HorizontalAlignment="Center" Foreground="#999" FontSize="9"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Map Controls -->
                                        <Border Grid.Row="1" Background="#fafafa" Padding="8" BorderBrush="#ddd" BorderThickness="1,1,1,0">
                                            <StackPanel>
                                                <TextBlock Text="Karten-Info:" FontSize="9" FontWeight="Bold" Margin="0,0,0,4"/>
                                                <TextBlock Text="Zoom Level: 12" FontSize="9" Margin="0,2"/>
                                                <TextBlock Text="Position: 52.5200° N, 13.4050° E" FontSize="9" Margin="0,2"/>
                                                <Button Content="Zum aktuellen Standort zoomen" Padding="8,4" Margin="0,6,0,0" FontSize="9" Width="Auto" HorizontalAlignment="Left"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- SPLITTER -->
                    <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" Background="#e0e0e0" Cursor="SizeNS" Margin="0,2"/>

                    <!-- AI CHAT MINI-WINDOW -->
                    <Border Grid.Row="2" Background="White" BorderBrush="#e0e0e0" BorderThickness="1" Margin="0,4,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Mini-Window Title Bar -->
                            <Grid Grid.Row="0" Background="#f5f5f5" Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="AI-Assistent" FontSize="11" FontWeight="Bold" Margin="8,4" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="_" Width="24" Height="20" FontSize="10" Margin="4,0" ToolTip="Minimieren"/>
                                <Button Grid.Column="2" Content="X" Width="24" Height="20" FontSize="10" ToolTip="Schliessen"/>
                            </Grid>

                            <!-- Integrated AI Chat View -->
                            <local:AIChatView x:Name="SidebarAIChatView" Grid.Row="1"/> 
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- STATUSBAR -->
        <StatusBar Grid.Row="3" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,1,0,0" Height="30">
            <StatusBarItem>
                <TextBlock x:Name="StatusMessage" Text="Bereit"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="Version 1.0.0" FontSize="11"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
