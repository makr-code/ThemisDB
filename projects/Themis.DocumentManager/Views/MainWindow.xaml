<Window x:Class="Themis.DocumentManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Themis.DocumentManager.Views"
        Title="ThemisDB Document Manager" 
        Height="900" Width="1600"
        MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#f8fafc">

    <!-- Tastaturkürzel auf zentrale Toolbar-Kommandos routen -->
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewCommand}"/>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenCommand}"/>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/>
        <KeyBinding Key="F" Modifiers="Control" Command="{x:Static local:MainWindow.FocusSearchCommand}"/>
        <KeyBinding Key="Comma" Modifiers="Control" Command="{Binding OpenSettingsCommand}"/>
        <KeyBinding Key="F11" Command="{Binding ToggleThemeCommand}"/>
        <KeyBinding Key="Tab" Modifiers="Control" Command="{Binding NextTabCommand}"/>
        <KeyBinding Key="Tab" Modifiers="Control+Shift" Command="{Binding PreviousTabCommand}"/>
        <KeyBinding Key="W" Modifiers="Control" Command="{x:Static local:MainWindow.CloseTabCommand}"/>
        <KeyBinding Key="T" Modifiers="Control" Command="{x:Static local:MainWindow.NewTabCommand}"/>
        <KeyBinding Key="D" Modifiers="Control" Command="{x:Static local:MainWindow.DuplicateTabCommand}"/>
        <KeyBinding Key="B" Modifiers="Control" Command="{x:Static local:MainWindow.ToggleLeftSidebarCommand}"/>
        <KeyBinding Key="B" Modifiers="Control+Shift" Command="{x:Static local:MainWindow.ToggleRightSidebarCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <!-- Menu Bar -->
            <RowDefinition Height="50"/>
            <!-- Ribbon -->
            <RowDefinition Height="*"/>
            <!-- Content Area -->
            <RowDefinition Height="30"/>
            <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- Menu Bar -->
        <Menu Grid.Row="0" Background="#ffffff" BorderBrush="#e2e8f0" BorderThickness="0,0,0,1">
            <MenuItem Header="Datei">
                <MenuItem Header="Neu" Command="{Binding NewCommand}"/>
                <MenuItem Header="Öffnen" Command="{Binding OpenCommand}"/>
                <MenuItem Header="Speichern" Command="{Binding SaveCommand}"/>
                <Separator/>
                <MenuItem Header="Beenden" Click="MenuExit_Click"/>
            </MenuItem>
            <MenuItem Header="Ansicht">
                <MenuItem Header="Vollbild" x:Name="MenuFullscreen" Click="MenuFullscreen_Click"/>
                <Separator/>
                <MenuItem Header="Audit-Logs" Click="MenuAuditLogs_Click"/>
                <Separator/>
                <MenuItem Header="Aktiven Tab schließen" Command="{x:Static local:MainWindow.CloseTabCommand}"/>
                <MenuItem Header="Neuen Tab öffnen" Command="{x:Static local:MainWindow.NewTabCommand}"/>
                <MenuItem Header="Aktiven Tab duplizieren" Command="{x:Static local:MainWindow.DuplicateTabCommand}"/>
            </MenuItem>
            <MenuItem Header="Extras">
                <MenuItem Header="Einstellungen" Command="{Binding OpenSettingsCommand}"/>
                <MenuItem Header="Theme">
                    <MenuItem Header="Hell" x:Name="MenuThemeLight" Click="MenuThemeLight_Click"/>
                    <MenuItem Header="Dunkel" x:Name="MenuThemeDark" Click="MenuThemeDark_Click"/>
                    <MenuItem Header="System" x:Name="MenuThemeSystem" Click="MenuThemeSystem_Click" IsChecked="True"/>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="Hilfe">
                <MenuItem Header="Dokumentation" />
                <MenuItem Header="Über" />
            </MenuItem>
        </Menu>

        <!-- Ribbon Toolbar -->
        <Border Grid.Row="1" Background="#ffffff" BorderBrush="#e2e8f0" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="10,5">
                <Button Content="📄 Neu" Command="{Binding NewCommand}" Padding="10,5" Margin="0,0,5,0"/>
                <Button Content="📂 Öffnen" Command="{Binding OpenCommand}" Padding="10,5" Margin="0,0,5,0"/>
                <Button Content="💾 Speichern" Command="{Binding SaveCommand}" Padding="10,5" Margin="0,0,5,0"/>
                <Separator Margin="5,0" Background="#e2e8f0" Width="1"/>
                <TextBox x:Name="SearchBox" Width="240" Height="26" Margin="0,0,5,0"
                         VerticalAlignment="Center"
                         Padding="6,2"
                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
                <Button Content="🔍 Suchen" Command="{Binding SearchCommand}" Padding="10,5" Margin="0,0,5,0"/>
                <Button Content="⚙️ Einstellungen" Command="{Binding OpenSettingsCommand}" Padding="10,5"/>
            </StackPanel>
        </Border>

        <!-- Main Content Area with flexible sidebars and center -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ColLeft" Width="280"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition x:Name="ColRight" Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- Left Sidebar -->
            <Border Grid.Column="0" Background="#ffffff" BorderBrush="#e2e8f0" BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Background="#f8fafc" Margin="8,6,8,6">
                        <TextBlock Text="Seitenleiste" Foreground="#64748b"/>
                        <Button Content="◀" Command="{x:Static local:MainWindow.ToggleLeftSidebarCommand}" Margin="8,0,0,0"/>
                    </StackPanel>
                    <TabControl x:Name="LeftSidebarTabs">
                        <TabItem Header="📂 Explorer">
                            <Grid Margin="0" x:Name="LeftExplorerPanel">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <!-- Title -->
                                <TextBlock Text="📂 Dokument-Explorer" Foreground="#334155" Margin="8" FontWeight="Bold" FontSize="12"/>
                                
                                <!-- Search & Filter -->
                                <Grid Grid.Row="1" Margin="8,4,8,4" Background="#f8fafc">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Name="ExplorerSearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="4" Margin="0,0,4,0" Foreground="#64748b"/>
                                    <Button Grid.Column="1" Command="{Binding SearchCommand}" Content="🔍" Padding="6,4" Margin="0,0,4,0"/>
                                    <ComboBox Grid.Column="2" ItemsSource="All|Documents|Files|Filings" SelectedItem="{Binding FilterCategory}" Padding="4"/>
                                </Grid>
                                
                                <!-- Search Results (dynamic) -->
                                <ListBox Grid.Row="2" ItemsSource="{Binding FilteredResults}" DisplayMemberPath="Name" MaxHeight="100" 
                                         Background="#f1f5f9" Foreground="#475569" FontSize="11" Margin="8,0,8,4" Padding="4"/>
                                
                                <!-- Hierarchical TreeView (hauptsächliche Ansicht) -->
                                <TreeView Grid.Row="3" ItemsSource="{Binding RootNodes}" Margin="0" Background="White" Foreground="#334155">
                                    <TreeView.ItemTemplate>
                                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                <TextBlock Text="{Binding NodeType, Converter={StaticResource StringToIconConverter}}" Margin="0,0,4,0" FontSize="12"/>
                                                <TextBlock Text="{Binding Name}" Foreground="#334155" FontSize="11"/>
                                                <ProgressBar IsIndeterminate="True" Width="20" Height="8" Margin="4,0" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            </StackPanel>
                                        </HierarchicalDataTemplate>
                                    </TreeView.ItemTemplate>
                                </TreeView>
                                
                                <!-- Status Bar -->
                                <TextBlock Grid.Row="4" Text="{Binding isLoading, StringFormat='Loading...'}" Margin="8" Foreground="#94a3b8" FontSize="10"/>
                            </Grid>
                        </TabItem>
                        <TabItem Header="⭐ Favoriten">
                            <Grid Margin="8" x:Name="LeftFavoritesPanel">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Favoriten" Foreground="#334155"/>
                                <ListBox Grid.Row="1" ItemsSource="{Binding AllFavorites}" DisplayMemberPath="EntityName"/>
                            </Grid>
                        </TabItem>
                        <TabItem Header="🔗 Prozesse">
                            <Grid Margin="8" x:Name="LeftProcessesPanel">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Prozess-Verknüpfungen" Foreground="#334155"/>
                                <ListBox Grid.Row="1" ItemsSource="{Binding LinkedProcesses}" DisplayMemberPath="ProcessName"/>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </Border>

            <!-- Splitter Left -->
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#e2e8f0" ShowsPreview="True"/>

            <!-- Center Content Area with TabControl -->
            <TabControl x:Name="CenterContent" Grid.Column="2" Background="White">
                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem">
                        <Setter Property="ContextMenu">
                            <Setter.Value>
                                <ContextMenu>
                                    <MenuItem Header="Tab schließen" Command="{x:Static local:MainWindow.CloseTabCommand}"/>
                                    <MenuItem Header="Tab duplizieren" Command="{x:Static local:MainWindow.DuplicateTabCommand}"/>
                                    <MenuItem Header="In neuem Fenster öffnen" Click="MenuOpenTabInNewWindow_Click"/>
                                </ContextMenu>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.ItemContainerStyle>
                <TabItem Header="📊 Start" x:Name="TabStart" IsSelected="True">
                     <local:DashboardPreviewView/>
                </TabItem>
                <TabItem Header="📑 Documents" x:Name="TabDocuments">
                     <local:DocumentBrowserSimpleView/>
                </TabItem>
                <TabItem Header="🔗 Timeline" x:Name="TabTimeline">
                     <local:TimelineViewImproved/>
                </TabItem>
                <TabItem Header="📊 Gantt" x:Name="TabGantt">
                     <local:GanttView/>
                </TabItem>
                <TabItem Header="📊 Dashboard" x:Name="TabDashboard">
                     <local:FullDashboardSimpleView/>
                </TabItem>
                <TabItem Header="🗂️ ERD" x:Name="TabERD">
                     <local:ERDView/>
                </TabItem>
                <TabItem Header="🔍 Query" x:Name="TabQuery">
                     <local:QueryEditorView/>
                </TabItem>
            </TabControl>

            <!-- Splitter Right -->
            <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#e2e8f0" ShowsPreview="True"/>

            <!-- Right Sidebar -->
            <Border Grid.Column="4" Background="#ffffff" BorderBrush="#e2e8f0" BorderThickness="1,0,0,0">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Background="#f8fafc" Margin="8,6,8,6">
                        <TextBlock Text="Details" Foreground="#64748b"/>
                        <Button Content="▶" Command="{x:Static local:MainWindow.ToggleRightSidebarCommand}" Margin="8,0,0,0"/>
                    </StackPanel>
                    <TabControl x:Name="RightSidebarTabs">
                        <TabItem Header="🏷️ Metadaten" x:Name="RightMetadataTab">
                            <Grid Margin="8" x:Name="RightMetadataPanel">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                            </Grid>
                        </TabItem>
                        <TabItem Header="🕑 Revisionen" x:Name="RightRevisionTab">
                            <Grid Margin="8" x:Name="RightRevisionPanel">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                            </Grid>
                        </TabItem>
                        <TabItem Header="💬 Kommentare" x:Name="RightCommentsTab">
                            <Grid Margin="8" x:Name="RightCommentsPanel">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <StatusBar Grid.Row="3" Background="#ffffff" BorderBrush="#e2e8f0" BorderThickness="0,1,0,0">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Bereit" Foreground="#64748b"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
