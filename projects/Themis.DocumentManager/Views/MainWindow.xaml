<Window x:Class="Themis.DocumentManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:local="clr-namespace:Themis.DocumentManager.Views"
        mc:Ignorable="d"
        Title="ThemisDB Document Manager" 
        Height="900" Width="1600"
        MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        ui:WindowHelper.UseModernWindowStyle="True">

    <Grid Background="{DynamicResource SystemControlBackgroundAltMediumLowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- MENÜLEISTE -->
        <Menu Grid.Row="0" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" Padding="0" Height="30">
            <MenuItem Header="Datei">
                <MenuItem Header="Neu" InputGestureText="Strg+N"/>
                <MenuItem Header="Öffnen" InputGestureText="Strg+O"/>
                <MenuItem Header="Speichern" InputGestureText="Strg+S"/>
                <Separator/>
                <MenuItem Header="Beenden" InputGestureText="Strg+Q"/>
            </MenuItem>
            <MenuItem Header="Ansicht">
                <MenuItem Header="Vollbild" x:Name="MenuFullscreen" Click="ToggleFullscreen_Click"/>
                <MenuItem Header="Fensterformat" x:Name="MenuWindowMode" Click="ToggleWindowMode_Click"/>
                <Separator/>
                <MenuItem Header="Linke Seitenleiste" IsCheckable="True" IsChecked="True" x:Name="MenuLeftSidebar" Click="ToggleSidebar_Click"/>
                <MenuItem Header="Rechte Seitenleiste" IsCheckable="True" IsChecked="True" x:Name="MenuRightSidebar" Click="ToggleSidebar_Click"/>
            </MenuItem>
        </Menu>

        <!-- RIBBON TOOLBAR (Office-Style) -->
        <Grid Grid.Row="1" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Ribbon Tabs -->
                <RowDefinition Height="Auto"/>
                <!-- Ribbon Content -->
            </Grid.RowDefinitions>

            <!-- Ribbon Tab Bar -->
            <Border Grid.Row="0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                    <RadioButton Content="Start" GroupName="RibbonTabs" IsChecked="True" 
                                Style="{StaticResource {x:Type ToggleButton}}" 
                                Padding="15,8" FontSize="13" x:Name="TabStart" Click="RibbonTab_Click"/>
                    <RadioButton Content="Einfügen" GroupName="RibbonTabs" 
                                Style="{StaticResource {x:Type ToggleButton}}" 
                                Padding="15,8" FontSize="13" x:Name="TabInsert" Click="RibbonTab_Click"/>
                    <RadioButton Content="Ansicht" GroupName="RibbonTabs" 
                                Style="{StaticResource {x:Type ToggleButton}}" 
                                Padding="15,8" FontSize="13" x:Name="TabView" Click="RibbonTab_Click"/>
                    <RadioButton Content="Module" GroupName="RibbonTabs" 
                                Style="{StaticResource {x:Type ToggleButton}}" 
                                Padding="15,8" FontSize="13" x:Name="TabModules" Click="RibbonTab_Click"/>
                </StackPanel>
            </Border>

            <!-- Ribbon Content Area -->
            <Border Grid.Row="1" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" 
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,0,1" 
                    Padding="10,8" MinHeight="100">
                <Grid>
                    <!-- START TAB CONTENT -->
                    <Grid x:Name="RibbonStartContent" Visibility="Visible">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal">
                            
                            <!-- Zwischenablage Group -->
                            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" 
                                    BorderThickness="0,0,1,0" Padding="10,0" Margin="0,0,5,0">
                                <StackPanel>
                                    <TextBlock Text="Zwischenablage" FontSize="10" Opacity="0.7" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Width="60" Height="60" Margin="2">
                                            <StackPanel>
                                                <TextBlock Text="📋" FontSize="24" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Einfügen" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Button>
                                        <StackPanel>
                                            <Button Height="28" Margin="2,2,2,1" Padding="8,4">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="✂️" FontSize="14" Margin="0,0,5,0"/>
                                                    <TextBlock Text="Ausschneiden" FontSize="10"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Height="28" Margin="2,1,2,2" Padding="8,4">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="📄" FontSize="14" Margin="0,0,5,0"/>
                                                    <TextBlock Text="Kopieren" FontSize="10"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Datei Group -->
                            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" 
                                    BorderThickness="0,0,1,0" Padding="10,0" Margin="0,0,5,0">
                                <StackPanel>
                                    <TextBlock Text="Datei" FontSize="10" Opacity="0.7" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Width="60" Height="60" Margin="2">
                                            <StackPanel>
                                                <TextBlock Text="📄" FontSize="24" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Neu" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Width="60" Height="60" Margin="2">
                                            <StackPanel>
                                                <TextBlock Text="📁" FontSize="24" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Öffnen" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Width="60" Height="60" Margin="2">
                                            <StackPanel>
                                                <TextBlock Text="💾" FontSize="24" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Speichern" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Bearbeiten Group -->
                            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" 
                                    BorderThickness="0,0,1,0" Padding="10,0" Margin="0,0,5,0">
                                <StackPanel>
                                    <TextBlock Text="Bearbeiten" FontSize="10" Opacity="0.7" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Width="50" Height="60" Margin="2">
                                            <StackPanel>
                                                <TextBlock Text="↶" FontSize="24" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Rückgängig" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Width="50" Height="60" Margin="2">
                                            <StackPanel>
                                                <TextBlock Text="↷" FontSize="24" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Wieder-herstellen" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Suche Group -->
                            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" 
                                    BorderThickness="0,0,1,0" Padding="10,0" Margin="0,0,5,0">
                                <StackPanel>
                                    <TextBlock Text="Suche" FontSize="10" Opacity="0.7" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox Width="200" Height="30" Padding="8,5" VerticalContentAlignment="Center" Margin="2"/>
                                        <Button Width="50" Height="30" Margin="2">
                                            <TextBlock Text="🔍" FontSize="16"/>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- INSERT TAB CONTENT -->
                <Grid x:Name="RibbonInsertContent" Visibility="Collapsed">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal">
                            
                            <!-- Office Dokumente Group -->
                            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" 
                                    BorderThickness="0,0,1,0" Padding="10,0" Margin="0,0,5,0">
                                <StackPanel>
                                    <TextBlock Text="Office Dokumente" FontSize="10" Opacity="0.7" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Width="60" Height="60" Margin="2">
                                            <StackPanel>
                                                <TextBlock Text="📝" FontSize="24" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Word" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Width="60" Height="60" Margin="2">
                                            <StackPanel>
                                                <TextBlock Text="📊" FontSize="24" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Excel" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Width="60" Height="60" Margin="2">
                                            <StackPanel>
                                                <TextBlock Text="🎯" FontSize="24" HorizontalAlignment="Center"/>
                                                <TextBlock Text="PowerPoint" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Width="60" Height="60" Margin="2">
                                            <StackPanel>
                                                <TextBlock Text="📧" FontSize="24" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Outlook" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Tabellen & Charts Group -->
                            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" 
                                    BorderThickness="0,0,1,0" Padding="10,0" Margin="0,0,5,0">
                                <StackPanel>
                                    <TextBlock Text="Tabellen &amp; Diagramme" FontSize="10" Opacity="0.7" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Width="60" Height="60" Margin="2">
                                            <StackPanel>
                                                <TextBlock Text="📋" FontSize="24" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Tabelle" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Width="60" Height="60" Margin="2">
                                            <StackPanel>
                                                <TextBlock Text="📈" FontSize="24" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Diagramm" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- VIEW TAB CONTENT -->
                <Grid x:Name="RibbonViewContent" Visibility="Collapsed">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal">
                            
                            <!-- Layout Group -->
                            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" 
                                    BorderThickness="0,0,1,0" Padding="10,0" Margin="0,0,5,0">
                                <StackPanel>
                                    <TextBlock Text="Layout" FontSize="10" Opacity="0.7" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Width="70" Height="60" Margin="2">
                                            <StackPanel>
                                                <TextBlock Text="⬜" FontSize="24" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Vollbild" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Width="70" Height="60" Margin="2">
                                            <StackPanel>
                                                <TextBlock Text="⬛" FontSize="24" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Maximieren" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Sidebars Group -->
                            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" 
                                    BorderThickness="0,0,1,0" Padding="10,0" Margin="0,0,5,0">
                                <StackPanel>
                                    <TextBlock Text="Sidebars" FontSize="10" Opacity="0.7" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal">
                                        <ToggleButton Width="70" Height="60" Margin="2" IsChecked="True" x:Name="ToggleLeftSidebar">
                                            <StackPanel>
                                                <TextBlock Text="◀️" FontSize="24" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Links" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </ToggleButton>
                                        <ToggleButton Width="70" Height="60" Margin="2" IsChecked="True" x:Name="ToggleRightSidebar">
                                            <StackPanel>
                                                <TextBlock Text="▶️" FontSize="24" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Rechts" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </ToggleButton>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- MODULES TAB CONTENT -->
                <Grid x:Name="RibbonModulesContent" Visibility="Collapsed">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal">
                            
                            <!-- Visualisierung Group -->
                            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" 
                                    BorderThickness="0,0,1,0" Padding="10,0" Margin="0,0,5,0">
                                <StackPanel>
                                    <TextBlock Text="Visualisierung" FontSize="10" Opacity="0.7" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal">
                                        <ToggleButton Width="70" Height="60" Margin="2" x:Name="ToggleGantt">
                                            <StackPanel>
                                                <TextBlock Text="📊" FontSize="24" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Gantt" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </ToggleButton>
                                        <ToggleButton Width="70" Height="60" Margin="2" x:Name="ToggleTimeline">
                                            <StackPanel>
                                                <TextBlock Text="📈" FontSize="24" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Timeline" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </ToggleButton>
                                        <ToggleButton Width="70" Height="60" Margin="2" x:Name="ToggleMap">
                                            <StackPanel>
                                                <TextBlock Text="🗺️" FontSize="24" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Karte" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </ToggleButton>
                                        <ToggleButton Width="70" Height="60" Margin="2" x:Name="ToggleGraph">
                                            <StackPanel>
                                                <TextBlock Text="🔗" FontSize="24" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Graph" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </ToggleButton>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Analyse Group -->
                            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" 
                                    BorderThickness="0,0,1,0" Padding="10,0" Margin="0,0,5,0">
                                <StackPanel>
                                    <TextBlock Text="Analyse" FontSize="10" Opacity="0.7" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Width="70" Height="60" Margin="2">
                                            <StackPanel>
                                                <TextBlock Text="📊" FontSize="24" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Dashboard" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Width="70" Height="60" Margin="2">
                                            <StackPanel>
                                                <TextBlock Text="📉" FontSize="24" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Berichte" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                </Grid>
            </Border>
        </Grid>

        <!-- MAIN CONTENT WITH TIMELINE & SIDEBARS -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Timeline Row -->
                <RowDefinition Height="*"/>    <!-- Content Row -->
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" x:Name="LeftSidebarColumn"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="350" x:Name="RightSidebarColumn"/>
            </Grid.ColumnDefinitions>

            <!-- DYNAMIC TIMELINE (Full Width, Under Ribbon) -->
            <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" 
                    Background="White" 
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" 
                    BorderThickness="0,0,0,1" 
                    Padding="10,8" 
                    MinHeight="90">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Timeline Ruler -->
                        <RowDefinition Height="*"/>    <!-- Timeline Items -->
                    </Grid.RowDefinitions>

                    <!-- Timeline Header / Zeitskala -->
                    <Border Grid.Row="0" Background="#f5f5f5" BorderBrush="#e0e0e0" BorderThickness="0,0,0,1" Padding="5,3">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,10,0">
                                <TextBlock Text="📅 Timeline" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox Width="80" FontSize="10" Padding="5,2">
                                    <ComboBoxItem>1 Woche</ComboBoxItem>
                                    <ComboBoxItem IsSelected="True">1 Monat</ComboBoxItem>
                                    <ComboBoxItem>3 Monate</ComboBoxItem>
                                    <ComboBoxItem>1 Jahr</ComboBoxItem>
                                </ComboBox>
                            </StackPanel>

                            <!-- Time Scale Ruler -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0">
                                <TextBlock Text="Mo" Width="60" TextAlignment="Center" FontSize="9" Foreground="#999"/>
                                <TextBlock Text="Di" Width="60" TextAlignment="Center" FontSize="9" Foreground="#999"/>
                                <TextBlock Text="Mi" Width="60" TextAlignment="Center" FontSize="9" Foreground="#999"/>
                                <TextBlock Text="Do" Width="60" TextAlignment="Center" FontSize="9" Foreground="#999"/>
                                <TextBlock Text="Fr" Width="60" TextAlignment="Center" FontSize="9" Foreground="#999"/>
                                <TextBlock Text="Sa" Width="60" TextAlignment="Center" FontSize="9" Foreground="#999"/>
                                <TextBlock Text="So" Width="60" TextAlignment="Center" FontSize="9" Foreground="#999"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Timeline Badges (Scrollable) -->
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden" Padding="5,5,5,0">
                        <StackPanel Orientation="Vertical">
                            <!-- Timeline Item 1 -->
                            <Border Margin="0,3,0,3" Padding="8,6" Background="#e3f2fd" CornerRadius="4" BorderBrush="#2196f3" BorderThickness="0,2,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="09:30" FontSize="10" FontWeight="Bold" Foreground="#1976d2"/>
                                    <TextBlock Grid.Column="1" Text="📧 E-Mail eintreffen" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="von ABC GmbH" FontSize="9" Foreground="#666" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>

                            <!-- Timeline Item 2 -->
                            <Border Margin="0,3,0,3" Padding="8,6" Background="#fff3e0" CornerRadius="4" BorderBrush="#ff9800" BorderThickness="0,2,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="11:15" FontSize="10" FontWeight="Bold" Foreground="#f57c00"/>
                                    <TextBlock Grid.Column="1" Text="⏰ Frist: Genehmigung" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="in 5 Tagen" FontSize="9" Foreground="#d84315" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Bold"/>
                                </Grid>
                            </Border>

                            <!-- Timeline Item 3 -->
                            <Border Margin="0,3,0,3" Padding="8,6" Background="#f3e5f5" CornerRadius="4" BorderBrush="#9c27b0" BorderThickness="0,2,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="14:45" FontSize="10" FontWeight="Bold" Foreground="#6a1b9a"/>
                                    <TextBlock Grid.Column="1" Text="⚙️ Prozess gestartet" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="Genehmigungsworkflow" FontSize="9" Foreground="#666" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>

                            <!-- Timeline Item 4 -->
                            <Border Margin="0,3,0,3" Padding="8,6" Background="#e8f5e9" CornerRadius="4" BorderBrush="#4caf50" BorderThickness="0,2,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="16:20" FontSize="10" FontWeight="Bold" Foreground="#388e3c"/>
                                    <TextBlock Grid.Column="1" Text="✅ Genehmigt von" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="Max Mustermann" FontSize="9" Foreground="#666" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- LEFT SIDEBAR -->
            <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,1,0">
                <StackPanel Padding="10">
                    <TextBlock Text="Navigation" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TreeView>
                        <TreeViewItem Header=" Dokumente" IsExpanded="True">
                            <TreeViewItem Header="Meine Dokumente"/>
                            <TreeViewItem Header="Zuletzt verwendet"/>
                        </TreeViewItem>
                        <TreeViewItem Header=" Projekte">
                            <TreeViewItem Header="Aktive Projekte"/>
                        </TreeViewItem>
                    </TreeView>
                </StackPanel>
            </Border>

            <!-- CENTER CONTENT -->
            <TabControl Grid.Row="1" Grid.Column="1" Background="Transparent">
                <TabItem Header=" Dashboard" IsSelected="True">
                    <TextBlock Text="Dashboard" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18"/>
                </TabItem>
                <TabItem Header=" Gantt" x:Name="TabGantt">
                    <TextBlock Text="Gantt-Diagramm" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
                </TabItem>
                <TabItem Header=" Timeline" x:Name="TabTimeline">
                    <TextBlock Text="Timeline" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
                </TabItem>
                <TabItem Header=" Karte" x:Name="TabMap">
                    <TextBlock Text="OSM-Karte" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
                </TabItem>
                <TabItem Header=" Graph" x:Name="TabGraph">
                    <TextBlock Text="Graph" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
                </TabItem>
            </TabControl>

            <!-- RIGHT SIDEBAR WITH TABS (Graph 3D & AI Chat) -->
            <Border Grid.Row="1" Grid.Column="2" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1,0,0,0" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Tab Bar -->
                        <RowDefinition Height="*"/>    <!-- Tab Content -->
                    </Grid.RowDefinitions>

                    <!-- Right Sidebar Tab Bar -->
                    <Border Grid.Row="0" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,0,1" Padding="8,6">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="🔗 Graph" GroupName="RightSidebarTabs" IsChecked="True" 
                                        Style="{StaticResource {x:Type ToggleButton}}" 
                                        Padding="10,4" FontSize="11" x:Name="RightTabGraph" Click="RightSidebarTab_Click" Margin="0,0,8,0"/>
                            <RadioButton Content="💬 AI-Chat" GroupName="RightSidebarTabs" 
                                        Style="{StaticResource {x:Type ToggleButton}}" 
                                        Padding="10,4" FontSize="11" x:Name="RightTabChat" Click="RightSidebarTab_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Tab Content Area -->
                    <Grid Grid.Row="1" Padding="10">
                        <!-- GRAPH 3D TAB -->
                        <StackPanel x:Name="RightSidebarGraphContent" Visibility="Visible">
                            <TextBlock Text="Graphen-Verbindungen" FontSize="12" FontWeight="Bold" Margin="0,0,0,8"/>
                            <Border Background="#f5f5f5" CornerRadius="4" BorderBrush="#ddd" BorderThickness="1" Height="200" Margin="0,0,0,8">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="🔗" FontSize="48" HorizontalAlignment="Center" Opacity="0.3"/>
                                    <TextBlock Text="3D Graph Rendering" HorizontalAlignment="Center" Foreground="#999" FontSize="11"/>
                                    <TextBlock Text="(ThreeJS / Babylon.js Integration)" HorizontalAlignment="Center" Foreground="#ccc" FontSize="9" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Graph Info -->
                            <GroupBox Header="Verbindungs-Info" Padding="8,6" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="Knoten: 15" FontSize="10" Margin="0,2"/>
                                    <TextBlock Text="Kanten: 28" FontSize="10" Margin="0,2"/>
                                    <TextBlock Text="Zentral: Dokument_001" FontSize="10" Margin="0,2" Foreground="#2196f3"/>
                                </StackPanel>
                            </GroupBox>

                            <!-- Related Items -->
                            <TextBlock Text="Verbundene Elemente" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                            <Border Background="White" CornerRadius="3" BorderBrush="#e0e0e0" BorderThickness="1" Padding="8" Height="120">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <Border Padding="4,3" Background="#f0f0f0" CornerRadius="2" Margin="0,2">
                                            <TextBlock Text="📄 Document_002" FontSize="9"/>
                                        </Border>
                                        <Border Padding="4,3" Background="#f0f0f0" CornerRadius="2" Margin="0,2">
                                            <TextBlock Text="👤 Max Mustermann" FontSize="9"/>
                                        </Border>
                                        <Border Padding="4,3" Background="#f0f0f0" CornerRadius="2" Margin="0,2">
                                            <TextBlock Text="⚙️ Process_ABC" FontSize="9"/>
                                        </Border>
                                        <Border Padding="4,3" Background="#f0f0f0" CornerRadius="2" Margin="0,2">
                                            <TextBlock Text="📅 2025-01-15" FontSize="9"/>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>

                        <!-- AI CHAT TAB -->
                        <Grid x:Name="RightSidebarChatContent" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/> <!-- Messages -->
                                <RowDefinition Height="Auto"/> <!-- Input Area -->
                            </Grid.RowDefinitions>

                            <!-- Chat Messages Area -->
                            <Border Grid.Row="0" Background="White" CornerRadius="4" BorderBrush="#e0e0e0" BorderThickness="1" Padding="10,8" Margin="0,0,0,8">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <!-- User Message -->
                                        <Border HorizontalAlignment="Right" Background="#2196f3" CornerRadius="8,8,0,8" Padding="10,6" Margin="20,0,0,6" MaxWidth="280">
                                            <TextBlock Text="Was sind die nächsten Schritte?" Foreground="White" TextWrapping="Wrap" FontSize="10"/>
                                        </Border>

                                        <!-- AI Message -->
                                        <Border HorizontalAlignment="Left" Background="#f5f5f5" CornerRadius="8,8,8,0" Padding="10,6" Margin="0,0,20,6" MaxWidth="280">
                                            <StackPanel>
                                                <TextBlock Text="Basierend auf dem aktuellen Prozess:" Foreground="#333" TextWrapping="Wrap" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                                                <TextBlock Text="1. Dokumentation prüfen&#10;2. Genehmigung einholen&#10;3. Archivierung" Foreground="#666" TextWrapping="Wrap" FontSize="10"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Action Buttons (MCP Style) -->
                                        <Border HorizontalAlignment="Left" Margin="0,0,0,10" Padding="8,6" Background="#fffacd" CornerRadius="4" BorderBrush="#ddd" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="💡 Empfohlene Aktionen:" FontSize="9" FontWeight="Bold" Margin="0,0,0,4"/>
                                                <Button Content="📋 Checkliste erstellen" Width="Auto" HorizontalAlignment="Left" Padding="8,4" FontSize="9" Margin="0,2"/>
                                                <Button Content="✉️ Benachrichtigung senden" Width="Auto" HorizontalAlignment="Left" Padding="8,4" FontSize="9" Margin="0,2"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>

                            <!-- Chat Input Area -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0" 
                                        Background="White" 
                                        BorderBrush="#ddd" 
                                        BorderThickness="1" 
                                        CornerRadius="4" 
                                        Padding="8,6" 
                                        FontSize="10"
                                        VerticalAlignment="Top"
                                        AcceptsReturn="True"
                                        MaxHeight="60"
                                        Text="Frage stellen..."/>

                                <Button Grid.Column="1" Content="📤" Width="32" Height="32" Margin="6,0,0,0" FontSize="14" VerticalAlignment="Top"/>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- STATUSBAR -->
        <StatusBar Grid.Row="3" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,1,0,0" Height="30">
            <StatusBarItem>
                <TextBlock x:Name="StatusMessage" Text="Bereit"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="Version 1.0.0" FontSize="11"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>


