<UserControl x:Class="Themis.DocumentManager.Views.TimelineViewImproved"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#f8fafc" BorderBrush="#e2e8f0" BorderThickness="0,0,0,1">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="🔗 Timeline Events" FontSize="18" FontWeight="Bold" Foreground="#1e293b"/>
                <TextBlock Grid.Row="1" Text="Document &amp; Process History" FontSize="12" Foreground="#64748b" Margin="0,4,0,0"/>
            </Grid>
        </Border>

        <!-- Filter &amp; Search -->
        <Grid Grid.Row="1" Margin="16,4,16,4" Background="#f0f4f8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="8"/>
            <Button Grid.Column="1" Content="🔍" Margin="0,8,8,8"/>
            <ComboBox Grid.Column="2" Margin="0,8,8,8"/>
            <TextBlock Grid.Column="3" Text="⚙️" Margin="0,8,8,8"/>
        </Grid>

        <!-- Timeline -->
        <ListBox Grid.Row="2" ItemsSource="{Binding FilteredItems}" Margin="8" Background="White">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="#ffffff" BorderBrush="#e2e8f0" BorderThickness="1" Margin="0,0,0,8">
                        <Grid Margin="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="📄" FontSize="16"/>
                            <Grid Grid.Column="1" Margin="12,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="#1e293b"/>
                                <TextBlock Grid.Row="1" Text="{Binding Description}" Foreground="#64748b" FontSize="11" Margin="0,4,0,0"/>
                                <TextBlock Grid.Row="2" Text="{Binding CreatedAt, StringFormat='📅 {0:yyyy-MM-dd HH:mm}'}" Foreground="#94a3b8" FontSize="10" Margin="0,6,0,0"/>
                            </Grid>
                            <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="#059669" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Top"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Stats -->
        <Border Grid.Row="3" Background="#f8fafc" BorderBrush="#e2e8f0" BorderThickness="0,1,0,0">
            <Grid Margin="16">
                <TextBlock Text="{Binding TotalItemsCount, StringFormat='Total: {0} events'}" Foreground="#64748b" FontSize="11"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
