<UserControl x:Class="Themis.DocumentManager.Views.ProcessLinkingDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="White" MinWidth="600" MinHeight="500">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="24,20" Background="#f8fafc" BorderBrush="#e2e8f0" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="🔄 Prozess verknüpfen" FontSize="18" FontWeight="SemiBold" Foreground="#1e293b"/>
                <TextBlock Text="Wählen Sie einen Prozess, um ihn mit diesem Element zu verknüpfen" 
                          FontSize="12" Opacity="0.7" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24">
            <StackPanel>
                <!-- Available Templates Section -->
                <TextBlock Text="Verfügbare Prozessvorlagen" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12" Foreground="#1e293b"/>
                
                <ItemsControl ItemsSource="{Binding AvailableTemplates}" Margin="0,0,0,24">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="16" Margin="0,0,0,8" 
                                   Background="{Binding RelativeSource={RelativeSource Self}, Path=(local:ProcessLinkingDialog.IsSelected), Converter={StaticResource BoolToColorConverter}, ConverterParameter='#eff6ff|#ffffff'}"
                                   BorderBrush="{Binding RelativeSource={RelativeSource Self}, Path=(local:ProcessLinkingDialog.IsSelected), Converter={StaticResource BoolToColorConverter}, ConverterParameter='#3b82f6|#e2e8f0'}"
                                   BorderThickness="2"
                                   Cursor="Hand"
                                   MouseLeftButtonDown="TemplateItem_MouseLeftButtonDown">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="#1e293b" VerticalAlignment="Center"/>
                                        <Border Background="#e0f2fe" Padding="6,2" CornerRadius="3" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding Category}" FontSize="11" Foreground="#0369a1"/>
                                        </Border>
                                    </StackPanel>
                                    
                                    <TextBlock Text="{Binding Description}" FontSize="12" Opacity="0.8" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                        <TextBlock Text="Schritte:" FontSize="11" Opacity="0.7"/>
                                        <TextBlock Text="{Binding StepCount}" FontSize="11" Opacity="0.7" Margin="4,0,0,0"/>
                                        <TextBlock Text="Anwendbar auf:" FontSize="11" Opacity="0.7" Margin="12,0,0,0"/>
                                        <TextBlock Text="{Binding ApplicableEntityTypes}" FontSize="11" Opacity="0.7" Margin="4,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Divider -->
                <Border Height="1" Background="#e2e8f0" Margin="0,12,0,12"/>

                <!-- Linked Processes Section -->
                <TextBlock Text="Bereits verknüpfte Prozesse" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12" Foreground="#1e293b"/>
                
                <ItemsControl ItemsSource="{Binding LinkedProcesses}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12" Margin="0,0,0,8" Background="#f0fdf4" BorderBrush="#86efac" BorderThickness="1" CornerRadius="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding ProcessTemplateId}" FontSize="12" FontWeight="SemiBold" Foreground="#166534"/>
                                        <TextBlock Text="{Binding Status}" FontSize="11" Opacity="0.7" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    
                                    <Button Grid.Column="1" Content="Entfernen" 
                                           Command="{Binding DataContext.UnlinkProcessCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}"
                                           Background="#dc2626" Foreground="White"
                                           Padding="8,6" FontSize="11"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Empty State -->
                <TextBlock Text="Keine Prozesse verknüpft" Foreground="#94a3b8" FontSize="12" Opacity="0.7"
                          Visibility="{Binding LinkedProcesses, Converter={StaticResource EmptyToVisibilityConverter}}"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Status Message -->
        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" 
                  Padding="24,12" FontSize="12" 
                  Background="#f1f5f9" Foreground="#475569"
                  TextWrapping="Wrap"/>

        <!-- Action Buttons -->
        <Border Grid.Row="3" Padding="24,16" Background="#f8fafc" BorderBrush="#e2e8f0" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Abbrechen" 
                       Command="{Binding CloseDialogCommand}"
                       Background="#e2e8f0" Foreground="#1e293b"
                       Padding="16,10" Margin="0,0,8,0" FontSize="12"/>
                
                <Button Content="✓ Prozess verknüpfen" 
                       Command="{Binding LinkProcessCommand}"
                       Background="#3b82f6" Foreground="White"
                       Padding="16,10" FontSize="12"
                       IsEnabled="{Binding SelectedTemplate, Converter={StaticResource NullToBoolConverter}}"/>
            </StackPanel>
        </Border>

        <!-- Loading Overlay -->
        <Border Grid.Row="0" Grid.RowSpan="4" Background="#00000040" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar Width="100" Height="4" Background="#ffffff20" Foreground="#3b82f6" IsIndeterminate="True"/>
                <TextBlock Text="Wird geladen..." Foreground="White" FontSize="12" Margin="0,8,0,0" TextAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
