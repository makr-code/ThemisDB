<UserControl x:Class="Themis.DocumentManager.Views.MetadataFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#f8fafc">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="24,20" Background="White" BorderBrush="#e2e8f0" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="{Binding FormDefinition.Title}" FontSize="20" FontWeight="SemiBold" Foreground="#1e293b"/>
                <TextBlock Text="{Binding FormDefinition.Description}" FontSize="13" Opacity="0.7" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24">
            <StackPanel>
                <!-- Loading State -->
                <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ProgressBar Height="3" Background="#e2e8f0" Foreground="#3b82f6" IsIndeterminate="True"/>
                    <TextBlock Text="Formular wird geladen..." Foreground="#64748b" FontSize="13" Margin="0,8,0,0"/>
                </StackPanel>

                <!-- Sections -->
                <ItemsControl ItemsSource="{Binding FormDefinition.Sections}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Section -->
                            <Expander Header="{Binding Title}" IsExpanded="{Binding IsExpanded}" Margin="0,0,0,16">
                                <Border Padding="16" Background="White" BorderBrush="#e2e8f0" BorderThickness="1">
                                    <StackPanel>
                                        <!-- Section Description -->
                                        <TextBlock Text="{Binding Description}" FontSize="12" Opacity="0.6" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                        <!-- Fields Grid -->
                                        <ItemsControl ItemsSource="{Binding Fields}">
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="Margin" Value="0,0,0,16"/>
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <!-- Field Container -->
                                                    <StackPanel>
                                                        <!-- Label -->
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="12" Foreground="#1e293b"/>
                                                            <TextBlock Text="*" Foreground="#dc2626" Margin="4,0,0,0" 
                                                                      Visibility="{Binding IsRequired, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                        </StackPanel>

                                                        <!-- Input Controls based on Type -->
                                                        <TextBox Padding="10,8" FontSize="12" Foreground="#1e293b"
                                                                Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                                MinHeight="36"
                                                                Visibility="{Binding Type, Converter={StaticResource TypeToVisibilityConverter}, ConverterParameter='text'}"/>
                                                        
                                                        <TextBox Padding="10,8" FontSize="12" Foreground="#1e293b"
                                                                Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                                AcceptsReturn="True"
                                                                MinHeight="80"
                                                                TextWrapping="Wrap"
                                                                Visibility="{Binding Type, Converter={StaticResource TypeToVisibilityConverter}, ConverterParameter='textarea'}"/>
                                                        
                                                        <ComboBox Padding="10,8" FontSize="12"
                                                                 ItemsSource="{Binding Options}"
                                                                 SelectedValuePath="Value"
                                                                 Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                                 MinHeight="36"
                                                                 Visibility="{Binding Type, Converter={StaticResource TypeToVisibilityConverter}, ConverterParameter='dropdown'}">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding Label}"/>
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>

                                                        <!-- Description -->
                                                        <TextBlock Text="{Binding Description}" FontSize="11" Opacity="0.6" Margin="0,6,0,0" TextWrapping="Wrap"/>

                                                        <!-- Error Message -->
                                                        <TextBlock Text="{Binding ErrorMessage}" FontSize="11" Foreground="#dc2626" Margin="0,4,0,0"
                                                                  Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Status Bar -->
        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" 
                  Padding="24,12" FontSize="12" 
                  Background="#f1f5f9" Foreground="#475569"
                  TextWrapping="Wrap"/>

        <!-- Action Buttons -->
        <Border Grid.Row="3" Padding="24,16" Background="White" BorderBrush="#e2e8f0" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="↻ Zurücksetzen" 
                       Command="{Binding ResetFormCommand}"
                       Background="#f1f5f9" Foreground="#1e293b"
                       Padding="16,10" FontSize="12" Margin="0,0,8,0"/>
                
                <Button Content="✕ Schließen" 
                       Command="{Binding CloseFormCommand}"
                       Background="#e2e8f0" Foreground="#1e293b"
                       Padding="16,10" FontSize="12" Margin="0,0,8,0"/>
                
                <Button Content="✓ Speichern" 
                       Command="{Binding SaveFormCommand}"
                       Background="#3b82f6" Foreground="White"
                       Padding="16,10" FontSize="12"
                       IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
