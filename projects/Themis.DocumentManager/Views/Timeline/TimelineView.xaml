<UserControl x:Class="Themis.DocumentManager.Views.Timeline.TimelineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:local="clr-namespace:Themis.DocumentManager.Views.Timeline"
             xmlns:vm="clr-namespace:Themis.DocumentManager.ViewModels"
             xmlns:models="clr-namespace:Themis.DocumentManager.Models"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1200"
             d:DataContext="{d:DesignInstance Type=vm:TimelineViewModel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Toolbar -->
            <RowDefinition Height="*"/>    <!-- Timeline -->
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" 
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- Zoom controls -->
                    <ColumnDefinition Width="Auto"/> <!-- Navigation -->
                    <ColumnDefinition Width="*"/>    <!-- Filters -->
                    <ColumnDefinition Width="Auto"/> <!-- Process selector -->
                    <ColumnDefinition Width="Auto"/> <!-- Refresh -->
                </Grid.ColumnDefinitions>

                <!-- Zoom Controls / View Mode Switcher -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,16,0">
                    <TextBlock Text="Ansicht:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ToggleButton x:Name="TimelineViewModeList" Content="📋 Liste" IsChecked="True" Width="80" Margin="0,0,4,0" Checked="ViewMode_Changed"/>
                    <ToggleButton x:Name="TimelineViewModeGantt" Content="📊 Gantt" Width="80" Margin="0,0,16,0" Checked="ViewMode_Changed"/>
                    
                    <Rectangle Width="1" Fill="#e0e0e0" Margin="0,4" VerticalAlignment="Stretch"/>
                    
                    <TextBlock Text="Zoom:" VerticalAlignment="Center" Margin="16,0,8,0"/>
                    <Button Content="−" 
                            Command="{Binding ZoomOutCommand}"
                            Width="32" Height="32"
                            Margin="0,0,4,0"
                            ToolTip="Zoom Out"/>
                    <ComboBox SelectedItem="{Binding CurrentScale}"
                              Width="120"
                              Margin="0,0,4,0">
                        <ComboBox.ItemsSource>
                            <x:Array Type="{x:Type models:TimelineScale}">
                                <models:TimelineScale>OneDay</models:TimelineScale>
                                <models:TimelineScale>ThreeDays</models:TimelineScale>
                                <models:TimelineScale>OneWeek</models:TimelineScale>
                                <models:TimelineScale>TwoWeeks</models:TimelineScale>
                                <models:TimelineScale>OneMonth</models:TimelineScale>
                                <models:TimelineScale>ThreeMonths</models:TimelineScale>
                                <models:TimelineScale>SixMonths</models:TimelineScale>
                                <models:TimelineScale>OneYear</models:TimelineScale>
                                <models:TimelineScale>FiveYears</models:TimelineScale>
                            </x:Array>
                        </ComboBox.ItemsSource>
                    </ComboBox>
                    <Button Content="+" 
                            Command="{Binding ZoomInCommand}"
                            Width="32" Height="32"
                            ToolTip="Zoom In"/>
                </StackPanel>

                <!-- Navigation -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,16,0">
                    <Button Content="📅 Heute" 
                            Command="{Binding JumpToTodayCommand}"
                            Margin="0,0,8,0"/>
                    <DatePicker SelectedDate="{Binding CenterDate, Mode=TwoWay}"
                                Width="140"/>
                </StackPanel>

                <!-- Filter Chips -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    
                    <!-- Object Type Filters -->
                    <ToggleButton Content="📥 Inbox" Margin="0,0,4,0"/>
                    <ToggleButton Content="⏰ Deadlines" Margin="0,0,4,0"/>
                    <ToggleButton Content="📋 Tasks" Margin="0,0,4,0"/>
                    <ToggleButton Content="✅ Approvals" Margin="0,0,4,0"/>
                    <ToggleButton Content="📄 Documents" Margin="0,0,8,0"/>
                    
                    <Button Content="🔍" 
                            Width="32"
                            ToolTip="Mehr Filter..."
                            Margin="0,0,4,0"/>
                    <Button Content="✕ Filter löschen" 
                            Command="{Binding ClearFiltersCommand}"
                            Style="{StaticResource AccentButtonStyle}"/>
                </StackPanel>

                <!-- Process Selector -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="16,0,16,0">
                    <TextBlock Text="Prozess:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Width="180"
                              SelectedValue="{Binding SelectedProcessId}">
                    </ComboBox>
                    <Button Content="✕" 
                            Command="{Binding ClearProcessCommand}"
                            Width="32"
                            Margin="4,0,0,0"
                            ToolTip="Prozess-Filter entfernen"/>
                </StackPanel>

                <!-- Refresh -->
                <Button Grid.Column="4"
                        Content="🔄"
                        Command="{Binding RefreshCommand}"
                        Width="32"
                        ToolTip="Aktualisieren"/>
            </Grid>
        </Border>

        <!-- Timeline Area -->
        <Grid Grid.Row="1" Background="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Zeitachse -->
                <RowDefinition Height="50"/>
                <!-- Gantt Bars (ein-/ausblendbar) -->
                <RowDefinition Height="*"/>
                <!-- Content (Liste oder leer) -->
            </Grid.RowDefinitions>

            <!-- Ansicht-Modus Header -->
            <Border Grid.Row="0" Background="#f5f5f5" BorderBrush="#e0e0e0" BorderThickness="0,0,0,1" Padding="16,12">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Ansicht:" VerticalAlignment="Center" Margin="0,0,12,0" FontWeight="Bold"/>
                    <ToggleButton x:Name="ContentViewModeList" Content="📋 Liste" IsChecked="True" Width="100" Margin="0,0,4,0" Checked="ViewMode_Changed"/>
                    <ToggleButton x:Name="ContentViewModeGantt" Content="📊 Gantt" Width="100" Margin="0,0,16,0" Checked="ViewMode_Changed"/>
                    <Separator Width="1" Background="#e0e0e0" Margin="0,0,12,0"/>
                    <TextBlock Text="Gantt-Balken:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <CheckBox x:Name="ShowGanttBars" Content="Anzeigen" IsChecked="False" VerticalAlignment="Center" Checked="ShowGanttBars_Changed" Unchecked="ShowGanttBars_Changed"/>
                </StackPanel>
            </Border>

            <!-- Gemeinsame Zeitachse (immer sichtbar) -->
            <Border Grid.Row="1" Background="#f5f5f5" BorderBrush="#e0e0e0" BorderThickness="0,0,0,1">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden">
                    <StackPanel Orientation="Horizontal" Margin="16,8">
                        <TextBlock Text="Dez 2025" FontWeight="Bold" FontSize="11" Width="120" TextAlignment="Center"/>
                        <TextBlock Text="Jan 2026" FontWeight="Bold" FontSize="11" Width="120" TextAlignment="Center"/>
                        <TextBlock Text="Feb 2026" FontWeight="Bold" FontSize="11" Width="120" TextAlignment="Center"/>
                        <TextBlock Text="Mär 2026" FontWeight="Bold" FontSize="11" Width="120" TextAlignment="Center"/>
                        <TextBlock Text="Apr 2026" FontWeight="Bold" FontSize="11" Width="120" TextAlignment="Center"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Gantt Bars (Canvas) - Ein-/Ausblendbar -->
            <Border Grid.Row="2" Background="White" x:Name="GanttBarsContainer" Visibility="Collapsed" BorderBrush="#e0e0e0" BorderThickness="0,0,0,1">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <Canvas Background="White" Height="200" MinHeight="100">
                        <!-- Prozess Alpha Bar -->
                        <Rectangle Canvas.Left="50" Canvas.Top="20" Width="150" Height="30" Fill="#4CAF50" RadiusX="2" RadiusY="2"/>
                        <TextBlock Canvas.Left="60" Canvas.Top="28" FontSize="10" Foreground="White" FontWeight="Bold" Text="Prozess Alpha"/>
                        
                        <!-- Prozess Beta Bar -->
                        <Rectangle Canvas.Left="90" Canvas.Top="70" Width="100" Height="30" Fill="#2196F3" RadiusX="2" RadiusY="2"/>
                        <TextBlock Canvas.Left="100" Canvas.Top="78" FontSize="10" Foreground="White" FontWeight="Bold" Text="Prozess Beta"/>
                        
                        <!-- Prozess Gamma Bar -->
                        <Rectangle Canvas.Left="40" Canvas.Top="120" Width="180" Height="30" Fill="#FF9800" RadiusX="2" RadiusY="2"/>
                        <TextBlock Canvas.Left="50" Canvas.Top="128" FontSize="10" Foreground="White" FontWeight="Bold" Text="Prozess Gamma"/>
                    </Canvas>
                </ScrollViewer>
            </Border>

            <!-- Inhaltsbereich (Liste oder leer) -->
            <ScrollViewer Grid.Row="2" x:Name="ListViewContent" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Visibility="Visible">
                <StackPanel Margin="16">
                    <TextBlock Text="📋 Zeitliche Ereignisse und Prozesse" FontSize="14" FontWeight="Bold" Margin="0,0,0,12"/>
                    <TextBlock Text="Wählen Sie 'Gantt' oben und aktivieren Sie 'Gantt-Balken anzeigen' um das Gantt-Diagramm anzusehen." 
                               FontSize="12"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Gantt-Only View (wenn Gantt-Modus aktiv und Balken angezeigt) -->
            <Border Grid.Row="2" x:Name="GanttOnlyPlaceholder" Visibility="Collapsed" Background="White">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="📊 Gantt-Diagramm" FontSize="16" FontWeight="Bold" Margin="0,0,0,12" HorizontalAlignment="Center"/>
                    <TextBlock Text="Prozesse und ihre zeitlichen Abläufe werden als Balken angezeigt" 
                               FontSize="12"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>