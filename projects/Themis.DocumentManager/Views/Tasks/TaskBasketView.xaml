<UserControl x:Class="Themis.DocumentManager.Views.Tasks.TaskBasketView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.modernwpf.com/2019"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200">
    
    <UserControl.Resources>
        <!-- Converters -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        
        <!-- Priority Colors -->
        <SolidColorBrush x:Key="LowPriorityBrush" Color="#22c55e"/>
        <SolidColorBrush x:Key="NormalPriorityBrush" Color="#3b82f6"/>
        <SolidColorBrush x:Key="HighPriorityBrush" Color="#f97316"/>
        <SolidColorBrush x:Key="UrgentPriorityBrush" Color="#dc2626"/>
        
        <!-- Status Colors -->
        <SolidColorBrush x:Key="PendingBrush" Color="#eab308"/>
        <SolidColorBrush x:Key="InProgressBrush" Color="#3b82f6"/>
        <SolidColorBrush x:Key="CompletedBrush" Color="#22c55e"/>
        <SolidColorBrush x:Key="OverdueBrush" Color="#dc2626"/>
        
        <!-- TreeView Item Template -->
        <HierarchicalDataTemplate x:Key="TaskTreeTemplate">
            <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    CornerRadius="4" Padding="12,8" Margin="0,2"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Checkbox for selection -->
                    <CheckBox Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    
                    <!-- Task Content -->
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock Text="{Binding Description}" FontSize="12" Opacity="0.7" 
                                   TextTrimming="CharacterEllipsis" MaxWidth="400"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{Binding Category}" FontSize="11" Padding="6,2" 
                                       Background="{DynamicResource SystemControlBackgroundAccentBrush}"
                                       Foreground="White" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding DueDate, StringFormat='Fällig: {0:dd.MM.yyyy}'}" 
                                       FontSize="11" Opacity="0.6" VerticalAlignment="Center"
                                       Visibility="{Binding DueDate, Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>
                    </StackPanel>
                    
                    <!-- Priority Indicator -->
                    <Border Grid.Column="2" Width="6" Height="40" CornerRadius="3" Margin="12,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Priority}" Value="Low">
                                        <Setter Property="Background" Value="{StaticResource LowPriorityBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Priority}" Value="Normal">
                                        <Setter Property="Background" Value="{StaticResource NormalPriorityBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Priority}" Value="High">
                                        <Setter Property="Background" Value="{StaticResource HighPriorityBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Priority}" Value="Urgent">
                                        <Setter Property="Background" Value="{StaticResource UrgentPriorityBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    
                    <!-- Status Badge -->
                    <Border Grid.Column="3" Padding="8,4" CornerRadius="12" Margin="8,0,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Pending">
                                        <Setter Property="Background" Value="{StaticResource PendingBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="InProgress">
                                        <Setter Property="Background" Value="{StaticResource InProgressBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Completed">
                                        <Setter Property="Background" Value="{StaticResource CompletedBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Overdue">
                                        <Setter Property="Background" Value="{StaticResource OverdueBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Status}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                    </Border>
                </Grid>
            </Border>
        </HierarchicalDataTemplate>
    </UserControl.Resources>
    
    <Grid Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
        <Grid.ColumnDefinitions>
            <!-- Filter Panel (Resizable) -->
            <ColumnDefinition Width="{Binding FilterPanelWidth, Mode=TwoWay}" 
                              MinWidth="200" MaxWidth="400"/>
            <ColumnDefinition Width="Auto"/>
            <!-- Main Content -->
            <ColumnDefinition Width="*" MinWidth="400"/>
            <ColumnDefinition Width="Auto"/>
            <!-- Detail Panel (Resizable) -->
            <ColumnDefinition Width="{Binding DetailPanelWidth, Mode=TwoWay}" 
                              MinWidth="250" MaxWidth="500"/>
        </Grid.ColumnDefinitions>
        
        <!-- LEFT: Filter Panel -->
        <Border Grid.Column="0" Background="{DynamicResource SystemControlBackgroundAltMediumLowBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" 
                BorderThickness="0,0,1,0"
                Visibility="{Binding IsFilterPanelVisible, Converter={StaticResource BoolToVisibility}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16">
                    <TextBlock Text="Aufgaben-Korb" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,20"/>
                    
                    <!-- Search Box -->
                    <TextBlock Text="Suche" FontSize="12" Opacity="0.7" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                             ui:ControlHelper.PlaceholderText="Aufgaben durchsuchen..." Margin="0,0,0,16"/>
                    
                    <!-- Status Filter -->
                    <TextBlock Text="Status" FontSize="12" Opacity="0.7" Margin="0,0,0,4"/>
                    <ComboBox SelectedItem="{Binding StatusFilter}" Margin="0,0,0,16">
                        <ComboBoxItem Content="Alle" Tag="{x:Null}"/>
                        <ComboBoxItem Content="Ausstehend" Tag="Pending"/>
                        <ComboBoxItem Content="In Bearbeitung" Tag="InProgress"/>
                        <ComboBoxItem Content="Erledigt" Tag="Completed"/>
                        <ComboBoxItem Content="Überfällig" Tag="Overdue"/>
                    </ComboBox>
                    
                    <!-- Priority Filter -->
                    <TextBlock Text="Priorität" FontSize="12" Opacity="0.7" Margin="0,0,0,4"/>
                    <ComboBox SelectedItem="{Binding PriorityFilter}" Margin="0,0,0,16">
                        <ComboBoxItem Content="Alle" Tag="{x:Null}"/>
                        <ComboBoxItem Content="Niedrig" Tag="Low"/>
                        <ComboBoxItem Content="Normal" Tag="Normal"/>
                        <ComboBoxItem Content="Hoch" Tag="High"/>
                        <ComboBoxItem Content="Dringend" Tag="Urgent"/>
                    </ComboBox>
                    
                    <!-- Category Filter -->
                    <TextBlock Text="Kategorie" FontSize="12" Opacity="0.7" Margin="0,0,0,4"/>
                    <ComboBox SelectedItem="{Binding CategoryFilter}" Margin="0,0,0,16">
                        <ComboBoxItem Content="Alle" Tag=""/>
                        <ComboBoxItem Content="Posteingang" Tag="Posteingang"/>
                        <ComboBoxItem Content="Wiedervorlage" Tag="Wiedervorlage"/>
                        <ComboBoxItem Content="Mitzeichnung" Tag="Mitzeichnung"/>
                    </ComboBox>
                    
                    <!-- Group By -->
                    <TextBlock Text="Gruppierung" FontSize="12" Opacity="0.7" Margin="0,0,0,4"/>
                    <ComboBox SelectedItem="{Binding GroupBy}" Margin="0,0,0,16">
                        <ComboBoxItem Content="Keine" Tag="None"/>
                        <ComboBoxItem Content="Kategorie" Tag="Category"/>
                        <ComboBoxItem Content="Priorität" Tag="Priority"/>
                        <ComboBoxItem Content="Status" Tag="Status"/>
                        <ComboBoxItem Content="Fälligkeitsdatum" Tag="DueDate"/>
                    </ComboBox>
                    
                    <!-- Sort By -->
                    <TextBlock Text="Sortierung" FontSize="12" Opacity="0.7" Margin="0,0,0,4"/>
                    <ComboBox SelectedItem="{Binding SortBy}" Margin="0,0,0,8">
                        <ComboBoxItem Content="Fälligkeitsdatum" Tag="DueDate"/>
                        <ComboBoxItem Content="Priorität" Tag="Priority"/>
                        <ComboBoxItem Content="Erstellt" Tag="CreatedDate"/>
                        <ComboBoxItem Content="Titel" Tag="Title"/>
                        <ComboBoxItem Content="Kategorie" Tag="Category"/>
                    </ComboBox>
                    
                    <CheckBox Content="Absteigend" IsChecked="{Binding SortDescending}" Margin="0,0,0,16"/>
                    <CheckBox Content="Erledigte anzeigen" IsChecked="{Binding ShowCompleted}" Margin="0,0,0,16"/>
                    
                    <!-- Action Buttons -->
                    <Button Content="Filter anwenden" Command="{Binding ApplyFiltersCommand}" 
                            Margin="0,0,0,8" HorizontalAlignment="Stretch"/>
                    <Button Content="Filter zurücksetzen" Command="{Binding ClearFiltersCommand}" 
                            HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
        
        <!-- GridSplitter for Filter Panel -->
        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                      Background="Transparent"
                      Visibility="{Binding IsFilterPanelVisible, Converter={StaticResource BoolToVisibility}}"/>
        
        <!-- CENTER: Task List/TreeView -->
        <Grid Grid.Column="2" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Toolbar -->
            <Border Grid.Row="0" Background="{DynamicResource SystemControlBackgroundAltMediumLowBrush}"
                    Padding="12,8" CornerRadius="4" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Orientation="Horizontal">
                        <Button Content="↻ Aktualisieren" Command="{Binding LoadTasksCommand}" 
                                Padding="12,6" Margin="0,0,8,0"/>
                        <Button Content="✓ Erledigt markieren" Command="{Binding MarkTasksCompletedCommand}" 
                                Padding="12,6" Margin="0,0,8,0"/>
                        <Button Content="🗑 Löschen" Command="{Binding DeleteSelectedTasksCommand}" 
                                Padding="12,6"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <ToggleButton Content="🌲 Baum" IsChecked="{Binding IsTreeViewMode}" 
                                      Padding="12,6" Margin="0,0,8,0"/>
                        <Button Content="⚙ Ansicht" Padding="12,6">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Filter-Panel anzeigen" IsCheckable="True" 
                                              IsChecked="{Binding IsFilterPanelVisible}"/>
                                    <MenuItem Header="Detail-Panel anzeigen" IsCheckable="True" 
                                              IsChecked="{Binding IsDetailPanelVisible}"/>
                                    <Separator/>
                                    <MenuItem Header="Gruppierung umschalten" Command="{Binding ToggleGroupByCommand}"/>
                                    <MenuItem Header="Sortierung umschalten" Command="{Binding ToggleSortOrderCommand}"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- Summary Bar -->
            <Border Grid.Row="1" Background="{DynamicResource SystemControlBackgroundAccentBrush}"
                    Padding="12,6" CornerRadius="4" Margin="0,0,0,12">
                <TextBlock Foreground="White" FontSize="13">
                    <Run Text="{Binding Tasks.Count, Mode=OneWay}"/>
                    <Run Text="Aufgaben"/>
                    <Run Text=" • "/>
                    <Run Text="{Binding SelectedTasks.Count, Mode=OneWay}"/>
                    <Run Text="ausgewählt"/>
                </TextBlock>
            </Border>
            
            <!-- TreeView (Grouped) -->
            <TreeView Grid.Row="2" ItemsSource="{Binding TasksView.Groups}"
                      Visibility="{Binding IsTreeViewMode, Converter={StaticResource BoolToVisibility}}"
                      AllowDrop="True">
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Items}">
                        <Border Background="{DynamicResource SystemControlBackgroundAccentBrush}"
                                Padding="12,8" CornerRadius="4" Margin="0,4">
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="White"/>
                        </Border>
                        <HierarchicalDataTemplate.ItemTemplate>
                            <DataTemplate>
                                <ContentPresenter Content="{Binding}" 
                                                  ContentTemplate="{StaticResource TaskTreeTemplate}"/>
                            </DataTemplate>
                        </HierarchicalDataTemplate.ItemTemplate>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
            
            <!-- ListView (Flat) -->
            <ListView Grid.Row="2" ItemsSource="{Binding Tasks}"
                      SelectedItem="{Binding SelectedTask}"
                      SelectionMode="Multiple"
                      Visibility="{Binding IsTreeViewMode, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}"
                      ItemTemplate="{StaticResource TaskTreeTemplate}"
                      AllowDrop="True"/>
            
            <!-- Loading Overlay -->
            <Border Grid.Row="2" Background="#80000000" 
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ui:ProgressRing IsActive="True" Width="60" Height="60"/>
                    <TextBlock Text="Lade Aufgaben..." Foreground="White" 
                               FontSize="16" Margin="0,16,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
        
        <!-- GridSplitter for Detail Panel -->
        <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                      Background="Transparent"
                      Visibility="{Binding IsDetailPanelVisible, Converter={StaticResource BoolToVisibility}}"/>
        
        <!-- RIGHT: Detail Panel -->
        <Border Grid.Column="4" Background="{DynamicResource SystemControlBackgroundAltMediumLowBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" 
                BorderThickness="1,0,0,0"
                Visibility="{Binding IsDetailPanelVisible, Converter={StaticResource BoolToVisibility}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16" DataContext="{Binding SelectedTask}">
                    <TextBlock Text="Aufgaben-Details" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,20"/>
                    
                    <TextBlock Text="Kein Aufgabe ausgewählt" FontSize="14" Opacity="0.6"
                               Visibility="{Binding Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}"/>
                    
                    <StackPanel Visibility="{Binding Converter={StaticResource BoolToVisibility}}">
                        <!-- Title -->
                        <TextBlock Text="Titel" FontSize="12" Opacity="0.7" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" 
                                   TextWrapping="Wrap" Margin="0,0,0,16"/>
                        
                        <!-- Description -->
                        <TextBlock Text="Beschreibung" FontSize="12" Opacity="0.7" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding Description}" FontSize="14" 
                                   TextWrapping="Wrap" Margin="0,0,0,16"/>
                        
                        <!-- Category -->
                        <TextBlock Text="Kategorie" FontSize="12" Opacity="0.7" Margin="0,0,0,4"/>
                        <Border Background="{DynamicResource SystemControlBackgroundAccentBrush}"
                                Padding="8,4" CornerRadius="4" HorizontalAlignment="Left" Margin="0,0,0,16">
                            <TextBlock Text="{Binding Category}" Foreground="White" FontWeight="SemiBold"/>
                        </Border>
                        
                        <!-- Priority -->
                        <TextBlock Text="Priorität" FontSize="12" Opacity="0.7" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding Priority}" FontSize="14" Margin="0,0,0,16"/>
                        
                        <!-- Status -->
                        <TextBlock Text="Status" FontSize="12" Opacity="0.7" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding Status}" FontSize="14" Margin="0,0,0,16"/>
                        
                        <!-- Due Date -->
                        <TextBlock Text="Fällig am" FontSize="12" Opacity="0.7" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding DueDate, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" 
                                   FontSize="14" Margin="0,0,0,16"/>
                        
                        <!-- Created Date -->
                        <TextBlock Text="Erstellt am" FontSize="12" Opacity="0.7" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" 
                                   FontSize="14" Margin="0,0,0,16"/>
                        
                        <!-- Actions -->
                        <Button Content="Aufgabe öffnen" Command="{Binding DataContext.OpenTaskCommand, 
                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" Margin="0,16,0,0"
                                HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
