<UserControl x:Class="Themis.DocumentManager.Views.UserSwitcherView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Current User Header -->
        <Border Grid.Row="0" Background="#f5f5f5" BorderBrush="#e0e0e0" BorderThickness="0,0,0,1" Padding="12,8">
            <StackPanel>
                <TextBlock Text="👤 Benutzer" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                
                <!-- Current User Display -->
                <Border Background="White" BorderBrush="#d0d0d0" BorderThickness="1" CornerRadius="3" Padding="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentUser.DisplayName}" FontSize="10" FontWeight="Bold" Foreground="#333"/>
                            <TextBlock Text="{Binding CurrentUser.Role}" FontSize="9" Foreground="#999" Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding CurrentUser.Department}" FontSize="8" Foreground="#ccc" Margin="0,1,0,0"/>
                        </StackPanel>
                        
                        <Button Grid.Column="1" Content="🔄" Width="24" Height="24" FontSize="10" Padding="0" 
                                Margin="4,0,0,0" ToolTip="Wechseln..." VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- Available Users List -->
        <Border Grid.Row="1" Background="White" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Verfügbare Benutzer" FontSize="10" FontWeight="Bold" 
                           Margin="0,0,0,8" Foreground="#666"/>

                <!-- Loading Indicator -->
                <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="2" 
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                            Margin="0,0,0,8"/>

                <!-- Users ListBox -->
                <ListBox Grid.Row="1" ItemsSource="{Binding AvailableUsers}" 
                        BorderThickness="0" Background="Transparent"
                        ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" Margin="0,2" BorderBrush="#e8e8e8" 
                                   BorderThickness="0,0,0,1" Padding="8,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- User Info -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="10" FontWeight="SemiBold" Foreground="#333"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="{Binding Role}" FontSize="8" Foreground="#666" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding Department}" FontSize="8" Foreground="#999"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Switch Button -->
                                    <Button Grid.Column="1" Content="→" Width="28" Height="28" FontSize="10" 
                                           Padding="0" VerticalAlignment="Center"
                                           Command="{Binding DataContext.SwitchUserCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                           CommandParameter="{Binding .}"
                                           ToolTip="Zu diesem Benutzer wechseln"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
