<!-- LEFT SIDEBAR WITH TAB-VIEW (Outlook-style notifications) -->
<Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" 
        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,1,0">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Tab Headers with Outlook-style unread count -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" 
                BorderThickness="0,0,0,1" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="SidebarTabNavigation" GroupName="SidebarTabs" 
                             IsChecked="True" Style="{StaticResource {x:Type ToggleButton}}" 
                             Padding="16,8" FontSize="12" Click="SidebarTab_Click">
                    <TextBlock Text="Navigation"/>
                </RadioButton>
                
                <RadioButton x:Name="SidebarTabTasks" GroupName="SidebarTabs" 
                             Style="{StaticResource {x:Type ToggleButton}}" 
                             Padding="16,8" FontSize="12" Click="SidebarTab_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Aufgaben">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Normal"/>
                                    <Style.Triggers>
                                        <!-- Bold when unread tasks exist (Outlook-style) -->
                                        <DataTrigger Binding="{Binding TaskBasketViewModel.HasUnreadTasks}" 
                                                     Value="True">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        
                        <!-- Unread count in parentheses (Outlook-style) -->
                        <TextBlock Margin="4,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundAccentBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TaskBasketViewModel.HasUnreadTasks}" 
                                                     Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                            <Run Text="("/><Run Text="{Binding TaskBasketViewModel.UnreadTasksCount, Mode=OneWay}"/><Run Text=")"/>
                        </TextBlock>
                    </StackPanel>
                </RadioButton>
                
                <RadioButton x:Name="SidebarTabFavorites" Content="Favoriten" GroupName="SidebarTabs" 
                             Style="{StaticResource {x:Type ToggleButton}}" 
                             Padding="16,8" FontSize="12" Click="SidebarTab_Click"/>
            </StackPanel>
        </Border>
        
        <!-- Tab Content -->
        <Grid Grid.Row="1">
            <!-- Navigation Tab Content -->
            <ScrollViewer x:Name="NavigationTabContent" VerticalScrollBarVisibility="Auto" 
                          Visibility="Visible" Padding="10">
                <StackPanel>
                    <TextBlock Text="Navigation" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TreeView>
                        <TreeViewItem Header="📊 Dashboard" IsExpanded="False"/>
                        <TreeViewItem Header="📄 Dokumente" IsExpanded="True">
                            <TreeViewItem Header="Meine Dokumente"/>
                            <TreeViewItem Header="Zuletzt verwendet"/>
                            <TreeViewItem Header="Favoriten"/>
                        </TreeViewItem>
                        <TreeViewItem Header="📂 Projekte">
                            <TreeViewItem Header="Aktive Projekte"/>
                            <TreeViewItem Header="Archivierte Projekte"/>
                        </TreeViewItem>
                        <TreeViewItem Header="📅 Wiedervorlagen"/>
                        <TreeViewItem Header="✍️ Mitzeichnungen"/>
                    </TreeView>
                </StackPanel>
            </ScrollViewer>
            
            <!-- Tasks Tab Content (Task Basket) -->
            <ContentControl x:Name="TasksTabContent" Visibility="Collapsed"/>
            
            <!-- Favorites Tab Content -->
            <ContentControl x:Name="FavoritesTabContent" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Border>
