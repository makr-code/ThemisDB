    private readonly MetadataLayoutService _metadataLayoutService;
    private readonly MetadataBindingService _metadataBindingService;
    private string? _currentDocumentId;
    private bool _isFullscreen = false;
    private WindowState _previousWindowState;
    private WindowStyle _previousWindowStyle;
    private DateTime _timelineStartDate = DateTime.Now.AddMonths(-1);
    private DateTime _timelineEndDate = DateTime.Now.AddMonths(1);
    private double _pixelsPerDay = 40; // 40 pixels pro Tag (skalierbar)
    private Dictionary<TabItem, bool> _tabChanges = new(); // Track unsaved changes per tab
    private Dictionary<TabItem, DocumentMetadata> _tabMetadata = new(); // Store metadata per tab
    private TreeViewItem? _contextMenuTreeViewItem; // Item für Kontextmenü-Operationen
    private KeyboardShortcutService _shortcutService = KeyboardShortcutService.Instance;

    public MainWindow(
        MainViewModel viewModel,
        IOfficeIntegrationService officeService,
        IThemeService themeService,
        ISettingsService settingsService,
        IAnimationService animationService,
        AIChatViewModel aiChatViewModel,
        StatusMonitorService statusMonitor,
        IFormTemplateService? formTemplateService = null)
    {
        try
        {
            InitializeComponent();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.ToString());
            throw;
        }
        _viewModel = viewModel;
        _officeService = officeService;
        _themeService = themeService;
        _settingsService = settingsService;
        _animationService = animationService;
        _aiChatViewModel = aiChatViewModel;
        _formTemplateService = formTemplateService;
        _stateService = new ApplicationStateService();
        _metadataLayoutService = new MetadataLayoutService();
        
        // Plugin-Service initialisieren und Standard-Plugins registrieren
        _pluginService = new FilePreviewPluginService();
        _pluginService.RegisterPlugin(new TextFilePreviewPlugin());
        _pluginService.RegisterPlugin(new ImageFilePreviewPlugin());
        _pluginService.RegisterPlugin(new PdfPreviewPlugin());
        _pluginService.RegisterPlugin(new MsgPreviewPlugin());
        
        // StatusMonitor per DI injizieren
        _statusMonitor = statusMonitor ?? throw new ArgumentNullException(nameof(statusMonitor));
        _statusMonitor.PropertyChanged += StatusMonitor_PropertyChanged;
        
        // Metadata Services initialisieren
        _metadataLayoutService = new MetadataLayoutService();
        _metadataBindingService = new MetadataBindingService();
        _currentDocumentId = null;        // Fenster schließen - Zustand speichern
        Closing += (s, e) =>
        {
            SaveApplicationState();
            _statusMonitor?.StopMonitoring();
            _statusMonitor?.Dispose();
        };

        InitializeShortcuts();
    }

    private void LoadShortcutSettings()
    {
        try
        {
            var converter = new KeyGestureConverter();
            string? s;
            s = _settingsService.GetSetting("Shortcut.SaveMetadata", (string?)null);
            if (!string.IsNullOrWhiteSpace(s))
                _shortcutService.UpdateShortcut("SaveMetadata", (KeyGesture)converter.ConvertFromString(s));

            s = _settingsService.GetSetting("Shortcut.ReloadMetadata", (string?)null);
            if (!string.IsNullOrWhiteSpace(s))
                _shortcutService.UpdateShortcut("ReloadMetadata", (KeyGesture)converter.ConvertFromString(s));

            s = _settingsService.GetSetting("Shortcut.FinalizeMetadata", (string?)null);
            if (!string.IsNullOrWhiteSpace(s))
                _shortcutService.UpdateShortcut("FinalizeMetadata", (KeyGesture)converter.ConvertFromString(s));

            s = _settingsService.GetSetting("Shortcut.OpenSettings", (string?)null);
            if (!string.IsNullOrWhiteSpace(s))
                _shortcutService.UpdateShortcut("OpenSettings", (KeyGesture)converter.ConvertFromString(s));

            s = _settingsService.GetSetting("Shortcut.CloseTab", (string?)null);
            if (!string.IsNullOrWhiteSpace(s))
                _shortcutService.UpdateShortcut("CloseTab", (KeyGesture)converter.ConvertFromString(s));

            s = _settingsService.GetSetting("Shortcut.DuplicateTab", (string?)null);
            if (!string.IsNullOrWhiteSpace(s))
                _shortcutService.UpdateShortcut("DuplicateTab", (KeyGesture)converter.ConvertFromString(s));

            s = _settingsService.GetSetting("Shortcut.SwitchSidebarGraph", (string?)null);
            if (!string.IsNullOrWhiteSpace(s))
                _shortcutService.UpdateShortcut("SwitchSidebarGraph", (KeyGesture)converter.ConvertFromString(s));

            s = _settingsService.GetSetting("Shortcut.SwitchSidebarMap", (string?)null);
            if (!string.IsNullOrWhiteSpace(s))
                _shortcutService.UpdateShortcut("SwitchSidebarMap", (KeyGesture)converter.ConvertFromString(s));
            s = _settingsService.GetSetting("Shortcut.CloseOthers", (string?)null);
            if (!string.IsNullOrWhiteSpace(s))
                _shortcutService.UpdateShortcut("CloseOthers", (KeyGesture)converter.ConvertFromString(s));

            s = _settingsService.GetSetting("Shortcut.SearchTabs", (string?)null);
            if (!string.IsNullOrWhiteSpace(s))
                _shortcutService.UpdateShortcut("SearchTabs", (KeyGesture)converter.ConvertFromString(s));

            s = _settingsService.GetSetting("Shortcut.OpenTabInNewWindow", (string?)null);
            if (!string.IsNullOrWhiteSpace(s))
                _shortcutService.UpdateShortcut("OpenTabInNewWindow", (KeyGesture)converter.ConvertFromString(s));

            s = _settingsService.GetSetting("Shortcut.FavoriteAdd", (string?)null);
            if (!string.IsNullOrWhiteSpace(s))
                _shortcutService.UpdateShortcut("FavoriteAdd", (KeyGesture)converter.ConvertFromString(s));

            s = _settingsService.GetSetting("Shortcut.FavoriteRemove", (string?)null);
            if (!string.IsNullOrWhiteSpace(s))
                _shortcutService.UpdateShortcut("FavoriteRemove", (KeyGesture)converter.ConvertFromString(s));
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
        }
    }

    private void StatusMonitor_PropertyChanged(object? sender, System.ComponentModel.PropertyChangedEventArgs e)
    {
        Dispatcher.InvokeAsync(() =>
        {
            switch (e.PropertyName)
            {
                case nameof(StatusMonitorService.ThemisDbStatus):
                    ThemisDbStatusText.Text = _statusMonitor.ThemisDbStatus;
                    break;

                case nameof(StatusMonitorService.OllamaStatus):
                    OllamaStatusText.Text = _statusMonitor.OllamaStatus;
                    break;

                case nameof(StatusMonitorService.LastThemisCheck):
                    if (_statusMonitor.LastThemisCheck != DateTime.MinValue)
                    {
                        ThemisDbLastCheckText.Text = $"({_statusMonitor.LastThemisCheck:HH:mm:ss})";
                    }
                    break;

                case nameof(StatusMonitorService.LastOllamaCheck):
                    if (_statusMonitor.LastOllamaCheck != DateTime.MinValue)
                    {
                        OllamaLastCheckText.Text = $"({_statusMonitor.LastOllamaCheck:HH:mm:ss})";
                    }
                    break;
            }
        });
    }

    private void InitializeShortcuts()
    {
        LoadShortcutSettings();
        ApplyShortcuts();
        _shortcutService.ShortcutsChanged += (_, __) => ApplyShortcuts();
    }

    private void ApplyShortcuts()
    {
        try
        {
            InputBindings.Clear();
            CommandBindings.Clear();

            AddBinding(_shortcutService.Shortcuts["OpenSettings"], _viewModel.OpenSettingsCommand);
            AddBinding(_shortcutService.Shortcuts["NextTab"], _viewModel.NextTabCommand);
            AddBinding(_shortcutService.Shortcuts["PreviousTab"], _viewModel.PreviousTabCommand);
            AddBinding(_shortcutService.Shortcuts["OpenSearch"], _viewModel.OpenSearchCommand);
            AddBinding(_shortcutService.Shortcuts["ToggleTheme"], _viewModel.ToggleThemeCommand);

            AddBinding(_shortcutService.Shortcuts["SaveMetadata"], new RoutedCommand(), SaveMetadataBtn_Click);
            AddBinding(_shortcutService.Shortcuts["ReloadMetadata"], new RoutedCommand(), ReloadMetadataBtn_Click);
            AddBinding(_shortcutService.Shortcuts["FinalizeMetadata"], new RoutedCommand(), FinalizeMetadataBtn_Click);

            // Tab management
            AddBinding(_shortcutService.Shortcuts["CloseTab"], new RoutedCommand(), (s, e) => TabManagement_CloseAll(s, e));
            AddBinding(_shortcutService.Shortcuts["DuplicateTab"], new RoutedCommand(), (s, e) => TabManagement_Duplicate(s, e));

            // Sidebar visualization switching
            AddBinding(_shortcutService.Shortcuts["SwitchSidebarGraph"], new RoutedCommand(), (s, e) => SetVisualizationTab(graph:true));
            AddBinding(_shortcutService.Shortcuts["SwitchSidebarMap"], new RoutedCommand(), (s, e) => SetVisualizationTab(graph:false));

            // Tab operations: new window and favorites
            AddBinding(_shortcutService.Shortcuts["OpenTabInNewWindow"], new RoutedCommand(), (s, e) => TabManagement_NewWindow(s, e));
            AddBinding(_shortcutService.Shortcuts["FavoriteAdd"], new RoutedCommand(), (s, e) => TabFavorite_Add(s, e));
            AddBinding(_shortcutService.Shortcuts["FavoriteRemove"], new RoutedCommand(), (s, e) => TabFavorite_Remove(s, e));

            // Close others and search tabs
            AddBinding(_shortcutService.Shortcuts["CloseOthers"], new RoutedCommand(), (s, e) => TabManagement_CloseOthers(s, e));
            AddBinding(_shortcutService.Shortcuts["SearchTabs"], new RoutedCommand(), (s, e) => TabSearch_Click(s, e));
            AddBinding(_shortcutService.Shortcuts["ShowShortcutsOverlay"], new RoutedCommand(), (s, e) => ShowShortcutsOverlay());
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
        }
    }

    private void ShowShortcutsOverlay()
    {
        try
        {
            var dlg = new ShortcutsOverlay
            {
                Owner = this
            };
            dlg.ShowDialog();
        }
        catch { }
    }

    private void SetVisualizationTab(bool graph)
    {
        try
        {
            if (graph)
            {
                VisualizationTabGraph.IsChecked = true;
                GraphContent.Visibility = Visibility.Visible;
                MapContent.Visibility = Visibility.Collapsed;
            }
            else
            {
                VisualizationTabMap.IsChecked = true;
                GraphContent.Visibility = Visibility.Collapsed;
                MapContent.Visibility = Visibility.Visible;
            }
        }
        catch { }
    }

    private void AddBinding(KeyGesture gesture, ICommand command)
    {
        InputBindings.Add(new KeyBinding(command, gesture));
    }

    private void AddBinding(KeyGesture gesture, RoutedCommand routedCommand, ExecutedRoutedEventHandler handler)
    {
        CommandBindings.Add(new CommandBinding(routedCommand, handler));
        InputBindings.Add(new KeyBinding(routedCommand, gesture));
    }

    private void WireChatViews()
    {
        if (FindName("CenterAIChatView") is AIChatView centerChat)
        {
            centerChat.DataContext = _aiChatViewModel;
        }
        if (FindName("SidebarAIChatView") is AIChatView sidebarChat)
        {
            sidebarChat.DataContext = _aiChatViewModel;
        }
    }

    private void InitializeMetadataForm()
    {
        try
        {
            var layout = _metadataLayoutService.LoadLayout();
            if (FindName("MetadataForm") is UI.MetadataFormView formView)
            {
                // Temporäres Binding, bis echte Dokumentbindung vorhanden ist
                var testData = new ThemisTestDataGenerator();
                var binding = testData.GenerateMetadata();
                var groups = _metadataLayoutService.BuildGroups(binding, layout);
                formView.LoadMetadata(groups);
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Metadata form init failed: {ex.Message}");
        }
    }

    private void UpdateMetadataForm(string documentTag, string documentHeader)
    {
        try
        {
            // Setze aktuelles Dokument
            _currentDocumentId = documentTag;

            var layout = _metadataLayoutService.LoadLayout();
            if (FindName("MetadataForm") is UI.MetadataFormView formView)
            {
                // Lade echtes Binding für dieses Dokument
                var binding = _metadataBindingService.GetOrCreateBinding(documentTag);
                
                // Update Form
                var groups = _metadataLayoutService.BuildGroups(binding, layout);
                formView.LoadMetadata(groups);

                // Wire Events für Feldänderungen
                WireFormEvents(formView, binding);
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Metadata accordion update failed: {ex.Message}");
        }
    }

    private void WireFormEvents(UI.MetadataFormView formView, DocumentMetadataBinding binding)
    {
        // Event-Handler für Feld-Änderungen
        formView.FieldValueChanged += async (s, e) =>
        {
            if (e.Field != null && _currentDocumentId != null)
            {
                var success = await _metadataBindingService.UpdateFieldAsync(
                    _currentDocumentId, 
                    e.Field.FieldName, 
                    e.NewValue ?? string.Empty);

                if (!success)
                {
                    System.Diagnostics.Debug.WriteLine($"Failed to save field: {e.Field.FieldName}");
                }
            }
        };
    }

    private async void SaveMetadataBtn_Click(object sender, RoutedEventArgs e)
    {
        try
        {
            if (_currentDocumentId == null)
                return;

            var formView = FindName("MetadataForm") as UI.MetadataFormView;
            if (formView == null)
                return;

            // Validierung
            var (isValid, errors) = formView.ValidateAllFields();
            if (!isValid)
            {
                var errorMsg = string.Join("\n", errors.Take(10));
                if (errors.Count > 10)
                    errorMsg += $"\n... und {errors.Count - 10} weitere";

                var result = MessageBox.Show(
                    $"Folgende erforderliche Felder fehlen:\n\n{errorMsg}\n\nTrotzdem speichern?",
                    "Validierungsfehler",
                    MessageBoxButton.YesNo,
                    MessageBoxImage.Warning
                );

                if (result != MessageBoxResult.Yes)
                    return;
            }

            var binding = _metadataBindingService.GetOrCreateBinding(_currentDocumentId);
            var success = await _metadataBindingService.SaveBindingAsync(binding);

            if (success)
            {
                // Exportiere Metadaten
                var metadata = formView.ExportMetadata();

                MessageBox.Show(
                    $"Metadaten für '{_currentDocumentId}' erfolgreich gespeichert.\n" +
                    $"({metadata.Count} Felder)",
                    "Speichern erfolgreich",
                    MessageBoxButton.OK,
                    MessageBoxImage.Information
                );
            }
            else
            {
                MessageBox.Show(
                    "Fehler beim Speichern der Metadaten.",
                    "Fehler",
                    MessageBoxButton.OK,
                    MessageBoxImage.Error
                );
            }
        }
        catch (Exception ex)
        {
            MessageBox.Show(
                $"Fehler: {ex.Message}",
                "Fehler",
                MessageBoxButton.OK,
                MessageBoxImage.Error
            );
        }
    }

    private void ReloadMetadataBtn_Click(object sender, RoutedEventArgs e)
    {
        try
        {
            if (_currentDocumentId == null)
                return;

            // Cache invalidieren und neu laden
            _metadataBindingService.InvalidateCache(_currentDocumentId);

            var layout = _metadataLayoutService.LoadLayout();
            if (FindName("MetadataForm") is UI.MetadataFormView formView)
            {
                var binding = _metadataBindingService.GetOrCreateBinding(_currentDocumentId);
                var groups = _metadataLayoutService.BuildGroups(binding, layout);
                formView.LoadMetadata(groups);
                WireFormEvents(formView, binding);
            }

            MessageBox.Show(
                "Metadaten neu geladen.",
                "Neu geladen",
                MessageBoxButton.OK,
                MessageBoxImage.Information
            );
        }
        catch (Exception ex)
        {
            MessageBox.Show(
                $"Fehler beim Neuladen: {ex.Message}",
                "Fehler",
                MessageBoxButton.OK,
                MessageBoxImage.Error
            );
        }
    }

    private async void FinalizeMetadataBtn_Click(object sender, RoutedEventArgs e)
    {
        try
        {
            if (_currentDocumentId == null)
                return;

            var result = MessageBox.Show(
                $"Möchten Sie die Metadaten für '{_currentDocumentId}' finalisieren?\n\nDies sperrt das Dokument gegen weitere Änderungen.",
                "Finalisieren bestätigen",
                MessageBoxButton.YesNo,
                MessageBoxImage.Question
            );

            if (result == MessageBoxResult.Yes)
            {
                var success = await _metadataBindingService.FinalizeBindingAsync(_currentDocumentId);

                if (success)
                {
                    MessageBox.Show(
                        $"Metadaten für '{_currentDocumentId}' wurden finalisiert.",
                        "Finalisierung erfolgreich",
                        MessageBoxButton.OK,
                        MessageBoxImage.Information
                    );

                    // Reload zur Anzeige des neuen Status
                    ReloadMetadataBtn_Click(null!, null!);
                }
                else
                {
                    MessageBox.Show(
                        "Fehler beim Finalisieren der Metadaten.",
                        "Fehler",
                        MessageBoxButton.OK,
                        MessageBoxImage.Error
                    );
                }
            }
        }
        catch (Exception ex)
        {
            MessageBox.Show(
                $"Fehler: {ex.Message}",
                "Fehler",
                MessageBoxButton.OK,
                MessageBoxImage.Error
            );
        }
    }

