<UserControl x:Class="Themis.DocumentManager.Views.GraphView3D"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F5F5">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <!-- DirectX Render Surface -->
        <Border x:Name="RenderSurface" 
                Grid.Row="0" 
                Background="#1E1E1E"
                BorderBrush="#CCCCCC"
                BorderThickness="1"/>

        <!-- Status Bar -->
        <Border Grid.Row="1" Background="#EEEEEE" BorderBrush="#CCCCCC" BorderThickness="0,1,0,0">
            <Grid Margin="10,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusText" 
                           Grid.Column="0"
                           Text="Initializing DirectX 11..."
                           VerticalAlignment="Center"
                           FontSize="12"/>

                <TextBlock Grid.Column="1" 
                           Text="Drag: Rotate | Wheel: Zoom"
                           Margin="20,0,0,0"
                           Foreground="#666666"
                           FontSize="11"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
