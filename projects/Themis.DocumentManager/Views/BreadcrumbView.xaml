<UserControl x:Class="Themis.DocumentManager.Views.BreadcrumbView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#f8fafc" MinHeight="36">
    <Border BorderBrush="#334155" BorderThickness="0,0,0,1" Padding="12,8">
        <Grid>
            <!-- Fallback wenn keine Breadcrumbs vorhanden -->
            <TextBlock x:Name="FallbackText" 
                      Text="📁 Startseite" 
                      FontSize="12" 
                      Foreground="#64748b"
                      VerticalAlignment="Center"
                      Visibility="Visible">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <!-- Verstecke Fallback, wenn Breadcrumbs vorhanden sind -->
                            <DataTrigger Binding="{Binding ElementName=BreadcrumbItems, Path=HasItems}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            
            <ItemsControl ItemsSource="{Binding BreadcrumbPath}" x:Name="BreadcrumbItems">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,0,4,0">
                            <!-- Breadcrumb Item Button -->
                            <Button Background="Transparent" 
                                    BorderThickness="0"
                                    Padding="4,2"
                                    Command="{Binding DataContext.NavigateToCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding .}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Icon}" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Title}" FontSize="12" Foreground="#475569" FontWeight="Medium" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            
                            <!-- Separator (›) -->
                            <TextBlock Text="›" FontSize="14" Foreground="#94a3b8" Margin="4,0,4,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Border>
</UserControl>
