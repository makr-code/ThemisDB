<UserControl x:Class="Themis.DocumentManager.Views.Navigation.TimelineRulerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:Themis.DocumentManager.Converters"
             Height="60" Background="White">
    
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:ScaleToStringConverter x:Key="ScaleToStringConverter"/>
    </UserControl.Resources>
    
    <Border BorderBrush="#e2e8f0" BorderThickness="0,0,0,1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <!-- Controls Left -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center">
                <Button Content="◀" Width="24" Height="24" Margin="0,0,4,0" 
                        Command="{Binding NavigatePreviousCommand}" 
                        ToolTip="Vorheriger Zeitraum"/>
                <TextBlock Text="{Binding CurrentDateRange}" 
                           VerticalAlignment="Center" 
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="#475569" Margin="4,0"/>
                <Button Content="▶" Width="24" Height="24" Margin="4,0,8,0"
                        Command="{Binding NavigateNextCommand}"
                        ToolTip="Nächster Zeitraum"/>
                <Button Content="📅" Width="24" Height="24" 
                        Command="{Binding JumpToTodayCommand}"
                        ToolTip="Heute"/>
            </StackPanel>
            
            <!-- Timeline Ruler Canvas -->
            <Canvas Grid.Column="1" Background="#fafafa" ClipToBounds="True" Margin="0,8,0,8">
                <!-- Background grid lines (subtle) -->
                <ItemsControl ItemsSource="{Binding RulerTicks}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <!-- Tick mark -->
                                <Line X1="{Binding PositionX}" Y1="0" 
                                      X2="{Binding PositionX}" Y2="{Binding TickHeight}"
                                      Stroke="#cbd5e1" StrokeThickness="1"/>
                                <!-- Date label (only for major ticks) -->
                                <TextBlock Text="{Binding Label}" 
                                           Canvas.Left="{Binding LabelPositionX}"
                                           Canvas.Top="2"
                                           FontSize="9" Foreground="#64748b"
                                           Visibility="{Binding IsMajor, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                
                <!-- Process bars (compact) -->
                <ItemsControl ItemsSource="{Binding CompactProcessBars}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{Binding Color}" 
                                    Height="4" 
                                    CornerRadius="2"
                                    Canvas.Left="{Binding StartX}"
                                    Canvas.Top="20"
                                    Width="{Binding Width}"
                                    ToolTip="{Binding ProcessName}"
                                    Opacity="0.7"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                
                <!-- Event markers (termine, milestones) -->
                <ItemsControl ItemsSource="{Binding EventMarkers}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{Binding Color}"
                                    Width="6" Height="6"
                                    CornerRadius="3"
                                    Canvas.Left="{Binding PositionX}"
                                    Canvas.Top="28"
                                    ToolTip="{Binding Title}">
                                <Border.Effect>
                                    <DropShadowEffect Color="{Binding Color}" 
                                                      BlurRadius="4" 
                                                      ShadowDepth="0" 
                                                      Opacity="0.6"/>
                                </Border.Effect>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                
                <!-- Today indicator (red line) -->
                <Line X1="{Binding TodayPositionX}" Y1="0"
                      X2="{Binding TodayPositionX}" Y2="44"
                      Stroke="#ef4444" StrokeThickness="2"
                      Visibility="{Binding ShowTodayMarker, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </Canvas>
            
            <!-- Controls Right -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center">
                <ComboBox SelectedItem="{Binding CurrentScale}" 
                          Width="100" Height="24"
                          ItemsSource="{Binding AvailableScales}"
                          FontSize="10">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource ScaleToStringConverter}}" FontSize="10"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
