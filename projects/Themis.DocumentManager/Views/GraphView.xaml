<UserControl x:Class="Themis.DocumentManager.Views.GraphView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="Black">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="350"/>
        </Grid.ColumnDefinitions>

        <!-- 3D Graph Visualization -->
        <Border Grid.Column="0" 
                Background="#1a1a1a"
                KeyboardNavigation.TabNavigation="Continue">
            <Grid>
                <!-- WebGL Canvas für 3D-Rendering -->
                <Frame x:Name="GraphFrame" 
                       Background="Black"
                       KeyboardNavigation.IsTabStop="True"
                       AutomationProperties.Name="3D Graph Visualisierung"
                       AutomationProperties.HelpText="3D-Graph mit interaktiver Navigation. Nutzen Sie die Maus zum Drehen und Zoomen."/>
                
                <!-- Loading Indicator -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed" x:Name="LoadingPanel">
                    <TextBlock Text="3D Graph wird berechnet..." HorizontalAlignment="Center" FontSize="14" Foreground="White"/>
                    <ProgressBar Height="20" Width="200" IsIndeterminate="True" Margin="0,10,0,0" Foreground="#2196F3"/>
                </StackPanel>

                <!-- Control Overlay (oben links) -->
                <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="15" Background="rgba(0,0,0,0.7)" Padding="10" CornerRadius="5">
                    <StackPanel x:Name="ControlPanel">
                        <TextBlock Text="⌨️ Steuerung" Foreground="White" FontSize="12" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBlock Text="Maus: Rotation" Foreground="#AAA" FontSize="10" Margin="0,0,0,4"/>
                        <TextBlock Text="Scroll: Zoom" Foreground="#AAA" FontSize="10" Margin="0,0,0,4"/>
                        <TextBlock Text="WASD: Bewegung" Foreground="#AAA" FontSize="10"/>
                    </StackPanel>
                </Border>

                <!-- Stats Overlay (oben rechts) -->
                <Border VerticalAlignment="Top" HorizontalAlignment="Right" Margin="15" Background="rgba(0,0,0,0.7)" Padding="10" CornerRadius="5">
                    <StackPanel x:Name="StatsPanel">
                        <TextBlock x:Name="NodesCount" Text="Knoten: 0" Foreground="#2196F3" FontSize="10"/>
                        <TextBlock x:Name="EdgesCount" Text="Kanten: 0" Foreground="#2196F3" FontSize="10"/>
                        <TextBlock x:Name="DensityText" Text="Dichte: 0.0" Foreground="#2196F3" FontSize="10"/>
                        <TextBlock x:Name="FpsText" Text="FPS: 60" Foreground="#2196F3" FontSize="10"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Right Sidebar: Node Info & Controls -->
        <Border Grid.Column="1" Background="#2a2a2a" BorderThickness="1,0,0,0" BorderBrush="#444">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Background="#1976D2" Padding="15">
                    <TextBlock Text="🔗 Graph Eigenschaften" Foreground="White" FontSize="13" FontWeight="Bold"/>
                </Border>

                <!-- Info Panel -->
                <ScrollViewer Grid.Row="1" Background="#2a2a2a" Padding="15">
                    <StackPanel x:Name="InfoPanel">
                        <TextBlock x:Name="SelectedNodeInfo" Text="Wähle einen Knoten..." Foreground="#AAA" FontSize="11" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Controls -->
                <Border Grid.Row="2" Background="#1f1f1f" BorderThickness="0,1,0,0" BorderBrush="#444" Padding="10">
                    <StackPanel>
                        <Button x:Name="ResetViewBtn" Content="🔄 Ansicht zurücksetzen" Background="#2196F3" Foreground="White" Padding="8" Margin="0,0,0,5" Cursor="Hand"/>
                        <Button x:Name="ExportBtn" Content="💾 Exportieren" Background="#4CAF50" Foreground="White" Padding="8" Margin="0,0,0,5" Cursor="Hand"/>
                        <ComboBox x:Name="LayoutCombo" Padding="8" Margin="0,0,0,5" Background="#333" Foreground="White">
                            <ComboBoxItem>Force-Directed</ComboBoxItem>
                            <ComboBoxItem>Hierarchisch</ComboBoxItem>
                            <ComboBoxItem>Zirkular</ComboBoxItem>
                            <ComboBoxItem>Radial</ComboBoxItem>
                        </ComboBox>
                        <Button x:Name="ApplyLayoutBtn" Content="⚙️ Layout anwenden" Background="#FF9800" Foreground="White" Padding="8" Cursor="Hand"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
