<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vmDashboard="clr-namespace:Themis.DocumentManager.Features.Dashboard.ViewModels"
                    xmlns:viewDashboard="clr-namespace:Themis.DocumentManager.Features.Dashboard.Views"
                    xmlns:vmDoc="clr-namespace:Themis.DocumentManager.Features.DocumentBrowser.ViewModels"
                    xmlns:viewDoc="clr-namespace:Themis.DocumentManager.Features.DocumentBrowser.Views"
                    xmlns:vmTimeline="clr-namespace:Themis.DocumentManager.ViewModels"
                    xmlns:viewTimeline="clr-namespace:Themis.DocumentManager.Features.Timeline.Views"
                    xmlns:vmGantt="clr-namespace:Themis.DocumentManager.Features.Gantt.ViewModels"
                    xmlns:viewGantt="clr-namespace:Themis.DocumentManager.Features.Gantt.Views"
                    xmlns:vmFav="clr-namespace:Themis.DocumentManager.Features.Favorites.ViewModels"
                    xmlns:viewFav="clr-namespace:Themis.DocumentManager.Features.Favorites.Views"
                    xmlns:vmMeta="clr-namespace:Themis.DocumentManager.Features.MetadataForm.ViewModels"
                    xmlns:viewMeta="clr-namespace:Themis.DocumentManager.Features.MetadataForm.Views"
                    xmlns:vmAI="clr-namespace:Themis.DocumentManager.Features.AIChat.ViewModels"
                    xmlns:viewAI="clr-namespace:Themis.DocumentManager.Features.AIChat.Views"
                    xmlns:vmERD="clr-namespace:Themis.DocumentManager.Features.ERDQueryEditor.ViewModels"
                    xmlns:viewERD="clr-namespace:Themis.DocumentManager.Features.ERDQueryEditor.Views"
                    xmlns:vmGeo="clr-namespace:Themis.DocumentManager.Features.Geo.ViewModels"
                    xmlns:viewGeo="clr-namespace:Themis.DocumentManager.Features.Geo.Views"
                    xmlns:vmGraph="clr-namespace:Themis.DocumentManager.Features.Graph.ViewModels"
                    xmlns:viewGraph="clr-namespace:Themis.DocumentManager.Features.Graph.Views">

    <!-- Dashboard -->
    <DataTemplate DataType="{x:Type vmDashboard:DashboardViewModel}">
        <viewDashboard:DashboardView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vmDashboard:DashboardPreviewViewModel}">
        <viewDashboard:DashboardPreviewView/>
    </DataTemplate>

    <!-- Document Browser -->
    <DataTemplate DataType="{x:Type vmDoc:DocumentBrowserViewModel}">
        <viewDoc:DocumentBrowserView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vmDoc:DocumentBrowserSimpleViewModel}">
        <viewDoc:DocumentBrowserSimpleView/>
    </DataTemplate>

    <!-- Timeline -->
    <DataTemplate DataType="{x:Type vmTimeline:TimelineViewModel}">
        <viewTimeline:TimelineViewImproved/>
    </DataTemplate>

    <!-- Gantt -->
    <DataTemplate DataType="{x:Type vmGantt:GanttViewModel}">
        <viewGantt:GanttView/>
    </DataTemplate>

    <!-- Favorites -->
    <DataTemplate DataType="{x:Type vmFav:FavoritesViewModel}">
        <viewFav:FavoritesPanelView/>
    </DataTemplate>

    <!-- Metadata Form -->
    <DataTemplate DataType="{x:Type vmMeta:MetadataFormViewModel}">
        <viewMeta:MetadataFormView/>
    </DataTemplate>

    <!-- AI Chat -->
    <DataTemplate DataType="{x:Type vmAI:AIChatViewModel}">
        <viewAI:AIChatView/>
    </DataTemplate>

    <!-- ERD & Query Editor -->
    <DataTemplate DataType="{x:Type vmERD:ERDViewModel}">
        <viewERD:ERDView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vmERD:QueryEditorViewModel}">
        <viewERD:QueryEditorView/>
    </DataTemplate>

    <!-- Geo & Graph -->
    <DataTemplate DataType="{x:Type vmGeo:GeoViewModel}">
        <viewGeo:GeoView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vmGraph:GraphViewModel}">
        <viewGraph:GraphView/>
    </DataTemplate>

</ResourceDictionary>