        {
          "expr": "histogram_quantile(0.95, rate(themisdb_query_duration_seconds_bucket[5m])) * 1000",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, rate(themisdb_query_duration_seconds_bucket[5m])) * 1000",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "title": "Query Latency (p50/p95/p99)",
      "type": "timeseries"
    },
    {
