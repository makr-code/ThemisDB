        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(themisdb_query_duration_seconds_bucket[5m])) * 1000",
          "legendFormat": "p50",
          "refId": "A"
