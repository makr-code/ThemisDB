# ============================================================================
FROM base AS hyperscaler

LABEL org.opencontainers.image.title="ThemisDB vcpkg deps - Hyperscaler" \
      org.opencontainers.image.description="Pre-compiled dependencies for Hyperscaler Edition"

COPY docker/vcpkg-hyperscaler.json ./vcpkg.json
