    export VCPKG_DOWNLOAD_TOOL=aria2; \
    ${VCPKG_ROOT}/vcpkg install --triplet=${VCPKG_TRIPLET} && \
    echo "Hyperscaler dependencies installed successfully" && \
    ${VCPKG_ROOT}/vcpkg list
