# syntax=docker/dockerfile:1.6
# ============================================================================
# vcpkg-deps - Pre-compiled dependency images per edition
# ============================================================================
# Build once, cache forever (until dependencies change)
#
# Build:
#   docker buildx build -f docker/Dockerfile.vcpkg-deps --target community -t themisdb/vcpkg-deps:community-v1.4.0 .
#   docker buildx build -f docker/Dockerfile.vcpkg-deps --target enterprise -t themisdb/vcpkg-deps:enterprise-v1.4.0 .
#   docker buildx build -f docker/Dockerfile.vcpkg-deps --target hyperscaler -t themisdb/vcpkg-deps:hyperscaler-v1.4.0 .

ARG VCPKG_BASE_VERSION=2024.10.21
FROM themisdb/vcpkg-base:${VCPKG_BASE_VERSION} AS base

ARG TARGETARCH
ARG VCPKG_TRIPLET

# Auto-detect architecture and set vcpkg triplet
RUN TRIPLET="${VCPKG_TRIPLET}"; \
    if [ -z "$TRIPLET" ]; then \
      case "${TARGETARCH}" in \
        amd64) TRIPLET=x64-linux ;; \
        arm64) TRIPLET=arm64-linux ;; \
        arm) TRIPLET=arm-linux ;; \
        *) TRIPLET=x64-linux ;; \
      esac; \
    fi && \
    echo "export VCPKG_DEFAULT_TRIPLET=${TRIPLET}" >> /etc/profile.d/vcpkg.sh && \
    echo "Using vcpkg triplet: ${TRIPLET}"

ENV VCPKG_DEFAULT_TRIPLET=${VCPKG_TRIPLET}

WORKDIR /build

COPY ports-overlays ./ports-overlays/
ENV VCPKG_OVERLAY_PORTS=/build/ports-overlays

# Pin vcpkg baseline
RUN cd ${VCPKG_ROOT} && \
    VCPKG_BASELINE=$(git rev-parse HEAD) && \
    echo "{\"default-registry\":{\"kind\":\"builtin\",\"baseline\":\"$VCPKG_BASELINE\"}}" > /build/vcpkg-configuration.json

# ============================================================================
# Minimal Edition Dependencies (IoT/Embedded)
# ============================================================================
FROM base AS minimal

LABEL org.opencontainers.image.title="ThemisDB vcpkg deps - Minimal" \
      org.opencontainers.image.description="Pre-compiled dependencies for Minimal Edition"

COPY docker/vcpkg-minimal.json ./vcpkg.json
COPY vcpkg-configuration.json ./

RUN --mount=type=cache,target=/root/.cache/vcpkg,sharing=locked \
    --mount=type=cache,target=${VCPKG_ROOT}/downloads,sharing=locked \
    set -eux; \
    . /etc/profile.d/vcpkg.sh; \
    export VCPKG_DOWNLOAD_TOOL=aria2; \
    ${VCPKG_ROOT}/vcpkg install --triplet=${VCPKG_DEFAULT_TRIPLET} && \
    echo "Minimal dependencies installed successfully" && \
    ${VCPKG_ROOT}/vcpkg list

# ============================================================================
# Community Edition Dependencies
# ============================================================================
FROM base AS community

LABEL org.opencontainers.image.title="ThemisDB vcpkg deps - Community" \
      org.opencontainers.image.description="Pre-compiled dependencies for Community Edition"

COPY docker/vcpkg-community.json ./vcpkg.json
COPY vcpkg-configuration.json ./

RUN --mount=type=cache,target=/root/.cache/vcpkg,sharing=locked \
    --mount=type=cache,target=${VCPKG_ROOT}/downloads,sharing=locked \
    set -eux; \
    export VCPKG_DOWNLOAD_TOOL=aria2; \
    ${VCPKG_ROOT}/vcpkg install --triplet=${VCPKG_TRIPLET} && \
    echo "Community dependencies installed successfully" && \
    ${VCPKG_ROOT}/vcpkg list

