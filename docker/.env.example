# ============================================================================
# ThemisDB LoRA Framework - Environment Variables
# ============================================================================
# Copy this file to .env and customize for your environment
# ============================================================================

# Docker Compose Project Name
COMPOSE_PROJECT_NAME=themisdb-lora

# Build Configuration
BUILD_TYPE=Release
ENABLE_LLM=ON
ENABLE_LORA=ON
BUILD_TESTS=ON
BUILD_BENCHMARKS=ON

# ThemisDB Configuration
THEMIS_HTTP_PORT=8529
THEMIS_AQL_PORT=8765
THEMIS_METRICS_PORT=9090
THEMIS_LOG_LEVEL=info

# Prometheus Configuration
PROMETHEUS_PORT=9091
PROMETHEUS_RETENTION_TIME=30d

# Grafana Configuration
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Resource Limits (optional)
# THEMIS_MAX_MEMORY_MB=4096
# THEMIS_MAX_CPU_PERCENT=80

# Development Mode (optional)
# THEMIS_ENABLE_PROFILING=true
# THEMIS_ENABLE_DEBUG_ENDPOINTS=true
