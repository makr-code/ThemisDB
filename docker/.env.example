# ============================================================================
# ThemisDB LoRA Framework - Environment Variables
# ============================================================================
# Copy this file to .env and customize for your environment
# ============================================================================

# Docker Compose Project Name
COMPOSE_PROJECT_NAME=themisdb-lora

# Build Configuration
BUILD_TYPE=Release
ENABLE_LLM=ON
ENABLE_LORA=ON
BUILD_TESTS=ON
BUILD_BENCHMARKS=ON

# ThemisDB runtime (read by themis_server; precedence CLI > env > config file > default)
THEMIS_CONFIG=/etc/themis/config.yaml
THEMIS_DATA_DIR=/var/lib/themis/data
THEMIS_HOST=0.0.0.0
THEMIS_PORT=8080
THEMIS_WORKER_THREADS=0
THEMIS_HEALTH_BIND_ADDRESS=0.0.0.0
THEMIS_HEALTH_PORT=9090
# gRPC (port 50051) starts only with mTLS or explicit insecure opt-in:
# THEMIS_WAL_GRPC_PORT=50051
# THEMIS_WAL_GRPC_ENABLE_MTLS=true
# THEMIS_WAL_GRPC_ALLOW_INSECURE=false
# gRPC-Web proxy (/grpc-web/* on the HTTP port) target; defaults to 127.0.0.1:<THEMIS_WAL_GRPC_PORT>
# THEMIS_GRPC_WEB_BACKEND=127.0.0.1:50051
# MCP, WebSocket, SSE and GraphQL share the HTTP port; no extra ports needed.

# Prometheus Configuration
PROMETHEUS_PORT=9091
PROMETHEUS_RETENTION_TIME=30d

# Grafana Configuration
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Resource Limits (optional)
# THEMIS_MAX_MEMORY_MB=4096
# THEMIS_MAX_CPU_PERCENT=80

# Development Mode (optional)
# THEMIS_ENABLE_PROFILING=true
# THEMIS_ENABLE_DEBUG_ENDPOINTS=true
