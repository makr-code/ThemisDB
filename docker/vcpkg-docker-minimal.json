{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "themisdb-docker",
  "version": "1.4.0",
  "description": "ThemisDB v1.4.0 HYPERSCALER - Lightweight Docker build dependencies",
  "dependencies": [
    { "name": "openssl", "version>=": "3.0" },
    { "name": "zlib" },
    { "name": "curl", "features": ["openssl"] },
    { "name": "rocksdb", "features": ["lz4", "zstd"] },
    { "name": "spdlog" },
    { "name": "nlohmann-json" },
    { "name": "zstd" },
    { "name": "lz4" },
    { "name": "snappy" },
    { "name": "brotli" },
    { "name": "re2" },
    { "name": "boost-asio" },
    { "name": "boost-beast" },
    { "name": "boost-json" },
    { "name": "boost-system" },
    { "name": "boost-thread" },
    { "name": "boost-regex" }
  ]
}
