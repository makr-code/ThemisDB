# Minimal Runtime-only Dockerfile for ThemisDB Docker Desktop deployment
# This Dockerfile assumes a pre-built themis_server binary in docker/

FROM ubuntu:24.04

ARG VERSION=dev
ENV THEMIS_VERSION=${VERSION}
ENV THEMIS_PORT=18765
ENV THEMIS_CONFIG_PATH=/etc/themis/config.json
ENV LD_LIBRARY_PATH=/usr/local/lib/themisdb:/usr/local/lib

# Install minimal runtime dependencies with security updates
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
    ca-certificates \
    libssl3 \
    libcurl4 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Create non-root user
RUN groupadd -r themis --gid=999 && \
    useradd -r -g themis --uid=999 -s /sbin/nologin themis

# Copy binary
COPY docker/themis_server /usr/local/bin/themis_server
RUN chmod +x /usr/local/bin/themis_server && \
    chown themis:themis /usr/local/bin/themis_server

# Create data directory
RUN mkdir -p /data /etc/themis && \
    chown -R themis:themis /data /etc/themis

# Copy entrypoint script
COPY docker/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

# Health check
HEALTHCHECK --interval=10s --timeout=5s --start-period=5s --retries=3 \
    CMD /usr/local/bin/themis_server --version || exit 1

# Expose ports
EXPOSE 18765

# Switch to non-root user
USER themis

# Entrypoint
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
