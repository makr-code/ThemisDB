# Simplified ThemisDB Hyperscaler Docker Build
# Option 1: Use pre-built MSVC binaries from Windows build
# Option 2: Build from source with minimal dependencies

ARG BASE_IMAGE=ubuntu:24.04
ARG THEMIS_VERSION=1.4.0

FROM ${BASE_IMAGE} as builder

# Install minimal build dependencies
RUN apt-get update && apt-get upgrade -y && apt-get install -y \
    build-essential \
    cmake \
    git \
    curl \
    wget \
    ninja-build \
    pkg-config \
    python3 \
    && rm -rf /var/lib/apt/lists/*

# Set vcpkg environment
ENV VCPKG_ROOT=/opt/vcpkg
ENV VCPKG_FORCE_SYSTEM_BINARIES=ON
ENV VCPKG_MAX_CONCURRENCY=4

# Setup vcpkg (minimal, skip git clone)
RUN mkdir -p ${VCPKG_ROOT} && \
    cd ${VCPKG_ROOT} && \
    wget -q https://github.com/microsoft/vcpkg/archive/refs/tags/2024.04.26.tar.gz -O /tmp/vcpkg.tar.gz && \
    tar --strip-components=1 -xzf /tmp/vcpkg.tar.gz && \
    ./bootstrap-vcpkg.sh && \
    rm /tmp/vcpkg.tar.gz

WORKDIR /src

# Copy only essential files
COPY CMakeLists.txt VERSION ./
COPY include ./include
COPY src ./src
COPY cmake ./cmake
COPY ports-overlays ./ports-overlays

# Create minimal vcpkg.json with only essential packages
RUN cat > vcpkg.json << 'EOF'
{
  "name": "themisdb",
  "version-string": "1.4.0",
  "dependencies": [
    "boost",
    "openssl",
    "fmt",
    "nlohmann-json",
    "spdlog",
    "rocksdb",
    "rapidjson",
    "gflags"
  ],
  "builtin-baseline": "2024.04.26"
}
EOF

# Build with minimal flags
RUN mkdir -p build && \
    cmake -S . -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_MAKE_PROGRAM=/usr/bin/ninja \
    -DCMAKE_TOOLCHAIN_FILE=${VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake \
    -DVCPKG_TARGET_TRIPLET=x64-linux \
    -DTHEMIS_BUILD_TESTS=OFF \
    -DTHEMIS_BUILD_BENCHMARKS=OFF \
    -DTHEMIS_ENABLE_TRACING=OFF \
    -DTHEMIS_EDITION=HYPERSCALER \
    -DTHEMIS_ENABLE_LLM=OFF \
    -DTHEMIS_ENABLE_GRAPHQL=OFF \
    -DTHEMIS_ENABLE_VISION=OFF && \
    ninja -C build themis_server && \
    ls -lh build/themis_server

# Runtime stage
FROM ${BASE_IMAGE} as runtime

ARG THEMIS_VERSION

# Install only runtime dependencies
RUN apt-get update && apt-get upgrade -y && apt-get install -y \
    ca-certificates \
    curl \
    libssl3 \
    openssl \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN groupadd -r themis --gid=999 && \
    useradd -r -g themis --uid=999 --home-dir=/var/lib/themisdb themis

# Copy binary from builder
COPY --from=builder --chown=themis:themis /src/build/themis_server /usr/local/bin/themis_server

# Create config and data directories
RUN mkdir -p /etc/themis /var/lib/themisdb && \
    chown -R themis:themis /etc/themis /var/lib/themisdb && \
    chmod 755 /etc/themis && \
    chmod 700 /var/lib/themisdb

# Add entrypoint script
RUN cat > /usr/local/bin/entrypoint.sh << 'EOF'
#!/bin/bash
set -e

# Configuration defaults
: ${THEMIS_PORT:=18765}
: ${THEMIS_HTTP_PORT:=8080}
: ${THEMIS_DATA_DIR:=/var/lib/themisdb}
: ${THEMIS_LOG_LEVEL:=info}

exec /usr/local/bin/themis_server \
    --port ${THEMIS_PORT} \
    --http-port ${THEMIS_HTTP_PORT} \
    --data-dir ${THEMIS_DATA_DIR} \
    --log-level ${THEMIS_LOG_LEVEL} \
    "$@"
EOF

RUN chmod +x /usr/local/bin/entrypoint.sh

# Health check
HEALTHCHECK --interval=10s --timeout=3s --start-period=20s --retries=5 \
    CMD curl -f http://localhost:8080/health || exit 1

# Metadata
LABEL org.opencontainers.image.version="${THEMIS_VERSION}" \
      org.opencontainers.image.title="ThemisDB HYPERSCALER" \
      org.opencontainers.image.description="Hyperscaler Edition Docker Image" \
      org.opencontainers.image.url="https://github.com/makr-code/ThemisDB"

EXPOSE 8080 18765 4318

USER themis
WORKDIR /var/lib/themisdb

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["--help"]
