# ThemisDB Runtime Image - Using Pre-built Binary with Wire Protocol
# This Dockerfile uses a pre-compiled themis_server binary with Wire Protocol support
# Build locally first: wsl bash -c "cd /mnt/c/VCC/themis && export VCPKG_ROOT=/mnt/c/VCC/themis/vcpkg && cmake -S . -B build-wsl -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_TOOLCHAIN_FILE=/mnt/c/VCC/themis/vcpkg/scripts/buildsystems/vcpkg.cmake -DTHEMIS_BUILD_WIRE_PROTOCOL=ON && cmake --build build-wsl --target themis_server -j8"

FROM ubuntu:22.04 AS runtime

# Install runtime dependencies only (no build tools needed)
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libssl3 \
    libstdc++6 \
    libc6 \
    libboost-system1.74.0 \
    libboost-thread1.74.0 \
    libzstd1 \
    libbrotli1 \
    libcurl4 \
    && rm -rf /var/lib/apt/lists/*

# Create application directory
WORKDIR /app

# Copy pre-built binary from local WSL build with Wire Protocol enabled
# NOTE: Binary must be accessible in build context - use: docker build -f Dockerfile.prebuilt .
COPY build-wsl/themis_server* /app/themis_server
RUN chmod +x /app/themis_server || true

# Make binary executable
RUN chmod +x /app/themis_server

# Create data directory
RUN mkdir -p /data

# Create config directory
RUN mkdir -p /etc/themis

# Expose HTTP port and Wire Protocol port
EXPOSE 8765 8766

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD test -f /app/themis_server && ps aux | grep [t]hemis_server || exit 1

# Run server with Wire Protocol enabled
CMD ["/app/themis_server"]
