# ThemisDB Docker Build - Runtime from Pre-built Binary
# Use this after building locally: themis_server binary is copied in
# Avoids all vcpkg network downloads during container build

FROM ubuntu:22.04 AS runtime
ENV DEBIAN_FRONTEND=noninteractive

# Install only runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    libstdc++6 \
    libc6 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy pre-built themis_server binary
# Assumed to exist at: ./build-wsl/themis_server (from WSL cmake build)
# If missing, build locally first: cd /mnt/c/VCC/themis && cmake -B build-wsl && cmake --build build-wsl
COPY build-wsl/themis_server /app/themis_server

# Copy config and data files
COPY config/config.json /etc/themis/config.json
COPY config/*.yaml /etc/themis/
COPY config/policies.json /etc/themis/

# Create runtime structure
RUN mkdir -p /data /var/log/themis && \
    chmod +x /app/themis_server && \
    ldconfig

# Runtime setup
RUN useradd -m -u 1000 themis 2>/dev/null || true && \
    chown -R themis:themis /app /data /etc/themis /var/log/themis

USER themis

# Expose REST API (8765) and Wire Protocol (8766) + Prometheus (8765)
EXPOSE 8765 8766

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD test -f /app/themis_server || exit 1

# Default command
CMD ["/app/themis_server"]
