# ThemisDB HYPERSCALER Edition - Docker Runtime
# Uses pre-built binaries from MSVC Windows build
# Multi-platform deployment ready

FROM ubuntu:24.04

ARG THEMIS_VERSION=1.4.0

ENV DEBIAN_FRONTEND=noninteractive
ENV THEMIS_VERSION=${THEMIS_VERSION}
ENV THEMIS_EDITION=HYPERSCALER

LABEL org.opencontainers.image.title="ThemisDB HYPERSCALER Edition" \
      org.opencontainers.image.version="${THEMIS_VERSION}" \
      org.opencontainers.image.description="ThemisDB HYPERSCALER Edition - Enterprise multi-datacenter deployment" \
      org.opencontainers.image.vendor="VCC"

# Install runtime dependencies
RUN apt-get update && apt-get upgrade -y && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        libssl3 \
        zlib1g \
        libc6 \
        libstdc++6 \
        jq \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Create non-root user
RUN groupadd -r themis --gid=999 && \
    useradd -r -g themis --uid=999 \
        --home-dir=/var/lib/themisdb \
        --shell=/bin/bash \
        --create-home themis

# Create necessary directories
RUN mkdir -p /etc/themis /var/lib/themisdb /usr/local/share/themis && \
    chown -R themis:themis /etc/themis /var/lib/themisdb && \
    chmod 755 /etc/themis && \
    chmod 700 /var/lib/themisdb

# Copy configuration
COPY config/config.json /etc/themis/config.json
RUN chown themis:themis /etc/themis/config.json && chmod 644 /etc/themis/config.json

# Copy entrypoint script
COPY docker/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

# Expose ports
EXPOSE 8080 18765 4318

# Health check
HEALTHCHECK --interval=10s --timeout=3s --start-period=15s --retries=3 \
    CMD curl -fsSL http://localhost:8080/health || exit 1

# Switch to themis user
USER themis
WORKDIR /var/lib/themisdb

# Entrypoint
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["--config", "/etc/themis/config.json", "--log-level", "info"]
