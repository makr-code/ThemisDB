# ThemisDB Runtime Docker Image
# Uses pre-built themis_server binary (assumed to be compiled locally)
# Minimal runtime image - just Ubuntu + runtime dependencies + binary

FROM ubuntu:22.04

# Install only runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libssl3 \
    libstdc++6 \
    libc6 \
    libboost-system1.74.0 \
    libboost-thread1.74.0 \
    libzstd1 \
    libbrotli1 \
    libcurl4 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# The binary must be placed here before docker build runs
# FROM: c:\VCC\themis\build-wsl\themis_server (on Windows WSL)
# Method 1: Manual copy - cp build-wsl/themis_server before docker build
# Method 2: Create in Dockerfile (see Dockerfile.build-in-docker)
# Method 3: Use docker build with --build-arg to mount volume

RUN echo "Waiting for themis_server binary..."
COPY themis_server /app/themis_server

RUN chmod +x /app/themis_server && \
    ls -lh /app/themis_server

# Create required directories
RUN mkdir -p /data /etc/themis /var/log/themis

# Create non-root user
RUN useradd -m -u 1000 themis 2>/dev/null || true && \
    chown -R themis:themis /app /data /etc/themis /var/log/themis

USER themis

# Expose ports: 8765 (HTTP REST API), 8766 (Wire Protocol)
EXPOSE 8765 8766

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD test -f /app/themis_server || exit 1

# Default command
CMD ["/app/themis_server"]
