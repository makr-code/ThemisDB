# ============================================================================
# .dockerignore - Docker Build Context Optimization
# ============================================================================
# Version: 4.0.0 (Maximum Size Reduction)
# Ziel: Build Context von ~38GB auf <500MB reduzieren
# ============================================================================

# --- KRITISCH: Größte Verursacher (30+ GB) ---------------------------------
# vcpkg aus dem Repo mitnehmen (Cache/Ports), aber große Artefakte ausschließen
!vcpkg/
!vcpkg/**
vcpkg/buildtrees/
vcpkg/downloads/
vcpkg/packages/
vcpkg/installed/
vcpkg/.github/
vcpkg/.vs/
vcpkg/toolsrc/
vcpkg_installed/
.vcpkg/

# llama.cpp komplett ausschließen - wird im Docker geklont
llama.cpp/

# Git History (~2GB)
.git/
.github/
.gitignore
.gitattributes
.gitmodules

# --- Build Artifacts (~5-10 GB) --------------------------------------------
build/
build-*/
build-msvc/
build-wsl/
out/
bin/
obj/
lib/
dist/
Testing/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
*.cmake
*.a
*.o
*.obj
*.lib
*.dll
*.so
*.so.*
*.dylib
*.exe
*.pdb
*.ilk
*.exp

# Build logs
*.log
build*.txt
docker-build*.log
msbuild*.txt
msvc_build*.txt
ctest*.txt
ingestion_output.json

# --- Testing & Benchmarks (~3-5 GB) ----------------------------------------
tests/
benchmarks/
fuzz/
data/
test_geo_integration_db/
adapters/
test_output*
*_test
*_test.exe
test_*.cpp
test_debug.cpp

# --- Release Packages (~2-3 GB) --------------------------------------------
release/
release-changelogs/
packaging/
debian/
PKGBUILD
*.spec
*.tar
*.tar.gz
*.tgz
*.zip
*.deb
*.rpm

# --- Documentation (~1-2 GB) -----------------------------------------------
docs/
site/
wiki/
wiki_out/
wiki-temp/
book/
compendium/
*.md

# --- Unreal Engine (~3-5 GB wenn vorhanden) --------------------------------
unreal/

# --- IDE & Editor Files ----------------------------------------------------
.vscode/
.idea/
.vs/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
*.suo
*.user

# --- Node & JavaScript -----------------------------------------------------
node_modules/
npm-debug.log
yarn-error.log
.npm/
.yarn/
package-lock.json
yarn.lock

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.Python
env/
venv/
.venv/
*.egg-info/
.pytest_cache/
*.pyc

# --- Temporary & Cache -----------------------------------------------------
temp/
tmp/
tmp*/
*.tmp
*.cache
*.bak
*.backup
*~
logs/
*.pid
*.err
*.out
server.pid
server.err
server.out

# --- Config & Secrets ------------------------------------------------------
*.pem
*.key
*.crt
*.pfx
.env
.env.local
.env.*.local
secrets/

# --- Docker Artifacts ------------------------------------------------------
docker-compose*.yml.backup
Dockerfile.backup
*.tar.bz2

# --- External & SDKs -------------------------------------------------------
sdks/
clients/
external/llama.cpp/
external/vcpkg/

# --- Grafana & Monitoring --------------------------------------------------
grafana/data/
grafana/logs/

# --- Projects & Tools ------------------------------------------------------
projects/
tools/jaeger/
tools/Themis.*/
.tools/

# --- CodeQL & Security Scanning --------------------------------------------
_codeql_detected_source_root/

# --- Deploy Scripts --------------------------------------------------------
deploy/
docker-bin/
helm/

# --- Models & Data ---------------------------------------------------------
models/*.gguf
models/*.bin

# ============================================================================
# EXPLIZIT EINBEZIEHEN (überschreibt obige Regeln)
# ============================================================================
!CMakeLists.txt
!CMakeLists_debug.txt
!CMakePresets.json
!vcpkg.json
!vcpkg-configuration.json
!README.md
!LICENSE
!SECURITY.md

# Source Code
!src/
!include/
!proto/

# Build Infrastructure
!cmake/
!scripts/
!ports-overlays/
!external/

# Docker Files
!Dockerfile*
!*.sh
!*.ps1

# OpenAPI Spec
!openapi/

# ============================================================================
# Build Context Ziel: <500MB (vorher 38GB)
# ============================================================================
