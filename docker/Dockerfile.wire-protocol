# ThemisDB Docker Image - Full Build with Wire Protocol
# Multi-stage build that compiles themis_server from source with Wire Protocol support
# Built locally and works with both Linux Docker and Docker Desktop

ARG VCPKG_VERSION=2025.01.20

FROM ubuntu:22.04 AS builder

ARG VCPKG_VERSION

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    git \
    curl \
    pkg-config \
    libboost-dev \
    libboost-system-dev \
    libboost-thread-dev \
    libssl-dev \
    zlib1g-dev \
    libbrotli-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Copy source code
COPY CMakeLists.txt ./
COPY include/ ./include/
COPY src/ ./src/
COPY tests/ ./tests/
COPY vcpkg.json ./
COPY .gitmodules ./

# Initialize and download vcpkg
RUN git init && \
    git submodule update --init --recursive vcpkg 2>/dev/null || \
    (mkdir -p vcpkg && \
     git clone https://github.com/Microsoft/vcpkg.git vcpkg && \
     cd vcpkg && \
     git checkout ${VCPKG_VERSION} && \
     ./bootstrap-vcpkg.sh)

ENV VCPKG_ROOT=/build/vcpkg

# Build themis_server with Wire Protocol enabled
RUN \
    cd /build && \
    cmake -S . -B build-docker \
        -G "Unix Makefiles" \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_TOOLCHAIN_FILE=${VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake \
        -DTHEMIS_BUILD_WIRE_PROTOCOL=ON \
        -DCMAKE_CXX_FLAGS="-O3 -march=native" && \
    cmake --build build-docker --target themis_server -j$(nproc) && \
    ls -lh /build/build-docker/themis_server

# ============ Runtime Stage ============
FROM ubuntu:22.04 AS runtime

# Install runtime dependencies only
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libssl3 \
    libstdc++6 \
    libc6 \
    libboost-system1.74.0 \
    libboost-thread1.74.0 \
    libzstd1 \
    libbrotli1 \
    libcurl4 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy compiled binary from builder
COPY --from=builder /build/build-docker/themis_server /app/themis_server

# Make binary executable
RUN chmod +x /app/themis_server

# Create required directories
RUN mkdir -p /data /etc/themis /var/log/themis

# Create non-root user for security
RUN useradd -m -u 1000 themis && \
    chown -R themis:themis /app /data /etc/themis /var/log/themis

USER themis

# Expose ports
# 8765: HTTP REST API
# 8766: Wire Protocol (binary TCP)
EXPOSE 8765 8766

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD test -f /app/themis_server || exit 1

# Default command
CMD ["/app/themis_server"]
