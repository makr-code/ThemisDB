# syntax=docker/dockerfile:1.6
# ============================================================================
# ThemisDB Unified Docker Build - All Editions
# ============================================================================
# Supports: MINIMAL, COMMUNITY, ENTERPRISE, HYPERSCALER
# Build:    docker build --build-arg THEMIS_EDITION=COMMUNITY -t themisdb:community .

# ============================================================================
# Stage 1: base - Shared foundation with build tools
# ============================================================================
FROM ubuntu:24.04 AS base

ARG EXTRA_CA_CERT_B64=""

ENV DEBIAN_FRONTEND=noninteractive
ENV VCPKG_ROOT=/opt/vcpkg
ENV VCPKG_FORCE_SYSTEM_BINARIES=1
ENV VCPKG_DISABLE_METRICS=1
ENV SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt

# Fetch pinned vcpkg source archive at Docker build time to avoid
# in-container git TLS/proxy trust-chain issues.
ADD https://github.com/microsoft/vcpkg/archive/10b7a178346f3f0abef60cecd5130e295afd8da4.tar.gz /tmp/vcpkg.tar.gz

# Install build essentials (combined layer for efficiency)
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
        build-essential cmake ninja-build git curl ca-certificates pkg-config \
        zip unzip tar wget flex bison aria2 ccache python3 perl nasm autoconf \
        automake libtool && \
    if [ -n "${EXTRA_CA_CERT_B64}" ]; then \
        echo "${EXTRA_CA_CERT_B64}" | base64 -d > /usr/local/share/ca-certificates/themis-extra-ca.crt && \
        update-ca-certificates; \
    fi && \
    rm -rf /var/lib/apt/lists/* && \
    tar -xzf /tmp/vcpkg.tar.gz -C /opt && \
    mv /opt/vcpkg-10b7a178346f3f0abef60cecd5130e295afd8da4 ${VCPKG_ROOT} && \
    ${VCPKG_ROOT}/bootstrap-vcpkg.sh -disableMetrics && \
    touch ${VCPKG_ROOT}/vcpkg.disable-metrics && \
    rm -f /tmp/vcpkg.tar.gz && \
    ${VCPKG_ROOT}/vcpkg version --disable-metrics

# ============================================================================
# Stage 2: deps - Install edition-specific dependencies
# ============================================================================
FROM base AS deps

ARG THEMIS_EDITION=COMMUNITY
ARG TARGETARCH
ARG VCPKG_MANIFEST_HASH=""

WORKDIR /build

# Copy vcpkg manifests
COPY docker/vcpkg-minimal.json docker/vcpkg-community.json \
     docker/vcpkg-enterprise.json docker/vcpkg-hyperscaler.json ./

# Select edition manifest and detect architecture
RUN set -eux; \
    EDITION=$(echo "${THEMIS_EDITION}" | tr '[:upper:]' '[:lower:]'); \
    if [ -f "vcpkg-${EDITION}.json" ]; then \
        cp "vcpkg-${EDITION}.json" vcpkg.json; \
        echo "Edition selected: ${EDITION}"; \
    else \
        echo "ERROR: vcpkg-${EDITION}.json not found!"; exit 1; \
    fi && \
    ARCH="${TARGETARCH:-}"; \
    if [ -z "${ARCH}" ]; then ARCH="$(uname -m)"; fi; \
    TRIPLET="x64-linux"; \
    case "${ARCH}" in \
        amd64|x86_64) TRIPLET="x64-linux" ;; \
        arm64|aarch64) TRIPLET="arm64-linux" ;; \
        arm|armv7l) TRIPLET="arm-linux" ;; \
        *) echo "WARN: Unknown TARGETARCH='${ARCH}', fallback to x64-linux" ;; \
    esac && \
    echo "${TRIPLET}" > /tmp/triplet.txt && \
    echo "Architecture: ${ARCH} -> ${TRIPLET}"

# Copy vcpkg configuration and overlay ports
COPY vcpkg-configuration.json ./
# Ensure overlay-ports directory exists before COPY so that any stale
# GHA build-cache entry for this layer is invalidated on the first run
# after this change, and the directory is always present for vcpkg.
RUN mkdir -p /build/ports
COPY ports ./ports

# Install dependencies (with cache mounts for downloads/packages)
RUN --mount=type=cache,target=/opt/vcpkg/downloads,sharing=locked \
    --mount=type=cache,target=/opt/vcpkg/packages,sharing=locked \
    set -eux; \
    echo "Using VCPKG_MANIFEST_HASH=${VCPKG_MANIFEST_HASH}"; \
    TRIPLET=$(cat /tmp/triplet.txt); \
    export VCPKG_BUILD_TYPE=release; \
    export VCPKG_MAX_CONCURRENCY=1; \
    export VCPKG_DOWNLOAD_TOOL=aria2; \
    export VCPKG_USE_ARIA2=1; \
    export VCPKG_DOWNLOADER=aria2; \
    export CURL_RETRIES=10; \
    export CURL_TIMEOUT=600; \
    export CMAKE_BUILD_PARALLEL_LEVEL=1; \
    mkdir -p /build/vcpkg_installed; \
    mkdir -p /build/ports; \
    find /opt/vcpkg/downloads -name '*.part' -delete || true; \
    # PATCH: Modify boost-context portfile to build release-only (Debug fails in container)
    if [ -f "${VCPKG_ROOT}/ports/boost-context/portfile.cmake" ]; then \
        # Add early return for boost-context to skip Debug build attempt
        sed -i '1i # Docker container patch: skip Debug build\\nif(VCPKG_BUILD_TYPE STREQUAL \"release\")\\n  set(VCPKG_BUILD_TYPE \"release\")\\nendif()' \
            "${VCPKG_ROOT}/ports/boost-context/portfile.cmake"; \
    fi; \
    echo "Installing packages for ${TRIPLET} with aria2..."; \
    ${VCPKG_ROOT}/vcpkg install \
        --triplet="${TRIPLET}" \
        --x-manifest-root=/build \
        --x-install-root=/build/vcpkg_installed \
        --allow-unsupported \
        --clean-after-build; \
    test -d "/build/vcpkg_installed/${TRIPLET}/lib"; \
    find "/build/vcpkg_installed/${TRIPLET}/lib" -maxdepth 1 \( -name 'libspdlog*' -o -name 'spdlog*' \) | head -20; \
    ls -la /build/vcpkg_installed/lib/ || echo "WARNING: No lib dir"; \
    find /build/vcpkg_installed -name "*openssl*" -o -name "*curl*" | head -20

# ============================================================================
# Stage 3: llama - Build llama.cpp (optional, for LLM support)
# ============================================================================
FROM base AS llama

ARG ENABLE_LLM=ON

WORKDIR /opt

# Copy llama.cpp source (excluding build/, models/, etc. via .dockerignore)
COPY llama.cpp ./llama.cpp

# Build if LLM is enabled
RUN if [ "$ENABLE_LLM" = "ON" ]; then \
        echo "Building llama.cpp..."; \
        cd /opt/llama.cpp && \
        cmake -S . -B build -G Ninja \
            -DCMAKE_BUILD_TYPE=Release \
            -DLLAMA_BUILD_TESTS=OFF \
            -DLLAMA_BUILD_EXAMPLES=OFF \
            -DLLAMA_BUILD_SERVER=OFF \
            -DLLAMA_BUILD_SHARED_LIB=ON && \
        ninja -C build -j$(nproc) && \
        echo "llama.cpp build completed"; \
    else \
        echo "LLM disabled"; \
        mkdir -p /opt/llama.cpp/build/lib; \
    fi

# ============================================================================
# Stage 4: build - Compile ThemisDB
# ============================================================================
FROM deps AS build

ARG THEMIS_EDITION=COMMUNITY
ARG ENABLE_LLM=ON
ARG TARGETARCH

WORKDIR /src

# Copy source code and required build metadata
COPY CMakeLists.txt CMakePresets.json VERSION LICENSE ./
COPY cmake ./cmake
COPY include ./include
COPY src ./src
COPY proto ./proto
COPY internal ./internal
COPY ports ./ports
COPY plugins ./plugins
COPY scripts ./scripts
COPY tools ./tools

# Copy vcpkg config from deps stage (not from host!)
COPY --from=deps /build/vcpkg.json ./vcpkg.json
COPY --from=deps /build/vcpkg-configuration.json ./vcpkg-configuration.json

# Copy vcpkg installed packages where Dependencies.cmake expects them
COPY --from=deps /build/vcpkg_installed /src/vcpkg_installed

# Copy llama.cpp
COPY --from=llama /opt/llama.cpp /opt/llama.cpp

# Ensure system RocksDB dev headers/libs for build
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
        librocksdb-dev && \
    rm -rf /var/lib/apt/lists/*

# Build ThemisDB
# Note: GPU backends (Vulkan/CUDA) are enabled by default in COMMUNITY/ENTERPRISE/HYPERSCALER
# via CMake edition defaults. For CPU-only Docker builds, explicitly disable with:
# --build-arg FORCE_CPU_ONLY=ON
ARG FORCE_CPU_ONLY=ON
ARG THEMIS_BUILD_DIR=build-gcc-linux-release

RUN set -eux; \
    ARCH="${TARGETARCH:-}"; \
    if [ -z "${ARCH}" ]; then ARCH="$(uname -m)"; fi; \
    TRIPLET="x64-linux"; \
    case "${ARCH}" in \
        amd64|x86_64) TRIPLET="x64-linux" ;; \
        arm64|aarch64) TRIPLET="arm64-linux" ;; \
        arm|armv7l) TRIPLET="arm-linux" ;; \
        *) echo "WARN: Unknown TARGETARCH='${ARCH}', fallback to x64-linux" ;; \
    esac; \
    echo "Building ThemisDB ${THEMIS_EDITION} (LLM=${ENABLE_LLM}, FORCE_CPU_ONLY=${FORCE_CPU_ONLY})..."; \
    echo "TARGETARCH=${ARCH} TRIPLET=${TRIPLET}"; \
    ls -la /build/vcpkg_installed/${TRIPLET} 2>/dev/null | head -20 || echo "No vcpkg_installed"; \
    \
    EXTRA_ARGS=""; \
    HAS_VULKAN_HEADERS=0; \
    if [ -f /usr/include/vulkan/vulkan.h ] || [ -f /usr/local/include/vulkan/vulkan.h ]; then \
        HAS_VULKAN_HEADERS=1; \
    fi; \
    if [ "${FORCE_CPU_ONLY}" = "ON" ] || [ "${FORCE_CPU_ONLY}" = "true" ] || [ "${FORCE_CPU_ONLY}" = "TRUE" ] || [ "${HAS_VULKAN_HEADERS}" -ne 1 ]; then \
        echo "CPU-only mode active: disabling GPU backends for Docker build"; \
        if [ "${FORCE_CPU_ONLY}" = "ON" ] || [ "${FORCE_CPU_ONLY}" = "true" ] || [ "${FORCE_CPU_ONLY}" = "TRUE" ]; then \
            echo "FORCE_CPU_ONLY was explicitly enabled"; \
        else \
            echo "Vulkan SDK headers are not installed in this container; auto-disabling Vulkan/CUDA"; \
        fi; \
        EXTRA_ARGS="-DTHEMIS_ENABLE_GPU=OFF -DTHEMIS_GPU_AUTO_DETECT=OFF -DTHEMIS_ENABLE_VULKAN=OFF -DTHEMIS_ENABLE_CUDA=OFF -DTHEMIS_ENABLE_HIP=OFF"; \
    else \
        echo "Using edition defaults: Vulkan/CUDA enabled because SDK headers are available"; \
        echo "For GPU support in container, install Vulkan SDK headers and mount /dev/dri"; \
    fi; \
    \
    cmake --preset linux-release \
        -DTHEMIS_EDITION="${THEMIS_EDITION}" \
        -DTHEMIS_ENABLE_LLM="${ENABLE_LLM}" \
        -DTHEMIS_AUTO_BOOTSTRAP_DEPS=OFF \
        -DTHEMIS_DOCS_DB_MODE=OFF \
        -DVCPKG_TARGET_TRIPLET="${TRIPLET}" \
        -DVCPKG_INSTALLED_DIR="/src/vcpkg_installed" \
        -DCMAKE_PREFIX_PATH="/src/vcpkg_installed/${TRIPLET};/src/vcpkg_installed/${TRIPLET}/share;/src/vcpkg_installed/${TRIPLET}/lib/cmake" \
        -DOPENSSL_ROOT_DIR="/src/vcpkg_installed/${TRIPLET}" \
        -DOpenSSL_DIR="/src/vcpkg_installed/${TRIPLET}/share/openssl" \
        ${EXTRA_ARGS} && \
    ninja -C "${THEMIS_BUILD_DIR}" -j$(nproc)

# ============================================================================
# Stage 5: runtime - Production image
# ============================================================================
FROM ubuntu:24.04 AS runtime

ARG THEMIS_EDITION=COMMUNITY

ENV DEBIAN_FRONTEND=noninteractive
ENV THEMIS_EDITION=${THEMIS_EDITION}

WORKDIR /app

# Install runtime dependencies
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates librocksdb-dev libgrpc++1 libprotobuf32 curl && \
    rm -rf /var/lib/apt/lists/*

# Copy binary
COPY --from=build /src/build-gcc-linux-release/bin/themis_server /app/themis_server

# Copy llama.cpp libraries
COPY --from=llama /opt/llama.cpp/build/lib* /usr/local/lib/

RUN ldconfig

EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

ENTRYPOINT ["/app/themis_server"]

# ============================================================================
# Stage 6: debug - Development/debugging image
# ============================================================================
FROM ubuntu:24.04 AS debug

ARG THEMIS_EDITION=COMMUNITY

ENV DEBIAN_FRONTEND=noninteractive
ENV THEMIS_EDITION=${THEMIS_EDITION}

WORKDIR /app

# Install debug tools
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates librocksdb-dev libgrpc++1 libprotobuf32 curl \
        gdb strace htop less nano git telnet netcat-openbsd && \
    rm -rf /var/lib/apt/lists/*

# Copy binary and sources
COPY --from=build /src /src
COPY --from=build /src/build-gcc-linux-release/bin/themis_server /app/themis_server

# Copy llama.cpp libraries
COPY --from=llama /opt/llama.cpp/build/lib* /usr/local/lib/

RUN ldconfig

EXPOSE 8080
ENTRYPOINT ["/app/themis_server"]
