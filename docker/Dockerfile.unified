# syntax=docker/dockerfile:1.6
# ============================================================================
# ThemisDB Unified Docker Build - All Editions
# ============================================================================
# Supports: MINIMAL, COMMUNITY, ENTERPRISE, HYPERSCALER
# Build:    docker build --build-arg THEMIS_EDITION=COMMUNITY -t themisdb:community .

# ============================================================================
# Stage 1: base - Shared foundation with build tools
# ============================================================================
FROM ubuntu:24.04 AS base

ENV DEBIAN_FRONTEND=noninteractive
ENV VCPKG_ROOT=/opt/vcpkg
ENV VCPKG_FORCE_SYSTEM_BINARIES=1
ENV VCPKG_DISABLE_METRICS=1
ENV SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
ENV GIT_SSL_CAINFO=/etc/ssl/certs/ca-certificates.crt

# Install build essentials (combined layer for efficiency)
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
        build-essential cmake ninja-build git curl ca-certificates pkg-config \
        zip unzip tar wget flex bison aria2 python3 perl nasm autoconf \
        automake libtool && \
    git config --global http.sslCAInfo /etc/ssl/certs/ca-certificates.crt && \
    rm -rf /var/lib/apt/lists/* && \
    git clone https://github.com/microsoft/vcpkg.git ${VCPKG_ROOT} && \
    cd ${VCPKG_ROOT} && \
    git checkout 10b7a178346f3f0abef60cecd5130e295afd8da4 && \
    ./bootstrap-vcpkg.sh -disableMetrics

# ============================================================================
# Stage 2: deps - Install edition-specific dependencies
# ============================================================================
FROM base AS deps

ARG THEMIS_EDITION=COMMUNITY
ARG TARGETARCH=amd64
ARG VCPKG_MANIFEST_HASH=""

WORKDIR /build

# Copy vcpkg manifests
COPY docker/vcpkg-minimal.json docker/vcpkg-community.json \
     docker/vcpkg-enterprise.json docker/vcpkg-hyperscaler.json ./

# Select edition manifest and detect architecture
RUN set -eux; \
    EDITION=$(echo "${THEMIS_EDITION}" | tr '[:upper:]' '[:lower:]'); \
    if [ -f "vcpkg-${EDITION}.json" ]; then \
        cp "vcpkg-${EDITION}.json" vcpkg.json; \
        echo "Edition selected: ${EDITION}"; \
    else \
        echo "ERROR: vcpkg-${EDITION}.json not found!"; exit 1; \
    fi && \
    TRIPLET="x64-linux"; \
    case "${TARGETARCH}" in \
        amd64) TRIPLET="x64-linux" ;; \
        arm64) TRIPLET="arm64-linux" ;; \
        arm) TRIPLET="arm-linux" ;; \
    esac && \
    echo "${TRIPLET}" > /tmp/triplet.txt && \
    echo "Architecture: ${TRIPLET}"

# Copy vcpkg configuration and overlay ports
COPY vcpkg-configuration.json ./
# Ensure overlay-ports directory exists before COPY so that any stale
# GHA build-cache entry for this layer is invalidated on the first run
# after this change, and the directory is always present for vcpkg.
RUN mkdir -p /build/ports
COPY ports ./ports

# Install dependencies (with cache mounts for downloads/packages)
RUN --mount=type=cache,target=/opt/vcpkg/downloads,sharing=locked \
    --mount=type=cache,target=/opt/vcpkg/packages,sharing=locked \
    set -eux; \
    echo "Using VCPKG_MANIFEST_HASH=${VCPKG_MANIFEST_HASH}"; \
    TRIPLET=$(cat /tmp/triplet.txt); \
    export VCPKG_BUILD_TYPE=release; \
    export VCPKG_MAX_CONCURRENCY=2; \
    export VCPKG_DOWNLOAD_TOOL=curl; \
    export CURL_RETRIES=10; \
    export CURL_TIMEOUT=600; \
    mkdir -p /build/vcpkg_installed; \
    # Defensive guard: ensure the overlay-ports directory exists even if a
    # stale GHA build-cache entry for the COPY layer omits it.
    mkdir -p /build/ports; \
        # remove any stale partial boost archives that can poison the cache
        find /opt/vcpkg/downloads -name '*.part' -delete || true; \
    echo "Installing packages for ${TRIPLET} with aria2..."; \
    INSTALL_SUCCESS=0; \
    for i in 1 2 3; do \
        if ${VCPKG_ROOT}/vcpkg install \
            --triplet="${TRIPLET}" \
            --x-manifest-root=/build \
            --x-install-root=/build/vcpkg_installed \
            --allow-unsupported \
            --clean-after-build; then \
            INSTALL_SUCCESS=1; \
            break; \
        fi; \
        echo "vcpkg install failed (attempt ${i}/3), retrying in 10s"; \
        sleep 10; \
    done; \
    if [ ${INSTALL_SUCCESS:-0} -ne 1 ]; then \
        if ! ${VCPKG_ROOT}/vcpkg install \
            --triplet="${TRIPLET}" \
            --x-manifest-root=/build \
            --x-install-root=/build/vcpkg_installed \
            --allow-unsupported \
            --clean-after-build; then \
            echo "ERROR: vcpkg install failed after 3 attempts. Packages not installed."; \
            exit 1; \
        fi; \
        INSTALL_SUCCESS=1; \
    fi; \
    echo "✓ Packages installed in /build/vcpkg_installed"; \
    ls -la /build/vcpkg_installed/lib/ || echo "WARNING: No lib dir"; \
    find /build/vcpkg_installed -name "*openssl*" -o -name "*curl*" | head -20

# ============================================================================
# Stage 3: llama - Build llama.cpp (optional, for LLM support)
# ============================================================================
FROM base AS llama

ARG ENABLE_LLM=OFF

WORKDIR /opt

# Copy llama.cpp source (excluding build/, models/, etc. via .dockerignore)
COPY llama.cpp ./llama.cpp

# Build if LLM is enabled
RUN if [ "$ENABLE_LLM" = "ON" ]; then \
        echo "Building llama.cpp..."; \
        cd /opt/llama.cpp && \
        cmake -S . -B build -G Ninja \
            -DCMAKE_BUILD_TYPE=Release \
            -DLLAMA_BUILD_TESTS=OFF \
            -DLLAMA_BUILD_EXAMPLES=OFF \
            -DLLAMA_BUILD_SERVER=OFF \
            -DLLAMA_BUILD_SHARED_LIB=ON && \
        ninja -C build -j$(nproc) && \
        echo "llama.cpp build completed"; \
    else \
        echo "LLM disabled"; \
        mkdir -p /opt/llama.cpp/build/lib; \
    fi

# ============================================================================
# Stage 4: build - Compile ThemisDB
# ============================================================================
FROM deps AS build

ARG THEMIS_EDITION=COMMUNITY
ARG ENABLE_LLM=OFF
ARG TARGETARCH=amd64

WORKDIR /src

# Copy source code
COPY CMakeLists.txt CMakePresets.json VERSION ./
COPY cmake ./cmake
COPY include ./include
COPY src ./src
COPY proto ./proto
COPY internal ./internal

# Copy vcpkg config from deps stage (not from host!)
COPY --from=deps /build/vcpkg.json ./vcpkg.json
COPY --from=deps /build/vcpkg-configuration.json ./vcpkg-configuration.json

# Copy vcpkg installed packages
COPY --from=deps /build/vcpkg_installed /build/vcpkg_installed

# Copy llama.cpp
COPY --from=llama /opt/llama.cpp /opt/llama.cpp

# Ensure system RocksDB dev headers/libs for build
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
        librocksdb-dev && \
    rm -rf /var/lib/apt/lists/*

# Build ThemisDB
# Note: GPU backends (Vulkan/CUDA) are enabled by default in COMMUNITY/ENTERPRISE/HYPERSCALER
# via CMake edition defaults. For CPU-only Docker builds, explicitly disable with:
# --build-arg FORCE_CPU_ONLY=ON
ARG FORCE_CPU_ONLY=OFF

RUN set -eux; \
    TRIPLET=$(cat /tmp/triplet.txt); \
    echo "Building ThemisDB ${THEMIS_EDITION} (LLM=${ENABLE_LLM}, FORCE_CPU_ONLY=${FORCE_CPU_ONLY})..."; \
    echo "TRIPLET=${TRIPLET}"; \
    ls -la /build/vcpkg_installed/${TRIPLET} 2>/dev/null | head -20 || echo "No vcpkg_installed"; \
    \
    EXTRA_ARGS=""; \
    if [ "${FORCE_CPU_ONLY}" = "ON" ]; then \
        echo "FORCE_CPU_ONLY=ON: Disabling GPU backends for Docker CPU-only build"; \
        EXTRA_ARGS="-DTHEMIS_ENABLE_VULKAN=OFF -DTHEMIS_ENABLE_CUDA=OFF"; \
    else \
        echo "Using edition defaults: COMMUNITY/ENTERPRISE/HYPERSCALER have Vulkan=ON by default"; \
        echo "Note: Vulkan SDK not installed in container, runtime will use CPU fallback"; \
        echo "For GPU support in container, install Vulkan SDK in base stage and mount /dev/dri"; \
    fi; \
    \
    cmake --preset docker-release \
        -DTHEMIS_EDITION="${THEMIS_EDITION}" \
        -DTHEMIS_ENABLE_LLM="${ENABLE_LLM}" \
        -DVCPKG_TARGET_TRIPLET="${TRIPLET}" \
        -DCMAKE_PREFIX_PATH="/build/vcpkg_installed/${TRIPLET};/build/vcpkg_installed/${TRIPLET}/share;/build/vcpkg_installed/${TRIPLET}/lib/cmake" \
        -DOPENSSL_ROOT_DIR="/build/vcpkg_installed/${TRIPLET}" \
        -DOpenSSL_DIR="/build/vcpkg_installed/${TRIPLET}/share/openssl" \
        ${EXTRA_ARGS} && \
    ninja -C build -j$(nproc)

# ============================================================================
# Stage 5: runtime - Production image
# ============================================================================
FROM ubuntu:24.04 AS runtime

ARG THEMIS_EDITION=COMMUNITY

ENV DEBIAN_FRONTEND=noninteractive
ENV THEMIS_EDITION=${THEMIS_EDITION}

WORKDIR /app

# Install runtime dependencies
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates librocksdb-dev libgrpc++1 libprotobuf32 curl && \
    rm -rf /var/lib/apt/lists/*

# Copy binary
COPY --from=build /src/build/themis_server /app/themis_server

# Copy llama.cpp libraries
COPY --from=llama /opt/llama.cpp/build/lib* /usr/local/lib/

RUN ldconfig

EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

ENTRYPOINT ["/app/themis_server"]

# ============================================================================
# Stage 6: debug - Development/debugging image
# ============================================================================
FROM ubuntu:24.04 AS debug

ARG THEMIS_EDITION=COMMUNITY

ENV DEBIAN_FRONTEND=noninteractive
ENV THEMIS_EDITION=${THEMIS_EDITION}

WORKDIR /app

# Install debug tools
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates librocksdb-dev libgrpc++1 libprotobuf32 curl \
        gdb strace htop less nano git telnet netcat-openbsd && \
    rm -rf /var/lib/apt/lists/*

# Copy binary and sources
COPY --from=build /src /src
COPY --from=build /src/build/themis_server /app/themis_server

# Copy llama.cpp libraries
COPY --from=llama /opt/llama.cpp/build/lib* /usr/local/lib/

RUN ldconfig

EXPOSE 8080
ENTRYPOINT ["/app/themis_server"]
