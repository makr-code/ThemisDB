# ThemisDB v1.3.4 Runtime Image - Using Release Archive
# Uses pre-built binaries from Linux release

FROM ubuntu:24.04

# Docker Image Labels (OCI Standard)
LABEL org.opencontainers.image.title="ThemisDB" \
      org.opencontainers.image.description="High-Performance Multi-Model Database with Vector Search, Graph, Geospatial and Full-Text capabilities" \
      org.opencontainers.image.version="1.3.4" \
      org.opencontainers.image.created="2025-12-29" \
      org.opencontainers.image.authors="ThemisDB Team" \
      org.opencontainers.image.url="https://github.com/makr-code/ThemisDB" \
      org.opencontainers.image.documentation="https://github.com/makr-code/ThemisDB/tree/main/docs" \
      org.opencontainers.image.source="https://github.com/makr-code/ThemisDB" \
      org.opencontainers.image.vendor="ThemisDB" \
      org.opencontainers.image.licenses="MIT"

# Install runtime dependencies (including curl for healthcheck and jq for entrypoint)
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libssl3 \
    libstdc++6 \
    libc6 \
    libzstd1 \
    libbrotli1 \
    libcurl4 \
    curl \
    jq \
    && rm -rf /var/lib/apt/lists/*

# Create themis user
RUN groupadd -r themis --gid=999 && \
    useradd -r -g themis -u 999 -m -d /home/themis -s /bin/bash themis

# Environment Variables (PostgreSQL-Style Configuration)
ENV THEMIS_DATA_DIR=/var/lib/themisdb \
    THEMIS_PORT=18765 \
    THEMIS_HOST=0.0.0.0 \
    THEMIS_WORKER_THREADS=8 \
    THEMIS_CONFIG_PATH=/etc/themis/config.json \
    THEMIS_ROCKSDB_PATH=/var/lib/themisdb/data \
    THEMIS_VECTOR_INDEX_PATH=/var/lib/themisdb/vector_indexes \
    THEMIS_MEMTABLE_SIZE_MB=256 \
    THEMIS_BLOCK_CACHE_SIZE_MB=1024 \
    THEMIS_ENABLE_TRACING=false \
    THEMIS_ENABLE_SEMANTIC_CACHE=true \
    THEMIS_ENABLE_LLM_STORE=true \
    THEMIS_ENABLE_CDC=true \
    THEMIS_ENABLE_TIMESERIES=true \
    LD_LIBRARY_PATH=/usr/local/lib/themisdb:/usr/local/lib

# Create directory structure
RUN mkdir -p /app \
    /data \
    /var/lib/themisdb/data \
    /var/lib/themisdb/vector_indexes \
    /var/log/themis \
    /etc/themis \
    && chown -R themis:themis \
       /data \
       /var/lib/themisdb \
       /var/log/themis \
       /etc/themis

WORKDIR /app

# Copy and extract release archive
COPY docker/themis-linux.tar.gz /tmp/
RUN tar -xzf /tmp/themis-linux.tar.gz -C /tmp && \
    cp /tmp/linux-x64/bin/themis_server /app/ && \
    cp /tmp/linux-x64/bin/themis_demo /app/ && \
    rm -rf /tmp/themis-linux.tar.gz /tmp/linux-x64

# Copy default configuration and entrypoint
COPY config/config.json /etc/themis/config.json
COPY docker/entrypoint.sh /usr/local/bin/entrypoint.sh

# Make binaries and entrypoint executable
RUN chmod +x /app/themis_server /app/themis_demo /usr/local/bin/entrypoint.sh && \
    chown -R themis:themis /app

# Switch to themis user
USER themis

# Expose ports (Core functionality)
EXPOSE 7687 8080 18765 4318

# Health check with HTTP endpoint
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

# Use entrypoint for proper initialization
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
