# Multi-Stage Dockerfile für ThemisDB Release-Packages
# Features: CPack-Paket-Erstellung (ZIP, DEB, RPM, etc.)

FROM themisdb/themisdb:hyperscaler AS package-builder

WORKDIR /build

# Copy build artifacts and CMake configuration from builder
COPY --from=themisdb/themisdb:hyperscaler /build/build /build/build

# Install packaging tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    cmake \
    cpack \
    dpkg-dev \
    rpm \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Run CPack to generate packages
RUN cd /build/build && \
    cpack -G "TGZ;DEB" && \
    ls -lh ThemisDB-* 2>/dev/null || ls -lh *.tar.gz *.deb *.rpm 2>/dev/null || echo "No packages generated"

# Export stage - copy packages only
FROM alpine:latest

WORKDIR /packages

# Copy all generated packages
COPY --from=package-builder /build/build/*.tar.gz* ./
COPY --from=package-builder /build/build/*.deb ./
COPY --from=package-builder /build/build/*.rpm ./

RUN ls -lh /packages

ENTRYPOINT ["/bin/sh", "-c", "echo 'Release packages in /packages:' && ls -lh /packages/ && echo 'Use: docker cp <container>:/packages <dest>'"]
