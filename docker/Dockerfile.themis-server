# Multi-Stage Dockerfile für ThemisDB Hyperscaler Edition (Hochoptimiert)
# Optimierungen: vcpkg Binary Cache, BuildKit Cache Mounts, ccache, Layer-Optimierung

FROM ubuntu:24.04 AS builder

ARG THEMIS_ENABLE_LLM=ON
ARG THEMIS_ENABLE_GPU=ON
ARG THEMIS_ENABLE_GRPC=ON
ARG CMAKE_BUILD_TYPE=Release
ARG THEMIS_BUILD_TESTS=OFF
ARG THEMIS_BUILD_BENCHMARKS=OFF
ARG VCPKG_BINARY_SOURCES="clear;default,readwrite"

# Install build dependencies (cached layer)
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    build-essential gcc g++ cmake git curl wget zip unzip tar pkg-config python3 \
    ninja-build ccache autoconf automake libtool flex bison \
    libssl-dev zlib1g-dev libcurl4-openssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Set environment
ENV CC=/usr/bin/gcc \
    CXX=/usr/bin/g++ \
    CMAKE_C_COMPILER=/usr/bin/gcc \
    CMAKE_CXX_COMPILER=/usr/bin/g++ \
    CCACHE_DIR=/ccache \
    VCPKG_BINARY_SOURCES=${VCPKG_BINARY_SOURCES}

# Bootstrap vcpkg (full clone for baseline support)
RUN git clone https://github.com/microsoft/vcpkg.git /vcpkg && \
    /vcpkg/bootstrap-vcpkg.sh -disableMetrics

WORKDIR /build

# Copy dependency manifests first (for better layer caching)
COPY CMakeLists.txt vcpkg.json vcpkg-configuration.json VERSION RELEASE_TYPE ./
COPY cmake/ cmake/

# Now copy source code early (needed for llama.cpp detection)
COPY src/ src/
COPY include/ include/
COPY proto/ proto/
COPY internal/ internal/
COPY scripts/ scripts/

# Clone llama.cpp into source (required by CMake)
RUN if [ "${THEMIS_ENABLE_LLM}" = "ON" ]; then \
        git clone --depth 1 --branch master https://github.com/ggerganov/llama.cpp.git llama.cpp; \
    fi

# Install vcpkg dependencies (cached separately from source changes)
RUN --mount=type=cache,target=/root/.cache/vcpkg \
    --mount=type=cache,target=/vcpkg/buildtrees \
    --mount=type=cache,target=/vcpkg/downloads \
    cmake -S . -B build-deps \
    -G Ninja \
    -DCMAKE_BUILD_TYPE=${CMAKE_BUILD_TYPE} \
    -DCMAKE_TOOLCHAIN_FILE=/vcpkg/scripts/buildsystems/vcpkg.cmake \
    -DVCPKG_TARGET_TRIPLET=x64-linux \
    -DTHEMIS_ENABLE_LLM=${THEMIS_ENABLE_LLM} \
    -DTHEMIS_ENABLE_GPU=${THEMIS_ENABLE_GPU} \
    -DTHEMIS_ENABLE_GRPC=${THEMIS_ENABLE_GRPC} \
    -DTHEMIS_BUILD_TESTS=OFF \
    -DTHEMIS_BUILD_BENCHMARKS=OFF

# Build with ccache and parallel jobs
RUN --mount=type=cache,target=/ccache \
    cmake --build build-deps --config ${CMAKE_BUILD_TYPE} --parallel 8

# ============================================================================
# Debug Stage (Development mit allen Tools)
# ============================================================================
FROM builder AS debug

# Install debugging tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    gdb lldb valgrind strace ltrace \
    vim-tiny nano less curl wget \
    net-tools iproute2 tcpdump \
    && rm -rf /var/lib/apt/lists/*

# Keep build artifacts and source for debugging
WORKDIR /build
EXPOSE 18765 8080 9090

# Debug config with verbose logging
RUN echo '{"port": 18765, "http_port": 8080, "data_dir": "/var/lib/themisdb", "log_level": "debug"}' > /etc/themis/config-debug.json

CMD ["/build/build-deps/cmake/themis_server", "--config", "/etc/themis/config-debug.json"]

# ============================================================================
# Release Stage (Production - minimal)
# ============================================================================
FROM ubuntu:24.04 AS release

ARG CMAKE_BUILD_TYPE=Release

# Install minimal runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libssl3 \
    libcurl4 \
    libstdc++6 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Copy only the binary
COPY --from=builder /build/build-deps/cmake/themis_server /usr/local/bin/themis_server
RUN chmod +x /usr/local/bin/themis_server

# Create non-root user
RUN useradd -r -s /bin/false themis && \
    mkdir -p /var/lib/themisdb /etc/themis && \
    chown -R themis:themis /var/lib/themisdb

# Minimal production config
RUN echo '{"port": 18765, "http_port": 8080, "data_dir": "/var/lib/themisdb", "log_level": "info"}' > /etc/themis/config.json

EXPOSE 18765 8080 9090

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD test -f /var/lib/themisdb/.health || exit 1

USER themis
WORKDIR /var/lib/themisdb

CMD ["/usr/local/bin/themis_server", "--config", "/etc/themis/config.json"]

# ============================================================================
# Default: Release Stage
# ============================================================================
FROM release
