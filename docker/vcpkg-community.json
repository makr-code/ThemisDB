{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "themisdb-community",
  "version": "1.4.0",
  "description": "ThemisDB COMMUNITY Edition - Standard deployment (optimized deps)",

  "dependencies": [
    "boost-filesystem",
    "boost-beast",
    "boost-uuid",
    "cpp-httplib",
    "fmt",
    "spdlog",
    "nlohmann-json",
    "simdjson",
    "tbb",
    "tl-expected",
    "yaml-cpp",
    {
      "name": "rocksdb",
      "features": ["lz4", "snappy", "zlib", "zstd"]
    },
    "protobuf",
    "grpc",
    "curl",
    "openssl",
    "zlib",
    "zstd",
    "lz4",
    "libzip",
    "pugixml",
    "snappy",
    "msgpack",
    "mimalloc",
    "gtest",
    "benchmark"
  ]
}
