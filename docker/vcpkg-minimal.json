{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "themisdb-minimal",
  "version": "1.4.0",
  "description": "ThemisDB Minimal Edition - Core database only (embedded/IoT)",
  "dependencies": [
    { "name": "rocksdb", "features": ["lz4", "zstd"] },
    { "name": "boost-system" },
    { "name": "boost-asio" },
    { "name": "boost-json" },
    { "name": "fmt" },
    { "name": "spdlog" },
    { "name": "nlohmann-json" },
    { "name": "zlib" },
    { "name": "zstd" },
    { "name": "lz4" }
  ]
}
