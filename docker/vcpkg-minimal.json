{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "themisdb-minimal",
  "version": "1.4.0",
  "description": "ThemisDB MINIMAL Edition - Embedded/IoT, minimal dependencies",
  "dependencies": [
    {
      "name": "rocksdb",
      "features": [
        "snappy",
        "zlib",
        "zstd"
      ]
    },
    "cpp-httplib",
    "simdjson",
    "tl-expected"
  ]
}
