# Dockerfile for ThemisDB HYPERSCALER Edition
# Optimized for large-scale multi-datacenter deployments
#
# Build:
#   docker build -f docker/Dockerfile.hyperscaler --build-arg ENABLE_LLM=ON -t themisdb:hyperscaler .
#
# Features:
# - Sharding & distributed transactions
# - Advanced RAID redundancy (RAID5, RAID6, RAID10)
# - Multi-region replication
# - GraphQL support
# - Optional LLM support
# - Full monitoring & metrics

# ============================================================================
# Stage 1: Builder - Minimal dependencies
# ============================================================================
FROM ubuntu:24.04 AS builder

ARG ENABLE_LLM=ON
ARG LLAMA_GIT_REF=master

ENV DEBIAN_FRONTEND=noninteractive
ENV THEMIS_EDITION=HYPERSCALER

# Install minimal build dependencies
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
    build-essential cmake ninja-build git curl ca-certificates python3 \
    && rm -rf /var/lib/apt/lists/*

# Bootstrap vcpkg (minimal - no aria2, simpler setup)
ENV VCPKG_ROOT=/opt/vcpkg
ENV VCPKG_DISABLE_METRICS=1

RUN git clone https://github.com/microsoft/vcpkg.git ${VCPKG_ROOT} && \
    cd ${VCPKG_ROOT} && \
    ./bootstrap-vcpkg.sh -disableMetrics

# Set build tools
ENV CC=/usr/bin/gcc
ENV CXX=/usr/bin/g++

WORKDIR /src

# Copy source files FIRST (before manifest)
COPY CMakeLists.txt VERSION ./
COPY include ./include
COPY cmake ./cmake
COPY src ./src
COPY vcpkg.json ./

# Clone llama.cpp if needed
RUN if [ "$ENABLE_LLM" = "ON" ]; then \
        echo "Cloning llama.cpp for LLM support"; \
        git clone --depth=1 https://github.com/ggerganov/llama.cpp.git /src/llama.cpp && \
        (cd /src/llama.cpp && git fetch --depth=1 origin ${LLAMA_GIT_REF} || true && git checkout ${LLAMA_GIT_REF} || true); \
    fi

# Build ThemisDB HYPERSCALER Edition
RUN echo "=== Building ThemisDB HYPERSCALER Edition ===" && \
    cmake -S . -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_C_COMPILER=gcc \
        -DCMAKE_CXX_COMPILER=g++ \
        -DCMAKE_MAKE_PROGRAM=/usr/bin/ninja \
        -DCMAKE_TOOLCHAIN_FILE=${VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake \
        -DVCPKG_TARGET_TRIPLET=x64-linux \
        -DTHEMIS_BUILD_TESTS=OFF \
        -DTHEMIS_BUILD_BENCHMARKS=OFF \
        -DTHEMIS_ENABLE_TRACING=OFF \
        -DTHEMIS_EDITION=HYPERSCALER \
        -DTHEMIS_ENABLE_LLM=${ENABLE_LLM} \
        -DTHEMIS_ENABLE_GRAPHQL=ON \
        -DTHEMIS_ENABLE_VISION=OFF && \
    ninja -C build -j$(nproc) && \
    ls -lh /src/build/themis_server || (echo "Build failed - themis_server not found" && exit 1)

# ============================================================================
# Stage 2: Runtime
# ============================================================================
FROM ubuntu:24.04 AS runtime

ENV DEBIAN_FRONTEND=noninteractive

ARG THEMIS_VERSION=1.4.0
LABEL org.opencontainers.image.title="ThemisDB HYPERSCALER Edition" \
    org.opencontainers.image.description="Enterprise multi-datacenter deployment" \
    org.opencontainers.image.version="$THEMIS_VERSION"

# Install runtime dependencies only
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
    ca-certificates curl libstdc++6 \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN groupadd -r themis --gid=999 && \
    useradd -r -g themis --uid=999 --home-dir=/var/lib/themisdb themis

# Copy binary from builder
COPY --from=builder --chown=themis:themis /src/build/themis_server /usr/local/bin/themis_server

# Copy entrypoint
COPY docker/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

# Setup config directory
RUN mkdir -p /etc/themis && \
    chown themis:themis /etc/themis && chmod 755 /etc/themis
COPY config/config.json /etc/themis/config.json

# Create data directory
RUN mkdir -p /var/lib/themisdb && \
    chown themis:themis /var/lib/themisdb && chmod 700 /var/lib/themisdb

# Copy any runtime libraries from builder if needed
COPY --from=builder --chown=themis:themis /src/vcpkg_installed/x64-linux/lib/*.so* /usr/local/lib/ 2>/dev/null || true
RUN ldconfig || true

# Expose ports
EXPOSE 8080 18765 4318

# Health check
HEALTHCHECK --interval=10s --timeout=3s --start-period=15s --retries=3 \
    CMD curl -fsSL http://localhost:8080/health || exit 1

# Switch to themis user
USER themis
WORKDIR /var/lib/themisdb

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["--config", "/etc/themis/config.json"]
