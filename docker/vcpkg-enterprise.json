{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "themisdb-enterprise",
  "version": "1.4.0",
  "description": "ThemisDB Enterprise Edition - Extended dependencies",
  "dependencies": [
    { "name": "rocksdb", "features": ["lz4", "zstd"] },
    { "name": "simdjson" },
    { "name": "boost-system" },
    { "name": "boost-asio" },
    { "name": "boost-beast" },
    { "name": "boost-json" },
    { "name": "boost-optional" },
    { "name": "boost-thread" },
    { "name": "boost-regex" },
    { "name": "fmt" },
    { "name": "spdlog" },
    { "name": "nlohmann-json" },
    { "name": "curl", "features": ["openssl"] },
    { "name": "openssl", "version>=": "3.0" },
    { "name": "zlib" },
    { "name": "zstd" },
    { "name": "lz4" },
    { "name": "snappy" },
    { "name": "brotli" },
    { "name": "re2" },
    { "name": "yaml-cpp" },
    { "name": "grpc" },
    { "name": "protobuf" },
    { "name": "prometheus-cpp" }
  ]
}
