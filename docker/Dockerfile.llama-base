# syntax=docker/dockerfile:1.6
# ============================================================================
# llama-base - Pre-built llama.cpp for LLM support
# ============================================================================
# Build once, reuse in all LLM-enabled builds
#
# Build:
#   docker buildx build -f docker/Dockerfile.llama-base -t themisdb/llama-base:latest .
#   docker push themisdb/llama-base:latest

ARG VCPKG_BASE_VERSION=2024.10.21
FROM themisdb/vcpkg-base:${VCPKG_BASE_VERSION}

ARG LLAMA_GIT_REF=master

LABEL org.opencontainers.image.title="llama.cpp base image" \
      org.opencontainers.image.description="Pre-compiled llama.cpp for ThemisDB LLM support" \
      org.opencontainers.image.version="local"

# Copy and build local llama.cpp from repository
COPY llama.cpp /opt/llama.cpp
RUN cd /opt/llama.cpp && \
    echo "Building local llama.cpp..." && \
    cmake -S . -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DLLAMA_BUILD_TESTS=OFF \
        -DLLAMA_BUILD_EXAMPLES=OFF \
        -DLLAMA_BUILD_SERVER=OFF \
        -DLLAMA_BUILD_SHARED_LIB=ON && \
    ninja -C build -j$(nproc) && \
    ninja -C build install && \
    ldconfig && \
    echo "llama.cpp installed successfully" && \
    ldd /usr/local/lib/libllama*.so* || true

# Verify installation
RUN test -f /usr/local/lib/libllama.so && \
    test -d /usr/local/include/llama.h || test -d /opt/llama.cpp/include && \
    echo "✅ llama.cpp build verified"

CMD ["/bin/bash"]
