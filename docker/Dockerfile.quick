# Quick Docker build for testing optimized ThemisDB
# Uses pre-built binaries from the repository

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# Install runtime dependencies only (not build tools)
RUN apt-get update && apt-get install -y --no-install-recommends \
    openssl libssl3 ca-certificates curl wget \
    python3 python3-pip python3-dev \
    librocksdb6 \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies for benchmarking
RUN pip3 install --no-cache-dir \
    numpy pandas matplotlib seaborn \
    sqlalchemy pymongo psycopg2-binary \
    redis

# Copy the application
WORKDIR /app

# Copy source code (will be compiled with optimizations)
COPY . /app

# Copy pre-built binaries from build directory (if available)
# Otherwise, they will be compiled during build
RUN if [ -d "/app/build-wsl/Release" ]; then \
    cp /app/build-wsl/Release/themis_server /usr/local/bin/ || true; \
    cp /app/build-wsl/Release/themis_tests /usr/local/bin/ || true; \
  elif [ -d "/app/build-msvc/Release" ]; then \
    cp /app/build-msvc/Release/themis_server* /usr/local/bin/ || true; \
  fi

# Create benchmark results directory
RUN mkdir -p /app/benchmark_results /results

# Create non-root user for security
RUN groupadd -r themis --gid=999 && \
    useradd -r -g themis --uid=999 --home-dir=/app --shell=/bin/bash themis && \
    chown -R themis:themis /app /results

# Run as non-root user
USER themis

# Default command: run benchmarks
CMD ["python3", "/app/benchmarks/run_complete_benchmarks.py"]

EXPOSE 8765 8080
