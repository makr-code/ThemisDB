# QNAP-compatible Dockerfile (Ubuntu 20.04 for GLIBC 2.31)
# Build themis_server in this container to ensure QNAP compatibility

FROM ubuntu:20.04 AS builder
ENV DEBIAN_FRONTEND=noninteractive

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    ninja-build \
    git \
    curl \
    zip \
    unzip \
    tar \
    pkg-config \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Upgrade CMake (Ubuntu 20.04 ships 3.16, vcpkg needs 3.21+)
RUN curl -L -o cmake.sh https://github.com/Kitware/CMake/releases/download/v3.28.1/cmake-3.28.1-linux-x86_64.sh && \
    sh cmake.sh --skip-license --prefix=/usr/local && \
    rm cmake.sh

# Install vcpkg
WORKDIR /opt
RUN git clone https://github.com/Microsoft/vcpkg.git && \
    cd vcpkg && \
    git checkout 2024.10.21 && \
    ./bootstrap-vcpkg.sh

ENV VCPKG_ROOT=/opt/vcpkg
ENV PATH="${VCPKG_ROOT}:${PATH}"

# Copy source
WORKDIR /build
COPY . .

# Build ThemisDB
RUN cmake -B build-release -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_TOOLCHAIN_FILE=${VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake \
    -DVCPKG_MANIFEST_MODE=ON && \
    cmake --build build-release --target themis_server -j$(nproc)

# Runtime stage - Ubuntu 20.04 for GLIBC 2.31 compatibility
FROM ubuntu:20.04 AS runtime
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libstdc++6 \
    && rm -rf /var/lib/apt/lists/*

# Copy built binary from builder
COPY --from=builder /build/build-release/themis_server /usr/local/bin/themis_server

RUN mkdir -p /etc/themis /usr/local/share/themis /data /var/log/themis && \
    chmod +x /usr/local/bin/themis_server

ENV THEMIS_CONFIG_PATH=/etc/themis/config.json
ENV THEMIS_PORT=18765

VOLUME ["/data"]
EXPOSE 8080 18765

ENTRYPOINT ["/usr/local/bin/themis_server"]
CMD ["--config", "/etc/themis/config.json"]
