{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 23, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "description": "Base preset: Ninja generator with standard compiler cache settings",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_SUPPRESS_DEVELOPER_WARNINGS": "ON",
        "THEMIS_ENABLE_COMPILER_CACHE": "ON",
        "THEMIS_COMPILER_CACHE_PROGRAM": "sccache",
        "THEMIS_BUILD_TESTS": "ON",
        "THEMIS_BUILD_BENCHMARKS": "OFF"
      }
    },
    {
      "name": "vcpkg-base",
      "hidden": true,
      "description": "vcpkg-enabled base: Configures CMAKE_TOOLCHAIN_FILE and VCPKG_INSTALLED_DIR. Required by linux-release and windows-release. Requires: vcpkg repo cloned to ./vcpkg and bootstrapped",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed"
      }
    },
    {
      "name": "windows-base",
      "hidden": true,
      "description": "Windows base: MSVC x64 with vcpkg and GPU support. Requires: Windows 10/11, MSVC 2022+, Ninja, vcpkg",
      "inherits": "vcpkg-base",
      "environment": {
        "CMAKE_BUILD_PARALLEL_LEVEL": "16",
        "SCCACHE_DIR": "$penv{USERPROFILE}/.cache/sccache/themisdb"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "THEMIS_MSVC_ENV_INIT_MODE": "AUTO",
        "CMAKE_TRY_COMPILE_TARGET_TYPE": "STATIC_LIBRARY",
        "Z_VCPKG_OPENSSL_USE_SINGLE_CONFIG": "1",
        "THEMIS_ENABLE_GPU": "ON",
        "THEMIS_ENABLE_HTTP_SERVER": "ON"
      }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "description": "Linux base: GCC x64 with vcpkg and GPU support. Requires: Linux, GCC 11+, Ninja, vcpkg. Fallback: Use community-release preset with system packages",
      "inherits": "vcpkg-base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "VCPKG_TARGET_TRIPLET": "x64-linux",
        "THEMIS_ENABLE_GPU": "ON",
        "THEMIS_ENABLE_HTTP_SERVER": "ON"
      }
    },
    {
      "name": "windows-release",
      "displayName": "Windows x64: Release (vcpkg required)",
      "description": "Production release build for Windows. Requires: Windows 10/11, MSVC 2022+, Ninja, vcpkg. See SETUP.md for setup instructions.",
      "inherits": "windows-base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "binaryDir": "${sourceDir}/build-msvc-windows-release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "THEMIS_EDITION": "COMMUNITY" }
    },
    {
      "name": "windows-release-minimal",
      "displayName": "Windows x64: Release Minimal (vcpkg required)",
      "description": "Troubleshooting preset for Windows: disables optional heavy/network features and pins try-compile/runtime settings.",
      "inherits": "windows-base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "binaryDir": "${sourceDir}/build-msvc-windows-release-minimal",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TRY_COMPILE_CONFIGURATION": "Release",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreadedDLL",
        "THEMIS_MSVC_ENV_INIT_MODE": "AUTO",
        "THEMIS_EDITION": "COMMUNITY",
        "THEMIS_ENABLE_GPU": "OFF",
        "THEMIS_ENABLE_LLM": "OFF",
        "THEMIS_ENABLE_CUDA": "OFF",
        "THEMIS_ENABLE_HTTP3": "OFF",
        "THEMIS_ENABLE_GRPC": "OFF",
        "THEMIS_ENABLE_MQTT": "OFF",
        "THEMIS_ENABLE_MCP": "OFF",
        "THEMIS_ENABLE_POSTGRES_WIRE": "OFF",
        "THEMIS_BUILD_BENCHMARKS": "OFF"
      }
    },
    {
      "name": "windows-release-community-qa",
      "displayName": "Windows x64: Community QA (CTest + Benchmarks)",
      "description": "Community release QA profile with unit/integration tests and benchmarks enabled.",
      "inherits": "windows-release",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "binaryDir": "${sourceDir}/build-msvc-windows-community-qa",
      "cacheVariables": {
        "CMAKE_TRY_COMPILE_CONFIGURATION": "Release",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreadedDLL",
        "THEMIS_MSVC_ENV_INIT_MODE": "AUTO",
        "THEMIS_EDITION": "COMMUNITY",
        "THEMIS_BUILD_TESTS": "ON",
        "THEMIS_BUILD_BENCHMARKS": "ON"
      }
    },
    {
      "name": "windows-release-community-qa-minimal",
      "displayName": "Windows x64: Community QA Minimal (CTest + Benchmarks)",
      "description": "Troubleshooting QA profile: tests and benchmarks enabled, heavy optional features disabled.",
      "inherits": "windows-release-minimal",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "binaryDir": "${sourceDir}/build-msvc-windows-community-qa-minimal",
      "cacheVariables": {
        "THEMIS_MSVC_ENV_INIT_MODE": "AUTO",
        "THEMIS_EDITION": "COMMUNITY",
        "THEMIS_BUILD_TESTS": "ON",
        "THEMIS_BUILD_BENCHMARKS": "ON"
      }
    },
    {
      "name": "windows-debug",
      "displayName": "Windows x64: Debug (vcpkg required)",
      "description": "Development debug build for Windows. Requires: Windows 10/11, MSVC 2022+, Ninja, vcpkg. See SETUP.md for setup instructions.",
      "inherits": "windows-base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "binaryDir": "${sourceDir}/build-msvc-windows-debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "THEMIS_EDITION": "COMMUNITY", "THEMIS_MSVC_ENV_INIT_MODE": "AUTO" }
    },
    {
      "name": "linux-release",
      "displayName": "Linux x64: Release (vcpkg required)",
      "description": "Production release build for Linux with vcpkg. Requires: Linux, GCC 11+, Ninja, vcpkg. Fallback: Use community-release preset for system package builds. See SETUP.md for setup instructions.",
      "inherits": "linux-base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "binaryDir": "${sourceDir}/build-gcc-linux-release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "THEMIS_EDITION": "COMMUNITY" }
    },
    {
      "name": "linux-debug",
      "displayName": "Linux x64: Debug (vcpkg required)",
      "description": "Development debug build for Linux with vcpkg. Requires: Linux, GCC 11+, Ninja, vcpkg. Fallback: Use community-release preset for system package builds. See SETUP.md for setup instructions.",
      "inherits": "linux-base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "binaryDir": "${sourceDir}/build-gcc-linux-debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "THEMIS_EDITION": "COMMUNITY" }
    },
    {
      "name": "community-release",
      "displayName": "Configure: Community Release (system packages, no vcpkg)",
      "description": "Fallback preset: Uses system-installed packages instead of vcpkg. Requires: Linux/macOS, GCC/Clang, Ninja, system development packages (librocksdb-dev, libssl-dev, zlib1g-dev, etc.). Use this when vcpkg is unavailable. See SETUP.md for system package installation guide.",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build-community-release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "THEMIS_EDITION": "COMMUNITY" }
    },
    {
      "name": "nightly-bench-sweep",
      "displayName": "Nightly Benchmark Sweep (vcpkg required)",
      "description": "Nightly benchmark sweep: Linux release with benchmarks enabled, GPU and LLM disabled. Requires: Linux, GCC 11+, Ninja, vcpkg. See SETUP.md for setup instructions.",
      "inherits": "linux-base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "binaryDir": "${sourceDir}/build-gcc-linux-nightly",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "THEMIS_BUILD_BENCHMARKS": "ON", "THEMIS_ENABLE_GPU": "OFF", "THEMIS_ENABLE_LLM": "OFF" }
    }
    ,
    {
      "name": "hyperscaler-debug-windows",
     "displayName": "Hyperscaler Debug (Windows) — Requires License",
     "description": "Hyperscaler debug build for Windows with benchmarks enabled. NOTE: HYPERSCALER Edition requires mandatory license for all builds (no Debug exception). Requires: Windows 10/11, MSVC 2022+, Ninja, vcpkg, and THEMIS_LICENSE_FILE. Usage: cmake --preset hyperscaler-debug-windows -DTHEMIS_LICENSE_FILE=/path/to/hyperscaler-license.json. See docs/de/deployment/LICENSE_REQUIREMENTS.md for details.",
     "inherits": "windows-base",
     "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
     "binaryDir": "${sourceDir}/build-hyperscaler-windows-debug",
     "cacheVariables": {
       "CMAKE_BUILD_TYPE": "Debug",
       "THEMIS_EDITION": "HYPERSCALER",
       "THEMIS_BUILD_BENCHMARKS": "ON",
       "THEMIS_BUILD_TESTS": "ON",
       "THEMIS_MSVC_ENV_INIT_MODE": "AUTO"
     }
    },
    {
      "name": "hyperscaler-debug-linux",
      "displayName": "Hyperscaler Debug (Linux) (vcpkg required)",
      "description": "Hyperscaler debug build for Linux with benchmarks enabled. Requires: Linux, GCC 11+, Ninja, vcpkg. See SETUP.md for setup instructions.",
      "inherits": "linux-base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "binaryDir": "${sourceDir}/build-hyperscaler-linux-debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "THEMIS_EDITION": "HYPERSCALER", "THEMIS_BUILD_BENCHMARKS": "ON", "THEMIS_BUILD_TESTS": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "windows-release", "configurePreset": "windows-release", "jobs": 16 },
    { "name": "windows-release-minimal", "configurePreset": "windows-release-minimal", "jobs": 16 },
    { "name": "windows-release-community-qa", "configurePreset": "windows-release-community-qa", "jobs": 16 },
    { "name": "windows-release-community-qa-minimal", "configurePreset": "windows-release-community-qa-minimal", "jobs": 16 },
    { "name": "windows-debug", "configurePreset": "windows-debug", "jobs": 4 },
    { "name": "hyperscaler-debug-windows", "configurePreset": "hyperscaler-debug-windows", "jobs": 16 },
    { "name": "linux-release", "configurePreset": "linux-release" },
    { "name": "linux-debug", "configurePreset": "linux-debug" },
    { "name": "community-release", "configurePreset": "community-release" },
    { "name": "nightly-bench-sweep", "configurePreset": "nightly-bench-sweep" }
  ],
  "testPresets": [
    { "name": "windows-release", "configurePreset": "windows-release" },
    { "name": "windows-release-minimal", "configurePreset": "windows-release-minimal" },
    { "name": "windows-release-community-qa", "configurePreset": "windows-release-community-qa" },
    { "name": "windows-release-community-qa-minimal", "configurePreset": "windows-release-community-qa-minimal" },
    { "name": "hyperscaler-debug-windows", "configurePreset": "hyperscaler-debug-windows" },
    { "name": "linux-release", "configurePreset": "linux-release" },
    { "name": "community-release", "configurePreset": "community-release" }
  ],
  "workflowPresets": [
    { "name": "windows-release", "steps": [ { "type": "configure", "name": "windows-release" }, { "type": "build", "name": "windows-release" }, { "type": "test", "name": "windows-release" } ] },
    { "name": "windows-release-minimal", "steps": [ { "type": "configure", "name": "windows-release-minimal" }, { "type": "build", "name": "windows-release-minimal" }, { "type": "test", "name": "windows-release-minimal" } ] },
    { "name": "windows-release-community-qa", "steps": [ { "type": "configure", "name": "windows-release-community-qa" }, { "type": "build", "name": "windows-release-community-qa" }, { "type": "test", "name": "windows-release-community-qa" } ] },
    { "name": "windows-release-community-qa-minimal", "steps": [ { "type": "configure", "name": "windows-release-community-qa-minimal" }, { "type": "build", "name": "windows-release-community-qa-minimal" }, { "type": "test", "name": "windows-release-community-qa-minimal" } ] },
    { "name": "hyperscaler-debug-windows", "steps": [ { "type": "configure", "name": "hyperscaler-debug-windows" }, { "type": "build", "name": "hyperscaler-debug-windows" }, { "type": "test", "name": "hyperscaler-debug-windows" } ] },
    { "name": "linux-release", "steps": [ { "type": "configure", "name": "linux-release" }, { "type": "build", "name": "linux-release" }, { "type": "test", "name": "linux-release" } ] },
    { "name": "community-release", "steps": [ { "type": "configure", "name": "community-release" }, { "type": "build", "name": "community-release" }, { "type": "test", "name": "community-release" } ] }
  ]
}
