    },
    {
      "name": "linux-arm64-debug",
      "displayName": "Workflow: Linux arm64 Debug (Configure → Build → Test)",
      "steps": [
        { "type": "configure", "name": "linux-arm64-debug" },
        { "type": "build",     "name": "linux-arm64-debug" },
        { "type": "test",      "name": "linux-arm64-debug" }
      ]
    },
    {
      "name": "docker-release",
      "displayName": "Workflow: Docker Release (Configure → Build)",
      "steps": [
        { "type": "configure", "name": "docker-release" },
        { "type": "build",     "name": "docker-release" }
      ]
    },
    {
      "name": "linux-asan",
      "displayName": "Workflow: Linux x64 AddressSanitizer (Configure → Build → Test)",
      "steps": [
        { "type": "configure", "name": "linux-asan" },
        { "type": "build",     "name": "linux-asan" },
        { "type": "test",      "name": "linux-asan" }
      ]
    },
    {
      "name": "linux-ubsan",
      "displayName": "Workflow: Linux x64 UndefinedBehaviorSanitizer (Configure → Build → Test)",
      "steps": [
        { "type": "configure", "name": "linux-ubsan" },
        { "type": "build",     "name": "linux-ubsan" },
        { "type": "test",      "name": "linux-ubsan" }
      ]
    },
    {
      "name": "linux-tsan",
      "displayName": "Workflow: Linux x64 ThreadSanitizer (Configure → Build → Test)",
      "steps": [
        { "type": "configure", "name": "linux-tsan" },
        { "type": "build",     "name": "linux-tsan" },
        { "type": "test",      "name": "linux-tsan" }
      ]
    },
    {
      "name": "linux-coverage",
      "displayName": "Workflow: Linux x64 Coverage (Configure → Build → Test)",
      "steps": [
        { "type": "configure", "name": "linux-coverage" },
        { "type": "build",     "name": "linux-coverage" },
        { "type": "test",      "name": "linux-coverage" }
      ]
    },
    {
      "name": "linux-strict",
      "displayName": "Workflow: Linux x64 Strict / CI (Configure → Build → Test)",
      "steps": [
        { "type": "configure", "name": "linux-strict" },
        { "type": "build",     "name": "linux-strict" },
        { "type": "test",      "name": "linux-strict" }
      ]
    }
  ]
}
