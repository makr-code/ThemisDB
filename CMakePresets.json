{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_SUPPRESS_DEVELOPER_WARNINGS": "ON",
        "THEMIS_ENABLE_COMPILER_CACHE": "ON",
        "THEMIS_COMPILER_CACHE_PROGRAM": "",
        "THEMIS_BUILD_TESTS": "ON",
        "THEMIS_BUILD_BENCHMARKS": "OFF",
        "THEMIS_BUILD_CHIMERA": "OFF",
        "THEMIS_ENABLE_TRACING": "OFF",
        "THEMIS_ENABLE_ASAN": "OFF",
        "THEMIS_STRICT_BUILD": "OFF"
      }
    },
    {
      "name": "vcpkg-base",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed"
      }
    },
    {
      "name": "windows-base",
      "hidden": true,
      "inherits": "vcpkg-base",
      "environment": {
        "VCPKG_POWERSHELL_PATH": "$env{LOCALAPPDATA}/Microsoft/WindowsApps/pwsh.exe",
        "Z_VCPKG_POWERSHELL_PATH": "$env{LOCALAPPDATA}/Microsoft/WindowsApps/pwsh.exe",
        "Z_VCPKG_PWSH_PATH": "$env{LOCALAPPDATA}/Microsoft/WindowsApps/pwsh.exe",
        "SCCACHE_DIR": "$env{LOCALAPPDATA}/Mozilla/sccache/themisdb",
        "SCCACHE_ERROR_LOG": "${sourceDir}/logs/sccache-error.log",
        "INCLUDE": "C:/Program Files/Microsoft Visual Studio/2022/Professional/VC/Tools/MSVC/14.44.35207/include;C:/Program Files (x86)/Windows Kits/10/Include/10.0.26100.0/ucrt;C:/Program Files (x86)/Windows Kits/10/Include/10.0.26100.0/um;C:/Program Files (x86)/Windows Kits/10/Include/10.0.26100.0/shared;C:/Program Files (x86)/Windows Kits/10/Include/10.0.26100.0/winrt;C:/Program Files (x86)/Windows Kits/10/Include/10.0.26100.0/cppwinrt;$penv{INCLUDE}",
        "LIB": "C:/Program Files/Microsoft Visual Studio/2022/Professional/VC/Tools/MSVC/14.44.35207/lib/x64;C:/Program Files (x86)/Windows Kits/10/Lib/10.0.26100.0/ucrt/x64;C:/Program Files (x86)/Windows Kits/10/Lib/10.0.26100.0/um/x64;$penv{LIB}"
      },
      "cacheVariables": {
        "CMAKE_VS_RUNTIME_LIBRARY": "MultiThreadedDLL",
        "CMAKE_C_COMPILER_LAUNCHER": "sccache",
        "CMAKE_CXX_COMPILER_LAUNCHER": "sccache",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "THEMIS_ENABLE_GPU": "ON",
        "THEMIS_ENABLE_HTTP_SERVER": "ON",
        "THEMIS_ENABLE_LLM": "ON",
        "THEMIS_BUILD_MODULAR": "ON",
        "THEMIS_CORE_SHARED": "ON"
      }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "inherits": "vcpkg-base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_C_COMPILER_LAUNCHER": "sccache",
        "CMAKE_CXX_COMPILER_LAUNCHER": "sccache",
        "VCPKG_TARGET_TRIPLET": "x64-linux",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed_linux",
        "THEMIS_ENABLE_GPU": "ON",
        "THEMIS_ENABLE_HTTP_SERVER": "ON",
        "THEMIS_ENABLE_LLM": "ON"
      }
    },
    {
      "name": "linux-arm64-base",
      "hidden": true,
      "inherits": "vcpkg-base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "aarch64-linux-gnu-gcc",
        "CMAKE_CXX_COMPILER": "aarch64-linux-gnu-g++",
        "CMAKE_C_COMPILER_LAUNCHER": "sccache",
        "CMAKE_CXX_COMPILER_LAUNCHER": "sccache",
        "CMAKE_SYSTEM_NAME": "Linux",
        "CMAKE_SYSTEM_PROCESSOR": "aarch64",
        "VCPKG_TARGET_TRIPLET": "arm64-linux",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed_arm64",
        "THEMIS_ENABLE_GPU": "OFF",
        "THEMIS_ENABLE_HTTP_SERVER": "ON",
        "THEMIS_ENABLE_LLM": "ON"
      }
    },
    {
      "name": "windows-release",
      "displayName": "Windows x64: Release (MSVC + Ninja)",
      "description": "Release build for Windows x64 — run cmake from a VS Developer Command Prompt",
      "inherits": "windows-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "binaryDir": "${sourceDir}/build-msvc-windows-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "THEMIS_EDITION": "COMMUNITY",
        "THEMIS_ENABLE_LIRS_CACHE": "ON",
        "THEMIS_ENABLE_RCU_INDEX": "ON",
        "THEMIS_ENABLE_HUGE_PAGES": "ON",
        "THEMIS_ENABLE_WISCKEY": "ON",
        "THEMIS_ENABLE_RABITQ": "ON",
        "THEMIS_ENABLE_DISKANN": "ON",
        "THEMIS_ENABLE_WEBSOCKET": "ON"
      }
    },
    {
      "name": "windows-debug",
      "displayName": "Windows x64: Debug (MSVC + Ninja)",
      "description": "Debug build for Windows x64 — run cmake from a VS Developer Command Prompt",
      "inherits": "windows-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "binaryDir": "${sourceDir}/build-msvc-windows-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "THEMIS_EDITION": "COMMUNITY"
      }
    },
    {
      "name": "linux-release",
      "displayName": "Linux x64: Release (GCC + Ninja)",
      "description": "Release build for Linux x64 / Ubuntu with GCC, Ninja, vcpkg under sourceDir/vcpkg",
      "inherits": "linux-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "binaryDir": "${sourceDir}/build-gcc-linux-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "THEMIS_EDITION": "COMMUNITY"
      }
    },
    {
      "name": "linux-debug",
      "displayName": "Linux x64: Debug (GCC + Ninja)",
      "description": "Debug build for Linux x64 / Ubuntu with GCC, Ninja, vcpkg under sourceDir/vcpkg",
      "inherits": "linux-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "binaryDir": "${sourceDir}/build-gcc-linux-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "THEMIS_EDITION": "COMMUNITY"
      }
    },
    {
      "name": "nightly-bench-sweep",
      "displayName": "Nightly Benchmark Sweep (Linux x64)",
      "description": "Nightly benchmark sweep preset for CI (CPU-only, benchmarks enabled).",
      "inherits": "linux-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "binaryDir": "${sourceDir}/build-gcc-linux-nightly",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "THEMIS_EDITION": "COMMUNITY",
        "THEMIS_BUILD_TESTS": "OFF",
        "THEMIS_BUILD_BENCHMARKS": "ON",
        "THEMIS_ENABLE_GPU": "OFF",
        "THEMIS_ENABLE_LLM": "OFF",
        "THEMIS_ENABLE_ASAN": "OFF",
        "THEMIS_ENABLE_TRACING": "OFF"
      }
    },
    {
      "name": "nightly-bench-sweep-asan",
      "displayName": "Nightly Benchmark Sweep + ASan (Linux x64)",
      "description": "Nightly benchmark sweep preset with AddressSanitizer enabled for runtime memory checks.",
      "inherits": "nightly-bench-sweep",
      "binaryDir": "${sourceDir}/build-gcc-linux-nightly-asan",
      "cacheVariables": {
        "THEMIS_ENABLE_ASAN": "ON",
        "CMAKE_C_FLAGS": "-fsanitize=address -fno-omit-frame-pointer",
        "CMAKE_CXX_FLAGS": "-fsanitize=address -fno-omit-frame-pointer"
      }
    },
    {
      "name": "linux-arm64-release",
      "displayName": "Linux arm64: Release (GCC cross + Ninja)",
      "description": "Cross-compiled Release build for Linux arm64 — requires aarch64-linux-gnu-gcc toolchain",
      "inherits": "linux-arm64-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "binaryDir": "${sourceDir}/build-gcc-linux-arm64-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "THEMIS_EDITION": "COMMUNITY"
      }
    },
    {
      "name": "linux-arm64-debug",
      "displayName": "Linux arm64: Debug (GCC cross + Ninja)",
      "description": "Cross-compiled Debug build for Linux arm64 — requires aarch64-linux-gnu-gcc toolchain",
      "inherits": "linux-arm64-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "binaryDir": "${sourceDir}/build-gcc-linux-arm64-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "THEMIS_EDITION": "COMMUNITY"
      }
    },
    {
      "name": "docker-release",
      "displayName": "Docker: Linux Release (inside container)",
      "description": "Release build for Docker containers — vcpkg at /opt/vcpkg, installed packages at /build/vcpkg_installed. Override THEMIS_EDITION / THEMIS_ENABLE_LLM / VCPKG_TARGET_TRIPLET via -D on the command line.",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build-gcc-linux-docker-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_TOOLCHAIN_FILE": "/opt/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-linux",
        "VCPKG_INSTALLED_DIR": "/build/vcpkg_installed",
        "VCPKG_MANIFEST_MODE": "OFF",
        "THEMIS_EDITION": "COMMUNITY",
        "THEMIS_ENABLE_HTTP_SERVER": "ON",
        "THEMIS_ENABLE_LLM": "OFF",
        "THEMIS_ENABLE_GPU": "OFF",
        "THEMIS_ENABLE_TRACING": "OFF",
        "THEMIS_BUILD_TESTS": "OFF"
      }
    },

    {
      "name": "windows-enterprise-base",
      "hidden": true,
      "inherits": "windows-base",
      "cacheVariables": { "THEMIS_EDITION": "ENTERPRISE" }
    },
    {
      "name": "windows-hyperscaler-base",
      "hidden": true,
      "inherits": "windows-base",
      "cacheVariables": { "THEMIS_EDITION": "HYPERSCALER" }
    },
    {
      "name": "linux-enterprise-base",
      "hidden": true,
      "inherits": "linux-base",
      "cacheVariables": { "THEMIS_EDITION": "ENTERPRISE" }
    },
    {
      "name": "linux-hyperscaler-base",
      "hidden": true,
      "inherits": "linux-base",
      "cacheVariables": { "THEMIS_EDITION": "HYPERSCALER" }
    },

    {
      "name": "windows-release-enterprise",
      "displayName": "Windows x64: Release — ENTERPRISE (MSVC + Ninja)",
      "description": "ENTERPRISE release build. Requires -DTHEMIS_LICENSE_FILE=/path/to/license.json at configure time.",
      "inherits": "windows-enterprise-base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "binaryDir": "${sourceDir}/build-msvc-windows-release-enterprise",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "windows-debug-enterprise",
      "displayName": "Windows x64: Debug — ENTERPRISE (MSVC + Ninja)",
      "description": "ENTERPRISE debug build — no license file required.",
      "inherits": "windows-enterprise-base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "binaryDir": "${sourceDir}/build-msvc-windows-debug-enterprise",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "windows-release-hyperscaler",
      "displayName": "Windows x64: Release — HYPERSCALER (MSVC + Ninja)",
      "description": "HYPERSCALER release build — all features enabled, unlimited resource limits.",
      "inherits": "windows-hyperscaler-base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "binaryDir": "${sourceDir}/build-msvc-windows-release-hyperscaler",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "windows-debug-hyperscaler",
      "displayName": "Windows x64: Debug — HYPERSCALER (MSVC + Ninja)",
      "description": "HYPERSCALER debug build — all features enabled, unlimited resource limits.",
      "inherits": "windows-hyperscaler-base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "binaryDir": "${sourceDir}/build-msvc-windows-debug-hyperscaler",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "linux-release-enterprise",
      "displayName": "Linux x64: Release — ENTERPRISE (GCC + Ninja)",
      "description": "ENTERPRISE release build. Requires -DTHEMIS_LICENSE_FILE=/path/to/license.json at configure time.",
      "inherits": "linux-enterprise-base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "binaryDir": "${sourceDir}/build-gcc-linux-release-enterprise",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "linux-debug-enterprise",
      "displayName": "Linux x64: Debug — ENTERPRISE (GCC + Ninja)",
      "description": "ENTERPRISE debug build — no license file required.",
      "inherits": "linux-enterprise-base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "binaryDir": "${sourceDir}/build-gcc-linux-debug-enterprise",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "linux-release-hyperscaler",
      "displayName": "Linux x64: Release — HYPERSCALER (GCC + Ninja)",
      "description": "HYPERSCALER release build — all features enabled, unlimited resource limits.",
      "inherits": "linux-hyperscaler-base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "binaryDir": "${sourceDir}/build-gcc-linux-release-hyperscaler",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "linux-debug-hyperscaler",
      "displayName": "Linux x64: Debug — HYPERSCALER (GCC + Ninja)",
      "description": "HYPERSCALER debug build — all features enabled, unlimited resource limits.",
      "inherits": "linux-hyperscaler-base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "binaryDir": "${sourceDir}/build-gcc-linux-debug-hyperscaler",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    }
  ],
