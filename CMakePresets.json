{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_SUPPRESS_DEVELOPER_WARNINGS": "ON",
        "THEMIS_ENABLE_COMPILER_CACHE": "ON",
        "THEMIS_COMPILER_CACHE_PROGRAM": "",
        "THEMIS_BUILD_TESTS": "ON",
        "THEMIS_BUILD_BENCHMARKS": "OFF",
        "THEMIS_BUILD_CHIMERA": "OFF",
        "THEMIS_ENABLE_TRACING": "OFF",
        "THEMIS_ENABLE_ASAN": "OFF",
        "THEMIS_STRICT_BUILD": "OFF"
      }
    },
    {
      "name": "vcpkg-base",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed"
      }
    },
    {
      "name": "windows-base",
      "hidden": true,
      "inherits": "vcpkg-base",
      "environment": {
        "VCPKG_POWERSHELL_PATH": "$env{LOCALAPPDATA}/Microsoft/WindowsApps/pwsh.exe",
        "Z_VCPKG_POWERSHELL_PATH": "$env{LOCALAPPDATA}/Microsoft/WindowsApps/pwsh.exe",
        "Z_VCPKG_PWSH_PATH": "$env{LOCALAPPDATA}/Microsoft/WindowsApps/pwsh.exe",
        "SCCACHE_DIR": "${sourceDir}/.sccache",
        "SCCACHE_ERROR_LOG": "${sourceDir}/logs/sccache-error.log"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl.exe",
        "CMAKE_CXX_COMPILER": "cl.exe",
        "CMAKE_MAKE_PROGRAM": "ninja.exe",
        "CMAKE_VS_RUNTIME_LIBRARY": "MultiThreadedDLL",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "THEMIS_ENABLE_GPU": "ON",
        "THEMIS_ENABLE_HTTP_SERVER": "ON",
        "THEMIS_ENABLE_LLM": "ON",
        "THEMIS_BUILD_MODULAR": "ON",
        "THEMIS_CORE_SHARED": "ON"
      }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "inherits": "vcpkg-base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "VCPKG_TARGET_TRIPLET": "x64-linux",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed_linux",
        "THEMIS_ENABLE_GPU": "ON",
        "THEMIS_ENABLE_HTTP_SERVER": "ON",
        "THEMIS_ENABLE_LLM": "ON"
      }
    },
    {
      "name": "linux-dev-base",
      "hidden": true,
      "inherits": "vcpkg-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "VCPKG_TARGET_TRIPLET": "x64-linux",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed_linux",
        "THEMIS_ENABLE_GPU": "OFF",
        "THEMIS_ENABLE_HTTP_SERVER": "ON",
        "THEMIS_ENABLE_LLM": "OFF",
        "THEMIS_BUILD_TESTS": "ON",
        "CMAKE_BUILD_TYPE": "Debug",
        "THEMIS_EDITION": "COMMUNITY"
      }
    },
    {
      "name": "linux-arm64-base",
      "hidden": true,
      "inherits": "vcpkg-base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "aarch64-linux-gnu-gcc",
        "CMAKE_CXX_COMPILER": "aarch64-linux-gnu-g++",
        "CMAKE_SYSTEM_NAME": "Linux",
        "CMAKE_SYSTEM_PROCESSOR": "aarch64",
        "VCPKG_TARGET_TRIPLET": "arm64-linux",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed_arm64",
        "THEMIS_ENABLE_GPU": "OFF",
        "THEMIS_ENABLE_HTTP_SERVER": "ON",
        "THEMIS_ENABLE_LLM": "ON"
      }
    },
    {
      "name": "windows-release",
      "displayName": "Windows x64: Release (MSVC + Ninja)",
      "description": "Release build for Windows x64 — run cmake from a VS Developer Command Prompt",
      "inherits": "windows-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "binaryDir": "${sourceDir}/build/windows-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "THEMIS_EDITION": "COMMUNITY"
      }
    },
    {
      "name": "windows-debug",
      "displayName": "Windows x64: Debug (MSVC + Ninja)",
      "description": "Debug build for Windows x64 — run cmake from a VS Developer Command Prompt",
      "inherits": "windows-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "binaryDir": "${sourceDir}/build/windows-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "THEMIS_EDITION": "COMMUNITY"
      }
    },
    {
      "name": "linux-release",
      "displayName": "Linux x64: Release (GCC + Ninja)",
      "description": "Release build for Linux x64 / Ubuntu with GCC, Ninja, vcpkg under sourceDir/vcpkg",
      "inherits": "linux-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "binaryDir": "${sourceDir}/build/linux-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "THEMIS_EDITION": "COMMUNITY"
      }
    },
    {
      "name": "linux-debug",
      "displayName": "Linux x64: Debug (GCC + Ninja)",
      "description": "Debug build for Linux x64 / Ubuntu with GCC, Ninja, vcpkg under sourceDir/vcpkg",
      "inherits": "linux-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "binaryDir": "${sourceDir}/build/linux-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "THEMIS_EDITION": "COMMUNITY"
      }
    },
    {
      "name": "linux-arm64-release",
      "displayName": "Linux arm64: Release (GCC cross + Ninja)",
      "description": "Cross-compiled Release build for Linux arm64 — requires aarch64-linux-gnu-gcc toolchain",
      "inherits": "linux-arm64-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "binaryDir": "${sourceDir}/build/linux-arm64-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "THEMIS_EDITION": "COMMUNITY"
      }
    },
    {
      "name": "linux-arm64-debug",
      "displayName": "Linux arm64: Debug (GCC cross + Ninja)",
      "description": "Cross-compiled Debug build for Linux arm64 — requires aarch64-linux-gnu-gcc toolchain",
      "inherits": "linux-arm64-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "binaryDir": "${sourceDir}/build/linux-arm64-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "THEMIS_EDITION": "COMMUNITY"
      }
    },
    {
      "name": "docker-release",
      "displayName": "Docker: Linux Release (inside container)",
      "description": "Release build for Docker containers — vcpkg at /opt/vcpkg, installed packages at /build/vcpkg_installed. Override THEMIS_EDITION / THEMIS_ENABLE_LLM / VCPKG_TARGET_TRIPLET via -D on the command line.",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_TOOLCHAIN_FILE": "/opt/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-linux",
        "VCPKG_INSTALLED_DIR": "/build/vcpkg_installed",
        "VCPKG_MANIFEST_MODE": "OFF",
        "THEMIS_EDITION": "COMMUNITY",
        "THEMIS_ENABLE_HTTP_SERVER": "ON",
        "THEMIS_ENABLE_LLM": "OFF",
        "THEMIS_ENABLE_GPU": "OFF",
        "THEMIS_ENABLE_TRACING": "OFF",
        "THEMIS_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "linux-asan",
      "displayName": "Linux x64: AddressSanitizer + LeakSanitizer (Debug)",
      "description": "Detects memory errors (use-after-free, buffer overflows, leaks). Runs ~2x slower. Not for production. PIE and FORTIFY_SOURCE are disabled: PIE conflicts with ASAN shadow memory layout; FORTIFY_SOURCE requires optimised code (-O2+) incompatible with ASAN's Debug -O1.",
      "inherits": "linux-dev-base",
      "binaryDir": "${sourceDir}/build/linux-asan",
      "cacheVariables": {
        "THEMIS_ENABLE_ASAN": "ON",
        "THEMIS_ENABLE_LSAN": "ON",
        "THEMIS_DISABLE_PIE": "ON",
        "THEMIS_DISABLE_FORTIFY_SOURCE": "ON"
      }
    },
    {
      "name": "linux-ubsan",
      "displayName": "Linux x64: UndefinedBehaviorSanitizer (Debug)",
      "description": "Detects undefined behavior: signed overflow, null dereference, misalignment, etc. PIE is disabled to avoid interactions with UBSan's runtime instrumentation.",
      "inherits": "linux-dev-base",
      "binaryDir": "${sourceDir}/build/linux-ubsan",
      "cacheVariables": {
        "THEMIS_ENABLE_UBSAN": "ON",
        "THEMIS_DISABLE_PIE": "ON"
      }
    },
    {
      "name": "linux-tsan",
      "displayName": "Linux x64: ThreadSanitizer (Debug)",
      "description": "Detects data races and threading issues. Runs ~5-15x slower. Incompatible with ASAN. PIE and FORTIFY_SOURCE are disabled: TSan uses a fixed shadow-memory mapping that conflicts with PIE's ASLR; FORTIFY_SOURCE requires -O2 while TSan needs -O1 for accurate reporting.",
      "inherits": "linux-dev-base",
      "binaryDir": "${sourceDir}/build/linux-tsan",
      "cacheVariables": {
        "THEMIS_ENABLE_TSAN": "ON",
        "THEMIS_DISABLE_PIE": "ON",
        "THEMIS_DISABLE_FORTIFY_SOURCE": "ON"
      }
    },
    {
      "name": "linux-coverage",
      "displayName": "Linux x64: Code Coverage (Debug + gcov)",
      "description": "Instruments code for line/branch coverage with gcov. Use lcov/genhtml for HTML reports. PIE and FORTIFY_SOURCE are disabled to prevent interference with gcov instrumentation and because coverage builds use -O0.",
      "inherits": "linux-dev-base",
      "binaryDir": "${sourceDir}/build/linux-coverage",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "--coverage",
        "CMAKE_C_FLAGS": "--coverage",
        "CMAKE_EXE_LINKER_FLAGS": "--coverage",
        "THEMIS_DISABLE_PIE": "ON",
        "THEMIS_DISABLE_FORTIFY_SOURCE": "ON"
      }
    },
    {
      "name": "linux-strict",
      "displayName": "Linux x64: Strict / CI (Release + -Werror)",
      "description": "Release build with all warnings treated as errors. Used in CI to enforce code quality gates.",
      "inherits": "linux-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "binaryDir": "${sourceDir}/build/linux-strict",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "THEMIS_EDITION": "COMMUNITY",
        "THEMIS_STRICT_BUILD": "ON",
        "THEMIS_CI_MODE": "ON",
        "THEMIS_ENABLE_GPU": "OFF",
        "THEMIS_ENABLE_LLM": "OFF",
        "THEMIS_BUILD_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-release",
      "displayName": "Build: Windows x64 Release",
      "configurePreset": "windows-release",
      "jobs": 4
    },
    {
      "name": "windows-debug",
      "displayName": "Build: Windows x64 Debug",
      "configurePreset": "windows-debug",
      "jobs": 4
    },
    {
      "name": "linux-release",
      "displayName": "Build: Linux x64 Release",
      "configurePreset": "linux-release",
      "jobs": 0
    },
    {
      "name": "linux-debug",
      "displayName": "Build: Linux x64 Debug",
      "configurePreset": "linux-debug",
      "jobs": 0
    },
    {
      "name": "linux-arm64-release",
      "displayName": "Build: Linux arm64 Release",
      "configurePreset": "linux-arm64-release",
      "jobs": 0
    },
    {
      "name": "linux-arm64-debug",
      "displayName": "Build: Linux arm64 Debug",
      "configurePreset": "linux-arm64-debug",
      "jobs": 0
    },
    {
      "name": "docker-release",
      "displayName": "Build: Docker Release",
      "configurePreset": "docker-release",
      "jobs": 0
    },
    {
      "name": "linux-asan",
      "displayName": "Build: Linux x64 AddressSanitizer",
      "configurePreset": "linux-asan",
      "jobs": 0
    },
    {
      "name": "linux-ubsan",
      "displayName": "Build: Linux x64 UndefinedBehaviorSanitizer",
      "configurePreset": "linux-ubsan",
      "jobs": 0
    },
    {
      "name": "linux-tsan",
      "displayName": "Build: Linux x64 ThreadSanitizer",
      "configurePreset": "linux-tsan",
      "jobs": 0
    },
    {
      "name": "linux-coverage",
      "displayName": "Build: Linux x64 Coverage",
      "configurePreset": "linux-coverage",
      "jobs": 0
    },
    {
      "name": "linux-strict",
      "displayName": "Build: Linux x64 Strict / CI",
      "configurePreset": "linux-strict",
      "jobs": 0
    }
  ],
  "testPresets": [
    {
      "name": "windows-release",
      "displayName": "Test: Windows x64 Release",
      "configurePreset": "windows-release",
      "environment": {
        "PATH": "${sourceDir}/build/windows-release/bin${pathListSep}${sourceDir}/vcpkg_installed/x64-windows/bin${pathListSep}$penv{PATH}"
      }
    },
    {
      "name": "windows-debug",
      "displayName": "Test: Windows x64 Debug",
      "configurePreset": "windows-debug",
      "environment": {
        "PATH": "${sourceDir}/build/windows-debug/bin${pathListSep}${sourceDir}/vcpkg_installed/x64-windows/bin${pathListSep}$penv{PATH}"
      }
    },
    {
      "name": "linux-release",
      "displayName": "Test: Linux x64 Release",
      "configurePreset": "linux-release",
      "environment": {
        "PATH": "${sourceDir}/build/linux-release/bin${pathListSep}$penv{PATH}",
        "LD_LIBRARY_PATH": "${sourceDir}/build/linux-release/lib${pathListSep}${sourceDir}/build/linux-release/bin${pathListSep}$penv{LD_LIBRARY_PATH}"
      }
    },
    {
      "name": "linux-debug",
      "displayName": "Test: Linux x64 Debug",
      "configurePreset": "linux-debug",
      "environment": {
        "PATH": "${sourceDir}/build/linux-debug/bin${pathListSep}$penv{PATH}",
        "LD_LIBRARY_PATH": "${sourceDir}/build/linux-debug/lib${pathListSep}${sourceDir}/build/linux-debug/bin${pathListSep}$penv{LD_LIBRARY_PATH}"
      }
    },
    {
      "name": "linux-arm64-release",
      "displayName": "Test: Linux arm64 Release",
      "configurePreset": "linux-arm64-release",
      "environment": {
        "PATH": "${sourceDir}/build/linux-arm64-release/bin${pathListSep}$penv{PATH}",
        "LD_LIBRARY_PATH": "${sourceDir}/build/linux-arm64-release/lib${pathListSep}$penv{LD_LIBRARY_PATH}"
      }
    },
    {
      "name": "linux-arm64-debug",
      "displayName": "Test: Linux arm64 Debug",
      "configurePreset": "linux-arm64-debug",
      "environment": {
        "PATH": "${sourceDir}/build/linux-arm64-debug/bin${pathListSep}$penv{PATH}",
        "LD_LIBRARY_PATH": "${sourceDir}/build/linux-arm64-debug/lib${pathListSep}$penv{LD_LIBRARY_PATH}"
      }
    },
    {
      "name": "docker-release",
      "displayName": "Test: Docker Release",
      "configurePreset": "docker-release",
      "environment": {
        "PATH": "${sourceDir}/build/bin${pathListSep}$penv{PATH}",
        "LD_LIBRARY_PATH": "/build/vcpkg_installed/x64-linux/lib${pathListSep}${sourceDir}/build/lib${pathListSep}$penv{LD_LIBRARY_PATH}"
      }
    },
    {
      "name": "linux-asan",
      "displayName": "Test: Linux x64 AddressSanitizer",
      "configurePreset": "linux-asan",
      "environment": {
        "PATH": "${sourceDir}/build/linux-asan/bin${pathListSep}$penv{PATH}",
        "LD_LIBRARY_PATH": "${sourceDir}/build/linux-asan/lib${pathListSep}$penv{LD_LIBRARY_PATH}",
        "ASAN_OPTIONS": "detect_leaks=1:halt_on_error=0:print_stats=1"
      }
    },
    {
      "name": "linux-ubsan",
      "displayName": "Test: Linux x64 UndefinedBehaviorSanitizer",
      "configurePreset": "linux-ubsan",
      "environment": {
        "PATH": "${sourceDir}/build/linux-ubsan/bin${pathListSep}$penv{PATH}",
        "LD_LIBRARY_PATH": "${sourceDir}/build/linux-ubsan/lib${pathListSep}$penv{LD_LIBRARY_PATH}",
        "UBSAN_OPTIONS": "halt_on_error=0:print_stacktrace=1"
      }
    },
    {
      "name": "linux-tsan",
      "displayName": "Test: Linux x64 ThreadSanitizer",
      "configurePreset": "linux-tsan",
      "environment": {
        "PATH": "${sourceDir}/build/linux-tsan/bin${pathListSep}$penv{PATH}",
        "LD_LIBRARY_PATH": "${sourceDir}/build/linux-tsan/lib${pathListSep}$penv{LD_LIBRARY_PATH}",
        "TSAN_OPTIONS": "halt_on_error=0:second_deadlock_stack=1"
      }
    },
    {
      "name": "linux-coverage",
      "displayName": "Test: Linux x64 Coverage",
      "configurePreset": "linux-coverage",
      "environment": {
        "PATH": "${sourceDir}/build/linux-coverage/bin${pathListSep}$penv{PATH}",
        "LD_LIBRARY_PATH": "${sourceDir}/build/linux-coverage/lib${pathListSep}$penv{LD_LIBRARY_PATH}"
      }
    },
    {
      "name": "linux-strict",
      "displayName": "Test: Linux x64 Strict / CI",
      "configurePreset": "linux-strict",
      "environment": {
        "PATH": "${sourceDir}/build/linux-strict/bin${pathListSep}$penv{PATH}",
        "LD_LIBRARY_PATH": "${sourceDir}/build/linux-strict/lib${pathListSep}$penv{LD_LIBRARY_PATH}"
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "windows-release",
      "displayName": "Workflow: Windows x64 Release (Configure → Build → Test)",
      "steps": [
        { "type": "configure", "name": "windows-release" },
        { "type": "build",     "name": "windows-release" },
        { "type": "test",      "name": "windows-release" }
      ]
    },
    {
      "name": "windows-debug",
      "displayName": "Workflow: Windows x64 Debug (Configure → Build → Test)",
      "steps": [
        { "type": "configure", "name": "windows-debug" },
        { "type": "build",     "name": "windows-debug" },
        { "type": "test",      "name": "windows-debug" }
      ]
    },
    {
      "name": "linux-release",
      "displayName": "Workflow: Linux x64 Release (Configure → Build → Test)",
      "steps": [
        { "type": "configure", "name": "linux-release" },
        { "type": "build",     "name": "linux-release" },
        { "type": "test",      "name": "linux-release" }
      ]
    },
    {
      "name": "linux-debug",
      "displayName": "Workflow: Linux x64 Debug (Configure → Build → Test)",
      "steps": [
        { "type": "configure", "name": "linux-debug" },
        { "type": "build",     "name": "linux-debug" },
        { "type": "test",      "name": "linux-debug" }
      ]
    },
    {
      "name": "linux-arm64-release",
      "displayName": "Workflow: Linux arm64 Release (Configure → Build → Test)",
      "steps": [
        { "type": "configure", "name": "linux-arm64-release" },
        { "type": "build",     "name": "linux-arm64-release" },
        { "type": "test",      "name": "linux-arm64-release" }
