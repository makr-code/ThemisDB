{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "description": "Base preset: Ninja generator with standard compiler cache settings",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_SUPPRESS_DEVELOPER_WARNINGS": "ON",
        "THEMIS_ENABLE_COMPILER_CACHE": "ON",
        "THEMIS_COMPILER_CACHE_PROGRAM": "sccache",
        "THEMIS_BUILD_TESTS": "OFF",
        "THEMIS_BUILD_BENCHMARKS": "OFF"
      }
    },
    {
      "name": "vcpkg-base",
      "hidden": true,
      "description": "vcpkg-enabled base: Configures CMAKE_TOOLCHAIN_FILE and VCPKG_INSTALLED_DIR. Required by linux-release and windows-release. Requires: vcpkg repo cloned to ./vcpkg and bootstrapped",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed"
      }
    },
    {
      "name": "windows-base",
      "hidden": true,
      "description": "Windows base: MSVC x64 with vcpkg and GPU support. Requires: Windows 10/11, MSVC 2022+, Ninja, vcpkg",
      "inherits": "vcpkg-base",
      "environment": {
        "CMAKE_BUILD_PARALLEL_LEVEL": "8",
        "SCCACHE_DIR": "${sourceDir}/.cache/sccache",
        "VCToolsInstallDir": "C:/Program Files/Microsoft Visual Studio/2022/Professional/VC/Tools/MSVC/14.44.35207",
        "WindowsSdkDir": "C:/Program Files (x86)/Windows Kits/10",
        "WindowsSDKVersion": "10.0.26100.0",
        "WindowsSDKLibVersion": "10.0.26100.0",
        "INCLUDE": "C:/Program Files/Microsoft Visual Studio/2022/Professional/VC/Tools/MSVC/14.44.35207/include;C:/Program Files (x86)/Windows Kits/10/Include/10.0.26100.0/ucrt;C:/Program Files (x86)/Windows Kits/10/Include/10.0.26100.0/shared;C:/Program Files (x86)/Windows Kits/10/Include/10.0.26100.0/um",
        "LIB": "C:/Program Files/Microsoft Visual Studio/2022/Professional/VC/Tools/MSVC/14.44.35207/lib/x64;C:/Program Files (x86)/Windows Kits/10/Lib/10.0.26100.0/ucrt/x64;C:/Program Files (x86)/Windows Kits/10/Lib/10.0.26100.0/um/x64",
        "LIBPATH": "C:/Program Files/Microsoft Visual Studio/2022/Professional/VC/Tools/MSVC/14.44.35207/lib/x64;C:/Program Files (x86)/Windows Kits/10/Lib/10.0.26100.0/ucrt/x64;C:/Program Files (x86)/Windows Kits/10/Lib/10.0.26100.0/um/x64"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "THEMIS_ENABLE_GPU": "ON",
        "THEMIS_ENABLE_HTTP_SERVER": "ON",
        "THREADS_PREFER_PTHREAD_FLAG": "OFF",
        "CMAKE_USE_PTHREADS_INIT": "OFF",
        "CMAKE_HAVE_PTHREAD_H": "OFF",
        "CMAKE_HAVE_PTHREADS_CREATE": "OFF",
        "CMAKE_THREAD_LIBS_INIT": ""
      }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "description": "Linux base: GCC x64 with vcpkg and GPU support. Requires: Linux, GCC 11+, Ninja, vcpkg. Fallback: Use community-release preset with system packages",
      "inherits": "vcpkg-base",
      "cacheVariables": {
        "THEMIS_AUTO_BOOTSTRAP_DEPS": "ON",
        "CMAKE_TOOLCHAIN_FILE": "",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "VCPKG_TARGET_TRIPLET": "x64-linux",
        "THEMIS_ENABLE_GPU": "ON",
        "THEMIS_ENABLE_HTTP_SERVER": "ON"
      },
      "environment": {
        "CMAKE_BUILD_PARALLEL_LEVEL": "8"
      }
    },
    {
      "name": "windows-release",
      "displayName": "Windows x64: Release (strict)",
      "description": "Production release build for Windows. Core dependencies are mandatory; no silent fallback in normal release builds.",
      "inherits": "windows-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "binaryDir": "${sourceDir}/build-msvc-windows-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "THEMIS_EDITION": "COMMUNITY",
        "THEMIS_DIAGNOSTIC_MODE": "OFF",
        "THEMIS_BUILD_TESTS": "OFF",
        "THEMIS_BUILD_BENCHMARKS": "OFF"
      }
    },
    {
      "name": "windows-debug",
      "displayName": "Windows x64: Debug (strict)",
      "description": "Development debug build for Windows. Core dependencies are mandatory; build must fail instead of silently falling back.",
      "inherits": "windows-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "binaryDir": "${sourceDir}/build-msvc-windows-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "THEMIS_EDITION": "COMMUNITY",
        "THEMIS_DIAGNOSTIC_MODE": "OFF"
      }
    },
    {
      "name": "linux-release",
      "displayName": "Linux x64: Release (vcpkg required)",
      "description": "Production release build for Linux with vcpkg. Requires: Linux, GCC 11+, Ninja, vcpkg. Fallback: Use community-release preset for system package builds. See SETUP.md for setup instructions.",
      "inherits": "linux-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "binaryDir": "${sourceDir}/build-gcc-linux-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "THEMIS_EDITION": "COMMUNITY",
        "THEMIS_BUILD_TESTS": "OFF",
        "THEMIS_BUILD_BENCHMARKS": "OFF"
      }
    },
    {
      "name": "linux-debug",
      "displayName": "Linux x64: Debug (vcpkg required)",
      "description": "Development debug build for Linux with vcpkg. Requires: Linux, GCC 11+, Ninja, vcpkg. Fallback: Use community-release preset for system package builds. See SETUP.md for setup instructions.",
      "inherits": "linux-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "binaryDir": "${sourceDir}/build-gcc-linux-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "THEMIS_EDITION": "COMMUNITY"
      }
    },
    {
      "name": "community-release",
      "displayName": "Configure: Community Release (system packages, no vcpkg)",
      "description": "Fallback preset: Uses system-installed packages instead of vcpkg. Requires: Linux/macOS, GCC/Clang, Ninja, system development packages (librocksdb-dev, libssl-dev, zlib1g-dev, etc.). Use this when vcpkg is unavailable. See SETUP.md for system package installation guide.",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build-community-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "THEMIS_EDITION": "COMMUNITY",
        "THEMIS_BUILD_TESTS": "OFF",
        "THEMIS_BUILD_BENCHMARKS": "OFF"
      }
    },
    {
      "name": "community-release-allow-missing-rocksdb",
      "displayName": "Configure: Community Debug (DIAGNOSTIC ONLY)",
      "description": "DIAGNOSTIC PRESET ONLY - explicit bootstrap troubleshooting mode. It may allow missing RocksDB during diagnosis, but normal developer and release presets are strict.",
      "inherits": "community-release",
      "binaryDir": "${sourceDir}/build-community-debug-allow-missing-rocksdb",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "THEMIS_ALLOW_MISSING_ROCKSDB": "ON",
        "THEMIS_DIAGNOSTIC_MODE": "ON",
        "THEMIS_EDITION": "COMMUNITY"
      }
    },
    {
      "name": "community-asan",
      "displayName": "Configure: Community ASan (AddressSanitizer, system packages)",
      "description": "Debug build with AddressSanitizer enabled. Use to detect memory-safety bugs: heap/stack buffer overflows, use-after-free, use-after-return. Requires: GCC 8+ or Clang 7+, libasan. Not for production builds. SEC-CC-4 companion preset.",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build-community-asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "THEMIS_EDITION": "COMMUNITY",
        "THEMIS_ENABLE_ASAN": "ON",
        "THEMIS_DISABLE_SECURITY_HARDENING": "ON"
      }
    },
    {
      "name": "community-ubsan",
      "displayName": "Configure: Community UBSan (UndefinedBehaviorSanitizer, system packages)",
      "description": "Debug build with UndefinedBehaviorSanitizer enabled. Use to detect undefined behavior: signed overflow, misaligned access, invalid enum values, null dereference. Requires: GCC 8+ or Clang 7+. Not for production builds. SEC-CC-4 companion preset.",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build-community-ubsan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "THEMIS_EDITION": "COMMUNITY",
        "THEMIS_ENABLE_UBSAN": "ON",
        "THEMIS_DISABLE_SECURITY_HARDENING": "ON"
      }
    },
    {
      "name": "community-debug",
      "displayName": "Configure: Community Debug (system packages, no vcpkg)",
      "description": "Development debug build with system packages. Includes benchmarks for development/profiling. Requires: Linux/macOS, GCC/Clang, Ninja, system development packages. See SETUP.md for system package installation guide.",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build-community-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "THEMIS_EDITION": "COMMUNITY",
        "THEMIS_BUILD_BENCHMARKS": "ON"
      }
    },
    {
      "name": "linux-asan",
