{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "description": "Base preset: Ninja generator with standard compiler cache settings",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_SUPPRESS_DEVELOPER_WARNINGS": "ON",
        "THEMIS_ENABLE_COMPILER_CACHE": "ON",
        "THEMIS_COMPILER_CACHE_PROGRAM": "sccache",
        "THEMIS_BUILD_TESTS": "ON",
        "THEMIS_BUILD_BENCHMARKS": "OFF"
      }
    },
    {
      "name": "vcpkg-base",
      "hidden": true,
      "description": "vcpkg-enabled base: Configures CMAKE_TOOLCHAIN_FILE and VCPKG_INSTALLED_DIR. Required by linux-release and windows-release. Requires: vcpkg repo cloned to ./vcpkg and bootstrapped",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed"
      }
    },
    {
      "name": "windows-base",
      "hidden": true,
      "description": "Windows base: MSVC x64 with vcpkg and GPU support. Requires: Windows 10/11, MSVC 2022+, Ninja, vcpkg",
      "inherits": "vcpkg-base",
      "environment": {
        "CMAKE_BUILD_PARALLEL_LEVEL": "16",
        "SCCACHE_DIR": "$penv{USERPROFILE}/.cache/sccache/themisdb"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "THEMIS_ENABLE_GPU": "ON",
        "THEMIS_ENABLE_HTTP_SERVER": "ON"
      }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "description": "Linux base: GCC x64 with vcpkg and GPU support. Requires: Linux, GCC 11+, Ninja, vcpkg. Fallback: Use community-release preset with system packages",
      "inherits": "vcpkg-base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "VCPKG_TARGET_TRIPLET": "x64-linux",
        "THEMIS_ENABLE_GPU": "ON",
        "THEMIS_ENABLE_HTTP_SERVER": "ON"
      }
    },
    {
      "name": "windows-release",
      "displayName": "Windows x64: Release (vcpkg required)",
      "description": "Production release build for Windows. Requires: Windows 10/11, MSVC 2022+, Ninja, vcpkg. See SETUP.md for setup instructions.",
      "inherits": "windows-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "binaryDir": "${sourceDir}/build-msvc-windows-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "THEMIS_EDITION": "COMMUNITY"
      }
    },
    {
      "name": "windows-debug",
      "displayName": "Windows x64: Debug (vcpkg required)",
      "description": "Development debug build for Windows. Requires: Windows 10/11, MSVC 2022+, Ninja, vcpkg. See SETUP.md for setup instructions.",
      "inherits": "windows-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "binaryDir": "${sourceDir}/build-msvc-windows-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "THEMIS_EDITION": "COMMUNITY"
      }
    },
    {
      "name": "linux-release",
      "displayName": "Linux x64: Release (vcpkg required)",
      "description": "Production release build for Linux with vcpkg. Requires: Linux, GCC 11+, Ninja, vcpkg. Fallback: Use community-release preset for system package builds. See SETUP.md for setup instructions.",
      "inherits": "linux-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "binaryDir": "${sourceDir}/build-gcc-linux-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "THEMIS_EDITION": "COMMUNITY"
      }
    },
    {
      "name": "linux-debug",
      "displayName": "Linux x64: Debug (vcpkg required)",
      "description": "Development debug build for Linux with vcpkg. Requires: Linux, GCC 11+, Ninja, vcpkg. Fallback: Use community-release preset for system package builds. See SETUP.md for setup instructions.",
      "inherits": "linux-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "binaryDir": "${sourceDir}/build-gcc-linux-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "THEMIS_EDITION": "COMMUNITY"
      }
    },
    {
      "name": "community-release",
      "displayName": "Configure: Community Release (system packages, no vcpkg)",
      "description": "Fallback preset: Uses system-installed packages instead of vcpkg. Requires: Linux/macOS, GCC/Clang, Ninja, system development packages (librocksdb-dev, libssl-dev, zlib1g-dev, etc.). Use this when vcpkg is unavailable. See SETUP.md for system package installation guide.",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build-community-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "THEMIS_EDITION": "COMMUNITY",
        "THEMIS_ALLOW_MISSING_ROCKSDB": "ON"
      }
    },
    {
      "name": "community-asan",
      "displayName": "Configure: Community ASan (AddressSanitizer, system packages)",
      "description": "Debug build with AddressSanitizer enabled. Use to detect memory-safety bugs: heap/stack buffer overflows, use-after-free, use-after-return. Requires: GCC 8+ or Clang 7+, libasan. Not for production builds. SEC-CC-4 companion preset.",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build-community-asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "THEMIS_EDITION": "COMMUNITY",
        "THEMIS_ENABLE_ASAN": "ON",
        "THEMIS_DISABLE_SECURITY_HARDENING": "ON"
      }
    },
    {
      "name": "community-ubsan",
      "displayName": "Configure: Community UBSan (UndefinedBehaviorSanitizer, system packages)",
      "description": "Debug build with UndefinedBehaviorSanitizer enabled. Use to detect undefined behavior: signed overflow, misaligned access, invalid enum values, null dereference. Requires: GCC 8+ or Clang 7+. Not for production builds. SEC-CC-4 companion preset.",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build-community-ubsan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "THEMIS_EDITION": "COMMUNITY",
        "THEMIS_ENABLE_UBSAN": "ON",
        "THEMIS_DISABLE_SECURITY_HARDENING": "ON"
      }
    },
    {
      "name": "linux-asan",
      "displayName": "Linux x64: ASan Debug (vcpkg required)",
      "description": "Debug build with AddressSanitizer enabled. Requires: Linux, GCC 8+, Ninja, vcpkg. SEC-CC-4 companion preset.",
      "inherits": "linux-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "binaryDir": "${sourceDir}/build-gcc-linux-asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "THEMIS_EDITION": "COMMUNITY",
        "THEMIS_ENABLE_ASAN": "ON",
        "THEMIS_DISABLE_SECURITY_HARDENING": "ON"
      }
    },
    {
      "name": "linux-ubsan",
      "displayName": "Linux x64: UBSan Debug (vcpkg required)",
      "description": "Debug build with UndefinedBehaviorSanitizer enabled. Requires: Linux, GCC 8+, Ninja, vcpkg. SEC-CC-4 companion preset.",
      "inherits": "linux-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "binaryDir": "${sourceDir}/build-gcc-linux-ubsan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "THEMIS_EDITION": "COMMUNITY",
        "THEMIS_ENABLE_UBSAN": "ON",
        "THEMIS_DISABLE_SECURITY_HARDENING": "ON"
      }
    },
    {
      "name": "nightly-bench-sweep",
      "displayName": "Nightly Benchmark Sweep (vcpkg required)",
      "description": "Nightly benchmark sweep: Linux release with benchmarks enabled, GPU and LLM disabled. Requires: Linux, GCC 11+, Ninja, vcpkg. See SETUP.md for setup instructions.",
      "inherits": "linux-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "binaryDir": "${sourceDir}/build-gcc-linux-nightly",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "THEMIS_BUILD_BENCHMARKS": "ON",
        "THEMIS_ENABLE_GPU": "OFF",
        "THEMIS_ENABLE_LLM": "OFF"
      }
    },
    {
      "name": "hyperscaler-debug-windows",
      "displayName": "Hyperscaler Debug (Windows) (vcpkg required)",
      "description": "Hyperscaler debug build for Windows with benchmarks enabled. Requires: Windows 10/11, MSVC 2022+, Ninja, vcpkg. See SETUP.md for setup instructions.",
      "inherits": "windows-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "binaryDir": "${sourceDir}/build-hyperscaler-windows-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "THEMIS_EDITION": "HYPERSCALER",
        "THEMIS_BUILD_BENCHMARKS": "ON",
        "THEMIS_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "hyperscaler-debug-linux",
      "displayName": "Hyperscaler Debug (Linux) (vcpkg required)",
      "description": "Hyperscaler debug build for Linux with benchmarks enabled. Requires: Linux, GCC 11+, Ninja, vcpkg. See SETUP.md for setup instructions.",
      "inherits": "linux-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "binaryDir": "${sourceDir}/build-hyperscaler-linux-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "THEMIS_EDITION": "HYPERSCALER",
        "THEMIS_BUILD_BENCHMARKS": "ON",
        "THEMIS_BUILD_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-release",
      "configurePreset": "windows-release",
      "jobs": 16
    },
    {
      "name": "windows-debug",
      "configurePreset": "windows-debug",
      "jobs": 4
    },
    {
      "name": "hyperscaler-debug-windows",
      "configurePreset": "hyperscaler-debug-windows",
      "jobs": 16
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release"
    },
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug"
    },
    {
      "name": "community-release",
      "configurePreset": "community-release"
    },
    {
      "name": "nightly-bench-sweep",
      "configurePreset": "nightly-bench-sweep"
    },
    {
      "name": "community-asan",
      "configurePreset": "community-asan",
      "jobs": 8
    },
    {
      "name": "community-ubsan",
      "configurePreset": "community-ubsan",
      "jobs": 8
    },
    {
      "name": "linux-asan",
      "configurePreset": "linux-asan",
      "jobs": 16
    },
    {
      "name": "linux-ubsan",
      "configurePreset": "linux-ubsan",
      "jobs": 16
    }
  ],
  "testPresets": [
    {
      "name": "windows-release",
      "configurePreset": "windows-release"
    },
    {
      "name": "hyperscaler-debug-windows",
      "configurePreset": "hyperscaler-debug-windows"
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release"
    },
    {
      "name": "community-release",
      "configurePreset": "community-release"
    },
    {
      "name": "community-asan",
      "configurePreset": "community-asan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "community-ubsan",
      "configurePreset": "community-ubsan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-asan",
      "configurePreset": "linux-asan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-ubsan",
      "configurePreset": "linux-ubsan",
      "output": {
        "outputOnFailure": true
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "windows-release",
      "steps": [
        {
          "type": "configure",
          "name": "windows-release"
        },
        {
          "type": "build",
          "name": "windows-release"
        },
        {
          "type": "test",
          "name": "windows-release"
        }
      ]
    },
    {
      "name": "hyperscaler-debug-windows",
      "steps": [
        {
          "type": "configure",
          "name": "hyperscaler-debug-windows"
        },
        {
          "type": "build",
          "name": "hyperscaler-debug-windows"
        },
        {
          "type": "test",
          "name": "hyperscaler-debug-windows"
        }
      ]
    },
    {
      "name": "linux-release",
      "steps": [
        {
          "type": "configure",
          "name": "linux-release"
        },
        {
          "type": "build",
          "name": "linux-release"
        },
        {
          "type": "test",
          "name": "linux-release"
        }
      ]
    },
    {
      "name": "community-release",
      "steps": [
        {
          "type": "configure",
          "name": "community-release"
        },
        {
          "type": "build",
          "name": "community-release"
        },
        {
          "type": "test",
          "name": "community-release"
        }
      ]
    }
  ]
}
