  "testPresets": [
    {
      "name": "windows-release",
      "displayName": "Test: Windows x64 Release",
      "configurePreset": "windows-release",
      "environment": {
        "PATH": "${sourceDir}/build-msvc-windows-release/bin${pathListSep}${sourceDir}/vcpkg_installed/x64-windows/bin${pathListSep}$penv{PATH}"
      }
    },
    {
      "name": "windows-release-gate",
      "displayName": "Test: Windows x64 Release (Gate)",
      "configurePreset": "windows-release",
      "environment": {
        "PATH": "${sourceDir}/build-msvc-windows-release/bin${pathListSep}${sourceDir}/vcpkg_installed/x64-windows/bin${pathListSep}$penv{PATH}"
      },
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "stopOnFailure": true,
        "noTestsAction": "error"
      },
      "filter": {
        "include": {
          "label": "^std-gate$"
        }
      }
    },
    {
      "name": "windows-release-gate-soak",
