{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "THEMIS_BUILD_TESTS": "ON",
        "THEMIS_BUILD_BENCHMARKS": "ON",
        "THEMIS_ENABLE_TRACING": "OFF",
        "THEMIS_ENABLE_ASAN": "OFF",
        "THEMIS_STRICT_BUILD": "OFF"
      }
    },
    {
      "name": "vcpkg-base",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    },
    {
      "name": "windows-base",
      "hidden": true,
      "generator": "Visual Studio 17 2022",
      "inherits": "vcpkg-base",
      "cacheVariables": {
        "CMAKE_VS_RUNTIME_LIBRARY": "MultiThreadedDLL",
        "THEMIS_ENABLE_GPU": "OFF",
        "THEMIS_ENABLE_LLM": "ON"
      }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "inherits": "vcpkg-base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "VCPKG_TARGET_TRIPLET": "x64-linux",
        "THEMIS_ENABLE_GPU": "OFF",
        "THEMIS_ENABLE_LLM": "ON"
      }
    },
    {
      "name": "msvc-vs-release",
      "displayName": "Windows: MSVC + Visual Studio Release",
      "description": "Release build for Windows with MSVC, Visual Studio 17 2022, and COMMUNITY Edition (LLM enabled, GPU disabled)",
      "inherits": "windows-base",
      "binaryDir": "${sourceDir}/build-msvc-vs-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "THEMIS_EDITION": "COMMUNITY"
      }
    },
    {
      "name": "msvc-vs-debug",
      "displayName": "Windows: MSVC + Visual Studio Debug",
      "description": "Debug build for Windows with MSVC and Visual Studio 17 2022 (COMMUNITY Edition)",
      "inherits": "windows-base",
      "binaryDir": "${sourceDir}/build-msvc-vs-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "THEMIS_EDITION": "COMMUNITY"
      }
    },
    {
      "name": "linux-ninja-release",
      "displayName": "Linux: GCC + Ninja Release",
      "description": "Release build for Linux with GCC, Ninja, and COMMUNITY Edition",
      "inherits": "linux-base",
      "binaryDir": "${sourceDir}/build-linux-ninja-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "THEMIS_EDITION": "COMMUNITY"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "msvc-vs-release",
      "displayName": "Build: Windows Release",
      "configurePreset": "msvc-vs-release"
    },
    {
      "name": "msvc-vs-debug",
      "displayName": "Build: Windows Debug",
      "configurePreset": "msvc-vs-debug"
    },
    {
      "name": "linux-ninja-release",
      "displayName": "Build: Linux Release",
      "configurePreset": "linux-ninja-release"
    }
  ],
  "testPresets": [
    {
      "name": "msvc-vs-release",
      "displayName": "Test: Windows Release",
      "configurePreset": "msvc-vs-release"
    },
    {
      "name": "msvc-vs-debug",
      "displayName": "Test: Windows Debug",
      "configurePreset": "msvc-vs-debug"
    },
    {
      "name": "linux-ninja-release",
      "displayName": "Test: Linux Release",
      "configurePreset": "linux-ninja-release"
    }
  ],
  "workflowPresets": [
    {
      "name": "windows-dev-workflow",
      "displayName": "Workflow: Windows Release (Configure → Build → Test)",
      "description": "Complete development workflow for Windows",
      "steps": [
        {
          "type": "configure",
          "name": "msvc-vs-release"
        },
        {
          "type": "build",
          "name": "msvc-vs-release"
        },
        {
          "type": "test",
          "name": "msvc-vs-release"
        }
      ]
    },
    {
      "name": "windows-debug-workflow",
      "displayName": "Workflow: Windows Debug (Configure → Build → Test)",
      "description": "Complete debug workflow for Windows",
      "steps": [
        {
          "type": "configure",
          "name": "msvc-vs-debug"
        },
        {
          "type": "build",
          "name": "msvc-vs-debug"
        },
        {
          "type": "test",
          "name": "msvc-vs-debug"
        }
      ]
    },
    {
      "name": "linux-workflow",
      "displayName": "Workflow: Linux Release (Configure → Build → Test)",
      "description": "Complete development workflow for Linux",
      "steps": [
        {
          "type": "configure",
          "name": "linux-ninja-release"
        },
        {
          "type": "build",
          "name": "linux-ninja-release"
        },
        {
          "type": "test",
          "name": "linux-ninja-release"
        }
      ]
    }
  ]
}
