{
  "$schema": "https://json.schemastore.org/github-branch-protection.json",
  "description": "ThemisDB Branch Protection Rules - Apply via GitHub Settings",
  "rules": {
    "main": {
      "protection": {
        "required_status_checks": {
          "strict": true,
          "contexts": [
            "build-windows-msvc",
            "build-linux-gcc",
            "test-unit",
            "test-integration",
            "static-analysis",
            "security-scan",
            "validate-ai-guardrails",
            "validate-roadmap",
            "build-and-test"
          ]
        },
        "enforce_admins": true,
        "required_pull_request_reviews": {
          "dismissal_restrictions": {},
          "dismiss_stale_reviews": true,
          "require_code_owner_reviews": true,
          "required_approving_review_count": 2,
          "require_last_push_approval": false
        },
        "restrictions": {
          "users": [],
          "teams": ["maintainers"]
        },
        "require_commit_signatures": true,
        "required_linear_history": false,
        "allow_force_pushes": false,
        "allow_deletions": false,
        "block_creations": false,
        "required_conversation_resolution": true,
        "lock_branch": false,
        "allow_fork_syncing": true
      }
    },
    "develop": {
      "protection": {
        "required_status_checks": {
          "strict": true,
          "contexts": [
            "build-windows-msvc",
            "build-linux-gcc",
            "test-unit",
            "static-analysis",
            "security-scan",
            "validate-ai-guardrails",
            "validate-roadmap"
          ]
        },
        "enforce_admins": false,
        "required_pull_request_reviews": {
          "dismissal_restrictions": {},
          "dismiss_stale_reviews": false,
          "require_code_owner_reviews": true,
          "required_approving_review_count": 2,
          "require_last_push_approval": false
        },
        "restrictions": null,
        "require_commit_signatures": false,
        "required_linear_history": false,
        "allow_force_pushes": false,
        "allow_deletions": false,
        "block_creations": false,
        "required_conversation_resolution": true,
        "lock_branch": false,
        "allow_fork_syncing": true
      }
    },
    "release/*": {
      "protection": {
        "required_status_checks": {
          "strict": true,
          "contexts": [
            "build-windows-msvc",
            "build-linux-gcc",
            "build-docker",
            "test-unit",
            "test-integration",
            "test-performance",
            "static-analysis",
            "security-scan",
            "validate-ai-guardrails",
            "validate-roadmap",
            "build-and-test"
          ]
        },
        "enforce_admins": true,
        "required_pull_request_reviews": {
          "dismissal_restrictions": {},
          "dismiss_stale_reviews": true,
          "require_code_owner_reviews": true,
          "required_approving_review_count": 2,
          "require_last_push_approval": true
        },
        "restrictions": {
          "users": [],
          "teams": ["maintainers"]
        },
        "require_commit_signatures": true,
        "required_linear_history": true,
        "allow_force_pushes": false,
        "allow_deletions": false,
        "block_creations": false,
        "required_conversation_resolution": true,
        "lock_branch": false,
        "allow_fork_syncing": false
      }
    }
  },
  "deployment": {
    "instructions": [
      "This file documents the branch protection rules for ThemisDB.",
      "To apply these rules:",
      "",
      "1. Navigate to GitHub Repository Settings",
      "2. Go to 'Branches' → 'Branch protection rules'",
      "3. For each branch pattern (main, develop, release/*), create a rule with:",
      "",
      "Main Branch:",
      "  - Require pull request reviews (2 approvals)",
      "  - Require status checks to pass before merging",
      "  - Require branches to be up to date before merging",
      "  - Require conversation resolution before merging",
      "  - Do not allow bypassing the above settings (enforce for admins)",
      "",
      "Develop Branch:",
      "  - Require pull request reviews (1 approval)",
      "  - Require status checks to pass before merging",
      "  - Require branches to be up to date before merging",
      "  - Require conversation resolution before merging",
      "",
      "Release/* Branches:",
      "  - Require pull request reviews (2 approvals, last push)",
      "  - Require linear history",
      "  - Require status checks to pass before merging",
      "  - Require branches to be up to date before merging",
      "  - Require conversation resolution before merging",
      "  - Do not allow bypassing the above settings (enforce for admins)"
    ]
  },
  "required_status_checks_descriptions": {
    "build-windows-msvc": "Windows build with MSVC 2022",
    "build-linux-gcc": "Linux build with GCC",
    "build-docker": "Multi-arch Docker build",
    "build-and-test": "Combined build and test suite",
    "test-unit": "Unit test suite",
    "test-integration": "Integration test suite",
    "test-performance": "Performance/benchmark tests",
    "static-analysis": "Static analysis (clang-tidy, cppcheck)",
    "Doxygen Governance": "Doxygen source-governance gate for changed public C/C++ APIs",
    "security-scan": "CodeQL security scanning",
    "validate-ai-guardrails": "AI-Guardrails validation workflow",
    "validate-roadmap": "Roadmap structure validation"
  },
  "notes": [
    "Branch protection rules must be configured manually in GitHub UI",
    "This file serves as documentation and reference",
    "Update this file when changing protection rules",
    "Review protection rules quarterly for effectiveness",
    "Commit signing (GPG) is required for main and release/* branches",
    "Roadmap validation (validate-roadmap) is required before merge on all protected branches",
    "Add the 'Doxygen Governance' required check to protected branches that enforce source-governance before merge",
    "Code owner review is required for main and release/* branches",
    "Restricted push access on main and release/* to @makr-code/maintainers team"
  ]
}
