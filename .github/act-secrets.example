# Example secrets file for local testing with `act`
# Copy this file to `.github/act-secrets` and fill in your values
# 
# ⚠️ NEVER commit this file with real values!
# Make sure `.github/act-secrets` is in .gitignore

# GitHub Token (for GHCR access)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Docker Hub credentials
DOCKERHUB_USERNAME=your-dockerhub-username
DOCKERHUB_TOKEN=dckr_pat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# PyPI API Token
PYPI_API_TOKEN=pypi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Maven Central credentials
MAVEN_USERNAME=your-maven-central-username
MAVEN_PASSWORD=your-maven-central-password
GPG_PASSPHRASE=your-gpg-passphrase

# NuGet API Key
NUGET_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
