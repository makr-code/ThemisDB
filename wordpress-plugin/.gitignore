# WordPress Plugin .gitignore

# OS Files
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary files
*.tmp
*.bak

# WordPress specific
wp-config.php
wp-content/uploads/
wp-content/cache/
wp-content/backup-db/
wp-content/advanced-cache.php
wp-content/wp-cache-config.php

# Node modules (if using npm/yarn for development)
node_modules/
package-lock.json
yarn.lock

# Build artifacts
dist/
build/
*.zip

# Testing
phpunit.xml
.phpunit.result.cache

# Composer
vendor/
composer.lock
