# Dockerfile for ThemisDB MINIMAL Edition
# Smallest possible build with only core database features
# No LLM, no GPU, no sharding, no advanced protocols
#
# Build:
#   docker build -f Dockerfile.minimal -t themisdb:minimal .
#
# Run:
#   docker run -d -p 8080:8080 -v themis_data:/data themisdb:minimal
#
# Binary size: ~50-80% smaller than Community Edition
# Build time: ~5-10 minutes (vs ~30-40 for full build)

# ============================================================================
# Stage 1: Builder
# ============================================================================
FROM ubuntu:24.04 AS builder

ARG CMAKE_BUILD_TYPE=Release

# Install minimal build dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    git \
    curl \
    zip \
    unzip \
    tar \
    pkg-config \
    ninja-build \
    && rm -rf /var/lib/apt/lists/*

# Install vcpkg
WORKDIR /opt
COPY vcpkg /opt/vcpkg
RUN cd /opt/vcpkg && \
    ./bootstrap-vcpkg.sh -disableMetrics && \
    ./vcpkg integrate install

ENV VCPKG_ROOT=/opt/vcpkg
ENV PATH="${VCPKG_ROOT}:${PATH}"
ENV VCPKG_BINARY_SOURCES="clear;default"

# Set working directory
WORKDIR /build

# Copy source code
COPY . .

# Configure CMake for MINIMAL edition
# Disable all non-essential features for smallest binary
RUN cmake -S . -B build \
    -G Ninja \
    -DCMAKE_BUILD_TYPE=${CMAKE_BUILD_TYPE} \
    -DCMAKE_TOOLCHAIN_FILE=${VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake \
    -DTHEMIS_EDITION=MINIMAL \
    -DTHEMIS_ENABLE_LLM=OFF \
    -DTHEMIS_ENABLE_GPU=OFF \
    -DTHEMIS_ENABLE_CUDA=OFF \
    -DTHEMIS_ENABLE_VULKAN=OFF \
    -DTHEMIS_ENABLE_HIP=OFF \
    -DTHEMIS_ENABLE_CONTENT_PROCESSORS=OFF \
    -DTHEMIS_ENABLE_TRACING=OFF \
    -DTHEMIS_ENABLE_VOICE_ASSISTANT=OFF \
    -DTHEMIS_ENABLE_WHISPER=OFF \
    -DTHEMIS_ENABLE_PIPER_TTS=OFF \
    -DTHEMIS_ENABLE_GRPC=OFF \
    -DTHEMIS_ENABLE_HTTP2=OFF \
    -DTHEMIS_ENABLE_HTTP3=OFF \
    -DTHEMIS_ENABLE_WEBSOCKET=OFF \
    -DTHEMIS_ENABLE_MQTT=OFF \
    -DTHEMIS_ENABLE_POSTGRES_WIRE=OFF \
    -DTHEMIS_ENABLE_MCP=OFF \
    -DTHEMIS_BUILD_TESTS=OFF \
    -DTHEMIS_BUILD_BENCHMARKS=OFF \
    -DBUILD_SHARED_LIBS=OFF

# Build ThemisDB
RUN cmake --build build --config ${CMAKE_BUILD_TYPE} --parallel $(nproc)

# ============================================================================
# Stage 2: Runtime
# ============================================================================
FROM ubuntu:24.04

ARG CMAKE_BUILD_TYPE=Release

# Install minimal runtime dependencies
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    libssl3 \
    libstdc++6 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Copy binary from builder
COPY --from=builder /build/build/themis_server /usr/local/bin/themis_server

# Copy minimal configuration
COPY config/config-minimal.yaml /etc/themisdb/config.yaml

# Make executable
RUN chmod +x /usr/local/bin/themis_server

# Create data directory
RUN mkdir -p /data/rocksdb

# Expose HTTP port only (no gRPC, no other protocols)
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

# Set working directory
WORKDIR /data

# Environment variables
ENV THEMIS_CONFIG=/etc/themisdb/config.yaml
ENV THEMIS_EDITION=MINIMAL

# Run server
CMD ["/usr/local/bin/themis_server", "--config", "/etc/themisdb/config.yaml"]
