{
	"folders": [
		{
			"name": "RailwayMonitor WPF",
			"path": "projects/RailwayMonitor.WPF"
		},
		{
			"name": "ThemisDB Core",
			"path": "."
		},
		{
			"name": "Railway Scripts",
			"path": "scripts/railway"
		},
		{
			"name": "Documentation",
			"path": "projects/RailwayMonitor.WPF",
			"folderFilter": {
				"include": ["*.md"]
			}
		}
	],
	"settings": {
		// C# / .NET Settings
		"omnisharp.enableRoslynAnalyzers": true,
		"omnisharp.enableEditorConfigSupport": true,
		"omnisharp.enableImportCompletion": true,
		"omnisharp.organizeImportsOnFormat": true,
		
		// File formatting
		"files.trimTrailingWhitespace": true,
		"files.insertFinalNewline": true,
		"files.encoding": "utf8",
		"files.eol": "\n",
		
		// File exclusions
		"files.exclude": {
			"**/bin": true,
			"**/obj": true,
			"**/.vs": true,
			"**/node_modules": true,
			"**/__pycache__": true,
			"**/*.pyc": true
		},
		
		// Search exclusions
		"search.exclude": {
			"**/bin": true,
			"**/obj": true,
			"**/.vs": true,
			"**/node_modules": true,
			"**/__pycache__": true
		},
		
		// Python settings (for simulator scripts)
		"python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
		"python.linting.enabled": true,
		"python.linting.pylintEnabled": true,
		"python.formatting.provider": "black",
		"python.analysis.typeCheckingMode": "basic",
		
		// Editor settings
		"editor.formatOnSave": true,
		"editor.rulers": [120],
		"editor.tabSize": 4,
		"editor.insertSpaces": true,
		"editor.detectIndentation": false,
		
		// C# specific
		"[csharp]": {
			"editor.defaultFormatter": "ms-dotnettools.csharp",
			"editor.formatOnSave": true,
			"editor.codeActionsOnSave": {
				"source.organizeImports": "explicit"
			}
		},
		
		// XAML specific
		"[xaml]": {
			"editor.tabSize": 4,
			"editor.formatOnSave": true
		},
		
		// Python specific
		"[python]": {
			"editor.defaultFormatter": "ms-python.black-formatter",
			"editor.formatOnSave": true,
			"editor.tabSize": 4
		},
		
		// Markdown specific
		"[markdown]": {
			"editor.wordWrap": "on",
			"editor.quickSuggestions": {
				"comments": "off",
				"strings": "off",
				"other": "off"
			}
		},
		
		// Terminal
		"terminal.integrated.cwd": "${workspaceFolder}",
		
		// Git
		"git.ignoreLimitWarning": true,
		"git.autofetch": true
	},
	"extensions": {
		"recommendations": [
			// C# / .NET
			"ms-dotnettools.csharp",
			"ms-dotnettools.csdevkit",
			"ms-dotnettools.vscodeintellicode-csharp",
			
			// Python (for scripts)
			"ms-python.python",
			"ms-python.vscode-pylance",
			"ms-python.black-formatter",
			
			// XAML
			"doggy8088.netcore-extension-pack",
			
			// General productivity
			"editorconfig.editorconfig",
			"visualstudioexptteam.vscodeintellicode",
			"streetsidesoftware.code-spell-checker",
			"streetsidesoftware.code-spell-checker-german",
			
			// Git
			"eamodio.gitlens",
			
			// Markdown
			"yzhang.markdown-all-in-one",
			"bierner.markdown-mermaid",
			
			// Database (for PostGIS)
			"mtxr.sqltools",
			"mtxr.sqltools-driver-pg"
		]
	},
	"launch": {
		"version": "0.2.0",
		"configurations": [
			{
				"name": "RailwayMonitor WPF (Debug)",
				"type": "coreclr",
				"request": "launch",
				"preLaunchTask": "build-wpf",
				"program": "${workspaceFolder}/projects/RailwayMonitor.WPF/bin/Debug/net8.0-windows/RailwayMonitor.WPF.dll",
				"args": [],
				"cwd": "${workspaceFolder}/projects/RailwayMonitor.WPF",
				"console": "internalConsole",
				"stopAtEntry": false
			},
			{
				"name": "RailwayMonitor WPF (Release)",
				"type": "coreclr",
				"request": "launch",
				"preLaunchTask": "build-wpf-release",
				"program": "${workspaceFolder}/projects/RailwayMonitor.WPF/bin/Release/net8.0-windows/RailwayMonitor.WPF.dll",
				"args": [],
				"cwd": "${workspaceFolder}/projects/RailwayMonitor.WPF",
				"console": "internalConsole",
				"stopAtEntry": false
			},
			{
				"name": "Python: Train Simulator",
				"type": "python",
				"request": "launch",
				"program": "${workspaceFolder}/scripts/railway/train_simulator.py",
				"console": "integratedTerminal",
				"cwd": "${workspaceFolder}/scripts/railway",
				"env": {
					"PYTHONPATH": "${workspaceFolder}/scripts"
				}
			},
			{
				"name": "Python: Asset Management",
				"type": "python",
				"request": "launch",
				"program": "${workspaceFolder}/scripts/railway/asset_management.py",
				"console": "integratedTerminal",
				"cwd": "${workspaceFolder}/scripts/railway"
			}
		],
		"compounds": [
			{
				"name": "Full Stack (WPF + Simulator)",
				"configurations": [
					"RailwayMonitor WPF (Debug)",
					"Python: Train Simulator"
				],
				"stopAll": true
			}
		]
	},
	"tasks": {
		"version": "2.0.0",
		"tasks": [
			{
				"label": "build-wpf",
				"command": "dotnet",
				"type": "process",
				"args": [
					"build",
					"${workspaceFolder}/projects/RailwayMonitor.WPF/RailwayMonitor.WPF.csproj",
					"/property:GenerateFullPaths=true",
					"/consoleloggerparameters:NoSummary"
				],
				"problemMatcher": "$msCompile",
				"group": {
					"kind": "build",
					"isDefault": true
				}
			},
			{
				"label": "build-wpf-release",
				"command": "dotnet",
				"type": "process",
				"args": [
					"build",
					"${workspaceFolder}/projects/RailwayMonitor.WPF/RailwayMonitor.WPF.csproj",
					"-c",
					"Release",
					"/property:GenerateFullPaths=true",
					"/consoleloggerparameters:NoSummary"
				],
				"problemMatcher": "$msCompile"
			},
			{
				"label": "clean-wpf",
				"command": "dotnet",
				"type": "process",
				"args": [
					"clean",
					"${workspaceFolder}/projects/RailwayMonitor.WPF/RailwayMonitor.WPF.csproj"
				],
				"problemMatcher": "$msCompile"
			},
			{
				"label": "restore-wpf",
				"command": "dotnet",
				"type": "process",
				"args": [
					"restore",
					"${workspaceFolder}/projects/RailwayMonitor.WPF/RailwayMonitor.WPF.csproj"
				],
				"problemMatcher": "$msCompile"
			},
			{
				"label": "run-wpf",
				"command": "dotnet",
				"type": "process",
				"args": [
					"run",
					"--project",
					"${workspaceFolder}/projects/RailwayMonitor.WPF/RailwayMonitor.WPF.csproj"
				],
				"problemMatcher": "$msCompile",
				"dependsOn": "build-wpf"
			},
			{
				"label": "test-wpf",
				"command": "dotnet",
				"type": "process",
				"args": [
					"test",
					"${workspaceFolder}/projects/RailwayMonitor.WPF/RailwayMonitor.WPF.csproj"
				],
				"problemMatcher": "$msCompile",
				"group": {
					"kind": "test",
					"isDefault": true
				}
			},
			{
				"label": "publish-wpf",
				"command": "dotnet",
				"type": "process",
				"args": [
					"publish",
					"${workspaceFolder}/projects/RailwayMonitor.WPF/RailwayMonitor.WPF.csproj",
					"-c",
					"Release",
					"-r",
					"win-x64",
					"--self-contained",
					"-o",
					"${workspaceFolder}/publish/RailwayMonitor"
				],
				"problemMatcher": "$msCompile"
			},
			{
				"label": "start-train-simulator",
				"type": "shell",
				"command": "python",
				"args": [
					"${workspaceFolder}/scripts/railway/train_simulator.py"
				],
				"options": {
					"cwd": "${workspaceFolder}/scripts/railway"
				},
				"problemMatcher": []
			},
			{
				"label": "format-code",
				"type": "shell",
				"command": "dotnet",
				"args": [
					"format",
					"${workspaceFolder}/projects/RailwayMonitor.WPF/RailwayMonitor.WPF.csproj"
				],
				"problemMatcher": []
			}
		]
	}
}
