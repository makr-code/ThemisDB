# XML Grammar
# Supports basic XML with elements, attributes, and text content

root ::= ws element ws

# Elements
element ::= empty-element | start-tag content end-tag
empty-element ::= "<" tag-name (ws attribute)* ws "/>"
start-tag ::= "<" tag-name (ws attribute)* ws ">"
end-tag ::= "</" tag-name ws ">"

# Tag names
tag-name ::= [a-zA-Z_:] [a-zA-Z0-9_:.-]*

# Attributes
attribute ::= attr-name ws "=" ws attr-value
attr-name ::= [a-zA-Z_:] [a-zA-Z0-9_:.-]*
attr-value ::= "\"" [^"]* "\"" | "'" [^']* "'"

# Content
content ::= (element | text)*
text ::= [^<]+
cdata ::= "<![CDATA[" [^\]]* "]]>"

# Whitespace
ws ::= [ \t\n\r]*
