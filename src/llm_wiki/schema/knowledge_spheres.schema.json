{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://themisdb.dev/schemas/knowledge_spheres.schema.json",
  "title": "Knowledge Spheres",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "spheres"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "spheres": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sphere"
      }
    }
  },
  "$defs": {
    "sphere": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sphere_id",
        "name",
        "status",
        "schema_version",
        "owner",
        "access_scope",
        "source_of_truth",
        "retention_policy",
        "migration_target",
        "is_protected"
      ],
      "properties": {
        "sphere_id": {
          "type": "string",
          "pattern": "^[a-z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": ["active", "deprecated", "archived", "migrating"]
        },
        "schema_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "access_scope": {
          "type": "string",
          "enum": ["public", "internal", "protected", "private"]
        },
        "source_of_truth": {
          "type": "string",
          "minLength": 1
        },
        "retention_policy": {
          "type": "string",
          "enum": ["short", "standard", "long", "compliance"]
        },
        "migration_target": {
          "type": ["string", "null"],
          "default": null
        },
        "is_protected": {
          "type": "boolean"
        },
        "extensions": {
          "type": "object",
          "additionalProperties": true
        },
        "audit_log_ref": {
          "type": ["string", "null"],
          "default": null
        }
      }
    }
  }
}
