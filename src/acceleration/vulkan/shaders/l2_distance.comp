#version 450

// Compute L2 (Euclidean) distance between query vectors and database vectors
// ThemisDB Vulkan Compute Shader
//
// Workgroup dimensions are exposed as SPIR-V specialization constants (IDs 0
// and 1) so that the host can tune occupancy per device at pipeline-creation
// time (e.g. 16×16 for Mali-G710 / AMD RDNA2 vs. 32×8 on desktop GPUs)
// without recompiling the shader.  Defaults match the original fixed sizes.
layout(constant_id = 0) const uint LOCAL_SIZE_X = 16;
layout(constant_id = 1) const uint LOCAL_SIZE_Y = 16;
layout(local_size_x_id = 0, local_size_y_id = 1) in;

layout(std430, binding = 0) readonly buffer QueryVectors {
    float queries[];
};

layout(std430, binding = 1) readonly buffer DatabaseVectors {
    float vectors[];
};

layout(std430, binding = 2) writeonly buffer Distances {
    float distances[];
};

layout(push_constant) uniform PushConstants {
    uint numQueries;
    uint numVectors;
    uint dim;
} pc;

void main() {
    uint qIdx = gl_GlobalInvocationID.y;  // Query index
    uint vIdx = gl_GlobalInvocationID.x;  // Vector index
    
    if (qIdx >= pc.numQueries || vIdx >= pc.numVectors) {
        return;
    }
    
    uint queryOffset = qIdx * pc.dim;
    uint vectorOffset = vIdx * pc.dim;
    
    float sum = 0.0;
    
    // Compute squared L2 distance
    for (uint i = 0; i < pc.dim; i++) {
        float diff = queries[queryOffset + i] - vectors[vectorOffset + i];
        sum += diff * diff;
    }
    
    // Store squared L2 distance (no sqrt for consistency and performance)
    distances[qIdx * pc.numVectors + vIdx] = sum;
}
