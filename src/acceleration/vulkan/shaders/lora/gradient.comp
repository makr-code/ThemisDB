#version 450

// Gradient computation for LoRA backward pass
// Computes gradients for LoRA parameters (A and B matrices)
// ThemisDB Vulkan Compute Shader for LoRA

layout(local_size_x = 16, local_size_y = 16) in;

// Forward pass cached values
layout(std430, binding = 0) readonly buffer Input {
    float input_buf[];  // Cached input from forward pass
};

layout(std430, binding = 1) readonly buffer MatrixB {
    float B[];  // LoRA B matrix (in_dim, rank)
};

layout(std430, binding = 2) readonly buffer MatrixA {
    float A[];  // LoRA A matrix (rank, out_dim)
};

layout(std430, binding = 3) readonly buffer GradOutput {
    float grad_output[];  // Gradient from next layer
};

// Gradient outputs
layout(std430, binding = 4) writeonly buffer GradA {
    float grad_A[];  // Gradient w.r.t. A
};

layout(std430, binding = 5) writeonly buffer GradB {
    float grad_B[];  // Gradient w.r.t. B
};

layout(std430, binding = 6) writeonly buffer GradInput {
    float grad_input[];  // Gradient w.r.t. input (for backprop)
};

layout(push_constant) uniform PushConstants {
    uint batch_size;
    uint in_dim;
    uint rank;
    uint out_dim;
    uint scaling;  // Scaling factor (as uint, reinterpreted as float)
    uint compute_mode;  // 0=grad_A, 1=grad_B, 2=grad_input
} pc;

shared float tile_shared[16][16];

void main() {
    uint row = gl_GlobalInvocationID.y;
    uint col = gl_GlobalInvocationID.x;
    
    float scaling_val = uintBitsToFloat(pc.scaling);
    
    if (pc.compute_mode == 0) {
        // Compute grad_A = B.T @ (input.T @ (grad_output * scaling))
        // Result shape: (rank, out_dim)
        
        if (row >= pc.rank || col >= pc.out_dim) {
            return;
        }
        
        float sum = 0.0;
        
        // Accumulate over batch and input dimensions
        for (uint b = 0; b < pc.batch_size; b++) {
            for (uint i = 0; i < pc.in_dim; i++) {
                float input_val = input_buf[b * pc.in_dim + i];
                float grad_val = grad_output[b * pc.out_dim + col] * scaling_val;
                float b_val = B[i * pc.rank + row];
                
                sum += b_val * input_val * grad_val;
            }
        }
        
        grad_A[row * pc.out_dim + col] = sum;
        
    } else if (pc.compute_mode == 1) {
        // Compute grad_B = (grad_output * scaling @ A.T) @ input.T
        // Result shape: (in_dim, rank)
        
        if (row >= pc.in_dim || col >= pc.rank) {
            return;
        }
        
        float sum = 0.0;
        
        // Accumulate over batch and output dimensions
        for (uint b = 0; b < pc.batch_size; b++) {
            for (uint o = 0; o < pc.out_dim; o++) {
                float grad_val = grad_output[b * pc.out_dim + o] * scaling_val;
                float a_val = A[col * pc.out_dim + o];
                float input_val = input_buf[b * pc.in_dim + row];
                
                sum += grad_val * a_val * input_val;
            }
        }
        
        grad_B[row * pc.rank + col] = sum;
        
    } else if (pc.compute_mode == 2) {
        // Compute grad_input = (grad_output * scaling) @ (BA).T
        // where BA = B @ A
        // Result shape: (batch_size, in_dim)
        
        if (row >= pc.batch_size || col >= pc.in_dim) {
            return;
        }
        
        float sum = 0.0;
        
        // Compute BA on-the-fly and multiply with grad_output
        for (uint o = 0; o < pc.out_dim; o++) {
            float grad_val = grad_output[row * pc.out_dim + o] * scaling_val;
            
            // Compute BA[col, o] = sum_r B[col, r] * A[r, o]
            float ba_val = 0.0;
            for (uint r = 0; r < pc.rank; r++) {
                ba_val += B[col * pc.rank + r] * A[r * pc.out_dim + o];
            }
            
            sum += grad_val * ba_val;
        }
        
        grad_input[row * pc.in_dim + col] = sum;
    }
}
