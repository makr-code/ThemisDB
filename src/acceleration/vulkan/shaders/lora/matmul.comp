#version 450

// Matrix Multiplication (GEMM) for LoRA Training
// Computes C = A @ B where A: (M, K), B: (K, N), C: (M, N)
// ThemisDB Vulkan Compute Shader for LoRA

layout(local_size_x = 16, local_size_y = 16) in;

layout(std430, binding = 0) readonly buffer MatrixA {
    float A[];
};

layout(std430, binding = 1) readonly buffer MatrixB {
    float B[];
};

layout(std430, binding = 2) writeonly buffer MatrixC {
    float C[];
};

layout(push_constant) uniform PushConstants {
    uint M;  // Rows of A and C
    uint K;  // Cols of A, Rows of B
    uint N;  // Cols of B and C
    // Note: alpha stored as uint and reinterpreted as float via uintBitsToFloat()
    // This is required because Vulkan push constants must be 4-byte aligned
    // and using float directly could cause alignment issues on some drivers.
    // The reinterpretation is lossless and allows consistent behavior across platforms.
    uint alpha;  // Scaling factor (stored as uint, reinterpreted as float)
} pc;

// Shared memory for tile-based GEMM (optimization)
shared float tileA[16][16];
shared float tileB[16][16];

void main() {
    uint row = gl_GlobalInvocationID.y;  // Row in C
    uint col = gl_GlobalInvocationID.x;  // Col in C
    
    if (row >= pc.M || col >= pc.N) {
        return;
    }
    
    uint localRow = gl_LocalInvocationID.y;
    uint localCol = gl_LocalInvocationID.x;
    
    float sum = 0.0;
    
    // Tile-based computation for better cache utilization
    uint numTiles = (pc.K + 15) / 16;
    
    for (uint tile = 0; tile < numTiles; tile++) {
        // Load tile of A into shared memory
        uint aCol = tile * 16 + localCol;
        if (row < pc.M && aCol < pc.K) {
            tileA[localRow][localCol] = A[row * pc.K + aCol];
        } else {
            tileA[localRow][localCol] = 0.0;
        }
        
        // Load tile of B into shared memory
        uint bRow = tile * 16 + localRow;
        if (bRow < pc.K && col < pc.N) {
            tileB[localRow][localCol] = B[bRow * pc.N + col];
        } else {
            tileB[localRow][localCol] = 0.0;
        }
        
        // Synchronize to ensure tile is loaded
        barrier();
        
        // Compute partial dot product for this tile
        for (uint k = 0; k < 16; k++) {
            sum += tileA[localRow][k] * tileB[k][localCol];
        }
        
        // Synchronize before loading next tile
        barrier();
    }
    
    // Apply scaling factor and store result
    float alpha_val = uintBitsToFloat(pc.alpha);
    C[row * pc.N + col] = sum * alpha_val;
}
