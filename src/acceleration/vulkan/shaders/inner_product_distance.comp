#version 450

// Compute Inner Product distance between query vectors and database vectors
// ThemisDB Vulkan Compute Shader
// Distance = -dot_product  (negative dot product; lower is more similar)

layout(local_size_x = 16, local_size_y = 16) in;

layout(std430, binding = 0) readonly buffer QueryVectors {
    float queries[];
};

layout(std430, binding = 1) readonly buffer DatabaseVectors {
    float vectors[];
};

layout(std430, binding = 2) writeonly buffer Distances {
    float distances[];
};

layout(push_constant) uniform PushConstants {
    uint numQueries;
    uint numVectors;
    uint dim;
} pc;

void main() {
    uint qIdx = gl_GlobalInvocationID.y;
    uint vIdx = gl_GlobalInvocationID.x;
    
    if (qIdx >= pc.numQueries || vIdx >= pc.numVectors) {
        return;
    }
    
    uint queryOffset = qIdx * pc.dim;
    uint vectorOffset = vIdx * pc.dim;
    
    float dotProduct = 0.0;
    
    // Compute dot product
    for (uint i = 0; i < pc.dim; i++) {
        dotProduct += queries[queryOffset + i] * vectors[vectorOffset + i];
    }
    
    // Store -dot_product as distance (consistent with CPU dispatch fallback)
    distances[qIdx * pc.numVectors + vIdx] = -dotProduct;
}
