.PHONY: help build up down logs test clean restart metrics

COMPOSE_FILE := docker/compose/docker-compose-llm-raid-tests-orchestrated.yml
DOCKER_IMAGE := themisdb/themis-llm-raid-tests:latest
TEST_RESULTS := test_results
DOCKER_BUILDKIT := 1

help:
	@echo "ThemisDB LLM RAID Orchestration Test Suite"
	@echo ""
	@echo "Available targets:"
	@echo "  make build          - Build Docker image for tests"
	@echo "  make up             - Start RAID cluster + test service"
	@echo "  make down           - Stop all services"
	@echo "  make test           - Run all tests (default: pipeline)"
	@echo "  make test-inline    - Run inline LoRA tests"
	@echo "  make test-pipeline  - Run RAID pipeline tests"
	@echo "  make test-bench     - Run all benchmarks"
	@echo "  make test-all       - Run all tests + benchmarks"
	@echo "  make logs           - View test service logs"
	@echo "  make metrics        - Show metrics from Prometheus"
	@echo "  make grafana        - Open Grafana dashboard (http://localhost:3000)"
	@echo "  make health         - Check RAID cluster health"
	@echo "  make results        - Show test results"
	@echo "  make clean          - Clean up containers and volumes"
	@echo "  make restart        - Restart services"
	@echo ""

build:
	@echo "Building Docker image: $(DOCKER_IMAGE)"
	@cd . && docker build \
		-f docker/Dockerfile.llm-raid-tests \
		-t $(DOCKER_IMAGE) .
	@echo "✓ Image built successfully"

up:
	@echo "Starting RAID cluster + test orchestration service..."
	@cd docker/compose && docker-compose -f $(COMPOSE_FILE) up -d
	@echo "✓ Services starting (wait 60-90 seconds for shards to be healthy)"
	@sleep 10
	@make health

down:
	@echo "Stopping all services..."
	@cd docker/compose && docker-compose -f $(COMPOSE_FILE) down
	@echo "✓ Services stopped"

test: test-pipeline

test-inline:
	@echo "Running inline LoRA tests..."
	@cd docker/compose && docker-compose -f $(COMPOSE_FILE) \
		run --rm -e TEST_TYPE=inline themis-llm-raid-tests
	@make results

test-pipeline:
	@echo "Running RAID pipeline tests..."
	@cd docker/compose && docker-compose -f $(COMPOSE_FILE) \
		run --rm -e TEST_TYPE=pipeline themis-llm-raid-tests
	@make results

test-bench:
	@echo "Running all benchmarks..."
	@cd docker/compose && docker-compose -f $(COMPOSE_FILE) \
		run --rm -e TEST_TYPE=all_bench themis-llm-raid-tests
	@make results

test-all:
	@echo "Running all tests + benchmarks..."
	@cd docker/compose && docker-compose -f $(COMPOSE_FILE) \
		run --rm -e TEST_TYPE=all themis-llm-raid-tests
	@make results

logs:
	@docker logs -f themis-llm-raid-tests 2>/dev/null || \
		echo "Test service not running (try: make up && make test)"

health:
	@echo "RAID Cluster Health Status:"
	@cd docker/compose && docker-compose -f $(COMPOSE_FILE) ps
	@echo ""
	@echo "Shard Health Checks:"
	@docker ps --filter "label=raid_type" --format "{{.Names}}: {{.Status}}" 2>/dev/null || true

metrics:
	@echo "Fetching metrics from Prometheus..."
	@curl -s "http://localhost:9090/api/v1/query?query=themis_documents_total" | python3 -m json.tool
	@echo ""
	@echo "Grafana: http://localhost:3000 (admin/themis)"
	@echo "Prometheus: http://localhost:9090"

grafana:
	@echo "Opening Grafana dashboard..."
	@open http://localhost:3000 2>/dev/null || \
		xdg-open http://localhost:3000 2>/dev/null || \
		start http://localhost:3000 2>/dev/null || \
		echo "Open http://localhost:3000 in your browser (admin/themis)"

results:
	@echo ""
	@echo "Test Results:"
	@docker cp themis-llm-raid-tests:/test_results/. ./$(TEST_RESULTS)/ 2>/dev/null || true
	@echo "✓ Results copied to ./$(TEST_RESULTS)/"
	@echo ""
	@if [ -f "$(TEST_RESULTS)/test_report.html" ]; then \
		echo "HTML Report: ./$(TEST_RESULTS)/test_report.html"; \
		ls -lh $(TEST_RESULTS)/*.{html,xml,json} 2>/dev/null | tail -10; \
	else \
		echo "No results available yet"; \
	fi

clean:
	@echo "Cleaning up containers, volumes, and images..."
	@cd docker/compose && docker-compose -f $(COMPOSE_FILE) down -v
	@docker rmi $(DOCKER_IMAGE) 2>/dev/null || true
	@rm -rf $(TEST_RESULTS)
	@echo "✓ Cleanup complete"

restart: down
	@sleep 5
	@make up

# Entwickler-Targets

rebuild: clean build up

full-test: up test-all

shell:
	@docker exec -it themis-llm-raid-tests /bin/bash

shell-shard:
	@docker exec -it themis-raid0-shard1 /bin/bash

# CI/CD Integration

ci-test:
	@make build
	@make up
	@make test-all
	@make health
	@make results
	@exit_code=$$?; make down; exit $$exit_code

# Monitoring Shortcuts

prometheus:
	@echo "Opening Prometheus..."
	@open http://localhost:9090 2>/dev/null || \
		xdg-open http://localhost:9090 2>/dev/null || \
		start http://localhost:9090 2>/dev/null || \
		echo "Open http://localhost:9090 in your browser"

# Hilfsfunktionen

.PHONY: version docker-info
version:
	@echo "ThemisDB LLM RAID Test Suite v1.0"
	@echo "Docker: $$(docker --version)"
	@echo "Docker Compose: $$(docker-compose --version)"

docker-info:
	@docker info | grep -E "Containers|Images|Memory"
