# ============================================================================
# .dockerignore - Docker Build Context Optimization
# ============================================================================
# Reduziert Build-Context von ~200k+ auf ~500 Dateien
# Spart ~1-2 GB Upload-Zeit zum Docker-Daemon

# --- Build Artifacts (nicht für Docker-Build nötig) ------------------------
build/
build-*/
out/
bin/
lib/
dist/
Testing/
CMakeFiles/
CMakeCache.txt
*.cmake

# --- vcpkg (wird im Docker neu gebaut - 163k+ Dateien!) --------------------
vcpkg_installed/
vcpkg/
.vcpkg/
packages/
downloads/
buildtrees/

# --- Development & Testing (nicht für Production) --------------------------
tests/
benchmarks/
fuzz/
data/
test_geo_integration_db/
# examples/ - NEEDED for Docker packages
# clients/ - NEEDED for SDK distribution
# openapi/ - NEEDED for API specification
adapters/

# --- Documentation (nicht für Runtime) -------------------------------------
# docs/ - Some docs needed for packages (openapi, deployment guides)
site/
wiki/
wiki_out/
wiki-temp/
# Exclude most markdown except essential ones
*.md
!README.md
!CHANGELOG.md
!LICENSE.md
!SECURITY.md
# Exclude most of docs/ but keep essential subdirs
docs/**
!docs/ThemisDB-Documentation.pdf
!docs/deployment/

# --- Developer Tools (nicht für Production) --------------------------------
# tools/ - plugin_signer and sign scripts needed
tools/jaeger/
tools/Themis.*/
tools/CMakeLists.txt
tools/debug_graph_keys.cpp
tools/publish_wiki.py
tools/STATUS.md
tools/MOCK_MODE.md
tools/Themis.sln
.tools/
# scripts/ - needed for install scripts in packages
.github/
.vscode/
.idea/
.vs/

# --- Logs und temporäre Dateien --------------------------------------------
logs/
*.log
*.pid
*.err
*.out
tmp*/
test_output*
server.pid
server.err
server.out

# --- Git Repository --------------------------------------------------------
.git/
.gitignore
.gitattributes

# --- IDE und OS Dateien ----------------------------------------------------
*.swp
*.swo
*~
.DS_Store
Thumbs.db
*.suo
*.user
.vscode/
.idea/

# --- Build Artefakte (kompiliert) ------------------------------------------
*.o
*.obj
*.a
*.lib
*.so
*.dll
*.exe
*.pdb
*.ilk
*.dylib

# --- Archive und Packages --------------------------------------------------
*.tar.gz
*.zip
*.deb
*.rpm
*.tgz

# --- Python (falls vorhanden) ----------------------------------------------
__pycache__/
*.py[cod]
.pytest_cache/
venv/
.venv/
*.egg-info/

# --- Node.js (falls vorhanden) ---------------------------------------------
node_modules/
npm-debug.log
yarn-error.log

# --- Packaging (nicht für Docker-Build) ------------------------------------
packaging/
debian/
PKGBUILD
*.spec

# ============================================================================
# Explizit einbeziehen (überschreibt obige Regeln)
# ============================================================================
!CMakeLists.txt
!vcpkg.json
!vcpkg-configuration.json
!Dockerfile
!docker-compose*.yml
!setup.sh
!build.sh

# --- Ende .dockerignore -----------------------------------------------------