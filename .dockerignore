# Keep Docker build context minimal for docker/Dockerfile.unified.
# Ignore everything by default and only include required paths.
*

# Root files required by Dockerfile.unified
!CMakeLists.txt
!CMakePresets.json
!VERSION
!LICENSE
!vcpkg-configuration.json

# Required directories and their contents
!cmake/
!cmake/**
!docker/
!docker/**
!include/
!include/**
!src/
!src/**
!proto/
!proto/**
!internal/
!internal/**
!ports/
!ports/**
!plugins/
!plugins/**
!external/
!external/**
!tests/
!tests/**
!artifacts/
!artifacts/**
!scripts/
!scripts/**
!tools/
!tools/**
!vcpkg/
!vcpkg/**
!llama.cpp/
!llama.cpp/**
!whisper.cpp/
!whisper.cpp/**
!stable-diffusion.cpp/
!stable-diffusion.cpp/**
!ffmpeg/
!ffmpeg/**

# Model handling: never include local model artifacts in build context.
!models/
models/
models/**
!models/**/default.gguf
!models/**/*tinyllama*.gguf
!models/**/*TinyLlama*.gguf
!models/.gitkeep

# Keep llama.cpp cache/model outputs out of context.
llama.cpp/build/
llama.cpp/build/**
!llama.cpp/models/
llama.cpp/models/
llama.cpp/models/**
!llama.cpp/models/**/default.gguf
!llama.cpp/models/**/*tinyllama*.gguf
!llama.cpp/models/**/*TinyLlama*.gguf
!llama.cpp/models/.gitkeep

# Exclude non-essential large assets from source trees.
llama.cpp/docs/
llama.cpp/docs/**
llama.cpp/examples/
llama.cpp/examples/**
llama.cpp/tests/
llama.cpp/tests/**
llama.cpp/benches/
llama.cpp/benches/**
tools/wix311/
tools/wix311/**
tools/copilot-ollama-router/node_modules/
tools/copilot-ollama-router/node_modules/**
