# ============================================================================
# Docker Build Context Optimization
# ============================================================================
# Exclude unnecessary directories to speed up context transfer

# Build directories
build/
build-**/
artifacts/
cmake/artifacts/

# Cache/temp files  
.git/
.git/**
.cache/
*.log
.docker-build-**/

# Large/irrelevant directories
docs/
deploy/
helm/
benchmarks/
fuzz/
projects/
wordpress-plugin/
wordpress-theme/

# Development files
.vscode/
.vs/
*.code-workspace

# System files
.DS_Store
Thumbs.db
*.swp
*.swo
