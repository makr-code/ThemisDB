# ============================================================================
# Docker Build Context Exclusions (BLACKLIST - exclude large/unnecessary files)
# ============================================================================
# Strategy: Exclude everything NOT needed for Docker build to minimize context size

# ============================================================================
# CRITICAL: Large directories (60GB+ excluded)
# ============================================================================
models/                 # 30GB - LLM models, not needed for build
build-msvc/             # 22GB - build artifacts
build-wsl/              # 6GB - build artifacts
projects/               # 922MB - example projects
external/               # 826MB - external dependencies
compendium/             # 612MB - documentation
release/                # 947MB - release artifacts
site/                   # 141MB - generated website
tools/                  # 122MB - development tools

# vcpkg/ MUST stay in context for bind-mounts to work
# Only exclude unnecessary subdirectories
vcpkg/buildtrees/
vcpkg/.git/

# llama.cpp/ is NEEDED for build - only exclude large subdirectories
llama.cpp/build/
llama.cpp/build-*/
llama.cpp/models/
llama.cpp/.git/

# ============================================================================
# Build artifacts (will be rebuilt in container)
# ============================================================================
build/
build-*/
out/
CMakeFiles/
*.o
*.a
*.so*
*.dll
*.exe
*.pdb
Testing/
vcpkg_installed/
logs/

# ============================================================================
# Development/testing (not needed for Docker build)
# ============================================================================
tests/
benchmarks/
fuzz/
data/
test_geo_integration_db/
test_replication_loopback_data/

# ============================================================================
# Documentation (not needed in runtime image)
# ============================================================================
docs/
book/
*.md
!docker/*.md

# ============================================================================
# CI/CD and VCS
# ============================================================================
.git/
.github/
.gitignore
.gitattributes
.gitmodules
.gitleaks.toml

# ============================================================================
# IDE and dev tools
# ============================================================================
.vscode/
.clang-*
*.code-workspace
CMakePresets.json
CMakeLists.txt.user
CMakeUserPresets.json
__pycache__/
*.pyc
node_modules/

# ============================================================================
# Packaging and release artifacts
# ============================================================================
packaging/
debian/
release-changelogs/
wordpress-*/
helm/
grafana/
deploy/

# ============================================================================
# Temporary and log files
# ============================================================================
*.log
*.log.*
*.tmp
*.swp
*~
.DS_Store

# ============================================================================
# IMPORTANT: These are explicitly NOT excluded (needed for build)
# ============================================================================
# !llama.cpp/          - Essential for ThemisDB LLM features
# !vcpkg/              - Required for dependency management
# !vcpkg.json          - Dependency manifest
# !vcpkg-configuration.json
# !ports-overlays/     - Custom vcpkg ports
# !CMakeLists.txt      - Build configuration
# !cmake/              - CMake modules and settings
# !src/                - Source code
# !include/            - Header files
# !proto/              - Protocol buffer definitions
# !internal/           - Internal libraries
# !scripts/            - Build and configuration scripts
# !Dockerfile*         - Docker build files
# !.dockerignore       - This file

