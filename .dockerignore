# ============================================================================
# Docker Build Context Optimization
# ============================================================================
# Exclude unnecessary directories to speed up context transfer

# Build directories
build/
build-**/
artifacts/
cmake/artifacts/

# Cache/temp files  
.git/
.git/**
.cache/
*.log
.docker-build-**/

# Large/irrelevant directories (documentation, deployment configs, extras)
docs/
deploy/
helm/
benchmarks/
fuzz/
projects/
wordpress-plugin/
wordpress-theme/
training/                   # LLM training data - not needed at runtime
pytorch_models/             # Model caches
llm_cache/                  # LLM cache directory
cache/                      # General cache
symbols/                    # Debug symbols

# vcpkg directories (huge, cause context transfer issues)
vcpkg/buildtrees/
vcpkg/packages/
vcpkg/downloads/
vcpkg_installed/

# Node/npm modules & compendium (problematic symlinks, large, documentation-only)
node_modules/
.npm/
compendium/                  # Documentation system (PDF/HTML generation) - NOT needed for server
**/node_modules/

# Development files
.vscode/
.vs/
*.code-workspace

# System files
.DS_Store
Thumbs.db
*.swp
*.swo
