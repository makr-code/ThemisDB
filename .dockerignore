# ============================================================================
# .dockerignore - Docker Build Context Optimization
# ============================================================================
# Reduziert Build-Context von ~200k+ auf ~500 Dateien
# Spart ~1-2 GB Upload-Zeit zum Docker-Daemon

# --- Build Artifacts (nicht f??r Docker-Build n??tig) ------------------------
build/
!build/themis_server
build-*/
out/
bin/
lib/
dist/
Testing/
CMakeFiles/
CMakeCache.txt
*.cmake

# --- vcpkg (wird im Docker neu gebaut - 163k+ Dateien!) --------------------
vcpkg_installed/
vcpkg/

# Allow vcpkg/downloads for offline builds (~2GB source archives)
!vcpkg/downloads/**
.vcpkg/
packages/
buildtrees/

# --- Development & Testing (nicht f??r Production) --------------------------
tests/
benchmarks/
fuzz/
data/
test_geo_integration_db/
# examples/ - NEEDED for Docker packages
# clients/ - NEEDED for SDK distribution
# openapi/ - NEEDED for API specification
adapters/

# --- Release packages (not needed in Docker builds) -----------------------
release/

# --- Documentation (nicht f??r Runtime) ----------------------------------------
# docs/ - Some docs needed for packages (openapi, deployment guides)
# Most markdown files excluded, but keep essentials
*.md
!README.md
!CHANGELOG.md
!LICENSE
!SECURITY.md
!docker/README.md
!docker/CHANGELOG.md
!docker/ROADMAP.md
!DOCKER_DEPLOYMENT.md
# Exclude heavy documentation dirs
site/
wiki/
wiki_out/
wiki-temp/
docs/archive/
docs/api/
docs/architecture/
docs/compliance/
docs/development/
docs/enterprise/
docs/features/
docs/governance/
docs/guides/
docs/operations/
docs/performance/
docs/plugins/
docs/query/
docs/reports/
docs/roadmap/
docs/sdk/
docs/security/
docs/server/
docs/sharding/
docs/src/
docs/storage/
docs/tools/
docs/updates/
docs/analysis/

# --- Developer Tools (nicht f??r Production) --------------------------------
# tools/ - plugin_signer and sign scripts needed
tools/jaeger/
tools/Themis.*/
tools/CMakeLists.txt
tools/debug_graph_keys.cpp
tools/publish_wiki.py
tools/STATUS.md
tools/MOCK_MODE.md
tools/Themis.sln
.tools/
# scripts/ - needed for install scripts in packages
.github/
.vscode/
.idea/
.vs/

# --- Logs und tempor??re Dateien --------------------------------------------
logs/
*.log
*.pid
*.err
*.out
tmp*/
test_output*
server.pid
server.err
server.out

# --- Git Repository --------------------------------------------------------
.git/
.gitignore
.gitattributes

# --- IDE und OS Dateien ----------------------------------------------------
*.swp
*.swo
*~
.DS_Store
Thumbs.db
*.suo
*.user
.vscode/
.idea/

# --- Build Artefakte (kompiliert) ------------------------------------------
*.o
*.obj
*.a
*.lib
*.so
*.dll
*.exe
*.pdb
*.ilk
*.dylib

# --- Archive und Packages --------------------------------------------------
*.tar.gz
*.zip
*.deb
*.rpm
*.tgz

# --- Python (falls vorhanden) ----------------------------------------------
__pycache__/
*.py[cod]
.pytest_cache/
venv/
.venv/
*.egg-info/

# --- Node.js (falls vorhanden) ---------------------------------------------
node_modules/
npm-debug.log
yarn-error.log

# --- Packaging (nicht f??r Docker-Build) ------------------------------------
packaging/
debian/
PKGBUILD
*.spec

# ============================================================================
# Explizit einbeziehen (??berschreibt obige Regeln)
# ============================================================================
!CMakeLists.txt
!vcpkg.json
!vcpkg-configuration.json
!Dockerfile
!docker-compose*.yml
!setup.sh
!build.sh
!ports-overlays/**
# --- Ende .dockerignore -----------------------------------------------------
