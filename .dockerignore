# ============================================================================
# .dockerignore - Docker Build Context Optimization
# ============================================================================
# Reduziert Build-Context von ~200k+ auf ~500 Dateien
# Spart ~1-2 GB Upload-Zeit zum Docker-Daemon

# --- Build Artifacts (nicht für Docker-Build nötig) ------------------------
build/
build-*/
out/
bin/
lib/
dist/
Testing/
CMakeFiles/
CMakeCache.txt
*.cmake

# --- vcpkg (wird im Docker neu gebaut - 163k+ Dateien!) --------------------
vcpkg_installed/
vcpkg/
.vcpkg/
packages/
downloads/
buildtrees/

# --- Development & Testing (nicht für Production) --------------------------
tests/
benchmarks/
fuzz/
data/
test_geo_integration_db/
examples/
adapters/
clients/

# --- Documentation (nicht für Runtime) -------------------------------------
docs/
site/
wiki/
wiki_out/
wiki-temp/
*.md
!README.md
!CHANGELOG.md
!LICENSE.md

# --- Developer Tools (nicht für Production) --------------------------------
tools/
.tools/
scripts/
.github/
.vscode/
.idea/
.vs/

# --- Logs und temporäre Dateien --------------------------------------------
logs/
*.log
*.pid
*.err
*.out
tmp*/
test_output*
server.pid
server.err
server.out

# --- Git Repository --------------------------------------------------------
.git/
.gitignore
.gitattributes

# --- IDE und OS Dateien ----------------------------------------------------
*.swp
*.swo
*~
.DS_Store
Thumbs.db
*.suo
*.user
.vscode/
.idea/

# --- Build Artefakte (kompiliert) ------------------------------------------
*.o
*.obj
*.a
*.lib
*.so
*.dll
*.exe
*.pdb
*.ilk
*.dylib

# --- Archive und Packages --------------------------------------------------
*.tar.gz
*.zip
*.deb
*.rpm
*.tgz

# --- Python (falls vorhanden) ----------------------------------------------
__pycache__/
*.py[cod]
.pytest_cache/
venv/
.venv/
*.egg-info/

# --- Node.js (falls vorhanden) ---------------------------------------------
node_modules/
npm-debug.log
yarn-error.log

# --- Packaging (nicht für Docker-Build) ------------------------------------
packaging/
debian/
PKGBUILD
*.spec

# ============================================================================
# Explizit einbeziehen (überschreibt obige Regeln)
# ============================================================================
!CMakeLists.txt
!vcpkg.json
!vcpkg-configuration.json
!Dockerfile
!docker-compose*.yml
!setup.sh
!build.sh

# --- Ende .dockerignore -----------------------------------------------------