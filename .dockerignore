# ============================================================================
# .dockerignore - Docker Build Context Optimization
# ============================================================================
# Version: 2.0.0 (vcpkg Offline-First)
# Last Updated: 18. Dezember 2025
#
# Reduziert Build-Context von ~200k+ auf ~2k Dateien
# WICHTIG: vcpkg/downloads/ (~2.5 GB) wird inkludiert für offline builds
# Spart dennoch ~15 GB durch Exclusion von vcpkg/packages & buildtrees

# --- Build Artifacts (nicht für Docker-Build nötig) ------------------------
# Alle lokalen Build-Verzeichnisse ausschließen
build/
build-*/
out/
bin/
lib/
dist/
Testing/
CMakeFiles/
CMakeCache.txt
*.cmake

# Build logs (alle Varianten)
*.log
build*.txt
docker-build*.log
msbuild*.txt
msvc_build*.txt

# (Release assets re-included below after release/ exclusion)

# --- vcpkg Offline-First Strategy (v4.0.0) ---------------------------------
# Include: vcpkg/downloads/ (~2.5 GB) for offline builds
# Exclude: build artifacts (~15 GB) - werden im Docker neu gebaut
vcpkg_installed/
vcpkg/buildtrees/
vcpkg/packages/
vcpkg/installed/
.vcpkg/

# INCLUDE vcpkg essentials for offline builds (only specific subpaths)
!vcpkg/downloads/
!vcpkg/downloads/**
!vcpkg/scripts/
!vcpkg/scripts/**
!vcpkg/.vcpkg-root
!vcpkg/bootstrap-vcpkg.sh
!vcpkg/vcpkg.json
!vcpkg-configuration.json

# --- Exclude local LLM source (not needed in Docker context) --------------
llama.cpp/

# --- Development & Testing (nicht f??r Production) --------------------------
tests/
benchmarks/
fuzz/
data/
test_geo_integration_db/
# examples/ - NEEDED for Docker packages
# clients/ - NEEDED for SDK distribution
# openapi/ - NEEDED for API specification
adapters/

# --- Release packages (not needed in Docker builds) -----------------------
release/

# Allow selected release artifacts for Docker builds
!release/v*/themis-v*.tar.gz
!release/v*/themis-v*.zip
!docker/themis-linux.tar.gz

# --- Documentation (nicht f??r Runtime) ----------------------------------------
# docs/ - Some docs needed for packages (openapi, deployment guides)
# Most markdown files excluded, but keep essentials
*.md
!README.md
!CHANGELOG.md
!LICENSE
!SECURITY.md
!docker/README.md
!docker/CHANGELOG.md
!docker/ROADMAP.md
!DOCKER_DEPLOYMENT.md
# Exclude heavy documentation dirs
site/
wiki/
wiki_out/
wiki-temp/
docs/archive/
docs/api/
docs/architecture/
docs/compliance/
docs/development/
docs/enterprise/
docs/features/
docs/governance/
docs/guides/
docs/operations/
docs/performance/
docs/plugins/
docs/query/
docs/reports/
docs/roadmap/
docs/sdk/
docs/security/
docs/server/
docs/sharding/
docs/src/
docs/storage/
docs/tools/
docs/updates/
docs/analysis/

# --- Developer Tools (nicht f??r Production) --------------------------------
# tools/ - plugin_signer and sign scripts needed
tools/jaeger/
tools/Themis.*/
tools/CMakeLists.txt
tools/debug_graph_keys.cpp
tools/publish_wiki.py
tools/STATUS.md
tools/MOCK_MODE.md
tools/Themis.sln
.tools/
# scripts/ - needed for install scripts in packages
.github/
.vscode/
.idea/
.vs/

# --- Logs und tempor??re Dateien --------------------------------------------
logs/
*.log
*.pid
*.err
*.out
tmp*/
test_output*
server.pid
server.err
server.out

# --- Git Repository --------------------------------------------------------
.git/
.gitignore
.gitattributes

# --- IDE und OS Dateien ----------------------------------------------------
*.swp
*.swo
*~
.DS_Store
Thumbs.db
*.suo
*.user
.vscode/
.idea/

# --- Build Artefakte (kompiliert) ------------------------------------------
*.o
*.obj
*.a
*.lib
*.so
*.dll
*.exe
*.pdb
*.ilk
*.dylib

# --- Archive und Packages --------------------------------------------------
*.tar.gz
*.zip
*.deb
*.rpm
*.tgz
# BUT allow release archives
!themis-linux.tar.gz

# --- Python (falls vorhanden) ----------------------------------------------
__pycache__/
*.py[cod]
.pytest_cache/
venv/
.venv/
.venv-*/
.venv-wsl/
env/
env-*/
compendium/.venv/
*.egg-info/

# --- Node.js (falls vorhanden) ---------------------------------------------
node_modules/
npm-debug.log
yarn-error.log

# --- Packaging (nicht f??r Docker-Build) ------------------------------------
packaging/
debian/
PKGBUILD
*.spec

# ============================================================================
# Explizit einbeziehen (??berschreibt obige Regeln)
# ============================================================================
!CMakeLists.txt

!Dockerfile
!docker-compose*.yml
!setup.sh
!build.sh
!ports-overlays/**
# --- Ende .dockerignore -----------------------------------------------------
