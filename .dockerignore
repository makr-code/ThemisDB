# ============================================================================
# Docker Build Context - STRICT WHITELIST
# ============================================================================
# Exclude everything by default
**

# ============================================================================
# INCLUDE: Root files
# ============================================================================
!CMakeLists.txt
!VERSION
!vcpkg.json
!vcpkg-configuration.json
!.dockerignore
!Dockerfile
!Dockerfile.*
!docker-compose.yml

# ============================================================================
# INCLUDE: Directories (must include both folder and contents)
# ============================================================================
!cmake/
!cmake/**
!include/
!include/**
!src/
!src/**
!proto/
!proto/**
!internal/
!internal/**
!adapters/
!adapters/**
!aql/
!aql/**
!docker/
!docker/**
!llama.cpp/
!llama.cpp/**

# ============================================================================
# EXCLUDE: llama.cpp build artifacts
# ============================================================================
llama.cpp/build/**
llama.cpp/build-*/**
llama.cpp/.git/**
llama.cpp/.github/**
llama.cpp/tests/**

# ============================================================================
# EXCLUDE: Anything large (redundant safety)
# ============================================================================
vcpkg/**
build/**
build-*/**
models/**
projects/**
external/**
compendium/**
release/**
site/**
tools/**
