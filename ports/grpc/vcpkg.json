{
  "name": "grpc",
  "version-semver": "1.81.1",
  "port-version": 1,
  "description": "ThemisDB overlay revision to refresh the installed gRPC headers from the current port source.",
  "homepage": "https://github.com/grpc/grpc",
  "license": "Apache-2.0",
  "dependencies": [
    "abseil",
    {
      "name": "c-ares",
      "platform": "!uwp"
    },
    {
      "name": "grpc",
      "host": true,
      "features": ["codegen"]
    },
    "openssl",
    "protobuf",
    {
      "name": "protobuf",
      "host": true
    },
    "re2",
    "utf8-range",
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    },
    "zlib"
  ],
  "features": {
    "codegen": {
      "description": "Build code generator machinery",
      "supports": "!uwp",
      "dependencies": [
        {
          "name": "protobuf",
          "features": ["libprotoc"]
        }
      ]
    },
    "systemd": {
      "description": "Build with libsystemd support",
      "dependencies": ["libsystemd"]
    }
  }
}
