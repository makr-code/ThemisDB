{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "themis-qnap",
  "version": "1.1.0",
  "description": "Themis v1.1.0 build manifest with mimalloc optimization",
  "license": "MIT",
  "builtin-baseline": "bee7b66f0219eeb463dc1ff77ad6ad0211f94f48",
  "dependencies": [
    { "name": "openssl" },
    { "name": "rocksdb", "features": ["lz4", "zstd"] },
    { "name": "simdjson" },
    { "name": "tbb" },
    { "name": "arrow", "features": ["parquet", "compute"] },
    { "name": "hnswlib" },
    { "name": "gtest" },
    { "name": "benchmark" },
    { "name": "boost-asio" },
    { "name": "boost-beast" },
    { "name": "spdlog" },
    { "name": "nlohmann-json" },
    { "name": "opentelemetry-cpp", "features": ["otlp-http"] },
    { "name": "curl" },
    { "name": "yaml-cpp" },
    { "name": "zstd" },
    { "name": "mimalloc" }
  ],
  "features": {
    "gpu": {
      "description": "Enable GPU acceleration for vector search (not recommended for QNAP NAS)",
      "dependencies": ["faiss"]
    },
    "http2": {
      "description": "Enable HTTP/2 protocol support",
      "dependencies": ["nghttp2"]
    },
    "http3": {
      "description": "Enable HTTP/3 (QUIC) protocol support",
      "dependencies": [
        "nghttp3",
        { "name": "ngtcp2", "features": ["openssl"] }
      ]
    },
    "grpc": {
      "description": "Enable gRPC protocol support",
      "dependencies": [
        "grpc",
        "protobuf"
      ]
    },
    "websocket": {
      "description": "Enable WebSocket protocol support (uses Boost.Beast)",
      "dependencies": []
    },
    "mqtt": {
      "description": "Enable MQTT protocol support for IoT deployments",
      "dependencies": ["paho-mqttpp3"]
    },
    "postgres-wire": {
      "description": "Enable PostgreSQL Wire Protocol support for SQL tool compatibility",
      "dependencies": []
    }
  }
}
