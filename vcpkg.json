{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "themisdb",
  "version": "1.3.0",
  "description": "ThemisDB v1.3.0 - Multi-model database with native LLM integration",
  "license": "MIT",
  "builtin-baseline": "01f602195983451bc83e72f4214af2cbc495aa94",
  "dependencies": [
    { "name": "openssl", "version>=": "3.0.0" },
    { "name": "rocksdb", "features": ["lz4", "zstd"] },
    { "name": "simdjson", "version>=": "3.0.0" },
    { "name": "tbb", "version>=": "2021.5.0" },
    { "name": "hnswlib" },
    { "name": "gtest", "version>=": "1.14.0" },
    { "name": "benchmark", "version>=": "1.8.0" },
    { "name": "boost-asio", "version>=": "1.83.0" },
    { "name": "boost-beast", "version>=": "1.83.0" },
    { "name": "spdlog", "version>=": "1.12.0" },
    { "name": "nlohmann-json", "version>=": "3.11.0" },
    { "name": "c-ares" },
    { "name": "grpc", "version>=": "1.50.0" },
    { "name": "opentelemetry-cpp", "features": ["otlp-http"], "version>=": "1.10.0" },
    { "name": "curl", "version>=": "8.0.0" },
    { "name": "yaml-cpp", "version>=": "0.7.0" },
    { "name": "zstd", "version>=": "1.5.0" },
    { "name": "mimalloc", "version>=": "2.1.0" },
    { "name": "prometheus-cpp", "features": ["pull"] },
    { "name": "libzip" },
    { "name": "pugixml" },
    { "name": "cpp-httplib", "version>=": "0.14.0" },
    { "name": "boost-url", "version>=": "1.83.0" },
    { "name": "msgpack", "version>=": "6.0.0" },
    { "name": "crc32c" },
    { "name": "boost-variant", "version>=": "1.83.0" },
    { "name": "tl-expected" }
  ],
  "features": {
    "gpu": {
      "description": "Enable GPU acceleration for vector search",
      "dependencies": [
        "faiss",
        "openblas",
        "lapack"
      ]
    },
    "llm": {
      "description": "Enable LLM integration with llama.cpp (v1.3.0+)",
      "dependencies": []
    },
    "rpc": {
      "description": "Enable RPC framework with gRPC (v1.3.0+)",
      "dependencies": [
        "grpc",
        "protobuf"
      ]
    },
    "cuda": {
      "description": "Enable NVIDIA CUDA support for GPU acceleration (requires CUDA Toolkit installed separately)",
      "dependencies": []
    },
    "http2": {
      "description": "Enable HTTP/2 protocol support with Server Push",
      "dependencies": ["nghttp2"]
    },
    "http3": {
      "description": "Enable HTTP/3 (QUIC) protocol support",
      "dependencies": [
        "nghttp3",
        { "name": "ngtcp2", "features": ["openssl"] }
      ]
    },
    "grpc": {
      "description": "Enable gRPC protocol support",
      "dependencies": [
        "grpc",
        "protobuf"
      ]
    },
    "websocket": {
      "description": "Enable WebSocket protocol support with CDC (uses Boost.Beast)",
      "dependencies": []
    },
    "mcp": {
      "description": "Enable Model Context Protocol (MCP) for LLM integration",
      "dependencies": []
    },
    "mqtt": {
      "description": "Enable MQTT protocol support for IoT deployments",
      "dependencies": ["paho-mqttpp3"]
    },
    "postgres-wire": {
      "description": "Enable PostgreSQL Wire Protocol support for SQL tool compatibility",
      "dependencies": []
    },
    "gdal": {
      "description": "Enable GDAL integration for Shapefile and GeoTIFF support",
      "dependencies": ["gdal"]
    }
  }
}
