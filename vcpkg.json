{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "themisdb",
  "version": "1.3.0",
  "description": "ThemisDB v1.3.0 - Multi-model database with native LLM integration",
  "license": "MIT",
  "builtin-baseline": "e55144c5a465b53bc71bd0b59111ea0b8bb039a5",
  "dependencies": [
    {
      "name": "openssl",
      "version>=": "3.6.0"
    },
    {
      "name": "zlib",
      "version>=": "1.3"
    },
    {
      "name": "rocksdb",
      "features": [
        "lz4",
        "snappy",
        "zlib",
        "zstd"
      ]
    },
    {
      "name": "simdjson",
      "version>=": "3.0.0"
    },
    {
      "name": "tbb",
      "version>=": "2021.5.0"
    },
    {
      "name": "hnswlib"
    },
    {
      "name": "faiss"
    },
    {
      "name": "gtest",
      "version>=": "1.14.0"
    },
    {
      "name": "benchmark",
      "version>=": "1.8.0"
    },
    {
      "name": "boost-asio",
      "version>=": "1.83.0"
    },
    {
      "name": "boost-beast",
      "version>=": "1.83.0"
    },
    {
      "name": "boost-variant",
      "version>=": "1.83.0"
    },
    {
      "name": "boost-url",
      "version>=": "1.83.0"
    },
    {
      "name": "spdlog",
      "version>=": "1.12.0"
    },
    {
      "name": "nlohmann-json",
      "version>=": "3.11.3"
    },
    {
      "name": "c-ares"
    },
    {
      "name": "grpc",
      "default-features": false,
      "version>=": "1.60.0"
    },
    {
      "name": "opentelemetry-cpp",
      "features": [
        "otlp-http"
      ],
      "version>=": "1.24.0"
    },
    {
      "name": "curl",
      "version>=": "8.10.0"
    },
    {
      "name": "yaml-cpp",
      "version>=": "0.7.0"
    },
    {
      "name": "zstd",
      "version>=": "1.5.0"
    },
    {
      "name": "lz4",
      "version>=": "1.9.0"
    },
    {
      "name": "mimalloc",
      "version>=": "2.2.6"
    },
    {
      "name": "jemalloc",
      "platform": "linux | osx"
    },
    {
      "name": "prometheus-cpp",
      "features": [
        "pull"
      ]
    },
    {
      "name": "libzip"
    },
    {
      "name": "pugixml"
    },
    {
      "name": "crc32c"
    },
    {
      "name": "cpp-httplib"
    },
    {
      "name": "msgpack"
    },
    {
      "name": "tl-expected"
    },
    {
      "name": "onnxruntime"
    },
    {
      "name": "arrow",
      "features": [
        "parquet",
        "flight"
      ]
    },
    {
      "name": "opencl"
    },
    {
      "name": "vulkan"
    },
    {
      "name": "shaderc"
    }
  ],
  "overrides": [
    {
      "name": "lz4",
      "version": "1.10.0"
    }
  ],
  "features": {
    "redis": {
      "description": "Enable Redis-compatible distributed cache coordination via hiredis pub/sub",
      "dependencies": [
        "hiredis"
      ]
    },
    "gpu": {
      "description": "Enable GPU acceleration for vector search",
      "dependencies": []
    },
    "llm": {
      "description": "Enable LLM integration with llama.cpp (v1.3.0+)",
      "dependencies": []
    },
    "rpc": {
      "description": "Enable RPC framework with gRPC (v1.3.0+) - Alias for 'grpc' feature for backward compatibility",
      "dependencies": [
        {
          "name": "grpc",
          "default-features": false
        },
        "protobuf"
      ]
    },
    "cuda": {
      "description": "Enable NVIDIA CUDA support for GPU acceleration (requires CUDA Toolkit installed separately)",
      "dependencies": []
    },
    "http2": {
      "description": "Enable HTTP/2 protocol support with Server Push",
      "dependencies": [
        "nghttp2"
      ]
    },
    "http3": {
      "description": "Enable HTTP/3 (QUIC) protocol support",
      "dependencies": [
        "nghttp3",
        {
          "name": "ngtcp2",
          "features": [
            "openssl"
          ]
        }
      ]
    },
    "grpc": {
      "description": "Enable gRPC protocol support - Alias for 'rpc' feature",
      "dependencies": [
        {
          "name": "grpc",
          "default-features": false
        },
        "protobuf"
      ]
    },
    "websocket": {
      "description": "Enable WebSocket protocol support with CDC (uses Boost.Beast)",
      "dependencies": []
    },
    "mcp": {
      "description": "Enable Model Context Protocol (MCP) for LLM integration",
      "dependencies": []
    },
    "mqtt": {
      "description": "Enable MQTT protocol support for IoT deployments",
      "dependencies": [
        "paho-mqttpp3"
      ]
    },
    "postgres-wire": {
      "description": "Enable PostgreSQL Wire Protocol support for SQL tool compatibility",
      "dependencies": []
    },
    "gdal": {
      "description": "Enable GDAL integration for Shapefile and GeoTIFF support",
      "dependencies": [
        "gdal"
      ]
    },
    "cloud-storage": {
      "description": "Enable cloud storage backends (AWS S3, Azure Blob, Google Cloud Storage) for backup automation",
      "dependencies": [
        {
          "name": "aws-sdk-cpp",
          "features": [
            "s3",
            "transfer"
          ]
        },
        "azure-storage-cpp",
        {
          "name": "google-cloud-cpp",
          "features": [
            "storage"
          ]
        }
      ]
    },
    "kafka": {
      "description": "Enable Kafka-compatible CDC producer (requires librdkafka)",
      "dependencies": [
        "librdkafka"
      ]
    }
  }
}
