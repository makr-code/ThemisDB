{
  "name": "themisdb",
  "version": "2.4.0",
  "dependencies": [
    "zlib",
    "rocksdb",
    "fmt",
    "spdlog",
    "nlohmann-json",
    "vulkan",
    "vulkan-loader",
    "shaderc",
    "simdjson",
    "tbb",
    "zstd",
    "openssl",
    "protobuf",
    "grpc",
    "gtest",
    "benchmark",
    {
      "name": "opentelemetry-cpp",
      "features": [
        "otlp-http"
      ]
    },
    {
      "name": "krb5",
      "platform": "!windows"
    },
    "yaml-cpp",
    "curl",
    "boost",
    "arrow",
    "hwloc",
    "faiss",
    "pugixml"
  ],
  "features": {
    "llm": {
      "description": "Enable LLM-related ThemisDB build integration",
      "dependencies": []
    },
    "mcp": {
      "description": "Enable MCP-related ThemisDB build integration",
      "dependencies": []
    },
    "mqtt": {
      "description": "Enable MQTT protocol support",
      "dependencies": []
    },
    "rpc": {
      "description": "Enable RPC protocol support",
      "dependencies": [
        {
          "name": "grpc",
          "default-features": false
        },
        "protobuf"
      ]
    },
    "websocket": {
      "description": "Enable WebSocket protocol support",
      "dependencies": []
    }
  }
}
