{
  "name": "user_storage_encrypted",
  "version": "@PROJECT_VERSION@",
  "description": "Multi-level encrypted user storage plugin with gocryptfs backend",
  "type": "CUSTOM",
  "visibility": "private",
  "allowed_editions": ["enterprise", "hyperscaler", "military"],
  "license_feature": "secure_user_storage",
  "min_themisdb_version": "2.4.0",
  "compatible_core_abi": "plugin-abi-v2",
  "binary": {
    "windows": "themis_user_storage_encrypted.dll",
    "linux": "themis_user_storage_encrypted.so",
    "macos": "themis_user_storage_encrypted.dylib"
  },
  "capabilities": {
    "thread_safe": true,
    "supports_batching": false,
    "supports_transactions": false,
    "supports_streaming": false,
    "gpu_accelerated": false
  },
  "dependencies": [
    "nlohmann_json"
  ],
  "auto_load": false,
  "load_priority": 50,
  "config_schema": {
    "type": "object",
    "properties": {
      "multi_level_storage": {
        "type": "object",
        "properties": {
          "levels": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {"type": "string", "enum": ["offen", "vs-nfd", "geheim", "streng-geheim"]},
                "encrypted": {"type": "boolean"},
                "path": {"type": "string"},
                "encrypted_dir": {"type": "string"},
                "mount_point": {"type": "string"},
                "encryption": {
                  "type": "object",
                  "properties": {
                    "backend": {"type": "string", "enum": ["gocryptfs", "fscrypt"]},
                    "key_id": {"type": "string"},
                    "key_provider": {"type": "string", "enum": ["vault", "hsm", "mock"]},
                    "vault_addr": {"type": "string"},
                    "vault_mount": {"type": "string"},
                    "hsm_library": {"type": "string"},
                    "hsm_slot": {"type": "integer"},
                    "hsm_key_label": {"type": "string"}
                  }
                },
                "rotation": {
                  "type": "object",
                  "properties": {
                    "enabled": {"type": "boolean"},
                    "interval_days": {"type": "integer"},
                    "auto_rotate": {"type": "boolean"},
                    "notification": {
                      "type": "object",
                      "properties": {
                        "email": {"type": "string"}
                      }
                    }
                  }
                }
              },
              "required": ["name"]
            }
          }
        },
        "required": ["levels"]
      }
    },
    "required": ["multi_level_storage"]
  }
}
