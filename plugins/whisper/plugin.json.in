{
  "name": "whisper",
  "version": "@PROJECT_VERSION@",
  "type": "AUDIO_PROCESSING",
  "description": "Audio transcription plugin backed by whisper.cpp. Supports WAV input, automatic language detection, and stub mode for CI without a model file.",
  "author": "ThemisDB Team",
  "license": "MIT",
  "allowed_editions": ["community", "enterprise", "hyperscaler", "military"],
  "capabilities": {
    "supports_streaming": true,
    "supports_batching": false,
    "supports_transactions": false,
    "thread_safe": true,
    "gpu_accelerated": false
  },
  "dependencies": {
    "nlohmann_json": ">=3.10"
  },
  "optional_dependencies": {
    "whisper_cpp": ">=1.5.0"
  },
  "api_version": "1.0",
  "min_themisdb_version": "2.0.0"
}
