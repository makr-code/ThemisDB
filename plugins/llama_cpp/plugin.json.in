{
  "name": "llama_cpp",
  "version": "@PROJECT_VERSION@",
  "type": "LLM_BACKEND",
  "description": "LLM backend plugin wrapping the existing LlamaWrapper for dynamic loading. Supports text generation, RAG, embeddings, and LoRA adapters. Stub mode available for CI without a model file.",
  "author": "ThemisDB Team",
  "license": "MIT",
  "capabilities": {
    "supports_streaming": false,
    "supports_batching": false,
    "supports_transactions": false,
    "thread_safe": true,
    "gpu_accelerated": false,
    "supports_lora": true,
    "supports_embeddings": true
  },
  "dependencies": {
    "nlohmann_json": ">=3.10"
  },
  "optional_dependencies": {
    "llama_cpp": ">=0.1.0"
  },
  "api_version": "1.0",
  "min_themisdb_version": "2.0.0"
}
