{
  "name": "LLMWiki",
  "plugin_id": "llm_wiki",
  "version": "0.1.0",
  "type": "CUSTOM",
  "description": "Enterprise LLM Wiki plugin for ThemisDB: document indexing, hybrid RAG retrieval, persistent workspace, and Wikipedia dump ingestion",
  "author": "ThemisDB Team",
  "license": "Proprietary",
  "visibility": "restricted",
  "allowed_editions": ["enterprise", "hyperscaler", "military"],
  "license_feature": "llm_wiki_enterprise",
  "compatible_core_abi": "plugin-abi-v2",
  "min_themisdb_version": "1.5.0",
  "capabilities": {
    "supports_streaming": false,
    "supports_batching": true,
    "supports_transactions": false,
    "thread_safe": true,
    "gpu_accelerated": false
  },
  "sub_features": {
    "llm_wiki_wikipedia": {
      "description": "Wikipedia XML dump ingestion (high-volume, resumable)",
      "requires_license": true
    },
    "llm_wiki_workspace": {
      "description": "Persistent LLM Wiki workspace with page management and lint",
      "requires_license": false
    }
  },
  "dependencies": {
    "nlohmann-json": ">=3.10.0",
    "spdlog": ">=1.9.0",
    "themisdb_sdk": ">=1.5.0"
  },
  "embedding_providers": {
    "hash": {
      "description": "Deterministic local hash embedding, no external dependency",
      "requires_license": false
    },
    "mock": {
      "description": "Mock embedding for tests (delegates to hash provider)",
      "requires_license": false
    },
    "sentence-transformers": {
      "description": "Sentence-Transformers model via Python bridge (optional)",
      "requires_license": false,
      "optional_dependency": "sentence-transformers>=2.2.0"
    },
    "openai": {
      "description": "OpenAI Embeddings API (requires OPENAI_API_KEY)",
      "requires_license": false,
      "requires_env": ["OPENAI_API_KEY"]
    }
  },
  "configuration": {
    "embedding_provider": "hash",
    "embedding_dim": 128,
    "table_name": "wiki_chunks",
    "splitter_max_tokens": 220,
    "splitter_overlap_tokens": 40,
    "rocksdb_dir": "",
    "workspace_root": "",
    "retrieval_top_k": 5,
    "retrieval_min_score": 0.0,
    "enable_bm25": true,
    "enable_vector": true,
    "rrf_k": 60.0,
    "fail_open": true,
    "lint_max_staleness_days": 30
  },
  "api_version": "0.1",
  "public_sdk_header": "include/llm_wiki/llm_wiki_plugin_interface.h",
  "factory_symbol": "themisdb_llm_wiki_create",
  "features": [
    "Heading-aware Markdown chunking with sliding-window overlap",
    "Hybrid retrieval: BM25 + HNSW cosine KNN + Reciprocal Rank Fusion",
    "Pluggable embedding providers (hash / sentence-transformers / openai)",
    "Persistent LLM Wiki workspace with page management",
    "Append-only ingest/query/lint timeline log",
    "Prompt-injection and unsafe-content guardrails",
    "Contradiction detection and review task tracking",
    "Wikipedia XML dump ingestion (C++ pipeline, resumable via checkpoint)",
    "Multi-projection Wikipedia storage: vector, graph, timeseries",
    "RAG pipeline integration via WikiRagSource + ModularRAGPipeline"
  ]
}
