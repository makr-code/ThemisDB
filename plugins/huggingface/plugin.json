{
  "name": "huggingface_ingestion",
  "version": "1.0.0",
  "type": "importer",
  "description": "HuggingFace Hub dataset importer for ThemisDB",
  "author": "ThemisDB Team",
  "license": "MIT",
  "binary": {
    "windows": "themis_huggingface_plugin.dll",
    "linux": "themis_huggingface_plugin.so",
    "macos": "themis_huggingface_plugin.dylib"
  },
  "dependencies": [
    "nlohmann/json",
    "curl"
  ],
  "capabilities": {
    "streaming": true,
    "batching": true,
    "transactions": false,
    "thread_safe": true,
    "gpu_accelerated": false
  },
  "config_schema": {
    "type": "object",
    "properties": {
      "dataset_name": {
        "type": "string",
        "description": "HuggingFace dataset identifier (e.g., 'lexlms/ger_legal_data')"
      },
      "split": {
        "type": "string",
        "default": "train",
        "enum": ["train", "test", "validation"],
        "description": "Dataset split to fetch"
      },
      "streaming": {
        "type": "boolean",
        "default": true,
        "description": "Enable streaming for large datasets"
      },
      "chunk_size": {
        "type": "integer",
        "default": 1000,
        "description": "Number of rows to fetch per API request"
      },
      "auth_token": {
        "type": "string",
        "description": "HuggingFace authentication token (optional, for private datasets)"
      },
      "text_field": {
        "type": "string",
        "default": "text",
        "description": "Field name containing text content"
      },
      "label_field": {
        "type": "string",
        "default": "label",
        "description": "Field name containing labels"
      },
      "cache_dir": {
        "type": "string",
        "default": "./cache/huggingface",
        "description": "Directory for caching downloaded datasets"
      },
      "use_cache": {
        "type": "boolean",
        "default": true,
        "description": "Enable local caching"
      },
      "max_requests_per_second": {
        "type": "integer",
        "default": 10,
        "description": "Rate limit for API requests"
      },
      "max_retries": {
        "type": "integer",
        "default": 3,
        "description": "Maximum number of retry attempts"
      },
      "retry_delay_ms": {
        "type": "integer",
        "default": 1000,
        "description": "Initial retry delay in milliseconds"
      }
    },
    "required": ["dataset_name"]
  },
  "supported_formats": [
    "huggingface",
    "hf"
  ],
  "auto_load": false,
  "load_priority": 50,
  "presets": {
    "legal_german": {
      "dataset_name": "lexlms/ger_legal_data",
      "split": "train",
      "text_field": "text",
      "label_field": "label",
      "chunk_size": 1000
    },
    "legal_us": {
      "dataset_name": "pile-of-law/pile-of-law",
      "split": "train",
      "text_field": "text",
      "chunk_size": 1000
    },
    "imdb_reviews": {
      "dataset_name": "imdb",
      "split": "train",
      "text_field": "text",
      "label_field": "label",
      "chunk_size": 500
    }
  },
  "examples": [
    {
      "name": "Basic Usage",
      "description": "Fetch and ingest a small dataset",
      "code": "examples/huggingface_ingestion_example.cpp"
    }
  ],
  "documentation": "docs/plugins/HUGGINGFACE_INGESTION.md",
  "visibility": "public"
}
