{
  "name": "mongo_importer",
  "version": "1.0.0",
  "type": "importer",
  "description": "MongoDB mongoexport JSON/NDJSON importer for ThemisDB",
  "author": "ThemisDB Team",
  "license": "Proprietary",
  "binary": {
    "windows": "themis_import_mongo.dll",
    "linux": "themis_import_mongo.so",
    "macos": "themis_import_mongo.dylib"
  },
  "dependencies": [
    "nlohmann/json"
  ],
  "capabilities": {
    "streaming": true,
    "batching": true,
    "transactions": false,
    "thread_safe": false,
    "gpu_accelerated": false
  },
  "config_schema": {
    "type": "object",
    "properties": {
      "collection": {
        "type": "string",
        "description": "Target collection name. When omitted, the base filename (without extension) of the source file is used."
      },
      "batch_size": {
        "type": "integer",
        "default": 1000,
        "description": "Number of documents to process per batch"
      }
    }
  },
  "supported_formats": [
    "mongodb",
    "mongoexport",
    "json",
    "jsonl",
    "ndjson"
  ],
  "auto_load": false,
  "load_priority": 50
}
