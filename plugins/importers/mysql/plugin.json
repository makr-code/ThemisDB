{
  "name": "mysql_importer",
  "version": "1.0.0",
  "type": "importer",
  "description": "MySQL/MariaDB mysqldump importer for ThemisDB with JDBC-compatible config",
  "author": "ThemisDB Team",
  "license": "Proprietary",
  "visibility": "private",
  "allowed_editions": ["enterprise", "hyperscaler", "military"],
  "license_feature": "private_connector_pack",
  "min_themisdb_version": "2.4.0",
  "compatible_core_abi": "plugin-abi-v2",
  "binary": {
    "windows": "themis_import_mysql.dll",
    "linux": "themis_import_mysql.so",
    "macos": "themis_import_mysql.dylib"
  },
  "dependencies": [
    "nlohmann/json"
  ],
  "capabilities": {
    "streaming": true,
    "batching": true,
    "transactions": false,
    "thread_safe": false,
    "gpu_accelerated": false
  },
  "config_schema": {
    "type": "object",
    "properties": {
      "url": {
        "type": "string",
        "description": "JDBC connection URL: jdbc:mysql://host:port/database or jdbc:mariadb://host:port/database"
      },
      "host": {
        "type": "string",
        "description": "MySQL/MariaDB server hostname"
      },
      "port": {
        "type": "integer",
        "default": 3306,
        "description": "MySQL/MariaDB server port"
      },
      "database": {
        "type": "string",
        "description": "Target database name"
      },
      "user": {
        "type": "string",
        "description": "Database username (use env var THEMIS_MYSQL_USER instead when possible)"
      },
      "ssl": {
        "type": "boolean",
        "default": false,
        "description": "Enable SSL/TLS for the connection"
      },
      "tinyint1_as_boolean": {
        "type": "boolean",
        "default": false,
        "description": "Map TINYINT(1) columns to boolean (mirrors JDBC tinyInt1isBit behaviour)"
      },
      "type_overrides": {
        "type": "object",
        "description": "Custom MySQL type -> ThemisDB type mappings",
        "additionalProperties": { "type": "string" }
      },
      "batch_size": {
        "type": "integer",
        "default": 1000,
        "description": "Number of records to process per batch"
      }
    }
  },
  "supported_formats": [
    "mysql",
    "mariadb",
    "mysqldump"
  ],
  "auto_load": false,
  "load_priority": 50
}
