{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "themisdb",
  "version": "1.3.0",
  "description": "ThemisDB v1.3.0 - Docker build manifest (offline-first)",
  "license": "MIT",
  "builtin-baseline": "bee7b66f0219eeb463dc1ff77ad6ad0211f94f48",
  "dependencies": [
    { "name": "openssl" },
    { "name": "rocksdb", "features": ["lz4", "zstd"] },
    { "name": "simdjson" },
    { "name": "tbb" },
    { "name": "arrow", "features": ["parquet", "compute"] },
    { "name": "hnswlib" },
    { "name": "boost-asio" },
    { "name": "boost-beast" },
    { "name": "spdlog" },
    { "name": "nlohmann-json" },
    { "name": "opentelemetry-cpp", "features": ["otlp-http"] },
    { "name": "curl" },
    { "name": "yaml-cpp" },
    { "name": "zstd" },
    { "name": "mimalloc" }
  ],
  "features": {
    "gpu": {
      "description": "Enable GPU acceleration for vector search",
      "dependencies": ["faiss"]
    },
    "llm": {
      "description": "Enable LLM integration with llama.cpp (v1.3.0+)",
      "dependencies": []
    },
    "rpc": {
      "description": "Enable RPC framework with gRPC (v1.3.0+)",
      "dependencies": [
        "grpc",
        "protobuf"
      ]
    }
  }
}
