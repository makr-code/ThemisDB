        <type>std::size_t</type>
        <definition>std::size_t themis::rag::TARGConfig::min_consecutive_uncertain</definition>
        <argsstring></argsstring>
        <name>min_consecutive_uncertain</name>
        <qualifiedname>themis::rag::TARGConfig::min_consecutive_uncertain</qualifiedname>
        <initializer>= 1</initializer>
        <briefdescription>
<para>Minimum number of consecutive low-confidence tokens before retrieval is triggered. Prevents over-retrieval on single uncertain tokens in otherwise confident sequences. </para>
        </briefdescription>
        <detaileddescription>
<para>Default: 1 (trigger immediately on first low-confidence token). </para>
        </detaileddescription>
