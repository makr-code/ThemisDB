    <sectiondef kind="public-attrib">
      <memberdef kind="variable" id="structthemis_1_1rag_1_1_t_a_r_g_config_1abf8d8fa7a6fbf7f038b634688ac47d75" prot="public" static="no" mutable="no">
        <type>float</type>
        <definition>float themis::rag::TARGConfig::gap_threshold</definition>
        <argsstring></argsstring>
        <name>gap_threshold</name>
        <qualifiedname>themis::rag::TARGConfig::gap_threshold</qualifiedname>
        <initializer>= 5.0f</initializer>
        <briefdescription>
<para>Logit-gap threshold for triggering retrieval. </para>
        </briefdescription>
        <detaileddescription>
<para>When (logit[top-1] − logit[top-2]) &lt; gap_threshold, retrieval is triggered. Larger values trigger retrieval more often; smaller values trust the language model more.</para>
<para>Default 5.0 is tuned for 7B–13B models on MMLU (paper §TARG Table 2). For smaller models (1B–3B), try 3.0; for larger (30B+), try 8.0. </para>
        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
        <location file="include/rag/targ_retrieval.h" line="41" column="11" bodyfile="include/rag/targ_retrieval.h" bodystart="41" bodyend="-1"/>
