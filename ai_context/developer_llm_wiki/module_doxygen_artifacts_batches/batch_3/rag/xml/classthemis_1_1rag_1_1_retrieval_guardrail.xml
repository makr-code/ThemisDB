        <argsstring>(const std::string &amp;query, const FederatedQueryPlan &amp;plan) const</argsstring>
        <name>checkFederatedCost</name>
        <qualifiedname>themis::rag::RetrievalGuardrail::checkFederatedCost</qualifiedname>
        <param>
          <type>const std::string &amp;</type>
          <declname>query</declname>
        </param>
        <param>
