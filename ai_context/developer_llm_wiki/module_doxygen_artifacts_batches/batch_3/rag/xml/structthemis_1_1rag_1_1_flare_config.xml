      <memberdef kind="variable" id="structthemis_1_1rag_1_1_flare_config_1a64c22fb65ae36ae91040b557d59421fb" prot="public" static="no" mutable="no">
        <type>float</type>
        <definition>float themis::rag::FlareConfig::confidence_threshold</definition>
        <argsstring></argsstring>
        <name>confidence_threshold</name>
        <qualifiedname>themis::rag::FlareConfig::confidence_threshold</qualifiedname>
        <initializer>= -2.303f</initializer>
        <briefdescription>
<para>Log-probability threshold for triggering retrieval. </para>
        </briefdescription>
        <detaileddescription>
<para>When log(p(t)) &lt; confidence_threshold for a generated token, the token is considered low-confidence and retrieval is scheduled.</para>
<para>Default: ln(0.1) ≈ -2.303 (trigger when token probability &lt; 10%). For more conservative retrieval (only very uncertain tokens): -3.0. For aggressive retrieval (more frequent): -1.0. </para>
        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
        <location file="include/rag/flare_retrieval.h" line="40" column="11" bodyfile="include/rag/flare_retrieval.h" bodystart="40" bodyend="-1"/>
      </memberdef>
