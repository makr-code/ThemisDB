        <argsstring></argsstring>
        <name>retrieval_cooldown_tokens</name>
        <qualifiedname>themis::rag::FlareConfig::retrieval_cooldown_tokens</qualifiedname>
        <initializer>= 30</initializer>
        <briefdescription>
<para>Cool-down period (number of tokens) after a successful retrieval. </para>
