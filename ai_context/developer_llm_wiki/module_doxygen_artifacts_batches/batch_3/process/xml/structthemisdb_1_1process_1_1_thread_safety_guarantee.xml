    <detaileddescription>
<sect1 id="structthemisdb_1_1process_1_1_thread_safety_guarantee_1thread_safety_table">
<title>Component Guarantees</title><para><table rows="6" cols="3"><row>
<entry thead="yes"><para>Component  </para>
</entry><entry thead="yes"><para>Pattern  </para>
</entry><entry thead="yes"><para>Details  </para>
</entry></row>
<row>
<entry thead="no"><para>ProcessModelManager  </para>
</entry><entry thead="no"><para>Snapshot Isolation  </para>
</entry><entry thead="no"><para>Readers see consistent snapshots across replicas  </para>
</entry></row>
<row>
<entry thead="no"><para>ProcessLinker  </para>
</entry><entry thead="no"><para>Fine-Grained Locking  </para>
</entry><entry thead="no"><para>Per-link atomicity; independent links don&apos;t block  </para>
</entry></row>
<row>
<entry thead="no"><para>BpmnSerializer  </para>
</entry><entry thead="no"><para>Stateless  </para>
</entry><entry thead="no"><para>Fully thread-safe; no shared state  </para>
</entry></row>
<row>
<entry thead="no"><para><ref refid="classthemisdb_1_1process_1_1_federation_consensus_manager" kindref="compound">FederationConsensusManager</ref>  </para>
</entry><entry thead="no"><para>Replicated State Machine  </para>
</entry><entry thead="no"><para>Single leader writer; followers read-only  </para>
</entry></row>
<row>
<entry thead="no"><para><ref refid="classthemisdb_1_1process_1_1_process_audit_logger" kindref="compound">ProcessAuditLogger</ref>  </para>
</entry><entry thead="no"><para>Fine-Grained Locking  </para>
</entry><entry thead="no"><para>Per-log-entry atomicity  </para>
</entry></row>
</table>
</para>
<para><simplesect kind="invariant"><para>All locks acquired in order: consensus_mutex_ → replica_mutex_ → log_mutex_ </para>
</simplesect>
<simplesect kind="invariant"><para>No thread holds more than 2 locks simultaneously </para>
</simplesect>
<simplesect kind="invariant"><para>No deadlock: acyclic lock dependency graph </para>
</simplesect>
</para>
</sect1>
