        <detaileddescription>
<para>Load From Json.</para>
<para>Expected JSON schema: <programlisting filename=".json"><codeline><highlight class="normal">{</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/>&quot;id&quot;:<sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/>&quot;risk_assessment&quot;,</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/>&quot;name&quot;:<sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/>&quot;Risk<sp/>Assessment&quot;,</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/>&quot;hit_policy&quot;:<sp/><sp/><sp/><sp/><sp/>&quot;UNIQUE&quot;,</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/>&quot;input_columns&quot;:<sp/><sp/>[&quot;amount&quot;,<sp/>&quot;type&quot;],</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/>&quot;output_columns&quot;:<sp/>[&quot;risk_level&quot;,<sp/>&quot;action&quot;],</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/>&quot;rules&quot;:<sp/>[</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>{<sp/>&quot;id&quot;:<sp/>&quot;r1&quot;,</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/><sp/><sp/>&quot;inputs&quot;:<sp/><sp/>[&quot;&gt;1000&quot;,<sp/>&quot;\&quot;credit\&quot;&quot;],</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/><sp/><sp/>&quot;outputs&quot;:<sp/>{&quot;risk_level&quot;:<sp/>&quot;HIGH&quot;,<sp/>&quot;action&quot;:<sp/>&quot;manual_review&quot;}<sp/>},</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>{<sp/>&quot;id&quot;:<sp/>&quot;r2&quot;,</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/><sp/><sp/>&quot;inputs&quot;:<sp/><sp/>[&quot;[100..1000]&quot;,<sp/>&quot;-&quot;],</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/><sp/><sp/>&quot;outputs&quot;:<sp/>{&quot;risk_level&quot;:<sp/>&quot;MEDIUM&quot;,<sp/>&quot;action&quot;:<sp/>&quot;auto_approve&quot;}<sp/>}</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/>]</highlight></codeline>
<codeline><highlight class="normal">}</highlight></codeline>
</programlisting></para>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>dmn_json</parametername>
</parameternamelist>
<parameterdescription>
<para>JSON object with the schema above. </para>
</parameterdescription>
</parameteritem>
