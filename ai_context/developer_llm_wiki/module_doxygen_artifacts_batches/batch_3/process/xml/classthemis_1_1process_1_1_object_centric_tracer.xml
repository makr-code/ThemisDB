        <briefdescription>
<para>Build an OCEL 2.0 compatible JSON log for a process instance. </para>
        </briefdescription>
        <detaileddescription>
<para>Format: <programlisting filename=".json"><codeline><highlight class="normal">{</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/>&quot;ocel:global-log&quot;:<sp/>{</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>&quot;ocel:attribute-names&quot;:<sp/>[],</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>&quot;ocel:object-types&quot;:<sp/>[&quot;documents&quot;,<sp/>&quot;metadata&quot;,<sp/>...]</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/>},</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/>&quot;ocel:events&quot;:<sp/>[</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>{</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/><sp/><sp/>&quot;ocel:id&quot;:<sp/>&quot;...&quot;,</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/><sp/><sp/>&quot;ocel:activity&quot;:<sp/>&quot;HAS_DOCUMENT&quot;,</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/><sp/><sp/>&quot;ocel:timestamp&quot;:<sp/>1234567890,</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/><sp/><sp/>&quot;ocel:omap&quot;:<sp/>{&quot;documents&quot;:<sp/>[&quot;doc-1&quot;]},</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/><sp/><sp/>&quot;ocel:vmap&quot;:<sp/>{}</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>},<sp/>...</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/>],</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/>&quot;ocel:objects&quot;:<sp/>{</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>&quot;doc-1&quot;:<sp/>{&quot;ocel:type&quot;:<sp/>&quot;documents&quot;},</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>...</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/>}</highlight></codeline>
<codeline><highlight class="normal">}</highlight></codeline>
</programlisting></para>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>instance_id</parametername>
</parameternamelist>
<parameterdescription>
<para>Process instance identifier. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>OCEL 2.0 JSON object. </para>
</simplesect>
</para>
