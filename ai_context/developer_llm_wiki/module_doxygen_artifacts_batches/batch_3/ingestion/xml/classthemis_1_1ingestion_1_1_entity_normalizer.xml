<sect1 id="classthemis_1_1ingestion_1_1_entity_normalizer_1autotoc_md0_1s1"><sect2 id="classthemis_1_1ingestion_1_1_entity_normalizer_1autotoc_md0">
<title>Canonical ID scheme (legal domain)</title><para><table rows="8" cols="3"><row>
<entry thead="yes"><para>Entity type  </para>
</entry><entry thead="yes"><para>ID pattern  </para>
</entry><entry thead="yes"><para>Example  </para>
</entry></row>
<row>
<entry thead="no"><para>LEGAL_PROVISION  </para>
</entry><entry thead="no"><para><computeroutput>law:&lt;Abbr&gt;:§&lt;n&gt;[:Abs&lt;m&gt;]</computeroutput>  </para>
</entry><entry thead="no"><para><computeroutput>law:BImSchG:§4:Abs1</computeroutput>  </para>
</entry></row>
<row>
<entry thead="no"><para>LEGAL_NORM_REF  </para>
</entry><entry thead="no"><para><computeroutput>normref:&lt;Abbr&gt;:§&lt;n&gt;</computeroutput>  </para>
</entry><entry thead="no"><para><computeroutput>normref:BGB:§823</computeroutput>  </para>
</entry></row>
<row>
<entry thead="no"><para>LEGAL_DECISION  </para>
</entry><entry thead="no"><para><computeroutput>bescheid:&lt;aktenzeichen&gt;</computeroutput>  </para>
</entry><entry thead="no"><para><computeroutput>bescheid:12_A_345_24</computeroutput>  </para>
</entry></row>
<row>
<entry thead="no"><para>PERSON  </para>
</entry><entry thead="no"><para><computeroutput>person:&lt;hash(text)&gt;</computeroutput>  </para>
</entry><entry thead="no"><para><computeroutput>person:abc123</computeroutput>  </para>
</entry></row>
<row>
<entry thead="no"><para>ORGANIZATION  </para>
</entry><entry thead="no"><para><computeroutput>org:&lt;hash(text)&gt;</computeroutput>  </para>
</entry><entry thead="no"><para><computeroutput>org:def456</computeroutput>  </para>
</entry></row>
<row>
<entry thead="no"><para>CHUNK  </para>
</entry><entry thead="no"><para><computeroutput>chunk:&lt;file_id&gt;:&lt;seq&gt;</computeroutput>  </para>
</entry><entry thead="no"><para><computeroutput>chunk:sha256:abc:0</computeroutput>  </para>
</entry></row>
<row>
<entry thead="no"><para>Default  </para>
</entry><entry thead="no"><para><computeroutput>&lt;type&gt;:&lt;file_id&gt;:&lt;hash(text)&gt;</computeroutput>  </para>
</entry><entry thead="no"><para><computeroutput>date:sha256:abc:789</computeroutput>  </para>
</entry></row>
</table>
</para>
</sect2></sect1>
<sect1 id="classthemis_1_1ingestion_1_1_entity_normalizer_1autotoc_md1_1s1"><sect2 id="classthemis_1_1ingestion_1_1_entity_normalizer_1autotoc_md1">
<title>Deduplication</title><para>When <computeroutput>dedup_strategy == "canonical_id"</computeroutput>, entities with the same canonical ID are merged: the one with higher <computeroutput>confidence</computeroutput> is retained; properties from the lower-confidence duplicate are merged in if the key is absent.</para>
</sect2></sect1>
<sect1 id="classthemis_1_1ingestion_1_1_entity_normalizer_1autotoc_md2_1s1"><sect2 id="classthemis_1_1ingestion_1_1_entity_normalizer_1autotoc_md2">
<title>Usage</title><para><programlisting><codeline><highlight class="normal">EntityNormalizerConfig<sp/>cfg;</highlight></codeline>
<codeline><highlight class="normal">cfg.known_law_abbreviations<sp/>=<sp/>{</highlight><highlight class="stringliteral">&quot;BImSchG&quot;</highlight><highlight class="normal">,<sp/></highlight><highlight class="stringliteral">&quot;BGB&quot;</highlight><highlight class="normal">,<sp/></highlight><highlight class="stringliteral">&quot;StGB&quot;</highlight><highlight class="normal">};</highlight></codeline>
<codeline><highlight class="normal"><ref refid="classthemis_1_1ingestion_1_1_entity_normalizer_1ac1371b0d8b67860e5a134be7329ab072" kindref="member">EntityNormalizer</ref><sp/>normalizer(cfg);</highlight></codeline>
<codeline><highlight class="normal"></highlight></codeline>
<codeline><highlight class="normal">normalizer.normalize(ctx);<sp/><sp/></highlight><highlight class="comment">//<sp/>updates<sp/>ctx.entities<sp/>in-place</highlight></codeline>
</programlisting> </para>
</sect2></sect1>
