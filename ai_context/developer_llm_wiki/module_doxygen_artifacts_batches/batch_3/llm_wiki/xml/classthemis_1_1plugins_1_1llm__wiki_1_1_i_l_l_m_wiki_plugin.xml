<simplesect kind="return"><para><computeroutput><ref refid="structthemis_1_1plugins_1_1llm__wiki_1_1_wiki_ingest_result" kindref="compound">WikiIngestResult</ref></computeroutput>. </para>
</simplesect>
</para>
        </detaileddescription>
