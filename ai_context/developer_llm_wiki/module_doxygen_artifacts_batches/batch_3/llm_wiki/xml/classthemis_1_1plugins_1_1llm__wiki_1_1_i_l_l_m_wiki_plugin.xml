</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>max_staleness_days</parametername>
</parameternamelist>
<parameterdescription>
<para>Pages whose source refs are older than this are flagged as stale (default 30). </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para><computeroutput><ref refid="structthemis_1_1plugins_1_1llm__wiki_1_1_wiki_lint_result" kindref="compound">WikiLintResult</ref></computeroutput> with categorised findings. </para>
</simplesect>
</para>
