        <param>
          <type>const std::string &amp;</type>
          <declname>config_json</declname>
        </param>
        <briefdescription>
<para>Initialize the plugin from a JSON configuration blob. </para>
        </briefdescription>
        <detaileddescription>
<para>Required fields (all have defaults):<itemizedlist>
<listitem><para><computeroutput>"embedding_provider"</computeroutput> (<computeroutput>string</computeroutput>, default <computeroutput>"hash"</computeroutput>)</para>
</listitem><listitem><para><computeroutput>"embedding_dim"</computeroutput> (<computeroutput>int</computeroutput>, default <computeroutput>128</computeroutput>)</para>
</listitem><listitem><para><computeroutput>"table_name"</computeroutput> (<computeroutput>string</computeroutput>, default <computeroutput>"wiki_chunks"</computeroutput>)</para>
</listitem><listitem><para><computeroutput>"workspace_root"</computeroutput> (<computeroutput>string</computeroutput>, optional)</para>
</listitem><listitem><para><computeroutput>"rocksdb_dir"</computeroutput> (<computeroutput>string</computeroutput>, optional — activates Phase B if set)</para>
</listitem><listitem><para><computeroutput>"fail_open"</computeroutput> (<computeroutput>bool</computeroutput>, default <computeroutput>false</computeroutput>; when <computeroutput>rocksdb_dir</computeroutput> is set, allows explicit test/degraded in-memory fallback on RocksDB init failure)</para>
</listitem></itemizedlist>
</para>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>config_json</parametername>
</parameternamelist>
<parameterdescription>
<para>JSON object with plugin configuration. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para><computeroutput><ref refid="structthemis_1_1plugins_1_1llm__wiki_1_1_status_1a34b5c0c5020ded76a271c1aee6d63b36" kindref="member">Status::Ok()</ref></computeroutput> on success; error status otherwise. </para>
</simplesect>
</para>
        </detaileddescription>
