        <definition>ContentToolboxBridge::BridgeResult themis::toolbox::ContentToolboxBridge::ingest</definition>
        <argsstring>(std::span&lt; const std::byte &gt; data, const std::string &amp;filename, const std::string &amp;mime_type=&quot;&quot;, const std::string &amp;collection=&quot;default&quot;, const std::string &amp;user_context=&quot;&quot;)</argsstring>
        <name>ingest</name>
        <qualifiedname>themis::toolbox::ContentToolboxBridge::ingest</qualifiedname>
        <param>
          <type>std::span&lt; const std::byte &gt;</type>
          <declname>data</declname>
        </param>
        <param>
          <type>const std::string &amp;</type>
