        <argsstring>(const std::string &amp;table, const std::string &amp;column, const std::vector&lt; std::string &gt; &amp;candidate_pks, const std::vector&lt; std::string &gt; &amp;negative_terms) const</argsstring>
        <name>filter</name>
        <qualifiedname>themis::NegativeKeywordFilter::filter</qualifiedname>
        <param>
          <type>const std::string &amp;</type>
          <declname>table</declname>
        </param>
        <param>
          <type>const std::string &amp;</type>
          <declname>column</declname>
        </param>
        <param>
          <type>const std::vector&lt; std::string &gt; &amp;</type>
