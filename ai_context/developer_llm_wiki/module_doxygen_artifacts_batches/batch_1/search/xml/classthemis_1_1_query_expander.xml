      <memberdef kind="function" id="classthemis_1_1_query_expander_1aec390513127222e79f524728348f645d" prot="public" static="no" const="yes" explicit="no" inline="no" virt="non-virtual">
        <type>std::vector&lt; <ref refid="structthemis_1_1_spelling_correction" kindref="compound">SpellingCorrection</ref> &gt;</type>
        <definition>std::vector&lt; SpellingCorrection &gt; themis::QueryExpander::suggestQueryCorrections</definition>
        <argsstring>(const std::string &amp;query, size_t max_suggestions=5) const</argsstring>
        <name>suggestQueryCorrections</name>
        <qualifiedname>themis::QueryExpander::suggestQueryCorrections</qualifiedname>
        <param>
          <type>const std::string &amp;</type>
          <declname>query</declname>
        </param>
        <param>
          <type>size_t</type>
          <declname>max_suggestions</declname>
          <defval>5</defval>
        </param>
        <briefdescription>
<para>Return ranked full-query spelling correction suggestions. </para>
        </briefdescription>
        <detaileddescription>
<para>Tokenizes the query, independently gathers up to <computeroutput>max_suggestions</computeroutput> corrections per token, and returns full-query strings formed by substituting one token at a time with its best correction. Results are sorted by total edit distance (ascending).</para>
<para>An empty list is returned when no token needs correction.</para>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>query</parametername>
</parameternamelist>
<parameterdescription>
<para>Raw user query (may contain multiple tokens). </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>max_suggestions</parametername>
</parameternamelist>
<parameterdescription>
<para>Maximum number of full-query suggestions (default 5). </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>Ranked list of <ref refid="structthemis_1_1_spelling_correction" kindref="compound">SpellingCorrection</ref> structs where <computeroutput>suggestion</computeroutput> is a full query string; may be empty. </para>
</simplesect>
</para>
        </detaileddescription>
