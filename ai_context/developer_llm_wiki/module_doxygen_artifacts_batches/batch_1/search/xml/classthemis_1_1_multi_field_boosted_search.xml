</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>fields</parametername>
</parameternamelist>
<parameterdescription>
<para>Ordered list of fields to search with their boost weights. Empty list returns empty results. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>Results sorted by combined score descending, limited to <ref refid="structthemis_1_1_multi_field_boosted_search_1_1_config_1a5b61cb62b3c938a55babd415cab79311" kindref="member">Config::k</ref>. </para>
</simplesect>
</para>
