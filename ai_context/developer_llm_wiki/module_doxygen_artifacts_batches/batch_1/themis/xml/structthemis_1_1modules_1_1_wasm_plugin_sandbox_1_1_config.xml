      <memberdef kind="variable" id="structthemis_1_1modules_1_1_wasm_plugin_sandbox_1_1_config_1ac59427ce4c15df955e0f8d2a52586920" prot="public" static="no" mutable="no">
        <type>uint64_t</type>
        <definition>uint64_t themis::modules::WasmPluginSandbox::Config::max_instructions</definition>
        <argsstring></argsstring>
        <name>max_instructions</name>
        <qualifiedname>themis::modules::WasmPluginSandbox::Config::max_instructions</qualifiedname>
        <initializer>= 0</initializer>
        <briefdescription>
        </briefdescription>
        <detaileddescription>
<para>Total instruction fuel budget for this sandbox (0 = unlimited).</para>
<para>Each <ref refid="classthemis_1_1modules_1_1_wasm_plugin_sandbox_1a3522c0e7d5df1b7c190356cf05c0a502" kindref="member">callExport()</ref> invocation deducts <ref refid="structthemis_1_1modules_1_1_wasm_plugin_sandbox_1_1_config_1a8a27ca84cc81afbbd0d2fadfa68f17aa" kindref="member">fuel_check_interval</ref> units from the budget. When the budget reaches zero, <ref refid="classthemis_1_1modules_1_1_wasm_plugin_sandbox_1a3522c0e7d5df1b7c190356cf05c0a502" kindref="member">callExport()</ref> returns a structured fuel-exhaustion error without invoking the runtime, bounding runaway plugin execution. Reset the budget by reloading the module. </para>
        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
        <location file="include/themis/base/wasm_plugin_sandbox.h" line="249" column="18" bodyfile="include/themis/base/wasm_plugin_sandbox.h" bodystart="249" bodyend="-1"/>
      </memberdef>
      <memberdef kind="variable" id="structthemis_1_1modules_1_1_wasm_plugin_sandbox_1_1_config_1a8a27ca84cc81afbbd0d2fadfa68f17aa" prot="public" static="no" mutable="no">
        <type>uint64_t</type>
        <definition>uint64_t themis::modules::WasmPluginSandbox::Config::fuel_check_interval</definition>
        <argsstring></argsstring>
        <name>fuel_check_interval</name>
        <qualifiedname>themis::modules::WasmPluginSandbox::Config::fuel_check_interval</qualifiedname>
        <initializer>= 1</initializer>
        <briefdescription>
        </briefdescription>
        <detaileddescription>
<para>Fuel units consumed per <ref refid="classthemis_1_1modules_1_1_wasm_plugin_sandbox_1a3522c0e7d5df1b7c190356cf05c0a502" kindref="member">callExport()</ref> invocation (default: 1).</para>
<para>In a real WASM interpreter this would correspond to how often fuel is decremented in the bytecode dispatch loop. At the sandbox boundary level it sets the granularity of the per-call fuel deduction.</para>
<para><simplesect kind="note"><para>A value of 0 is treated as 1 (minimum cost of one unit per call) to avoid infinite free calls when a budget is set. </para>
</simplesect>
</para>
        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
        <location file="include/themis/base/wasm_plugin_sandbox.h" line="259" column="18" bodyfile="include/themis/base/wasm_plugin_sandbox.h" bodystart="259" bodyend="-1"/>
