<para>Usage: <programlisting><codeline><highlight class="normal">V2ConnectionConfig<sp/>cfg;</highlight></codeline>
<codeline><highlight class="normal">cfg.port<sp/>=<sp/>7890;</highlight></codeline>
<codeline><highlight class="normal">cfg.max_concurrent_streams<sp/>=<sp/>200;</highlight></codeline>
<codeline><highlight class="normal"></highlight></codeline>
<codeline><highlight class="normal"><ref refid="classthemis_1_1wire_1_1_v2_server_1a78fb63724034ba57587c79169616e47e" kindref="member">V2Server</ref><sp/>server(cfg);</highlight></codeline>
<codeline><highlight class="normal">server.set_data_handler([](uint32_t<sp/>sid,<sp/></highlight><highlight class="keyword">const</highlight><highlight class="normal"><sp/></highlight><highlight class="keyword">auto</highlight><highlight class="normal">&amp;<sp/>payload,<sp/></highlight><highlight class="keywordtype">bool</highlight><highlight class="normal"><sp/>eos)<sp/>{</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/></highlight><highlight class="comment">//<sp/>handle<sp/>incoming<sp/>data</highlight><highlight class="normal"></highlight></codeline>
<codeline><highlight class="normal">});</highlight></codeline>
<codeline><highlight class="normal">server.start();</highlight></codeline>
<codeline><highlight class="normal"></highlight><highlight class="comment">//<sp/>...<sp/>run<sp/>event<sp/>loop<sp/>...</highlight><highlight class="normal"></highlight></codeline>
