        <definition>std::string themis::llm::LLMCorrelationContext::span_id</definition>
        <argsstring></argsstring>
        <name>span_id</name>
        <qualifiedname>themis::llm::LLMCorrelationContext::span_id</qualifiedname>
        <initializer>= {}</initializer>
        <briefdescription>
<para>W3C traceparent parent-span-id: 64-bit, 16 lower-case hex characters. </para>
        </briefdescription>
        <detaileddescription>
<para>Identifies the specific span (call site) that originated this request. May be empty for synthetic/generated contexts. </para>
        </detaileddescription>
