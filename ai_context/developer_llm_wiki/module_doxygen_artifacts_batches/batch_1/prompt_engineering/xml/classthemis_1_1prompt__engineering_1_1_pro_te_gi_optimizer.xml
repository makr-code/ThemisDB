    <briefdescription>
<para>ProTeGi – textual gradient descent optimizer. </para>
    </briefdescription>
    <detaileddescription>
<para>Usage: <programlisting><codeline><highlight class="normal">ProTeGiConfig<sp/>cfg;</highlight></codeline>
<codeline><highlight class="normal">cfg.beam_width<sp/><sp/><sp/><sp/><sp/>=<sp/>4;</highlight></codeline>
<codeline><highlight class="normal">cfg.num_candidates<sp/>=<sp/>4;</highlight></codeline>
<codeline><highlight class="normal">cfg.max_steps<sp/><sp/><sp/><sp/><sp/><sp/>=<sp/>10;</highlight></codeline>
<codeline><highlight class="normal"></highlight></codeline>
<codeline><highlight class="normal"><ref refid="classthemis_1_1prompt__engineering_1_1_pro_te_gi_optimizer_1a4f03388ccf10b173efbb3627dec2611f" kindref="member">ProTeGiOptimizer</ref><sp/>opt(cfg);</highlight></codeline>
<codeline><highlight class="normal">opt.setLLMProvider(std::make_shared&lt;MyLLMProvider&gt;());</highlight></codeline>
<codeline><highlight class="normal"></highlight></codeline>
<codeline><highlight class="normal">ProTeGiResult<sp/>result<sp/>=<sp/>opt.optimize(</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>initial_prompt,</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>test_cases,</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>my_eval_fn,</highlight></codeline>
