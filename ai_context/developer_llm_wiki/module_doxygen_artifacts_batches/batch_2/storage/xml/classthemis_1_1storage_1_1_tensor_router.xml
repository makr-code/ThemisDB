        <argsstring>(const DataProfile &amp;p) noexcept</argsstring>
        <name>decide</name>
        <qualifiedname>themis::storage::TensorRouter::decide</qualifiedname>
        <param>
          <type>const <ref refid="structthemis_1_1storage_1_1_tensor_router_1_1_data_profile" kindref="compound">DataProfile</ref> &amp;</type>
