          <name>TENSOR_TRAIN</name>
          <initializer>= 0</initializer>
          <briefdescription>
<para>Fully compress to TT (index on TT-cores). </para>
          </briefdescription>
          <detaileddescription>
          </detaileddescription>
        </enumvalue>
        <enumvalue id="classthemis_1_1storage_1_1_tensor_router_1a865469cca0153a7ad18915f385b6e090a3bf07fe8ac3883060b1558113ba248d4" prot="public">
          <name>HYBRID</name>
          <initializer>= 1</initializer>
          <briefdescription>
<para>TT shadow for ANN + native storage. </para>
          </briefdescription>
          <detaileddescription>
          </detaileddescription>
