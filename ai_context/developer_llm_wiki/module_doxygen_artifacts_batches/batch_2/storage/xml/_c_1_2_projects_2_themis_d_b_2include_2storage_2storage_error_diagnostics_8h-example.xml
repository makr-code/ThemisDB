<parameternamelist>
<parametername>code</parametername>
</parameternamelist>
<parameterdescription>
<para>Error code to classify </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>StorageErrorContext with incident_type, severity, and recommendations populated based on the error code.</para>
</simplesect>
