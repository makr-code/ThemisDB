      <memberdef kind="function" id="classthemis_1_1aql_1_1_l_l_m_a_q_l_embedding_bridge_1abbba27eb205a5f594cc31f1ab135e99f" prot="public" static="no" const="no" explicit="no" inline="no" virt="virtual">
