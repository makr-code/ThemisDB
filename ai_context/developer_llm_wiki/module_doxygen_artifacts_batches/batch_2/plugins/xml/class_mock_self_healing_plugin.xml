        <type>bool</type>
        <definition>bool MockSelfHealingPlugin::rollbackToLastGoodState</definition>
        <argsstring>() override</argsstring>
        <name>rollbackToLastGoodState</name>
        <qualifiedname>MockSelfHealingPlugin::rollbackToLastGoodState</qualifiedname>
        <reimplements refid="classthemis_1_1plugins_1_1_i_self_healing_plugin_1a9bd6726e007f05c865377682973466be">rollbackToLastGoodState</reimplements>
        <briefdescription>
<para>Rollback to last known good state. </para>
        </briefdescription>
        <detaileddescription>
<para>Restore plugin to the state captured by the most recent <ref refid="class_mock_self_healing_plugin_1a540170508c663ccdaad118a5cf3f7dd3" kindref="member">saveCheckpoint()</ref>. This should restore:<itemizedlist>
<listitem><para>Configuration</para>
</listitem><listitem><para>Connection parameters</para>
</listitem><listitem><para>Internal state</para>
</listitem></itemizedlist>
</para>
<para><simplesect kind="return"><para>true if rollback was successful </para>
</simplesect>
<simplesect kind="note"><para>Must be thread-safe </para>
</simplesect>
</para>
        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
        <location file="tests/plugins/test_plugin_health_monitor.cpp" line="64" column="10" bodyfile="tests/plugins/test_plugin_health_monitor.cpp" bodystart="64" bodyend="67"/>
