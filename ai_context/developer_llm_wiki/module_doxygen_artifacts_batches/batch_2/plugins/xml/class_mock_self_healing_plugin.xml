        <type><ref refid="structthemis_1_1plugins_1_1_plugin_diagnostics" kindref="compound">PluginDiagnostics</ref></type>
        <definition>PluginDiagnostics MockSelfHealingPlugin::performHealthCheck</definition>
        <argsstring>() override</argsstring>
        <name>performHealthCheck</name>
        <qualifiedname>MockSelfHealingPlugin::performHealthCheck</qualifiedname>
        <reimplements refid="classthemis_1_1plugins_1_1_i_self_healing_plugin_1a7a80178dbbffb1965eb386422decd5b7">performHealthCheck</reimplements>
        <briefdescription>
<para>Perform comprehensive health check. </para>
        </briefdescription>
        <detaileddescription>
<para>This method should check:<itemizedlist>
<listitem><para>Connection status (for network plugins)</para>
</listitem><listitem><para>Resource usage (memory, file handles, etc.)</para>
</listitem><listitem><para>Error rates</para>
</listitem><listitem><para>Response times</para>
</listitem></itemizedlist>
</para>
<para><simplesect kind="return"><para>Detailed diagnostic information </para>
</simplesect>
<simplesect kind="note"><para>This method is called periodically by <ref refid="classthemis_1_1plugins_1_1_plugin_health_monitor" kindref="compound">PluginHealthMonitor</ref> </para>
</simplesect>
<simplesect kind="note"><para>Must be thread-safe </para>
</simplesect>
</para>
        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
        <location file="tests/plugins/test_plugin_health_monitor.cpp" line="43" column="23" bodyfile="tests/plugins/test_plugin_health_monitor.cpp" bodystart="43" bodyend="52"/>
      </memberdef>
      <memberdef kind="function" id="class_mock_self_healing_plugin_1aa129bb388997cdf243dd810fd0331590" prot="public" static="no" const="no" explicit="no" inline="yes" virt="virtual">
        <type>bool</type>
        <definition>bool MockSelfHealingPlugin::attemptSelfRepair</definition>
        <argsstring>(const PluginDiagnostics &amp;) override</argsstring>
        <name>attemptSelfRepair</name>
        <qualifiedname>MockSelfHealingPlugin::attemptSelfRepair</qualifiedname>
        <reimplements refid="classthemis_1_1plugins_1_1_i_self_healing_plugin_1a92b2ff7289f6fddaac735eeeba88034b">attemptSelfRepair</reimplements>
        <param>
          <type>const <ref refid="structthemis_1_1plugins_1_1_plugin_diagnostics" kindref="compound">PluginDiagnostics</ref> &amp;</type>
          <declname>diagnostics</declname>
        </param>
        <briefdescription>
<para>Attempt automatic self-repair. </para>
        </briefdescription>
        <detaileddescription>
<para>This method is called when <ref refid="class_mock_self_healing_plugin_1abd81fe460876cd7d0da996f9af12f59b" kindref="member">performHealthCheck()</ref> indicates the plugin is unhealthy. The plugin should attempt to recover based on the diagnostics information.</para>
<para>Common recovery strategies:<itemizedlist>
<listitem><para>Reconnect to external services</para>
</listitem><listitem><para>Clear caches</para>
</listitem><listitem><para>Reload configuration</para>
</listitem><listitem><para>Rollback to last checkpoint</para>
</listitem></itemizedlist>
</para>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>diagnostics</parametername>
</parameternamelist>
<parameterdescription>
<para>Current diagnostic information </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>true if repair was successful, false otherwise </para>
</simplesect>
<simplesect kind="note"><para>Must be thread-safe </para>
</simplesect>
<simplesect kind="note"><para>Should complete within reasonable time (&lt; 30 seconds) </para>
</simplesect>
</para>
        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
        <location file="tests/plugins/test_plugin_health_monitor.cpp" line="54" column="10" bodyfile="tests/plugins/test_plugin_health_monitor.cpp" bodystart="54" bodyend="57"/>
      </memberdef>
