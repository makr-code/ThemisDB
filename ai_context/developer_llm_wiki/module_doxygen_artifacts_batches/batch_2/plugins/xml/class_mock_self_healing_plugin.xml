      <memberdef kind="function" id="class_mock_self_healing_plugin_1a540170508c663ccdaad118a5cf3f7dd3" prot="public" static="no" const="no" explicit="no" inline="yes" virt="virtual">
        <type>void</type>
        <definition>void MockSelfHealingPlugin::saveCheckpoint</definition>
        <argsstring>() override</argsstring>
        <name>saveCheckpoint</name>
        <qualifiedname>MockSelfHealingPlugin::saveCheckpoint</qualifiedname>
        <reimplements refid="classthemis_1_1plugins_1_1_i_self_healing_plugin_1ab8f2da2da737f9360323851302ae1b5e">saveCheckpoint</reimplements>
        <briefdescription>
<para>Save current state as a checkpoint. </para>
        </briefdescription>
        <detaileddescription>
<para>Capture the current &quot;known good&quot; state for potential rollback. This should save:<itemizedlist>
<listitem><para>Configuration</para>
</listitem><listitem><para>Connection parameters</para>
</listitem><listitem><para>Critical internal state</para>
</listitem></itemizedlist>
</para>
<para>The plugin should maintain a limited number of checkpoints (e.g., 5) to avoid excessive memory usage.</para>
<para><simplesect kind="note"><para>Call this after successful initialization and after major configuration changes </para>
</simplesect>
<simplesect kind="note"><para>Must be thread-safe </para>
</simplesect>
</para>
        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
