    <briefdescription>
<para>WebSocket voice streaming session. </para>
    </briefdescription>
    <detaileddescription>
<para>Manages the lifecycle of one bidirectional voice stream from a browser client: audio ingestion, incremental STT, optional NLU, and TTS synthesis back to the browser.</para>
<sect1 id="classthemis_1_1voice_1_1_voice_streaming_session_1autotoc_md18_1s1"><sect2 id="classthemis_1_1voice_1_1_voice_streaming_session_1autotoc_md18">
<title>Typical flow</title><para><programlisting filename=".cpp"><codeline><highlight class="keyword">auto</highlight><highlight class="normal"><sp/>session<sp/>=<sp/><ref refid="classthemis_1_1voice_1_1_voice_streaming_session_1a3f638ecbef58b78f6d06d77cab665d0e" kindref="member">VoiceStreamingSession::create</ref>(<ref refid="classthemis_1_1voice_1_1_voice_streaming_session_1a24a93af006cd290db98c25b486f95766" kindref="member">config</ref>);</highlight></codeline>
<codeline><highlight class="normal"></highlight></codeline>
<codeline><highlight class="normal"></highlight><highlight class="comment">//<sp/>Attach<sp/>callbacks<sp/>before<sp/>starting</highlight><highlight class="normal"></highlight></codeline>
<codeline><highlight class="normal">session-&gt;onPartialTranscript([](</highlight><highlight class="keyword">auto</highlight><highlight class="normal">&amp;<sp/>pt){<sp/>…<sp/>});</highlight></codeline>
<codeline><highlight class="normal">session-&gt;onFinalTranscript([](</highlight><highlight class="keyword">auto</highlight><highlight class="normal">&amp;<sp/>ft){<sp/>…<sp/>});</highlight></codeline>
<codeline><highlight class="normal">session-&gt;onTtsChunk([](</highlight><highlight class="keyword">auto</highlight><highlight class="normal">&amp;<sp/>chunk){<sp/>…<sp/>});<sp/></highlight><highlight class="comment">//<sp/>send<sp/>back<sp/>to<sp/>browser</highlight><highlight class="normal"></highlight></codeline>
<codeline><highlight class="normal"></highlight></codeline>
<codeline><highlight class="normal">session-&gt;start();</highlight></codeline>
<codeline><highlight class="normal"></highlight></codeline>
<codeline><highlight class="normal"></highlight><highlight class="comment">//<sp/>Called<sp/>by<sp/>the<sp/>WebSocket<sp/>on<sp/>each<sp/>incoming<sp/>message:</highlight><highlight class="normal"></highlight></codeline>
<codeline><highlight class="normal">session-&gt;sendAudioChunk(raw_audio_bytes);</highlight></codeline>
<codeline><highlight class="normal"></highlight></codeline>
<codeline><highlight class="normal">session-&gt;end();<sp/></highlight><highlight class="comment">//<sp/>or<sp/>auto-closes<sp/>after<sp/>max_duration_s</highlight></codeline>
</programlisting> </para>
</sect2></sect1>
    </detaileddescription>
