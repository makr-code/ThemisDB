        <type>std::function&lt; <ref refid="structthemis_1_1voice_1_1_partial_transcript" kindref="compound">PartialTranscript</ref>( const std::vector&lt; uint8_t &gt; &amp;audio, bool is_final, uint32_t seq)&gt;</type>
        <definition>using themis::voice::VoiceStreamingSession::TranscribeFn = std::function&lt;PartialTranscript(
