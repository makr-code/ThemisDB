    <innerclass refid="classthemis_1_1query_1_1_query_move_semantics_safety_test" prot="public">themis::query::QueryMoveSemanticsSafetyTest</innerclass>
    <innernamespace refid="namespacethemis">themis</innernamespace>
    <innernamespace refid="namespacethemis_1_1query">themis::query</innernamespace>
    <briefdescription>
<para>Comprehensive move semantics tests for Query module resource-holding classes. </para>
    </briefdescription>
    <detaileddescription>
<para><simplesect kind="note"><para>Sprint 8: Phase 1A - Move Semantics Remediation</para>
</simplesect>
Tests verify:<itemizedlist>
<listitem><para>Move constructors properly transfer ownership</para>
</listitem><listitem><para>Move assignment operators properly transfer ownership and clean up</para>
</listitem><listitem><para>Moved-from objects are in valid state (CWE-457 fix)</para>
</listitem><listitem><para>No double-free on moved objects (CWE-415 fix)</para>
</listitem><listitem><para>No use-after-move issues (CWE-672 fix)</para>
</listitem></itemizedlist>
</para>
<para>Coverage:<itemizedlist>
<listitem><para>AQLParser</para>
</listitem><listitem><para>ResultStream</para>
</listitem><listitem><para>QueryCacheManager</para>
</listitem><listitem><para>ApproximateAggregator</para>
</listitem><listitem><para>SemanticCache </para>
</listitem></itemizedlist>
</para>
    </detaileddescription>
