    <briefdescription>
<para>Stateful exponential-backoff sleep helper. </para>
    </briefdescription>
    <detaileddescription>
<para>Useful when the caller manages the retry loop explicitly (e.g. to check a cancellation token between attempts).</para>
<para><programlisting filename=".cpp"><codeline><highlight class="normal"><ref refid="classthemis_1_1utils_1_1_exponential_backoff_1aad75935fb9996f40784062cbc4eeaa19" kindref="member">ExponentialBackoff</ref><sp/>bo(cfg);</highlight></codeline>
<codeline><highlight class="normal"></highlight><highlight class="keywordflow">for</highlight><highlight class="normal"><sp/>(</highlight><highlight class="keywordtype">int</highlight><highlight class="normal"><sp/>i<sp/>=<sp/>0;<sp/>i<sp/>&lt;<sp/>cfg.max_attempts;<sp/>++i)<sp/>{</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/></highlight><highlight class="keywordflow">if</highlight><highlight class="normal"><sp/>(try_once())<sp/></highlight><highlight class="keywordflow">return</highlight><highlight class="normal">;</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/></highlight><highlight class="keywordflow">if</highlight><highlight class="normal"><sp/>(!bo.wait())<sp/></highlight><highlight class="keywordflow">break</highlight><highlight class="normal">;<sp/></highlight><highlight class="comment">//<sp/>max<sp/>backoff<sp/>iterations<sp/>reached</highlight><highlight class="normal"></highlight></codeline>
<codeline><highlight class="normal">}</highlight></codeline>
</programlisting> </para>
    </detaileddescription>
