        <name>tryAcquire</name>
        <qualifiedname>themis::maintenance::IDistributedLock::tryAcquire</qualifiedname>
        <reimplementedby refid="classthemis_1_1maintenance_1_1_in_process_distributed_lock_1a4ecb88a3612a2c307ade797518724b7a">tryAcquire</reimplementedby>
