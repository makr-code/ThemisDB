    <detaileddescription>
<para><ref refid="classthemisdb_1_1replication_1_1_replication_policy" kindref="compound">ReplicationPolicy</ref></para>
<para>Manages named replication policies and their assignment to collections.</para>
<para>Example: <programlisting><codeline><highlight class="normal"><ref refid="classthemisdb_1_1replication_1_1_replication_policy_1a6d12fab3af461f5b27453623dc010975" kindref="member">ReplicationPolicy</ref><sp/>policy_mgr(repl_mgr);</highlight></codeline>
<codeline><highlight class="normal"></highlight></codeline>
<codeline><highlight class="normal">ReplicationPolicy::Policy<sp/>critical;</highlight></codeline>
<codeline><highlight class="normal">critical.name<sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/>=<sp/></highlight><highlight class="stringliteral">&quot;critical&quot;</highlight><highlight class="normal">;</highlight></codeline>
<codeline><highlight class="normal">critical.desired_replicas<sp/>=<sp/>5;</highlight></codeline>
<codeline><highlight class="normal">critical.min_datacenters<sp/><sp/>=<sp/>3;</highlight></codeline>
<codeline><highlight class="normal">critical.mode<sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/>=<sp/><ref refid="namespacethemisdb_1_1replication_1ab2c44fa8fc1b43c8b21821aa509c54bca274ccef15a21e829d03293a6fd1974f3" kindref="member">ReplicationMode::SYNC</ref>;</highlight></codeline>
<codeline><highlight class="normal">critical.write_quorum<sp/><sp/><sp/><sp/><sp/>=<sp/>3;</highlight></codeline>
<codeline><highlight class="normal">critical.enable_pitr<sp/><sp/><sp/><sp/><sp/><sp/>=<sp/></highlight><highlight class="keyword">true</highlight><highlight class="normal">;</highlight></codeline>
<codeline><highlight class="normal">policy_mgr.definePolicy(</highlight><highlight class="stringliteral">&quot;critical&quot;</highlight><highlight class="normal">,<sp/>critical);</highlight></codeline>
<codeline><highlight class="normal"></highlight></codeline>
<codeline><highlight class="normal">policy_mgr.assignPolicy(</highlight><highlight class="stringliteral">&quot;financial_transactions&quot;</highlight><highlight class="normal">,<sp/></highlight><highlight class="stringliteral">&quot;critical&quot;</highlight><highlight class="normal">);</highlight></codeline>
