        <briefdescription>
<para>Extract the &quot;updated_at&quot; field from a minimal JSON payload. </para>
        </briefdescription>
        <detaileddescription>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername direction="in">json_doc</parametername>
</parameternamelist>
<parameterdescription>
<para>Input parameter. </para>
</parameterdescription>
</parameteritem>
