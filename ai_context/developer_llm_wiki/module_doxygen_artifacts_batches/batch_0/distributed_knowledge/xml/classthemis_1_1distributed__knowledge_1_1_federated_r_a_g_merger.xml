      <memberdef kind="function" id="classthemis_1_1distributed__knowledge_1_1_federated_r_a_g_merger_1a6498341ed13df36582cc5ec99303aa5e" prot="private" static="no" nodiscard="yes" const="yes" explicit="no" inline="no" virt="non-virtual">
