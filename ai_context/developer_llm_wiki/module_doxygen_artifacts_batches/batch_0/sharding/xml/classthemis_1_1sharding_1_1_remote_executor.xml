        <definition>RemoteExecutor::Result themis::sharding::RemoteExecutor::postBinary</definition>
        <argsstring>(const ShardInfo &amp;shard_info, const std::string &amp;path, const uint8_t *data, std::size_t size)</argsstring>
        <name>postBinary</name>
        <qualifiedname>themis::sharding::RemoteExecutor::postBinary</qualifiedname>
        <param>
          <type>const <ref refid="structthemis_1_1sharding_1_1_shard_info" kindref="compound">ShardInfo</ref> &amp;</type>
          <declname>shard_info</declname>
