</entry><entry thead="no"><para>ANA-BM-02  </para>
</entry><entry thead="no"><para>p95 ≤ 10 µs/batch  </para>
</entry></row>
<row>
<entry thead="no"><para>GATE-ANA-BM-03  </para>
