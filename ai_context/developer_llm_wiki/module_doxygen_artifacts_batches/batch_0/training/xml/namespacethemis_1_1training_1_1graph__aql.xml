      <memberdef kind="variable" id="namespacethemis_1_1training_1_1graph__aql_1a87308535ca9abe05eaa69c03d94e6f03" prot="public" static="no" constexpr="yes" mutable="no">
        <type>const char *</type>
        <definition>const char* themis::training::graph_aql::SIMILAR_DOCUMENTS</definition>
        <argsstring></argsstring>
        <name>SIMILAR_DOCUMENTS</name>
        <qualifiedname>themis::training::graph_aql::SIMILAR_DOCUMENTS</qualifiedname>
        <initializer>                                   =
&quot;FOR doc IN @@documents FILTER doc._key == @document_id &quot;
&quot;LET query_vec = doc.embedding &quot;
&quot;FOR candidate IN @@documents &quot;
&quot;FILTER candidate._key != @document_id &quot;
&quot;LET score = COSINE_SIMILARITY(query_vec, candidate.embedding) &quot;
&quot;FILTER score &gt;= @threshold &quot;
&quot;SORT score DESC &quot;
&quot;LIMIT @max_results &quot;
&quot;RETURN {doc_id: candidate._key, score: score}&quot;</initializer>
