<codeline><highlight class="normal">ivr.addNode({</highlight><highlight class="stringliteral">&quot;support&quot;</highlight><highlight class="normal">,</highlight><highlight class="stringliteral">&quot;Connecting<sp/>to<sp/>support.&quot;</highlight><highlight class="normal">,<sp/>{},<sp/></highlight><highlight class="stringliteral">&quot;&quot;</highlight><highlight class="normal">,<sp/></highlight><highlight class="keyword">true</highlight><highlight class="normal">});</highlight></codeline>
