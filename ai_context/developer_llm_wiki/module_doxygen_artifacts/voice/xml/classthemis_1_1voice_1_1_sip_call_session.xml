    <briefdescription>
<para>Manages one SIP call session within the ThemisDB voice pipeline. </para>
    </briefdescription>
    <detaileddescription>
<para>Handles SIP signalling lifecycle (INVITE → 200 OK → ACK → BYE), RTP media packetisation/depacketisation, DTMF decoding (RFC 4733), and incremental STT forwarding.</para>
<sect1 id="classthemis_1_1voice_1_1_sip_call_session_1autotoc_md36_1s1"><sect2 id="classthemis_1_1voice_1_1_sip_call_session_1autotoc_md36">
<title>Typical inbound flow</title><para><programlisting filename=".cpp"><codeline><highlight class="keyword">auto</highlight><highlight class="normal"><sp/>session<sp/>=<sp/><ref refid="classthemis_1_1voice_1_1_sip_call_session_1a3244c67db7ee895f513f011f6d1436d4" kindref="member">SipCallSession::create</ref>(<ref refid="classthemis_1_1voice_1_1_sip_call_session_1ae150298d0be6e5697a86cbe1316a81f2" kindref="member">config</ref>);</highlight></codeline>
<codeline><highlight class="normal">session-&gt;onTranscript([](</highlight><highlight class="keyword">auto</highlight><highlight class="normal">&amp;<sp/>t){<sp/></highlight><highlight class="comment">//<sp/>process<sp/>transcript</highlight><highlight class="normal"></highlight></codeline>
<codeline><highlight class="normal">});</highlight></codeline>
<codeline><highlight class="normal">session-&gt;onDtmf([](</highlight><highlight class="keyword">auto</highlight><highlight class="normal">&amp;<sp/>d){<sp/></highlight><highlight class="comment">//<sp/>handle<sp/>digit</highlight><highlight class="normal"></highlight></codeline>
<codeline><highlight class="normal">});</highlight></codeline>
<codeline><highlight class="normal">session-&gt;start();<sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/></highlight><highlight class="comment">//<sp/>send<sp/>200<sp/>OK</highlight><highlight class="normal"></highlight></codeline>
<codeline><highlight class="normal">session-&gt;receiveRtpPacket(pkt);<sp/><sp/><sp/></highlight><highlight class="comment">//<sp/>called<sp/>per<sp/>arriving<sp/>RTP<sp/>packet</highlight><highlight class="normal"></highlight></codeline>
<codeline><highlight class="normal">session-&gt;end();<sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/></highlight><highlight class="comment">//<sp/>sends<sp/>BYE</highlight></codeline>
</programlisting> </para>
</sect2></sect1>
    </detaileddescription>
