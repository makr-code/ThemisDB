        <briefdescription>
<para>Validate and accept a new audio chunk. </para>
        </briefdescription>
        <detaileddescription>
<para>Validate chunk.</para>
<para>Checks:<orderedlist>
<listitem><para>Chunk size is within bounds</para>
</listitem><listitem><para>Chunk format matches session expectations</para>
</listitem><listitem><para>Sequence number is in order</para>
</listitem><listitem><para>No buffer overflow or malformed data</para>
</listitem><listitem><para>Stream lifetime hasn&apos;t been exceeded</para>
</listitem></orderedlist>
</para>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>chunk</parametername>
</parameternamelist>
<parameterdescription>
<para>Raw audio chunk data (byte array) </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>chunk_size</parametername>
</parameternamelist>
<parameterdescription>
<para>Size of chunk in bytes </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>sequence_num</parametername>
</parameternamelist>
<parameterdescription>
<para>Sequence number of this chunk </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>timestamp_ms</parametername>
</parameternamelist>
<parameterdescription>
<para>Timestamp in milliseconds (optional) </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>is_final</parametername>
</parameternamelist>
<parameterdescription>
<para>True if this is the final chunk</para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para><ref refid="structthemis_1_1voice_1_1_validated_audio_chunk" kindref="compound">ValidatedAudioChunk</ref> with accepted data</para>
</simplesect>
