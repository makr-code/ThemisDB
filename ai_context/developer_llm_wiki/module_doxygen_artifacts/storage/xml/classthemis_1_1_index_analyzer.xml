<codeline><highlight class="normal"><ref refid="classthemis_1_1_index_analyzer_1a62a6b0a5f1a1295f8d1bebb7f242cbb2" kindref="member">IndexAnalyzer</ref><sp/>analyzer(db_wrapper,<sp/>*cfg);</highlight></codeline>
<codeline><highlight class="normal">analyzer.setAdvisor(my_ml_advisor);</highlight></codeline>
<codeline><highlight class="normal">analyzer.startScheduled();</highlight></codeline>
<codeline><highlight class="normal"></highlight><highlight class="comment">//<sp/>...</highlight><highlight class="normal"></highlight></codeline>
<codeline><highlight class="normal"></highlight><highlight class="keyword">auto</highlight><highlight class="normal"><sp/>reports<sp/>=<sp/>analyzer.analyzeAll();</highlight></codeline>
<codeline><highlight class="normal">analyzer.stopScheduled();</highlight></codeline>
</programlisting> </para>
</sect2></sect1>
