        <type>double</type>
        <definition>double OnnxClipGoldenEmbeddingsTest::computeL2Norm</definition>
        <argsstring>(const std::vector&lt; float &gt; &amp;embedding) const</argsstring>
        <name>computeL2Norm</name>
        <qualifiedname>OnnxClipGoldenEmbeddingsTest::computeL2Norm</qualifiedname>
        <param>
          <type>const std::vector&lt; float &gt; &amp;</type>
          <declname>embedding</declname>
        </param>
        <briefdescription>
<para>Compute L2 norm of an embedding vector. </para>
        </briefdescription>
        <detaileddescription>
<para>L2 norm is sqrt(sum(v[i]^2)). For normalized embeddings, this should be approximately 1.0.</para>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>embedding</parametername>
</parameternamelist>
<parameterdescription>
<para>Vector of floating-point embedding components </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>L2 norm (should be ≈ 1.0 for normalized embeddings) </para>
</simplesect>
</para>
        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
