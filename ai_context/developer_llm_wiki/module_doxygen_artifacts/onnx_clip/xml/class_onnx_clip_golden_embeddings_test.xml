        <argsstring>(const std::vector&lt; float &gt; &amp;a, const std::vector&lt; float &gt; &amp;b) const</argsstring>
        <name>computeL2Distance</name>
        <qualifiedname>OnnxClipGoldenEmbeddingsTest::computeL2Distance</qualifiedname>
        <param>
