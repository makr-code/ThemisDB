</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>tolerance</parametername>
</parameternamelist>
<parameterdescription>
<para>L2 distance tolerance for comparison (default: 1e-6) </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>true if all batch results match sequential results, false otherwise </para>
</simplesect>
</para>
