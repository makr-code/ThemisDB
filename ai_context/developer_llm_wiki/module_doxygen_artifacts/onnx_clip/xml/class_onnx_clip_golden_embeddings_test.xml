        <param>
          <type>const std::vector&lt; float &gt; &amp;</type>
          <declname>b</declname>
        </param>
        <briefdescription>
<para>Compute L2 distance between two embedding vectors. </para>
        </briefdescription>
        <detaileddescription>
<para>L2 distance = sqrt(sum((a[i] - b[i])^2)). Used to verify that identical inputs produce identical embeddings.</para>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>a</parametername>
</parameternamelist>
<parameterdescription>
<para>First embedding vector </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>b</parametername>
</parameternamelist>
<parameterdescription>
<para>Second embedding vector </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>L2 distance (should be 0 for identical embeddings, &lt; 1e-6 for reproducibility) </para>
</simplesect>
</para>
        </detaileddescription>
