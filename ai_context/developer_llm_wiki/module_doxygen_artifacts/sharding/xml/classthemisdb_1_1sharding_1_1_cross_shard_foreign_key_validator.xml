        <name>ChildExistsCallback</name>
        <qualifiedname>themisdb::sharding::CrossShardForeignKeyValidator::ChildExistsCallback</qualifiedname>
        <briefdescription>
<para>Callback to test whether any child row references a parent key. </para>
        </briefdescription>
        <detaileddescription>
<para>Used during parent-table DELETE checks (RESTRICT semantics).</para>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>shard_id</parametername>
</parameternamelist>
<parameterdescription>
<para>Shard to query. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>child_table</parametername>
</parameternamelist>
<parameterdescription>
<para>Table with the FK column. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>child_column</parametername>
</parameternamelist>
<parameterdescription>
<para>FK column. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>parent_value</parametername>
</parameternamelist>
<parameterdescription>
<para>Parent key value being deleted. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>true → at least one child row references <computeroutput>parent_value</computeroutput>; false → no referencing child rows found.</para>
</simplesect>
Must not throw. </para>
        </detaileddescription>
