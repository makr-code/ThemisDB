    <briefdescription>
<para>HuggingFace dataset connector. </para>
    </briefdescription>
    <detaileddescription>
<para>Downloads datasets from HuggingFace Hub via REST API and ingests them into ThemisDB. Supports streaming for large datasets.</para>
<para>Example usage: <programlisting><codeline><highlight class="normal"><ref refid="classthemis_1_1ingestion_1_1_hugging_face_connector_1a8f9d2e4b2dcf32ed77c32d8253e00e25" kindref="member">HuggingFaceConnector</ref><sp/>connector;</highlight></codeline>
<codeline><highlight class="normal">SourceConfig<sp/>config{</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>.source_id<sp/>=<sp/></highlight><highlight class="stringliteral">&quot;hf_legal&quot;</highlight><highlight class="normal">,</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>.type<sp/>=<sp/><ref refid="namespacethemis_1_1ingestion_1ac26ea3ec62832c4278b31929df0e755fa25e63a158754f6ce42160bc5084e0b05" kindref="member">SourceType::HUGGINGFACE</ref>,</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>.location<sp/>=<sp/></highlight><highlight class="stringliteral">&quot;lexlms/ger_legal_data&quot;</highlight><highlight class="normal">,</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>.options<sp/>=<sp/>{{</highlight><highlight class="stringliteral">&quot;split&quot;</highlight><highlight class="normal">,<sp/></highlight><highlight class="stringliteral">&quot;train&quot;</highlight><highlight class="normal">},<sp/>{</highlight><highlight class="stringliteral">&quot;streaming&quot;</highlight><highlight class="normal">,<sp/></highlight><highlight class="stringliteral">&quot;true&quot;</highlight><highlight class="normal">}}</highlight></codeline>
<codeline><highlight class="normal">};</highlight></codeline>
<codeline><highlight class="normal">connector.initialize(config);</highlight></codeline>
<codeline><highlight class="normal"></highlight><highlight class="keyword">auto</highlight><highlight class="normal"><sp/>stats<sp/>=<sp/>connector.ingest(</highlight><highlight class="stringliteral">&quot;legal_documents&quot;</highlight><highlight class="normal">,<sp/></highlight><highlight class="keyword">nullptr</highlight><highlight class="normal">);</highlight></codeline>
</programlisting> </para>
    </detaileddescription>
