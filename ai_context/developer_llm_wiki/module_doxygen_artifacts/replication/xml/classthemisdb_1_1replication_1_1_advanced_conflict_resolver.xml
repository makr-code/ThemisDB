        <detaileddescription>
<para>Select the winning write from a set of concurrent conflicting writes.</para>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>document_id</parametername>
</parameternamelist>
<parameterdescription>
<para>Identifier of the document in conflict. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>conflicting_writes</parametername>
</parameternamelist>
<parameterdescription>
<para>Two or more concurrent <ref refid="structthemisdb_1_1replication_1_1_m_m_write_entry" kindref="compound">MMWriteEntry</ref> values. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>context</parametername>
</parameternamelist>
<parameterdescription>
<para>Additional context for resolution logic. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>The winning write entry.</para>
</simplesect>
Constraints:<itemizedlist>
<listitem><para>Must be thread-safe and idempotent.</para>
</listitem><listitem><para>Must return one of the entries from conflicting_writes (no fabrication).</para>
</listitem><listitem><para>conflicting_writes.size() &gt;= 2 is guaranteed by the caller. </para>
</listitem></itemizedlist>
</para>
