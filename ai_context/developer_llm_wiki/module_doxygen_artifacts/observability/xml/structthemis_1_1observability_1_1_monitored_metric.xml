    <briefdescription>
<para>Configuration for a single metric stream to be monitored. </para>
    </briefdescription>
    <detaileddescription>
<para><heading level="3">Example</heading>
</para>
<para><programlisting filename=".cpp"><codeline><highlight class="normal">MonitoredMetric<sp/>cfg;</highlight></codeline>
<codeline><highlight class="normal">cfg.name<sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/>=<sp/></highlight><highlight class="stringliteral">&quot;themis_query_latency_ms&quot;</highlight><highlight class="normal">;</highlight></codeline>
<codeline><highlight class="normal">cfg.method<sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/>=<sp/>AnomalyMethod::Z_SCORE;</highlight></codeline>
<codeline><highlight class="normal">cfg.threshold<sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/>=<sp/>0.7;</highlight></codeline>
<codeline><highlight class="normal">cfg.window_size<sp/><sp/><sp/><sp/><sp/><sp/>=<sp/>500;</highlight></codeline>
<codeline><highlight class="normal">cfg.auto_train_after<sp/>=<sp/>100;</highlight></codeline>
<codeline><highlight class="normal">detector.monitor(cfg);</highlight></codeline>
</programlisting> </para>
    </detaileddescription>
