      <memberdef kind="function" id="structthemis_1_1network_1_1_retry_policy_1a831cd7b89db8f0cff3e733efdd23eaa4" prot="public" static="no" nodiscard="yes" const="yes" explicit="no" inline="no" noexcept="yes" virt="non-virtual">
        <type>std::chrono::milliseconds</type>
        <definition>std::chrono::milliseconds themis::network::RetryPolicy::computeDelay</definition>
        <argsstring>(uint32_t attempt) const noexcept</argsstring>
        <name>computeDelay</name>
        <qualifiedname>themis::network::RetryPolicy::computeDelay</qualifiedname>
        <param>
          <type>uint32_t</type>
          <declname>attempt</declname>
        </param>
        <briefdescription>
<para>Compute the back-off delay for the given zero-indexed attempt. </para>
        </briefdescription>
        <detaileddescription>
<para>Uses <computeroutput>std::chrono::steady_clock</computeroutput> epoch (cast to nanoseconds) as the random seed when the thread-local PRNG is first accessed so that the jitter is not deterministic across processes. The function never sleeps; callers are responsible for applying the returned duration (e.g. via <computeroutput>std::this_thread::sleep_for</computeroutput>).</para>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>attempt</parametername>
</parameternamelist>
<parameterdescription>
<para>Zero-based index: 0 = delay before the 1st retry, 1 = before the 2nd, and so on. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>Back-off duration capped at <computeroutput>max_delay_ms</computeroutput>. </para>
</simplesect>
</para>
        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
