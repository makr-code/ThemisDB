        <type></type>
        <name>Strategy</name>
        <qualifiedname>themis::network::GeoTopologyRouter::Strategy</qualifiedname>
        <enumvalue id="classthemis_1_1network_1_1_geo_topology_router_1a4ebe77273866838c0e9d69e904acf50ba6d1313ba7ab8afcb895591481871ef89" prot="public">
          <name>PREFER_LOCAL</name>
          <briefdescription>
          </briefdescription>
          <detaileddescription>
<para>Prefer shards co-located with this node (same region &gt; zone &gt; datacenter). Falls back to the nearest remote region when no local shard is available and <computeroutput>fallback_cross_region</computeroutput> is true. </para>
          </detaileddescription>
        </enumvalue>
        <enumvalue id="classthemis_1_1network_1_1_geo_topology_router_1a4ebe77273866838c0e9d69e904acf50bac206f99d8dc24fc9e4502b9d46605608" prot="public">
          <name>LOWEST_LATENCY</name>
          <briefdescription>
          </briefdescription>
          <detaileddescription>
<para>Route to the region with the lowest configured latency hint (see <computeroutput>region_latency_hints</computeroutput>). Falls back to PREFER_LOCAL when no hints are configured. </para>
          </detaileddescription>
        </enumvalue>
        <enumvalue id="classthemis_1_1network_1_1_geo_topology_router_1a4ebe77273866838c0e9d69e904acf50ba1ebd8dbf8c34e255f5cbf28f35860b71" prot="public">
          <name>ROUND_ROBIN</name>
          <briefdescription>
          </briefdescription>
          <detaileddescription>
<para>Distribute requests evenly across all healthy shards in a round-robin fashion, ignoring topology locality. </para>
          </detaileddescription>
        </enumvalue>
        <briefdescription>
<para>Controls how the router selects among healthy shard candidates. </para>
        </briefdescription>
        <detaileddescription>
        </detaileddescription>
