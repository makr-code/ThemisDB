    <innerclass refid="structthemis_1_1network_1_1_wire_retry_policy" prot="public">themis::network::WireRetryPolicy</innerclass>
    <innerclass refid="classthemis_1_1network_1_1_retry_context" prot="public">themis::network::RetryContext</innerclass>
