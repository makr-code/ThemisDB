<sect1 id="classthemis_1_1gpu_1_1_g_p_u_profiler_1autotoc_md40_1s1"><sect2 id="classthemis_1_1gpu_1_1_g_p_u_profiler_1autotoc_md40">
<title>Manual push/pop</title><para><programlisting filename=".cpp"><codeline><highlight class="keyword">auto</highlight><highlight class="normal">&amp;<sp/>prof<sp/>=<sp/><ref refid="classthemis_1_1gpu_1_1_g_p_u_profiler_1adeb627f2782dfdae9b4cbb082e8e11cd" kindref="member">GPUProfiler::GetInstance</ref>();</highlight></codeline>
<codeline><highlight class="normal">prof.beginRange(</highlight><highlight class="stringliteral">&quot;knn_query&quot;</highlight><highlight class="normal">,<sp/>0xFF0080FF);<sp/><sp/></highlight><highlight class="comment">//<sp/>blue</highlight><highlight class="normal"></highlight></codeline>
<codeline><highlight class="normal">doWork();</highlight></codeline>
<codeline><highlight class="normal">prof.endRange();</highlight></codeline>
</programlisting></para>
<para>Thread safety: all public methods are protected by an internal mutex. </para>
</sect2></sect1>
