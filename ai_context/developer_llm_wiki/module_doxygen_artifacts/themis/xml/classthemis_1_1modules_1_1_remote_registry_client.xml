    <sectiondef kind="public-type">
      <memberdef kind="typedef" id="classthemis_1_1modules_1_1_remote_registry_client_1a1313e356829cdaae86cb9f7fef2f2605" prot="public" static="no">
        <type>std::function&lt; void(const <ref refid="structthemis_1_1modules_1_1_request_stats" kindref="compound">RequestStats</ref> &amp;)&gt;</type>
        <definition>using themis::modules::RemoteRegistryClient::ObservabilityHook = std::function&lt;void(const RequestStats&amp;)&gt;</definition>
        <argsstring></argsstring>
        <name>ObservabilityHook</name>
        <qualifiedname>themis::modules::RemoteRegistryClient::ObservabilityHook</qualifiedname>
        <briefdescription>
<para>Callback type for retry-exhaust and timeout observability events. </para>
        </briefdescription>
        <detaileddescription>
<para>Called with the updated <computeroutput><ref refid="structthemis_1_1modules_1_1_request_stats" kindref="compound">RequestStats</ref></computeroutput> snapshot each time a request sequence exhausts its retry budget (<computeroutput>retry_exhausted_count</computeroutput> was incremented) or a per-attempt timeout occurs (<computeroutput>timeout_count</computeroutput> was incremented). Callbacks are invoked under the internal <computeroutput>stats_mutex_</computeroutput>, so implementations must be non-blocking and must not re-enter any <computeroutput><ref refid="classthemis_1_1modules_1_1_remote_registry_client" kindref="compound">RemoteRegistryClient</ref></computeroutput> method. </para>
        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
        <location file="include/themis/base/remote_registry_client.h" line="238" column="5" bodyfile="include/themis/base/remote_registry_client.h" bodystart="238" bodyend="-1"/>
      </memberdef>
    </sectiondef>
