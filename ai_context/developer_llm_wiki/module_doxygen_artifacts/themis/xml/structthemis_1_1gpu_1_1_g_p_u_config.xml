    <sectiondef kind="public-func">
      <memberdef kind="function" id="structthemis_1_1gpu_1_1_g_p_u_config_1a09a1f5d4dd32a5e78994dff90055abba" prot="public" static="no" const="yes" explicit="no" inline="no" virt="non-virtual">
        <type><ref refid="structthemis_1_1gpu_1_1_g_p_u_config_1_1_validation_result" kindref="compound">ValidationResult</ref></type>
        <definition>ValidationResult themis::gpu::GPUConfig::validate</definition>
        <argsstring>() const</argsstring>
        <name>validate</name>
        <qualifiedname>themis::gpu::GPUConfig::validate</qualifiedname>
        <briefdescription>
<para>Validate all fields for consistency. </para>
        </briefdescription>
        <detaileddescription>
<para>Rules enforced<itemizedlist>
<listitem><para>pool_slab_size must be &gt; 0 when enable_pool == true</para>
</listitem><listitem><para>oom_warning_threshold must be in (0, 1]</para>
</listitem><listitem><para>circuit_failure_threshold must be &gt;= 1</para>
</listitem><listitem><para>circuit_success_threshold must be &gt;= 1</para>
</listitem><listitem><para>circuit_reset_timeout_secs must be &gt; 0</para>
</listitem><listitem><para>If max_vram_bytes is non-zero, min_free_vram_bytes must be &lt; max_vram_bytes</para>
</listitem><listitem><para>If pool is enabled and pool_num_slabs is 0, max_vram_bytes must be set so it can be derived (warns if not) </para>
</listitem></itemizedlist>
</para>
        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
        <location file="include/themis/gpu/config.h" line="108" column="22"/>
      </memberdef>
      <memberdef kind="function" id="structthemis_1_1gpu_1_1_g_p_u_config_1ac9f5a50c84ed4cb389aa386f5bf2c314" prot="public" static="no" const="yes" explicit="no" inline="no" virt="non-virtual">
        <type>std::pair&lt; bool, std::string &gt;</type>
        <definition>std::pair&lt; bool, std::string &gt; themis::gpu::GPUConfig::simulateAllocation</definition>
        <argsstring>(uint64_t bytes, uint64_t current_allocated_bytes) const</argsstring>
        <name>simulateAllocation</name>
