          <declname>bytes</declname>
        </param>
        <param>
          <type>uint64_t</type>
          <declname>current_allocated_bytes</declname>
        </param>
        <briefdescription>
<para>Simulate whether an allocation of <computeroutput>bytes</computeroutput> would be accepted under this config given <computeroutput>current_allocated_bytes</computeroutput>. </para>
        </briefdescription>
        <detaileddescription>
<para>Does not touch any real GPU state. Returns a pair of (accepted, reason). </para>
        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
        <location file="include/themis/gpu/config.h" line="116" column="15"/>
