    <briefdescription>
<para><ref refid="classthemis_1_1utils_1_1_i_hash_chain_audit_log" kindref="compound">IHashChainAuditLog</ref> adapter backed by <ref refid="classthemis_1_1utils_1_1_hash_chain_audit_writer" kindref="compound">HashChainAuditWriter</ref>. </para>
    </briefdescription>
    <detaileddescription>
<para>Provides <ref refid="classthemis_1_1utils_1_1_hash_chain_audit_log_adapter_1a9750cfd249f64459e67c6b91abc8aef0" kindref="member">append()</ref>, <ref refid="classthemis_1_1utils_1_1_hash_chain_audit_log_adapter_1abacb9fae17989f4868e294ef2224cb34" kindref="member">verifyChain()</ref>, <ref refid="classthemis_1_1utils_1_1_hash_chain_audit_log_adapter_1ad659f61c72d8be2722e4537d0abcf46e" kindref="member">query()</ref>, <ref refid="classthemis_1_1utils_1_1_hash_chain_audit_log_adapter_1a3b51b848ec779b9db564a2bbdb4882cc" kindref="member">entryCount()</ref>, and <ref refid="classthemis_1_1utils_1_1_hash_chain_audit_log_adapter_1a538a5ab69fcf06b01f9539afea937310" kindref="member">lastEntryId()</ref> on top of the existing <ref refid="classthemis_1_1utils_1_1_hash_chain_audit_writer" kindref="compound">HashChainAuditWriter</ref> + <ref refid="classthemis_1_1utils_1_1_audit_log_verifier" kindref="compound">AuditLogVerifier</ref> pair.</para>
<para>Thread-safe for concurrent appends. </para>
    </detaileddescription>
