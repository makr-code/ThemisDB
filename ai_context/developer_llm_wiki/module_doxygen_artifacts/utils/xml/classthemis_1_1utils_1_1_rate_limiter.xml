<parameternamelist>
<parametername direction="in">tokens</parametername>
</parameternamelist>
<parameterdescription>
<para>Input parameter. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>True when the operation succeeds.</para>
</simplesect>
