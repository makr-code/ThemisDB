        <type>std::future&lt; <ref refid="structthemis_1_1utils_1_1_h_t_t_p_response" kindref="compound">HTTPResponse</ref> &gt;</type>
        <definition>std::future&lt; HTTPResponse &gt; themis::utils::HTTPClientPool::post</definition>
        <argsstring>(const std::string &amp;url, const json &amp;body, const std::unordered_map&lt; std::string, std::string &gt; &amp;headers={})</argsstring>
        <name>post</name>
        <qualifiedname>themis::utils::HTTPClientPool::post</qualifiedname>
        <param>
          <type>const std::string &amp;</type>
          <declname>url</declname>
        </param>
        <param>
          <type>const <ref refid="namespacethemis_1_1utils_1ae4db8de75ec73bf0351ca66e78ed8867" kindref="member">json</ref> &amp;</type>
          <declname>body</declname>
        </param>
