        <argsstring>(const std::string &amp;error_msg, int http_status, const std::string &amp;task_id, ExternalSchedulerType scheduler_type)</argsstring>
        <name>classifyAndMapExternalError</name>
        <qualifiedname>themis::scheduler::ExternalSchedulerAdapter::classifyAndMapExternalError</qualifiedname>
        <param>
          <type>const std::string &amp;</type>
          <declname>error_msg</declname>
        </param>
        <param>
          <type>int</type>
          <declname>http_status</declname>
        </param>
        <param>
          <type>const std::string &amp;</type>
