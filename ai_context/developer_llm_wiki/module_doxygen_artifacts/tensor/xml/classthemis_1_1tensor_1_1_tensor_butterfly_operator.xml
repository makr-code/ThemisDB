    <briefdescription>
<para>Immutable butterfly operator in TT-network format. </para>
    </briefdescription>
    <detaileddescription>
<para><heading level="3">Typical usage</heading>
</para>
<para><programlisting filename=".cpp"><codeline><highlight class="keyword">auto</highlight><highlight class="normal"><sp/>op<sp/>=<sp/><ref refid="classthemis_1_1tensor_1_1_tensor_butterfly_operator_1a7e150d44e081f9ac164131af3d54260a" kindref="member">TensorButterflyOperator::build</ref>(</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/><ref refid="namespacethemis_1_1tensor_1af047ac11b132f1fc9a4c2504516b9221a667d9ad5dc062018cfdc1ec703400be5" kindref="member">OperatorType::FOURIER</ref>,<sp/>{8,<sp/>8},<sp/>1e-6f);</highlight></codeline>
<codeline><highlight class="normal"></highlight></codeline>
<codeline><highlight class="normal">TTTrain<sp/>data<sp/>=<sp/>decompose(signal,<sp/>{8,<sp/>8});</highlight></codeline>
<codeline><highlight class="normal">TTTrain<sp/>freq<sp/>=<sp/>op.<ref refid="classthemis_1_1tensor_1_1_tensor_butterfly_operator_1a662fbea13cbd819f8847379eb179574b" kindref="member">apply</ref>(data);</highlight></codeline>
</programlisting></para>
<para><heading level="3">Thread safety</heading>
</para>
<para><computeroutput><ref refid="classthemis_1_1tensor_1_1_tensor_butterfly_operator_1a662fbea13cbd819f8847379eb179574b" kindref="member">apply()</ref></computeroutput> is const and safe for concurrent use after <computeroutput><ref refid="classthemis_1_1tensor_1_1_tensor_butterfly_operator_1a7e150d44e081f9ac164131af3d54260a" kindref="member">build()</ref></computeroutput>. The returned <computeroutput>TTTrain</computeroutput> is independent of <computeroutput>*this</computeroutput>. </para>
    </detaileddescription>
