        </briefdescription>
        <detaileddescription>
<para>A summary is considered stale if:<itemizedlist>
<listitem><para>freshness_state == STALE or INVALID, OR</para>
</listitem><listitem><para>Current time &gt; last_update_timestamp + freshness_ttl_seconds</para>
</listitem></itemizedlist>
</para>
