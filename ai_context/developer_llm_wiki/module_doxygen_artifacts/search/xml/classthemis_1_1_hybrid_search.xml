<parameteritem>
<parameternamelist>
<parametername direction="in">vector_dim</parametername>
</parameternamelist>
<parameterdescription>
<para>Input parameter. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="inout">stats</parametername>
</parameternamelist>
<parameterdescription>
<para>Input/output parameter. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>Return value.</para>
</simplesect>
Calls: empty(), scanFulltextWithScores(), reserve(), size(), Result(), push_back(), THEMIS_DEBUG(), THEMIS_WARN(). </para>
        </detaileddescription>
