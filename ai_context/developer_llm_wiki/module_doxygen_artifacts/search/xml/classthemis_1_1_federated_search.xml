<codeline><highlight class="normal"></highlight></codeline>
<codeline><highlight class="normal">fs.registerTenant(</highlight><highlight class="stringliteral">&quot;tenant_A&quot;</highlight><highlight class="normal">,<sp/>&amp;hs_a);</highlight></codeline>
