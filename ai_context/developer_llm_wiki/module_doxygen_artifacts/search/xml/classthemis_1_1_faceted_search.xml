</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>column</parametername>
</parameternamelist>
<parameterdescription>
<para>Column to facet on. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>candidate_pks</parametername>
</parameternamelist>
<parameterdescription>
<para>Optional set of PKs to restrict counting (search results). </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>max_values</parametername>
</parameternamelist>
<parameterdescription>
<para>Maximum number of distinct values to return (0 = no limit). </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>Pair of Status and <ref refid="structthemis_1_1_facet_result" kindref="compound">FacetResult</ref>. </para>
</simplesect>
</para>
