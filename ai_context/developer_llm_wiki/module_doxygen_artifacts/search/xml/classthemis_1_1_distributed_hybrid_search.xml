        <name>search</name>
        <qualifiedname>themis::DistributedHybridSearch::search</qualifiedname>
        <param>
          <type>const std::string &amp;</type>
          <declname>text_query</declname>
        </param>
        <param>
          <type>const std::vector&lt; float &gt; &amp;</type>
