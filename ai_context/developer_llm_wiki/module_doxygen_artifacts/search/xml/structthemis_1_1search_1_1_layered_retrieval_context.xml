    <briefdescription>
<para>Query payload consumed by <ref refid="classthemis_1_1search_1_1_layered_retrieval_orchestrator" kindref="compound">LayeredRetrievalOrchestrator</ref>. </para>
    </briefdescription>
    <detaileddescription>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>query</parametername>
</parameternamelist>
<parameterdescription>
<para>Natural-language query used by the final LLM layer. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>query_vector</parametername>
</parameternamelist>
<parameterdescription>
<para>Dense embedding used by the ANN layer. Empty disables ANN execution. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>tensor_query_key</parametername>
</parameternamelist>
<parameterdescription>
<para>Existing tensor fingerprint key queried against the tensor layer. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>graph_subject_id</parametername>
</parameternamelist>
<parameterdescription>
<para>Subject/entity whose provenance chain should be inferred. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>correlation_id</parametername>
</parameternamelist>
<parameterdescription>
<para>Stable request identifier propagated into trace attributes. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>llm_prompt_prefix</parametername>
</parameternamelist>
<parameterdescription>
<para>Optional system prefix prepended to the generated prompt. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>lora_adapter_id</parametername>
</parameternamelist>
<parameterdescription>
<para>Optional adapter identifier used for graph-layer plausibility scoring. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
</para>
    </detaileddescription>
