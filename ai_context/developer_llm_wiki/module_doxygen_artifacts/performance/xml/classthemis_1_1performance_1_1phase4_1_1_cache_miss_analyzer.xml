    <detaileddescription>
<para>Collects L1d, LLC, and branch-misprediction counters. Typical usage: <programlisting><codeline><highlight class="normal"><ref refid="classthemis_1_1performance_1_1phase4_1_1_cache_miss_analyzer_1a402b33961521978dc5515728b2f5ea52" kindref="member">CacheMissAnalyzer</ref><sp/>analyzer;</highlight></codeline>
<codeline><highlight class="normal"></highlight><highlight class="keywordflow">if</highlight><highlight class="normal"><sp/>(analyzer.is_available())<sp/>{</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>analyzer.start();</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>do_work();</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>CacheMissMetrics<sp/>m<sp/>=<sp/>analyzer.stop();</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/></highlight><highlight class="comment">//<sp/>use<sp/>m.llc_misses,<sp/>m.l1d_read_misses,<sp/>...</highlight><highlight class="normal"></highlight></codeline>
<codeline><highlight class="normal">}</highlight></codeline>
</programlisting> </para>
