</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>term2</parametername>
</parameternamelist>
<parameterdescription>
<para>Second term (pre-tokenised, lowercase). </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>distance</parametername>
</parameternamelist>
<parameterdescription>
<para>Maximum allowed token distance (inclusive). </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>top_k</parametername>
</parameternamelist>
<parameterdescription>
<para>Maximum results to return. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>Ranked results, descending score. </para>
</simplesect>
</para>
