        <reimplements refid="classthemis_1_1training_1_1_i_l_l_m_router_1ab0ae6f264b2b8c4c93b989cc89897cc9">setAdapterWeight</reimplements>
        <param>
          <type>const std::string &amp;</type>
          <declname>version</declname>
        </param>
        <param>
          <type>float</type>
          <declname>weight</declname>
