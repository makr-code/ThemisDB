        <definition>ModalityParseResult themis::training::ModalityDetector::parseDocument</definition>
        <argsstring>(const std::string &amp;content, const std::string &amp;document_id, const std::string &amp;mime_hint=&quot;&quot;) const</argsstring>
        <name>parseDocument</name>
        <qualifiedname>themis::training::ModalityDetector::parseDocument</qualifiedname>
        <param>
