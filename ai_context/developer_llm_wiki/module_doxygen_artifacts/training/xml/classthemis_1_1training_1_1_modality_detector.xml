        <type><ref refid="namespacethemis_1_1training_1a42b3986090b456e4c741a98b9ca1c430" kindref="member">ContentModality</ref></type>
        <definition>ContentModality themis::training::ModalityDetector::detectModality</definition>
        <argsstring>(const std::string &amp;content, const std::string &amp;mime_hint=&quot;&quot;) const</argsstring>
        <name>detectModality</name>
        <qualifiedname>themis::training::ModalityDetector::detectModality</qualifiedname>
        <param>
          <type>const std::string &amp;</type>
          <declname>content</declname>
