        <name>refreshIncremental</name>
        <qualifiedname>themis::ContinuousAggregateManager::refreshIncremental</qualifiedname>
        <param>
          <type>const <ref refid="structthemis_1_1_agg_config" kindref="compound">AggConfig</ref> &amp;</type>
          <declname>cfg</declname>
        </param>
