        <name>min_token_diversity</name>
        <qualifiedname>themis::prompt_engineering::QualityConfig::min_token_diversity</qualifiedname>
        <initializer>= 0.30</initializer>
        <briefdescription>
<para>Minimum acceptable token diversity ratio. </para>
