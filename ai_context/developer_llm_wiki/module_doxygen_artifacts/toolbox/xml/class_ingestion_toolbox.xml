        <definition>std::vector&lt; ingestion::BaseEntity &gt; themis::toolbox::IngestionToolbox::extractEntities</definition>
        <argsstring>(const std::string &amp;text, const std::string &amp;mime=&quot;text/plain&quot;, const std::string &amp;filename=&quot;input.txt&quot;)</argsstring>
        <name>extractEntities</name>
        <qualifiedname>IngestionToolbox::extractEntities</qualifiedname>
        <param>
          <type>const std::string &amp;</type>
