        <type>bool</type>
        <definition>virtual bool themis::plugins::ISelfHealingPlugin::attemptSelfRepair</definition>
        <argsstring>(const PluginDiagnostics &amp;diagnostics)=0</argsstring>
        <name>attemptSelfRepair</name>
        <qualifiedname>themis::plugins::ISelfHealingPlugin::attemptSelfRepair</qualifiedname>
        <reimplementedby refid="class_mock_self_healing_plugin_1aa129bb388997cdf243dd810fd0331590">attemptSelfRepair</reimplementedby>
        <param>
          <type>const <ref refid="structthemis_1_1plugins_1_1_plugin_diagnostics" kindref="compound">PluginDiagnostics</ref> &amp;</type>
          <declname>diagnostics</declname>
        </param>
        <briefdescription>
<para>Attempt automatic self-repair. </para>
        </briefdescription>
        <detaileddescription>
<para>This method is called when <ref refid="classthemis_1_1plugins_1_1_i_self_healing_plugin_1a7a80178dbbffb1965eb386422decd5b7" kindref="member">performHealthCheck()</ref> indicates the plugin is unhealthy. The plugin should attempt to recover based on the diagnostics information.</para>
<para>Common recovery strategies:<itemizedlist>
<listitem><para>Reconnect to external services</para>
</listitem><listitem><para>Clear caches</para>
</listitem><listitem><para>Reload configuration</para>
</listitem><listitem><para>Rollback to last checkpoint</para>
</listitem></itemizedlist>
</para>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>diagnostics</parametername>
</parameternamelist>
<parameterdescription>
<para>Current diagnostic information </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>true if repair was successful, false otherwise </para>
</simplesect>
<simplesect kind="note"><para>Must be thread-safe </para>
</simplesect>
<simplesect kind="note"><para>Should complete within reasonable time (&lt; 30 seconds) </para>
</simplesect>
</para>
        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
        <location file="include/plugins/self_healing_plugin.h" line="140" column="19"/>
      </memberdef>
