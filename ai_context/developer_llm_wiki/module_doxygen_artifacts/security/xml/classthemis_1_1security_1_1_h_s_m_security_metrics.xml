<para>HSM provider instance </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>warnings_count</parametername>
</parameternamelist>
<parameterdescription>
<para>Total number of security warnings issued </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>Prometheus-formatted metrics string </para>
</simplesect>
</para>
