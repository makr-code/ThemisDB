        <name>scheduleTable</name>
        <qualifiedname>themisdb::temporal::RetentionManager::scheduleTable</qualifiedname>
        <param>
          <type><ref refid="classthemisdb_1_1temporal_1_1SystemVersionedTable" kindref="compound">SystemVersionedTable</ref> &amp;</type>
