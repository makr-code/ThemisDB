    <detaileddescription>
<para>High-level codec that combines all compression techniques.</para>
<para>Typical usage: <programlisting><codeline><highlight class="normal">IndexCompressionCodec::Config<sp/>cfg;</highlight></codeline>
<codeline><highlight class="normal">cfg.enable_prefix_compression<sp/><sp/>=<sp/></highlight><highlight class="keyword">true</highlight><highlight class="normal">;</highlight></codeline>
<codeline><highlight class="normal">cfg.enable_delta_encoding<sp/><sp/><sp/><sp/><sp/><sp/>=<sp/></highlight><highlight class="keyword">true</highlight><highlight class="normal">;</highlight></codeline>
<codeline><highlight class="normal">cfg.enable_rle<sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/>=<sp/></highlight><highlight class="keyword">true</highlight><highlight class="normal">;</highlight></codeline>
<codeline><highlight class="normal">cfg.enable_dict_encoding<sp/><sp/><sp/><sp/><sp/><sp/><sp/>=<sp/></highlight><highlight class="keyword">true</highlight><highlight class="normal">;</highlight></codeline>
<codeline><highlight class="normal">cfg.enable_bloom_filter<sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/>=<sp/></highlight><highlight class="keyword">true</highlight><highlight class="normal">;</highlight></codeline>
<codeline><highlight class="normal">cfg.algorithm<sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/>=<sp/><ref refid="namespacethemis_1_1index_1a8cc565ef833715bded080fd643d4d6a3a8406cc2302e19183037b61249546b234" kindref="member">CompressionAlgorithm::ZSTD</ref>;</highlight></codeline>
<codeline><highlight class="normal">cfg.compression_level<sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/>=<sp/>3;</highlight></codeline>
<codeline><highlight class="normal"></highlight></codeline>
<codeline><highlight class="normal"><ref refid="classthemis_1_1index_1_1_index_compression_codec_1af5e80c4f952b291b808226e2cf6226f3" kindref="member">IndexCompressionCodec</ref><sp/>codec(cfg);</highlight></codeline>
<codeline><highlight class="normal">codec.trainDictionary(sample_values);</highlight></codeline>
<codeline><highlight class="normal"></highlight></codeline>
<codeline><highlight class="normal"></highlight><highlight class="keyword">auto</highlight><highlight class="normal"><sp/>blocks<sp/>=<sp/>codec.compressKeys(sorted_index_keys);</highlight></codeline>
<codeline><highlight class="normal"></highlight><highlight class="keyword">auto</highlight><highlight class="normal"><sp/>keys<sp/><sp/><sp/>=<sp/>codec.decompressKeys(blocks);</highlight></codeline>
</programlisting> </para>
