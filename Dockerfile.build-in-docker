# ThemisDB Docker Image - Wire Protocol Enabled
# Builds themis_server inside Docker to avoid file path issues

FROM ubuntu:22.04

# Install all dependencies (build + runtime) in one stage for simplicity
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    git \
    curl \
    wget \
    zip \
    unzip \
    tar \
    pkg-config \
    ca-certificates \
    libboost-dev \
    libboost-system-dev \
    libboost-thread-dev \
    libssl-dev \
    libssl3 \
    libstdc++6 \
    libc6 \
    libboost-system1.74.0 \
    libboost-thread1.74.0 \
    libzstd1 \
    libbrotli1 \
    libcurl4 \
    zlib1g-dev \
    libbrotli-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Copy only source files (minimal context)
COPY CMakeLists.txt ./
COPY include/ ./include/
COPY src/ ./src/
COPY vcpkg.json ./

# Clone and bootstrap vcpkg
RUN git clone https://github.com/Microsoft/vcpkg.git external/vcpkg && \
    cd external/vcpkg && \
    ./bootstrap-vcpkg.sh -disableMetrics && \
    cd /build

ENV VCPKG_ROOT=/build/external/vcpkg

# Build themis_server with Wire Protocol enabled
RUN \
    cmake -S . -B build \
        -G "Unix Makefiles" \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_TOOLCHAIN_FILE=${VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake \
        -DTHEMIS_BUILD_WIRE_PROTOCOL=ON && \
    cmake --build build --target themis_server -j4 && \
    echo "Build successful!" && \
    ls -lh /build/build/themis_server

# Move binary to final location
RUN cp /build/build/themis_server /app/themis_server && \
    chmod +x /app/themis_server

# Clean up build artifacts
RUN rm -rf /build

# Create application structure
RUN mkdir -p /data /etc/themis /var/log/themis && \
    useradd -m -u 1000 themis || true && \
    chown -R themis:themis /app /data /etc/themis /var/log/themis

WORKDIR /app
USER themis

# Expose ports
EXPOSE 8765 8766

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD test -f /app/themis_server || exit 1

# Default command
CMD ["/app/themis_server"]
