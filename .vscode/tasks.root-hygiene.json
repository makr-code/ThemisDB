{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Repo Hygiene: Root Logs DryRun",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        ".\\scripts\\move-root-logs.ps1",
        "-RepoRoot",
        ".",
        "-DryRun"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Repo Hygiene: Move Root Logs",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        ".\\scripts\\move-root-logs.ps1",
        "-RepoRoot",
        "."
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
