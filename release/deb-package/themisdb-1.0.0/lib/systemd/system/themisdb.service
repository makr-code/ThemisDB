[Unit]
Description=ThemisDB Multi-Model Database Server
Documentation=https://github.com/makr-code/ThemisDB
After=network.target

[Service]
Type=simple
User=themisdb
Group=themisdb
WorkingDirectory=/var/lib/themisdb
ExecStart=/usr/local/bin/themis_server
Restart=on-failure
RestartSec=5s

# Environment
Environment="THEMIS_DB_PATH=/var/lib/themisdb/data"
Environment="THEMIS_PORT=8765"

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/themisdb /var/log/themisdb

# Limits
LimitNOFILE=65536
LimitNPROC=4096

[Install]
WantedBy=multi-user.target
