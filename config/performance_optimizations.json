{
  "_comment": "Performance Optimization Configuration",
  "_description": "Runtime feature flags for research-based performance optimizations",
  "_documentation": "See docs/de/research/WISSENSCHAFTLICHE_PERFORMANCE_OPTIMIERUNGEN.md",
  
  "performance": {
    "_phase1_comment": "Phase 1 - Quick Wins (+50-100% read-heavy, 1-3 months)",
    
    "enable_mimalloc": false,
    "_mimalloc_desc": "Use mimalloc allocator (+10-20% overall performance, ISMM'19)",
    "_mimalloc_compile": "THEMIS_ENABLE_MIMALLOC",
    "_mimalloc_effort": "1 day",
    
    "enable_huge_pages": false,
    "_huge_pages_desc": "Enable 2MB/1GB pages (+15-30% memory-intensive, FAST'14)",
    "_huge_pages_compile": "THEMIS_ENABLE_HUGE_PAGES",
    "_huge_pages_effort": "2 days",
    
    "enable_rcu_index": false,
    "_rcu_index_desc": "RCU for read-heavy paths (+200-500% reads, ASPLOS'10)",
    "_rcu_index_compile": "THEMIS_ENABLE_RCU_INDEX",
    "_rcu_index_effort": "2 weeks",
    
    "enable_lirs_cache": false,
    "_lirs_cache_desc": "LIRS cache replacement (+30-40% hit rate, SIGMETRICS'02)",
    "_lirs_cache_compile": "THEMIS_ENABLE_LIRS_CACHE",
    "_lirs_cache_effort": "1 week",
    
    "_phase2_comment": "Phase 2 - Medium-Term (+100-200% overall, 3-6 months)",
    
    "enable_wisckey": false,
    "_wisckey_desc": "Value separation (+40-60% writes for >1KB, FAST'16)",
    "_wisckey_compile": "THEMIS_ENABLE_WISCKEY",
    "_wisckey_effort": "4 weeks",
    
    "enable_cicada_cc": false,
    "_cicada_cc_desc": "Optimistic concurrency (+100-150% TX, SIGMOD'17)",
    "_cicada_cc_compile": "THEMIS_ENABLE_CICADA_CC",
    "_cicada_cc_effort": "6 weeks",
    
    "_phase3_comment": "Phase 3 - Long-Term (+200-500% domain-specific, 6-12 months)",
    
    "enable_diskann": false,
    "_diskann_desc": "Billion-scale vector search (+300-400%, NeurIPS'19)",
    "_diskann_compile": "THEMIS_ENABLE_DISKANN",
    "_diskann_effort": "8 weeks",
    
    "enable_bw_tree": false,
    "_bw_tree_desc": "Lock-free index (+100-200% updates, ICDE'18)",
    "_bw_tree_compile": "THEMIS_ENABLE_BW_TREE",
    "_bw_tree_effort": "10 weeks"
  },
  
  "rollback": {
    "_description": "3-tier rollback strategy",
    "tier1_runtime": "Change config + restart (<1 minute)",
    "tier2_build": "Rebuild without flag (<10 minutes)",
    "tier3_git": "Git revert (<30 minutes)"
  },
  
  "validation": {
    "_description": "Benchmark validation requirements",
    "min_improvement_pct": 10,
    "min_repetitions": 10,
    "statistical_test": "t-test",
    "significance_level": 0.05
  }
}
