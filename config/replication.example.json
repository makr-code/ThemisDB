{
  "replication": {
    "shipper_enabled": true,
    "primary_id": "primary-node-1",
    "batch_size": 100,
    "max_batch_bytes": 1048576,
    "ship_interval_ms": 100,
    "retry_delay_ms": 1000,
    "max_retry_delay_ms": 60000,
    "max_retries": 5,
    "health_check_interval_ms": 10000,
    "compression": "zstd",
    "compression_level": 3,
    "replicas": [
      {
        "replica_id": "replica-node-1",
        "endpoint": "localhost:8766"
      },
      {
        "replica_id": "replica-node-2",
        "endpoint": "localhost:8767"
      }
    ]
  },
  "multi_primary": {
    "enabled": true,
    "current_node_id": "primary-node-1",
    "use_last_write_wins": true,
    "allow_concurrent_writes": true,
    "cross_primary_replication": true,
    "default_write_concern": "MAJORITY",
    "promotion_timeout_ms": 5000,
    "auto_promote_on_primary_failure": true,
    "nodes": [
      {"node_id": "primary-node-1", "endpoint": "http://primary1:8765"},
      {"node_id": "primary-node-2", "endpoint": "http://primary2:8765"}
    ]
  },
  "health_monitor": {
    "heartbeat_interval_ms": 1000,
    "health_check_timeout_ms": 500,
    "max_consecutive_failures": 3,
    "auto_failover_enabled": true,
    "auto_promote_standby": true,
    "failover_cooldown_ms": 10000,
    "health_check_path": "/health"
  },
  "replica_topology": [
    {
      "shard_id": "shard_0",
      "primary_id": "primary-node-1",
      "redundancy": "RAID1",
      "replicas": ["replica-node-1"],
      "stripe_key": 0
    },
    {
      "shard_id": "shard_1",
      "primary_id": "primary-node-1",
      "redundancy": "RAID10",
      "replicas": ["replica-node-1", "replica-node-2"],
      "stripe_key": 1
    }
  ]
}
