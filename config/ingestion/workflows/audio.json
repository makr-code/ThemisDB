{
  "apiVersion": "themis.ingestion/v1",
  "kind": "IngestionWorkflow",
  "name": "audio",
  "description": "Audio files (MP3, WAV, OGG, FLAC, M4A, AAC, OPUS) — speech-to-text via IFormatExtractor (STTProcessor adapter, requires THEMIS_ENABLE_VOICE_ASSISTANT)",

  "file_patterns": {
    "mime_types": [
      "audio/mpeg",
      "audio/wav",
      "audio/ogg",
      "audio/flac",
      "audio/mp4",
      "audio/aac",
      "audio/opus",
      "audio/x-ms-wma"
    ],
    "filename_patterns": [
      "*.mp3",
      "*.wav",
      "*.ogg",
      "*.flac",
      "*.m4a",
      "*.aac",
      "*.opus",
      "*.wma"
    ]
  },

  "requires_feature": "THEMIS_ENABLE_VOICE_ASSISTANT",

  "steps": [
    {
      "name": "parse_audio",
      "plugin": "builtin.parse_audio",
      "on_failure": "abort",
      "config": {
        "language": "auto",
        "model": "whisper-base",
        "diarization": false,
        "timestamps": true
      }
    },
    {
      "name": "chunk",
      "plugin": "builtin.chunk_text",
      "on_failure": "skip",
      "config": {
        "strategy": "fixed",
        "size": 256,
        "overlap": 32
      }
    },
    {
      "name": "assemble",
      "plugin": "builtin.base_entity_assembler",
      "on_failure": "skip",
      "config": {
        "dedup_strategy": "canonical_id"
      }
    }
  ],

  "output": {
    "graph": false,
    "vector": true,
    "document_store": true,
    "quality_gate": {
      "min_entities": 0,
      "min_quality_score": 0.0
    }
  }
}
