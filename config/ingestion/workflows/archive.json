{
  "apiVersion": "themis.ingestion/v1",
  "kind": "IngestionWorkflow",
  "name": "archive",
  "description": "Archive files (ZIP, TAR, GZ, BZ2, XZ, 7Z, RAR) — recursive extraction via IFormatExtractor (ArchiveProcessor adapter). Child files are re-ingested individually using their own workflow profiles.",

  "file_patterns": {
    "mime_types": [
      "application/zip",
      "application/x-tar",
      "application/gzip",
      "application/x-bzip2",
      "application/x-xz",
      "application/x-7z-compressed",
      "application/vnd.rar"
    ],
    "filename_patterns": [
      "*.zip",
      "*.tar",
      "*.tar.gz",
      "*.tgz",
      "*.tar.bz2",
      "*.tbz2",
      "*.tar.xz",
      "*.txz",
      "*.7z",
      "*.rar",
      "*.gz",
      "*.bz2",
      "*.xz"
    ]
  },

  "steps": [
    {
      "name": "parse_archive",
      "plugin": "builtin.parse_archive",
      "on_failure": "abort",
      "config": {
        "max_depth": 3,
        "max_entries": 1000,
        "max_entry_size": 104857600,
        "recurse": true,
        "skip_hidden": true
      }
    },
    {
      "name": "chunk",
      "plugin": "builtin.chunk_text",
      "on_failure": "skip",
      "config": {
        "strategy": "fixed",
        "size": 512,
        "overlap": 64
      }
    },
    {
      "name": "assemble",
      "plugin": "builtin.base_entity_assembler",
      "on_failure": "skip",
      "config": {
        "dedup_strategy": "canonical_id"
      }
    }
  ],

  "output": {
    "graph": false,
    "vector": true,
    "document_store": true,
    "quality_gate": {
      "min_entities": 0,
      "min_quality_score": 0.0
    }
  }
}
