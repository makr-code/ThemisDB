{
  "apiVersion": "themis.ingestion/v1",
  "kind": "IngestionWorkflow",
  "name": "image-document",
  "description": "Image files (PNG, JPG) with OCR and CLIP embedding",

  "file_patterns": {
    "mime_types": [
      "image/png",
      "image/jpeg",
      "image/tiff",
      "image/bmp"
    ],
    "filename_patterns": []
  },

  "steps": [
    {
      "name": "parse_text",
      "plugin": "builtin.parse_text",
      "on_failure": "skip",
      "config": {
        "ocr_enabled": true,
        "ocr_language": "deu+eng",
        "fallback_ocr_on_empty": false
      }
    },
    {
      "name": "chunk",
      "plugin": "builtin.chunk_text",
      "on_failure": "skip",
      "config": {
        "strategy": "fixed",
        "size": 256,
        "overlap": 32
      }
    },
    {
      "name": "assemble",
      "plugin": "builtin.base_entity_assembler",
      "on_failure": "skip",
      "config": {
        "dedup_strategy": "canonical_id"
      }
    }
  ],

  "output": {
    "graph": false,
    "vector": true,
    "document_store": true,
    "quality_gate": {
      "min_entities": 0,
      "min_quality_score": 0.0
    }
  }
}
