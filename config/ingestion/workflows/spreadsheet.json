{
  "apiVersion": "themis.ingestion/v1",
  "kind": "IngestionWorkflow",
  "name": "spreadsheet",
  "description": "Spreadsheet files (XLSX, CSV)",

  "file_patterns": {
    "mime_types": [
      "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
      "application/vnd.ms-excel",
      "text/csv"
    ],
    "filename_patterns": [
      "*.xlsx",
      "*.xls",
      "*.csv"
    ]
  },

  "steps": [
    {
      "name": "parse_text",
      "plugin": "builtin.parse_text",
      "on_failure": "skip",
      "config": {}
    },
    {
      "name": "chunk",
      "plugin": "builtin.chunk_text",
      "on_failure": "skip",
      "config": {
        "strategy": "fixed",
        "size": 1024,
        "overlap": 0
      }
    },
    {
      "name": "assemble",
      "plugin": "builtin.base_entity_assembler",
      "on_failure": "skip",
      "config": {
        "dedup_strategy": "canonical_id"
      }
    }
  ],

  "output": {
    "graph": false,
    "vector": true,
    "document_store": true,
    "quality_gate": {
      "min_entities": 0,
      "min_quality_score": 0.0
    }
  }
}
