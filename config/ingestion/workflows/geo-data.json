{
  "apiVersion": "themis.ingestion/v1",
  "kind": "IngestionWorkflow",
  "name": "geo-data",
  "description": "Geo-spatial data files (SHP, GeoJSON, KML)",

  "file_patterns": {
    "mime_types": [
      "application/octet-stream",
      "application/json",
      "application/vnd.google-earth.kml+xml",
      "application/geo+json"
    ],
    "filename_patterns": [
      "*.shp",
      "*.geojson",
      "*.kml",
      "*.gpx"
    ]
  },

  "steps": [
    {
      "name": "parse_text",
      "plugin": "builtin.parse_text",
      "on_failure": "skip",
      "config": {}
    },
    {
      "name": "assemble",
      "plugin": "builtin.base_entity_assembler",
      "on_failure": "skip",
      "config": {
        "dedup_strategy": "canonical_id"
      }
    }
  ],

  "output": {
    "graph": true,
    "vector": false,
    "document_store": true,
    "quality_gate": {
      "min_entities": 0,
      "min_quality_score": 0.0
    }
  }
}
