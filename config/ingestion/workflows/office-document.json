{
  "apiVersion": "themis.ingestion/v1",
  "kind": "IngestionWorkflow",
  "name": "office-document",
  "description": "Office documents (DOCX, PPTX, ODT, ODS, ODP, RTF, EPUB) via IFormatExtractor (OfficeProcessor adapter)",

  "file_patterns": {
    "mime_types": [
      "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
      "application/vnd.openxmlformats-officedocument.presentationml.presentation",
      "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
      "application/msword",
      "application/vnd.ms-powerpoint",
      "application/vnd.ms-excel",
      "application/vnd.oasis.opendocument.text",
      "application/vnd.oasis.opendocument.spreadsheet",
      "application/vnd.oasis.opendocument.presentation",
      "application/rtf",
      "application/epub+zip"
    ],
    "filename_patterns": [
      "*.docx",
      "*.doc",
      "*.pptx",
      "*.ppt",
      "*.odt",
      "*.ods",
      "*.odp",
      "*.rtf",
      "*.epub"
    ]
  },

  "steps": [
    {
      "name": "parse_office",
      "plugin": "builtin.parse_office",
      "on_failure": "abort",
      "config": {
        "extract_metadata": true,
        "extract_embedded_images": false,
        "extract_comments": true
      }
    },
    {
      "name": "chunk",
      "plugin": "builtin.chunk_text",
      "on_failure": "skip",
      "config": {
        "strategy": "section",
        "size": 512,
        "overlap": 64
      }
    },
    {
      "name": "assemble",
      "plugin": "builtin.base_entity_assembler",
      "on_failure": "skip",
      "config": {
        "dedup_strategy": "canonical_id"
      }
    }
  ],

  "output": {
    "graph": false,
    "vector": true,
    "document_store": true,
    "quality_gate": {
      "min_entities": 0,
      "min_quality_score": 0.0
    }
  }
}
