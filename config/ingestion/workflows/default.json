{
  "apiVersion": "themis.ingestion/v1",
  "kind": "IngestionWorkflow",
  "name": "default",
  "description": "Fallback workflow for unrecognised file types",

  "file_patterns": {},

  "steps": [
    {
      "name": "parse_text",
      "plugin": "builtin.parse_text",
      "on_failure": "skip",
      "config": {
        "ocr_enabled": false,
        "fallback_ocr_on_empty": false
      }
    },
    {
      "name": "chunk",
      "plugin": "builtin.chunk_text",
      "on_failure": "skip",
      "config": {
        "strategy": "fixed",
        "size": 512,
        "overlap": 64
      }
    },
    {
      "name": "assemble",
      "plugin": "builtin.base_entity_assembler",
      "on_failure": "skip",
      "config": {
        "dedup_strategy": "canonical_id"
      }
    }
  ],

  "output": {
    "graph": false,
    "vector": true,
    "document_store": true,
    "quality_gate": {
      "min_entities": 0,
      "min_quality_score": 0.0
    }
  }
}
