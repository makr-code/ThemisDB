{
  "_comment": "ThemisDB High Availability Replication Configuration (JSON)",
  "_description": "Enterprise-grade HA setup with automatic failure detection and failover",
  
  "server": {
    "host": "0.0.0.0",
    "port": 8765,
    "worker_threads": 8
  },
  
  "storage": {
    "rocksdb_path": "./data/themis_ha_primary",
    "memtable_size_mb": 256,
    "block_cache_size_mb": 512,
    "enable_blobdb": true,
    "compression": {
      "default": "zstd",
      "bottommost": "zstd"
    }
  },
  
  "replication": {
    "_comment_basic": "Basic replication settings",
    "enabled": true,
    "mode": "semi_sync",
    "node_id": "node-01",
    "datacenter": "dc-east-1",
    "conflict_strategy": "last_write_wins",
    
    "_comment_timing": "Timing configuration",
    "heartbeat_interval_ms": 1000,
    "election_timeout_min_ms": 3000,
    "election_timeout_max_ms": 5000,
    "replication_timeout_ms": 10000,
    
    "_comment_batching": "Batching for performance",
    "batch_size": 100,
    "batch_timeout_ms": 50,
    
    "_comment_wal": "WAL settings",
    "wal_directory": "/var/lib/themisdb/wal",
    "wal_segment_size_bytes": 67108864,
    "wal_retention_segments": 100,
    "wal_sync_on_commit": true,
    
    "_comment_quorum": "Quorum settings",
    "min_sync_replicas": 2,
    "allow_stale_reads": false,
    "max_replication_lag_ms": 10000,
    
    "_comment_ha": "HIGH AVAILABILITY CONFIGURATION",
    "enable_auto_failover": true,
    "failure_detection_timeout_ms": 5000,
    "min_quorum_for_failover": 2,
    "max_consecutive_failures": 3,
    "degraded_lag_threshold_ms": 5000,
    "default_read_preference": "primary_preferred",
    
    "_comment_security": "TLS/Security",
    "require_mtls": true,
    "cert_path": "/etc/themisdb/certs/node.crt",
    "key_path": "/etc/themisdb/certs/node.key",
    "ca_path": "/etc/themisdb/certs/ca.crt",
    
    "_comment_cluster": "Cluster seed nodes",
    "seed_nodes": [
      "node-01.cluster.local:8765",
      "node-02.cluster.local:8765",
      "node-03.cluster.local:8765"
    ]
  },
  
  "_topology_examples": {
    "_comment": "Configuration examples for different topologies",
    
    "active_passive_3_node": {
      "description": "3-node Active-Passive with automatic failover",
      "topology": {
        "node-01": "Primary (LEADER)",
        "node-02": "Standby (FOLLOWER, voting, high priority)",
        "node-03": "Read replica (FOLLOWER, voting)"
      },
      "config": {
        "mode": "semi_sync",
        "min_sync_replicas": 1,
        "enable_auto_failover": true
      }
    },
    
    "active_active_5_node": {
      "description": "5-node Active-Active with distributed consensus",
      "topology": {
        "all_nodes": "All voting members, can accept writes"
      },
      "config": {
        "mode": "sync",
        "min_sync_replicas": 3,
        "enable_auto_failover": true,
        "conflict_strategy": "vector_clock"
      }
    },
    
    "multi_datacenter_6_node": {
      "description": "6-node Multi-Datacenter deployment",
      "topology": {
        "dc_east": ["node-01 (LEADER)", "node-02 (FOLLOWER)", "node-03 (OBSERVER)"],
        "dc_west": ["node-04 (FOLLOWER)", "node-05 (FOLLOWER)", "node-06 (OBSERVER)"]
      },
      "config": {
        "mode": "semi_sync",
        "min_sync_replicas": 1,
        "degraded_lag_threshold_ms": 10000
      }
    }
  },
  
  "_prometheus_metrics": {
    "_comment": "Available at /metrics endpoint",
    "replication_metrics": [
      "themisdb_replication_entries_total",
      "themisdb_replication_bytes_total",
      "themisdb_replication_errors_total",
      "themisdb_replication_lag_max_ms",
      "themisdb_replication_lag_avg_ms"
    ],
    "ha_metrics": [
      "themisdb_automatic_failovers_total",
      "themisdb_manual_failovers_total",
      "themisdb_replica_failures_detected_total",
      "themisdb_network_partitions_detected_total",
      "themisdb_leader_elections_total"
    ]
  },
  
  "_alerting_rules": {
    "high_replication_lag": {
      "expr": "themisdb_replication_lag_max_ms > 30000",
      "for": "5m",
      "severity": "warning"
    },
    "replica_failed": {
      "expr": "increase(themisdb_replica_failures_detected_total[5m]) > 0",
      "severity": "critical"
    },
    "network_partition": {
      "expr": "increase(themisdb_network_partitions_detected_total[5m]) > 0",
      "severity": "critical"
    },
    "frequent_failovers": {
      "expr": "increase(themisdb_automatic_failovers_total[1h]) > 3",
      "severity": "warning"
    }
  },
  
  "_api_endpoints": {
    "manual_failover": {
      "method": "POST",
      "path": "/api/v1/replication/failover",
      "body": {
        "target_node_id": "node-02"
      }
    },
    "check_health": {
      "method": "GET",
      "path": "/api/v1/replication/health"
    },
    "check_status": {
      "method": "GET",
      "path": "/api/v1/replication/status"
    },
    "promote_node": {
      "method": "POST",
      "path": "/api/v1/replication/promote"
    },
    "demote_leader": {
      "method": "POST",
      "path": "/api/v1/replication/demote"
    }
  },
  
  "_rto_rpo": {
    "rpo": "0 (zero data loss with semi_sync/sync mode)",
    "rto": "< 30 seconds",
    "breakdown": {
      "failure_detection": "~5 seconds",
      "leader_election": "~3-5 seconds",
      "stream_reconnection": "~2-5 seconds",
      "client_reconnection": "~5-15 seconds (application dependent)",
      "total": "~15-30 seconds"
    }
  },
  
  "features": {
    "semantic_cache": false,
    "llm_store": false,
    "cdc": false,
    "timeseries": false
  }
}
