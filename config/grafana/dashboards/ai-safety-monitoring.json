{
  "uid": "themisdb-ai-safety",
  "title": "ThemisDB AI Safety Layer Monitoring",
  "description": "AI Safety Layer (ASL-12..15) operational dashboard — tool calls, pending approvals, blocked operations, snapshot storage and intent classification breakdown.",
  "schemaVersion": 36,
  "version": 1,
  "tags": ["themisdb", "ai-safety", "security"],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "pluginId": "prometheus",
        "label": "Prometheus",
        "hide": 0,
        "refresh": 1,
        "includeAll": false,
        "multi": false,
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "AI Operations Rate",
      "description": "Rate of AI-initiated MCP tool calls per second (ai_tool_call_total counter).",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "datasource": "${datasource}",
      "targets": [
        {
          "refId": "A",
          "datasource": "${datasource}",
          "expr": "rate(ai_tool_call_total[5m])",
          "legendFormat": "Tool Calls/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {"mode": "palette-classic"}
        }
      },
      "options": {
        "tooltip": {"mode": "single"},
        "legend": {"displayMode": "list", "placement": "bottom"}
      }
    },
    {
      "id": 2,
      "title": "Pending Approvals",
      "description": "Current number of AI operations waiting for operator approval (HILG queue).",
      "type": "gauge",
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 0},
      "datasource": "${datasource}",
      "targets": [
        {
          "refId": "A",
          "datasource": "${datasource}",
          "expr": "ai_pending_approvals_total",
          "legendFormat": "Pending"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 5},
              {"color": "red", "value": 20}
            ]
          },
          "color": {"mode": "thresholds"}
        }
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      }
    },
    {
      "id": 3,
      "title": "Blocked Operations",
      "description": "Total number of AI operations hard-blocked by the Destructive Operation Guard (DOG).",
      "type": "stat",
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 0},
      "datasource": "${datasource}",
      "targets": [
        {
          "refId": "A",
          "datasource": "${datasource}",
          "expr": "increase(ai_operations_blocked_total[1h])",
          "legendFormat": "Blocked (1h)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "orange", "value": 1},
              {"color": "red", "value": 10}
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 4,
      "title": "Approval Rate (Approved vs Denied)",
      "description": "Time series comparing operator-approved vs operator-denied AI operations.",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "datasource": "${datasource}",
      "targets": [
        {
          "refId": "A",
          "datasource": "${datasource}",
          "expr": "rate(ai_operations_executed_total[5m])",
          "legendFormat": "Approved"
        },
        {
          "refId": "B",
          "datasource": "${datasource}",
          "expr": "rate(ai_operations_denied_total[5m])",
          "legendFormat": "Denied"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {"mode": "palette-classic"}
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Denied"},
            "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]
          },
          {
            "matcher": {"id": "byName", "options": "Approved"},
            "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "green"}}]
          }
        ]
      },
      "options": {
        "tooltip": {"mode": "multi"},
        "legend": {"displayMode": "list", "placement": "bottom"}
      }
    },
    {
      "id": 5,
      "title": "Snapshot Storage Usage",
      "description": "Total disk usage of AI pre-operation snapshots (bytes).",
      "type": "gauge",
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 8},
      "datasource": "${datasource}",
      "targets": [
        {
          "refId": "A",
          "datasource": "${datasource}",
          "expr": "ai_snapshot_storage_bytes",
          "legendFormat": "Snapshot Storage"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 53687091200},
              {"color": "red", "value": 96636764160}
            ]
          },
          "color": {"mode": "thresholds"},
          "min": 0,
          "max": 107374182400
        }
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "orientation": "auto",
        "showThresholdLabels": true,
        "showThresholdMarkers": true
      }
    },
    {
      "id": 6,
      "title": "Intent Classification Breakdown",
      "description": "Bar chart of detected intent types from IntentClassifier (ASL-4/13). Counts accumulated since last restart.",
      "type": "barchart",
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 8},
      "datasource": "${datasource}",
      "targets": [
        {
          "refId": "A",
          "datasource": "${datasource}",
          "expr": "ai_intent_classification_total",
          "legendFormat": "{{intent_type}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {"mode": "palette-classic"}
        }
      },
      "options": {
        "orientation": "vertical",
        "xTickLabelRotation": -45,
        "groupWidth": 0.7,
        "barWidth": 0.97,
        "fillOpacity": 80,
        "gradientMode": "none",
        "tooltip": {"mode": "single"},
        "legend": {"displayMode": "list", "placement": "bottom"}
      }
    }
  ]
}
