{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Config Path Mapping Schema",
  "description": "Schema for validating the config path mapping table",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "description": "Schema version",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "mappings": {
      "type": "array",
      "description": "List of path mappings from legacy to new locations",
      "items": {
        "type": "object",
        "required": ["legacy_path", "new_path", "category"],
        "properties": {
          "legacy_path": {
            "type": "string",
            "description": "Original/legacy config path",
            "pattern": "^config/[a-zA-Z0-9_\\-/.]+\\.(yaml|yml|json)$"
          },
          "new_path": {
            "type": "string",
            "description": "New hierarchical config path",
            "pattern": "^config/[a-zA-Z0-9_\\-/]+/[a-zA-Z0-9_\\-/.]+\\.(yaml|yml|json)$"
          },
          "category": {
            "type": "string",
            "description": "Configuration category",
            "enum": [
              "ai_ml",
              "security",
              "compliance",
              "data_management",
              "performance",
              "deprecated",
              "core",
              "platform",
              "networking",
              "content",
              "monitoring",
              "features",
              "assistants",
              "processing",
              "licensing"
            ]
          },
          "deprecated_date": {
            "type": "string",
            "description": "ISO 8601 date when legacy path was deprecated",
            "format": "date"
          },
          "removal_date": {
            "type": "string",
            "description": "ISO 8601 date when legacy path will be removed",
            "format": "date"
          },
          "migration_guide": {
            "type": "string",
            "description": "URL or reference to migration documentation"
          }
        }
      }
    }
  },
  "required": ["version", "mappings"]
}
