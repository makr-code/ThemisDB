            {
              "id": "CVE-2025-58189",
              "name": "OsPackageVulnerability",
              "shortDescription": {
                "text": "CVE-2025-58189"
              },
              "helpUri": "https://scout.docker.com/v/CVE-2025-58189?s=golang&n=stdlib&t=golang&vr=%3C1.24.8",
              "help": {
                "text": "When Conn.Handshake fails during ALPN negotiation the error contains attacker controlled information (the ALPN protocols sent by the client) which is not escaped.\n",
