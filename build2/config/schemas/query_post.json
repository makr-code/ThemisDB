{
  "$comment": "Limit value must match MAX_QUERY_LIMIT constant in http_server.cpp",
  "type": "object",
  "required": ["query"],
  "properties": {
    "query": {
      "type": "string",
      "minLength": 1
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "offset": {
      "type": "integer",
      "minimum": 0
    },
    "filters": {
      "type": "object"
    },
    "sort": {
      "type": "array"
    }
  }
}
