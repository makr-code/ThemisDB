      "threshold": 10,
      "unit": "ns",
      "direction": "lower_is_better",
      "severity": "blocking",
      "status": "PASS",
      "description": "Switch dispatch p99 must not exceed 10 ns.",
      "rationale": "Validates O(1) jump-table compilation."
    },
    {
      "id": "GATE-MTN-03",
