{
  "schema_version": "1.0",
  "module": "maintenance",
  "description": "Maintenance module Phase 1-6 hardening release-gate manifest.",
  "effective_date": "2026-08-05",
  "owners": ["platform-maintenance@themisdb"],

  "baseline_freeze": {
    "compiler": "clang-17",
    "compiler_flags": "-O3 -march=native -DNDEBUG",
    "preset": "linux-release",
    "hardware_profile": "ci-runner-standard",
    "os_image": "ubuntu-22.04"
  },

  "seed": 42,
  "warmup_iterations": 500,
  "repetitions": 5,
  "min_sample_size": 30,

  "hard_gates": [
    {
      "id": "GATE-MTN-01",
      "benchmark": "mtn/BM_MTN01_ErrorEnumCast",
      "benchmark_file": "benchmarks/maintenance/bench_maintenance_release_gates.cpp",
      "metric": "latency_p99_ns",
      "threshold": 5,
      "unit": "ns",
      "direction": "lower_is_better",
      "severity": "blocking",
      "status": "PASS",
      "description": "Error enum cast p99 must not exceed 5 ns.",
      "rationale": "Error-path hot loop overhead baseline."
    },
    {
      "id": "GATE-MTN-02",
      "benchmark": "mtn/BM_MTN02_SwitchDispatch",
      "benchmark_file": "benchmarks/maintenance/bench_maintenance_release_gates.cpp",
