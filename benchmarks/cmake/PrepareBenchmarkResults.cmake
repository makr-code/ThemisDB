if(NOT DEFINED RESULTS_DIR OR RESULTS_DIR STREQUAL "")
    message(FATAL_ERROR "PrepareBenchmarkResults.cmake requires RESULTS_DIR")
endif()

if(NOT DEFINED ARCHIVE_DIR OR ARCHIVE_DIR STREQUAL "")
    message(FATAL_ERROR "PrepareBenchmarkResults.cmake requires ARCHIVE_DIR")
endif()

file(MAKE_DIRECTORY "${ARCHIVE_DIR}")
file(LOCK "${ARCHIVE_DIR}/prepare.lock" GUARD PROCESS TIMEOUT 60 RESULT_VARIABLE _lock_result)
if(NOT _lock_result STREQUAL "0")
    message(FATAL_ERROR "Could not lock benchmark result archive: ${_lock_result}")
endif()

if(EXISTS "${RESULTS_DIR}")
    file(GLOB _existing_results "${RESULTS_DIR}/*")
    if(_existing_results)
        string(TIMESTAMP _timestamp "%Y%m%d_%H%M%S" UTC)
        string(RANDOM LENGTH 8 ALPHABET 0123456789abcdef _nonce)
        set(_archive_path "${ARCHIVE_DIR}/ctest_${_timestamp}_${_nonce}")
        file(RENAME "${RESULTS_DIR}" "${_archive_path}" RESULT _rename_result)
        if(NOT _rename_result STREQUAL "0")
            message(FATAL_ERROR "Could not archive previous benchmark results: ${_rename_result}")
        endif()
        message(STATUS "Archived previous benchmark results to ${_archive_path}")
    else()
        file(REMOVE_RECURSE "${RESULTS_DIR}")
    endif()
endif()

file(MAKE_DIRECTORY "${RESULTS_DIR}")
message(STATUS "Prepared clean benchmark result directory ${RESULTS_DIR}")