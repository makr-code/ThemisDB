{
  "dashboard": {
    "title": "ThemisDB Performance Regression Dashboard",
    "tags": ["performance", "benchmarks", "regression"],
    "timezone": "browser",
    "schemaVersion": 27,
    "version": 1,
    "refresh": "5m",
    "panels": [
      {
        "id": 1,
        "title": "Performance Trend - Items per Second",
        "type": "graph",
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "expr": "themisdb_benchmark_items_per_second",
            "legendFormat": "{{benchmark_name}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {
            "format": "ops",
            "label": "Items/sec"
          }
        ],
        "alert": {
          "name": "Performance Regression Alert",
          "conditions": [
            {
              "evaluator": {
                "params": [-10],
                "type": "lt"
              },
              "operator": {
                "type": "and"
              },
              "query": {
                "params": ["A", "5m", "now"]
              },
              "reducer": {
                "params": [],
                "type": "diff_abs"
              },
              "type": "query"
            }
          ],
          "executionErrorState": "alerting",
          "frequency": "5m",
          "handler": 1,
          "message": "Performance regression detected: {{benchmark_name}} dropped by more than 10%",
          "noDataState": "no_data",
          "notifications": []
        }
      },
      {
        "id": 2,
        "title": "Regression Count by Severity",
        "type": "stat",
        "gridPos": {
          "x": 12,
          "y": 0,
          "w": 6,
          "h": 4
        },
        "targets": [
          {
            "expr": "sum(themisdb_regression_count{severity=\"critical\"})",
            "legendFormat": "Critical",
            "refId": "A"
          },
          {
            "expr": "sum(themisdb_regression_count{severity=\"major\"})",
            "legendFormat": "Major",
            "refId": "B"
          },
          {
            "expr": "sum(themisdb_regression_count{severity=\"minor\"})",
            "legendFormat": "Minor",
            "refId": "C"
          }
        ],
        "options": {
          "colorMode": "background",
          "graphMode": "area",
          "justifyMode": "auto",
          "orientation": "auto",
          "reduceOptions": {
            "calcs": ["lastNotNull"],
            "fields": "",
            "values": false
          },
          "text": {},
          "textMode": "auto"
        },
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 1
                },
                {
                  "color": "red",
                  "value": 5
                }
              ]
            }
          }
        }
      },
      {
        "id": 3,
        "title": "Top 10 Regressed Benchmarks",
        "type": "table",
        "gridPos": {
          "x": 0,
          "y": 8,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "expr": "topk(10, themisdb_benchmark_regression_pct < -10)",
            "legendFormat": "{{benchmark_name}}",
            "refId": "A",
            "format": "table"
          }
        ],
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": {
                "Time": true
              },
              "indexByName": {},
              "renameByName": {
                "benchmark_name": "Benchmark",
                "Value": "Regression %"
              }
            }
          }
        ]
      },
      {
        "id": 4,
        "title": "Benchmark Execution Time Trend",
        "type": "graph",
        "gridPos": {
          "x": 12,
          "y": 8,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "expr": "themisdb_benchmark_cpu_time_ms",
            "legendFormat": "{{benchmark_name}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {
            "format": "ms",
            "label": "CPU Time"
          }
        ]
      },
      {
        "id": 5,
        "title": "Release Comparison",
        "type": "graph",
        "gridPos": {
          "x": 0,
          "y": 16,
          "w": 24,
          "h": 8
        },
        "targets": [
          {
            "expr": "themisdb_benchmark_items_per_second{release_tag=~\"v.*\"}",
            "legendFormat": "{{benchmark_name}} - {{release_tag}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {
            "format": "ops",
            "label": "Items/sec"
          }
        ]
      },
      {
        "id": 6,
        "title": "Improvement Count",
        "type": "stat",
        "gridPos": {
          "x": 18,
          "y": 0,
          "w": 6,
          "h": 4
        },
        "targets": [
          {
            "expr": "sum(themisdb_improvement_count)",
            "legendFormat": "Improvements",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "background",
          "graphMode": "area",
          "orientation": "auto",
          "reduceOptions": {
            "calcs": ["lastNotNull"],
            "fields": "",
            "values": false
          }
        },
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "blue",
                  "value": null
                },
                {
                  "color": "green",
                  "value": 5
                }
              ]
            }
          }
        }
      },
      {
        "id": 7,
        "title": "PR Blocks Due to Regressions",
        "type": "stat",
        "gridPos": {
          "x": 18,
          "y": 4,
          "w": 6,
          "h": 4
        },
        "targets": [
          {
            "expr": "sum(increase(themisdb_pr_blocked_total[7d]))",
            "legendFormat": "Blocked PRs (7d)",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "background",
          "graphMode": "none",
          "orientation": "auto",
          "reduceOptions": {
            "calcs": ["lastNotNull"],
            "fields": "",
            "values": false
          }
        },
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 5
                },
                {
                  "color": "red",
                  "value": 10
                }
              ]
            }
          }
        }
      },
      {
        "id": 8,
        "title": "Memory Usage Trend",
        "type": "graph",
        "gridPos": {
          "x": 12,
          "y": 16,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "expr": "themisdb_benchmark_bytes_per_second",
            "legendFormat": "{{benchmark_name}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {
            "format": "Bps",
            "label": "Bytes/sec"
          }
        ]
      }
    ],
    "annotations": {
      "list": [
        {
          "datasource": "-- Grafana --",
          "enable": true,
          "hide": false,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Releases",
          "target": {
            "expr": "themisdb_release_annotation",
            "refId": "A"
          },
          "type": "tags"
        }
      ]
    },
    "templating": {
      "list": [
        {
          "name": "benchmark",
          "type": "query",
          "datasource": "Prometheus",
          "query": "label_values(themisdb_benchmark_items_per_second, benchmark_name)",
          "multi": true,
          "includeAll": true,
          "refresh": 1
        },
        {
          "name": "release",
          "type": "query",
          "datasource": "Prometheus",
          "query": "label_values(themisdb_benchmark_items_per_second, release_tag)",
          "multi": true,
          "includeAll": true,
          "refresh": 1
        }
      ]
    }
  },
  "overwrite": true
}
