# Example .env configuration file for ThemisDB Enterprise Pricing Server

# Application Settings
APP_NAME=ThemisDB Enterprise Pricing Server
VERSION=1.0.0
DEBUG=false

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Database
# SQLite (default for development)
DATABASE_URL=sqlite+aiosqlite:///./pricing_server.db
# PostgreSQL (recommended for production)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/pricing_db
# MySQL
# DATABASE_URL=mysql+aiomysql://user:password@localhost:3306/pricing_db

# Security
# IMPORTANT: Change this in production! Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE-THIS-SECRET-KEY-IN-PRODUCTION-USE-OPENSSL-RAND-HEX-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Payment Provider (Optional - for Stripe integration)
# STRIPE_API_KEY=sk_test_your_stripe_test_key
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Banking Interface (Optional - for direct bank integration)
# BANKING_API_URL=https://api.your-bank.com
# BANKING_API_KEY=your-banking-api-key

# Pricing Configuration (EUR per month)
COMMUNITY_PRICE=0.0
ENTERPRISE_PRICE=5000.0
HYPERSCALER_PRICE=25000.0
RESELLER_PRICE=15000.0
