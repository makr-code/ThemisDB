{
  "version": 6,
  "include": ["CMakePresets.json"],
  "configurePresets": [
    {
      "name": "vscode-windows-release",
      "displayName": "VS Code: Windows MSVC Release (LoRA+Tests)",
      "description": "Uses MSVC with VsDevCmd environment",
      "hidden": false,
      "inherits": "windows-ninja-msvc-release",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl.exe",
        "CMAKE_CXX_COMPILER": "cl.exe",
        "CMAKE_MAKE_PROGRAM": "ninja.exe",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "THEMIS_BUILD_TESTS": "ON",
        "THEMIS_ENABLE_LLM": "ON",
        "THEMIS_ENABLE_GPU": "OFF"
      },
      "environment": {
        "VCPKG_ROOT": "${sourceDir}/vcpkg"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "vscode-windows-release",
      "configurePreset": "vscode-windows-release",
      "targets": ["themis_tests"],
      "jobs": 4
    }
  ],
  "testPresets": [
    {
      "name": "vscode-lora-tests",
      "configurePreset": "vscode-windows-release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
