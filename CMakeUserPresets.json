{
  "version": 6,
  "include": ["CMakePresets.json"],
  "configurePresets": [
    {
      "name": "vscode-windows-release",
      "displayName": "VS Code: Windows Release (Default)",
      "description": "Default VS Code preset - MSVC + Ninja Release with tests and vcpkg",
      "hidden": false,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "inherits": "msvc-ninja-release",
      "cacheVariables": {
        "THEMIS_BUILD_TESTS": "OFF",
        "THEMIS_ENABLE_LLM": "ON",
        "THEMIS_ENABLE_GPU": "OFF",
        "THEMIS_PLUGIN_ETHICS_AI": "ON",
        "THEMIS_DEV_ETHICS_AI_OVERRIDE": "ON",
        "THEMIS_BUILD_ENTERPRISE_PLUGINS": "OFF"
      }
    },
    {
      "name": "vscode-windows-debug",
      "displayName": "VS Code: Windows Debug",
      "description": "VS Code preset for debug builds with vcpkg",
      "hidden": false,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "inherits": "msvc-ninja-debug",
      "cacheVariables": {
        "THEMIS_BUILD_TESTS": "ON",
        "THEMIS_ENABLE_LLM": "ON",
        "THEMIS_ENABLE_GPU": "OFF"
      }
    },
    {
      "name": "hyperscaler-full-build",
      "displayName": "Hyperscaler Edition: Full Build with all Tests & Benchmarks",
      "description": "Complete Hyperscaler build with all enterprise modules, tests, benchmarks, and every feature enabled",
      "hidden": false,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "inherits": "windows-base",
      "binaryDir": "${sourceDir}/build-hyperscaler-full",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "CMAKE_PREFIX_PATH": "${sourceDir}/vcpkg_installed/x64-windows",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed",
        "ZLIB_ROOT": "${sourceDir}/vcpkg_installed/x64-windows",
        "OPENSSL_ROOT_DIR": "${sourceDir}/vcpkg_installed/x64-windows",
        "THEMISDB_CERT_PATH": "${sourceDir}/certs/test/test-plugin-signer.crt",
        "THEMISDB_KEY_PATH": "${sourceDir}/certs/test/test-plugin-signer.key",
        "THEMISDB_CA_CERT_PATH": "${sourceDir}/certs/test/test-ca.crt",
        "THEMIS_LICENSE_FILE": "${sourceDir}/certs/hyperscaler/license_test.json",
        "THEMIS_EDITION": "HYPERSCALER",
        "THEMIS_BUILD_TESTS": "ON",
        "THEMIS_BUILD_BENCHMARKS": "ON",
        "THEMIS_BUILD_CHIMERA": "ON",
        "THEMIS_BUILD_MODULAR": "ON",
        "THEMIS_ENABLE_LLM": "ON",
        "THEMIS_ENABLE_GPU": "ON",
        "THEMIS_ENABLE_HTTP_SERVER": "ON",
        "THEMIS_ENABLE_GRPC": "ON",
        "THEMIS_ENABLE_TRACING": "ON",
        "THEMIS_ENABLE_DISTRIBUTED_TRAINING": "ON",
        "THEMIS_ENABLE_CYCLE_METRICS": "ON",
        "THEMIS_BUILD_ENTERPRISE_PLUGINS": "ON"
      }
    },
    {
      "name": "vscode-wsl-release",
      "displayName": "VS Code: WSL Release (Linux/GCC)",
      "description": "WSL/Linux Release build with GCC+Ninja — mirrors Docker production environment, no MSVC dependencies",
      "hidden": false,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "inherits": "linux-base",
      "environment": {
        "VCPKG_POWERSHELL_PATH": "",
        "Z_VCPKG_POWERSHELL_PATH": "",
        "Z_VCPKG_PWSH_PATH": ""
      },
      "binaryDir": "${sourceDir}/build-wsl-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "THEMIS_EDITION": "COMMUNITY",
        "THEMIS_BUILD_TESTS": "OFF",
        "THEMIS_ENABLE_LLM": "ON",
        "THEMIS_ENABLE_GPU": "OFF",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed_linux"
      }
    },
    {
      "name": "vscode-wsl-bench",
      "displayName": "VS Code: WSL Benchmark (Linux/GCC perf)",
      "description": "WSL/Linux Performance build — -O3 Release, benchmarks only, no tests, mirrors linux-ninja-perf",
      "hidden": false,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "inherits": "linux-ninja-perf",
      "environment": {
        "VCPKG_POWERSHELL_PATH": "",
        "Z_VCPKG_POWERSHELL_PATH": "",
        "Z_VCPKG_PWSH_PATH": ""
      },
      "binaryDir": "${sourceDir}/build-wsl-bench",
      "cacheVariables": {
        "THEMIS_EDITION": "COMMUNITY",
        "THEMIS_BUILD_TESTS": "OFF",
        "THEMIS_BUILD_BENCHMARKS": "ON",
        "THEMIS_BUILD_CHIMERA": "ON",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed_linux"
      }
    },
    {
      "name": "vscode-wsl-debug",
      "displayName": "VS Code: WSL Debug (Linux/GCC)",
      "description": "WSL/Linux Debug build with GCC+Ninja — mirrors Docker production environment, no MSVC dependencies",
      "hidden": false,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "inherits": "linux-base",
      "environment": {
        "VCPKG_POWERSHELL_PATH": "",
        "Z_VCPKG_POWERSHELL_PATH": "",
        "Z_VCPKG_PWSH_PATH": ""
      },
      "binaryDir": "${sourceDir}/build-wsl-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "THEMIS_EDITION": "COMMUNITY",
        "THEMIS_BUILD_TESTS": "ON",
        "THEMIS_ENABLE_LLM": "ON",
        "THEMIS_ENABLE_GPU": "OFF",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed_linux"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "vscode-windows-release",
      "configurePreset": "vscode-windows-release",
      "targets": ["themis_server"],
      "jobs": 8
    },
    {
      "name": "vscode-windows-debug",
      "configurePreset": "vscode-windows-debug",
      "targets": ["themis_tests"],
      "jobs": 2
    },
    {
      "name": "graph-tests-debug",
      "displayName": "Graph Tests: Debug (focused)",
      "description": "Debug build of graph and GraphQL test executables",
      "configurePreset": "vscode-windows-debug",
      "targets": [
        "test_graph_distributed",
        "test_graph_distributed_shared_mutex_focused",
        "test_graphql",
        "test_graphql_performance",
        "test_graphql_limits",
        "test_graphql_error_masking",
        "test_graphql_p1_features",
        "test_graphql_multimodel",
        "test_graphql_cache_security"
      ],
      "jobs": 1
    },
    {
      "name": "graph-tests-release",
      "displayName": "Graph Tests: Release (focused)",
      "description": "Release build of graph and GraphQL test executables",
      "configurePreset": "vscode-windows-release",
      "targets": [
        "test_graph_distributed",
        "test_graph_distributed_shared_mutex_focused",
        "test_graphql",
        "test_graphql_performance",
        "test_graphql_limits",
        "test_graphql_error_masking",
        "test_graphql_p1_features",
        "test_graphql_multimodel",
        "test_graphql_cache_security"
      ],
      "jobs": 8
    },
    {
      "name": "cache-tests-release",
      "displayName": "Cache Tests: Release (focused)",
      "description": "Release build of cache-related test executables only",
      "configurePreset": "vscode-windows-release",
      "targets": [
        "test_enhanced_query_cache",
        "test_cache_admin_api_handler",
        "test_cache_warmup",
        "test_cache_replication",
        "test_cache_replication_coordinator",
        "test_cache_interfaces"
      ],
      "jobs": 8
    },
    {
      "name": "cdc-tests-release",
      "displayName": "CDC Tests: Release (focused)",
      "description": "Release build of CDC-related test executables only",
      "configurePreset": "vscode-windows-release",
      "targets": [
        "test_cdc_admin",
        "test_cdc_retention",
        "test_cdc_changefeed_sequence_counter",
        "test_cdc_changefeed_core_focused",
        "test_cdc_ws_handler",
        "test_cdc_consumer_group",
        "test_cdc_pause_control",
        "test_cdc_backpressure_signal",
        "test_cdc_fan_in",
        "test_cdc_event_schema",
        "test_cdc_delivery_guarantee_config"
      ],
      "jobs": 8
    },
    {
      "name": "transaction-tests-release",
      "displayName": "Transaction Tests: Release (focused)",
      "description": "Release build of transaction-related test executables only",
      "configurePreset": "vscode-windows-release",
      "targets": [
        "test_transaction_manager_comprehensive",
        "test_transaction_occ",
        "test_transaction_bulk",
        "test_transaction_retry",
        "test_transaction_timeout",
        "test_transaction_isolation",
        "test_transaction_ssi",
        "test_transaction_batcher_focused",
        "test_transaction_auditor_focused",
        "test_transaction_manager_focused",
        "test_transaction_distributed_2pc_focused",
        "test_transaction_isolation_levels_focused"
      ],
      "jobs": 8
    },
    {
      "name": "replication-tests-release",
      "displayName": "Replication Tests: Release (focused)",
      "description": "Release build of replication-related test executables only",
      "configurePreset": "vscode-windows-release",
      "targets": [
        "test_replication_ha_focused",
        "test_replication_new_features_focused",
        "test_replication_ha",
        "test_replication_new_features",
        "test_replication_topology_api_handler",
        "test_replication_raft_v2",
        "test_replication_crdt_types"
      ],
      "jobs": 8
    },
    {
      "name": "main-tests-release",
      "displayName": "Main Tests: Release (aggregated)",
      "description": "Release build aggregating the focused graph, cache, CDC, transaction, and replication test executables",
      "configurePreset": "vscode-windows-release",
      "targets": [
        "test_graph_distributed",
        "test_graph_distributed_shared_mutex_focused",
        "test_enhanced_query_cache",
        "test_cache_admin_api_handler",
        "test_cache_warmup",
        "test_cache_replication",
        "test_cache_replication_coordinator",
        "test_cache_interfaces",
        "test_cdc_admin",
        "test_cdc_retention",
        "test_cdc_changefeed_sequence_counter",
        "test_cdc_changefeed_core_focused",
        "test_cdc_ws_handler",
        "test_cdc_consumer_group",
        "test_cdc_pause_control",
        "test_cdc_backpressure_signal",
        "test_cdc_fan_in",
        "test_cdc_event_schema",
        "test_cdc_delivery_guarantee_config",
        "test_transaction_manager_comprehensive",
        "test_transaction_occ",
        "test_transaction_bulk",
        "test_transaction_retry",
        "test_transaction_timeout",
        "test_transaction_isolation",
        "test_transaction_ssi",
        "test_transaction_batcher_focused",
        "test_transaction_auditor_focused",
        "test_transaction_manager_focused",
        "test_transaction_distributed_2pc_focused",
        "test_transaction_isolation_levels_focused",
        "test_replication_ha_focused",
        "test_replication_new_features_focused",
        "test_replication_ha",
        "test_replication_new_features",
        "test_replication_topology_api_handler",
        "test_replication_raft_v2",
        "test_replication_crdt_types"
      ],
      "jobs": 8
    },
    {
      "name": "hyperscaler-full-build",
      "configurePreset": "hyperscaler-full-build",
      "targets": [],
      "jobs": 8
    },
    {
      "name": "vscode-wsl-release",
      "displayName": "Build: WSL Release (Linux/GCC)",
      "configurePreset": "vscode-wsl-release",
      "targets": ["themis_server"],
      "jobs": 8
    },
    {
      "name": "vscode-wsl-debug",
      "displayName": "Build: WSL Debug (Linux/GCC)",
      "configurePreset": "vscode-wsl-debug",
      "targets": ["themis_tests"],
      "jobs": 4
    },
    {
      "name": "vscode-wsl-bench",
      "displayName": "Build: WSL Benchmark (Linux/GCC perf)",
      "configurePreset": "vscode-wsl-bench",
      "targets": [
        "bench_storage_performance",
        "bench_vector_search",
        "bench_graph_traversal",
        "bench_graph_query_optimizer",
        "bench_metrics_collector"
      ],
      "jobs": 8
    }
  ],
  "testPresets": [
    {
      "name": "vscode-lora-tests",
      "displayName": "VS Code: LoRA Tests",
      "configurePreset": "vscode-windows-release",
      "environment": {
        "PATH": "${sourceDir}/build-msvc-ninja-release/bin${pathListSep}${sourceDir}/build-msvc-ninja-release/vcpkg_installed/x64-windows/bin${pathListSep}$penv{PATH}"
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "vscode-gpu-tests",
      "displayName": "VS Code: GPU Tests",
      "configurePreset": "vscode-windows-release",
      "environment": {
        "PATH": "${sourceDir}/build-msvc-ninja-release/bin${pathListSep}${sourceDir}/build-msvc-ninja-release/vcpkg_installed/x64-windows/bin${pathListSep}$penv{PATH}"
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "graph-tests-debug",
      "displayName": "Graph Tests: Debug",
      "configurePreset": "vscode-windows-debug",
      "environment": {
        "PATH": "${sourceDir}/build-msvc-ninja-debug/bin${pathListSep}${sourceDir}/build-msvc-ninja-debug/vcpkg_installed/x64-windows/bin${pathListSep}$penv{PATH}"
      },
      "filter": {
        "include": {
          "name": "^(DistributedGraphTests|DistributedGraphSharedMutexFocusedTests|GraphQLParserTests|GraphQLPerformanceTests|GraphQLLimitsTests|GraphQLErrorMaskingTests|GraphQLP1FeatureTests|GraphQLMultiModelTests|GraphQLCacheSecurityTests)$"
        }
      },
      "output": {
        "outputOnFailure": true,
        "verbosity": "verbose"
      }
    },
    {
      "name": "graph-tests-release",
      "displayName": "Graph Tests: Release",
      "configurePreset": "vscode-windows-release",
      "environment": {
        "PATH": "${sourceDir}/build-msvc-ninja-release/bin${pathListSep}${sourceDir}/build-msvc-ninja-release/vcpkg_installed/x64-windows/bin${pathListSep}$penv{PATH}"
      },
      "filter": {
        "include": {
          "name": "^(DistributedGraphTests|DistributedGraphSharedMutexFocusedTests|GraphQLParserTests|GraphQLPerformanceTests|GraphQLLimitsTests|GraphQLErrorMaskingTests|GraphQLP1FeatureTests|GraphQLMultiModelTests|GraphQLCacheSecurityTests)$"
        }
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "cache-tests-release",
      "displayName": "Cache Tests: Release",
      "configurePreset": "vscode-windows-release",
      "environment": {
        "PATH": "${sourceDir}/build-msvc-ninja-release/bin${pathListSep}${sourceDir}/build-msvc-ninja-release/vcpkg_installed/x64-windows/bin${pathListSep}$penv{PATH}"
      },
      "filter": {
        "include": {
          "name": "^(EnhancedQueryCacheTests|CacheAdminApiHandlerTests|CacheWarmupTests|CacheReplicationTests|CacheReplicationCoordinatorTests|CacheInterfacesTests)$"
        }
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "cdc-tests-release",
      "displayName": "CDC Tests: Release",
      "configurePreset": "vscode-windows-release",
      "environment": {
        "PATH": "${sourceDir}/build-msvc-ninja-release/bin${pathListSep}${sourceDir}/build-msvc-ninja-release/vcpkg_installed/x64-windows/bin${pathListSep}$penv{PATH}"
      },
      "filter": {
        "include": {
          "name": "^(CDCAdminFocusedTests|CDCRetentionFocusedTests|CDCChangefeedSequenceCounterTests|ChangefeedCoreFocusedTests|CdcWsHandlerFocusedTests|ConsumerGroupFocusedTests|CDCPauseControlFocusedTests|CDCBackpressureSignalFocusedTests|CDCFanInFocusedTests|CDCEventSchemaFocusedTests|CDCDeliveryGuaranteeConfigFocusedTests)$"
        }
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "transaction-tests-release",
      "displayName": "Transaction Tests: Release",
      "configurePreset": "vscode-windows-release",
      "environment": {
        "PATH": "${sourceDir}/build-msvc-ninja-release/bin${pathListSep}${sourceDir}/build-msvc-ninja-release/vcpkg_installed/x64-windows/bin${pathListSep}$penv{PATH}"
      },
      "filter": {
        "include": {
          "name": "^(TransactionManagerComprehensiveTests|TransactionOccTests|TransactionBulkTests|TransactionRetryTests|TransactionTimeoutTests|TransactionIsolationTests|TransactionSSITests|TransactionBatcherFocusedTests|TransactionAuditorFocusedTests|TransactionManagerFocusedTests|TransactionDistributed2PCFocusedTests|TransactionIsolationLevelsFocusedTests)$"
        }
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "replication-tests-release",
      "displayName": "Replication Tests: Release",
      "configurePreset": "vscode-windows-release",
      "environment": {
        "PATH": "${sourceDir}/build-msvc-ninja-release/bin${pathListSep}${sourceDir}/build-msvc-ninja-release/vcpkg_installed/x64-windows/bin${pathListSep}$penv{PATH}"
      },
      "filter": {
        "include": {
          "name": "^(ReplicationHAFocusedTests|ReplicationNewFeaturesFocusedTests|ReplicationHATests|ReplicationNewFeaturesTests|ReplicationTopologyAPITests|ReplicationRaftV2Tests|ReplicationCRDTTypesTests)$"
        }
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "main-tests-release",
      "displayName": "Main Tests: Release",
      "configurePreset": "vscode-windows-release",
      "environment": {
        "PATH": "${sourceDir}/build-msvc-ninja-release/bin${pathListSep}${sourceDir}/build-msvc-ninja-release/vcpkg_installed/x64-windows/bin${pathListSep}$penv{PATH}"
      },
      "filter": {
        "include": {
          "name": "^(DistributedGraphTests|DistributedGraphSharedMutexFocusedTests|GraphQLParserTests|GraphQLPerformanceTests|GraphQLLimitsTests|GraphQLErrorMaskingTests|GraphQLP1FeatureTests|GraphQLMultiModelTests|GraphQLCacheSecurityTests|EnhancedQueryCacheTests|CacheAdminApiHandlerTests|CacheWarmupTests|CacheReplicationTests|CacheReplicationCoordinatorTests|CacheInterfacesTests|CDCAdminFocusedTests|CDCRetentionFocusedTests|CDCChangefeedSequenceCounterTests|ChangefeedCoreFocusedTests|CdcWsHandlerFocusedTests|ConsumerGroupFocusedTests|CDCPauseControlFocusedTests|CDCBackpressureSignalFocusedTests|CDCFanInFocusedTests|CDCEventSchemaFocusedTests|CDCDeliveryGuaranteeConfigFocusedTests|TransactionManagerComprehensiveTests|TransactionOccTests|TransactionBulkTests|TransactionRetryTests|TransactionTimeoutTests|TransactionIsolationTests|TransactionSSITests|TransactionBatcherFocusedTests|TransactionAuditorFocusedTests|TransactionManagerFocusedTests|TransactionDistributed2PCFocusedTests|TransactionIsolationLevelsFocusedTests|ReplicationHAFocusedTests|ReplicationNewFeaturesFocusedTests|ReplicationHATests|ReplicationNewFeaturesTests|ReplicationTopologyAPITests|ReplicationRaftV2Tests|ReplicationCRDTTypesTests)$"
        }
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "vscode-wsl-release",
      "displayName": "VS Code: WSL Release Tests (Linux/GCC)",
      "configurePreset": "vscode-wsl-release",
      "environment": {
        "LD_LIBRARY_PATH": "${sourceDir}/build-wsl-release/lib:${sourceDir}/build-wsl-release/bin:$penv{LD_LIBRARY_PATH}"
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "vscode-wsl-debug",
      "displayName": "VS Code: WSL Debug Tests (Linux/GCC)",
      "configurePreset": "vscode-wsl-debug",
      "environment": {
        "LD_LIBRARY_PATH": "${sourceDir}/build-wsl-debug/lib:${sourceDir}/build-wsl-debug/bin:$penv{LD_LIBRARY_PATH}"
      },
      "output": {
        "outputOnFailure": true,
        "verbosity": "verbose"
      }
    }
  ]
}

