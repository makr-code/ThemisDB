# Git Attributes - File handling and normalization

# Auto detect text files and normalize line endings to LF
* text=auto

# Source code
*.h text eol=lf
*.hpp text eol=lf
*.cpp text eol=lf
*.c text eol=lf
*.py text eol=lf
*.ps1 text eol=crlf
*.sh text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.xml text eol=lf
*.toml text eol=lf

# Binary files
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.lib binary
*.a binary
*.o binary
*.obj binary

# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.svg binary

# Archives
*.zip binary
*.tar.gz binary
*.rar binary
*.7z binary

# Databases
*.db binary
*.sst binary
*.ldb binary

# Large file protection - prevent accidental commits of large test data
# These patterns work in conjunction with .gitignore
*.test.db binary
testdata*.json binary
test_data*.json binary
benchmark_results/*.json binary

# CMake files
CMakeLists.txt text eol=lf
*.cmake text eol=lf
vcpkg.json text eol=lf

# --- Merge strategy guards ---------------------------------------------------
# Keep main restricted to Minimal/Community when merging from develop.
# These patterns force merges to prefer the current branch version (ours),
# preventing sensitive or non-public assets from landing on main.
src/enterprise/** merge=ours
include/enterprise/** merge=ours
plugins/enterprise/** merge=ours
docs/enterprise/** merge=ours
docs/en/confidential/** merge=ours
docs/de/confidencial/** merge=ours
internal/** merge=ours
wordpress-plugin/** merge=ours
wordpress-theme/** merge=ours
epServer/** merge=ours
examples/gpu_impact_analysis/** merge=ours
tests/test_enterprise_*.cpp merge=ours
tests/test_gpu_impact_analysis_plugin.cpp merge=ours
benchmarks/bench_gpu_impact_analysis.cpp merge=ours
benchmarks/run_enterprise_benchmarks.py merge=ours
