{
  "id": null,
  "uid": "themis-raid",
  "title": "Themis RAID Benchmark",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "tags": ["themis", "raid", "benchmark"],
  "style": "dark",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "title": "Cluster Size",
      "type": "stat",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "themis_cluster_size",
          "legendFormat": "shards",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area"
      },
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 0}
    },
    {
      "id": 2,
      "title": "Migration Progress % (max)",
      "type": "gauge",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "max(themis_migration_progress_percent)",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "fieldOptions": {
          "defaults": {"min": 0, "max": 100, "unit": "percent", "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "orange", "value": 30}, {"color": "yellow", "value": 60}, {"color": "green", "value": 90}]}}
        }
      },
      "gridPos": {"h": 6, "w": 8, "x": 8, "y": 0}
    },
    {
      "id": 3,
      "title": "Routing Requests /s by Type",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "sum by (type)(rate(themis_routing_requests_total[$__rate_interval]))",
          "legendFormat": "{{type}}",
          "refId": "A"
        }
      ],
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0}
    },
    {
      "id": 4,
      "title": "Routing Errors /s",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "sum by (error_type)(rate(themis_routing_errors_total[$__rate_interval]))",
          "legendFormat": "{{error_type}}",
          "refId": "A"
        }
      ],
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 6}
    },
    {
      "id": 5,
      "title": "Routing Latency (p50/p95/p99)",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {"expr": "themis_routing_latency_seconds{quantile=\"0.5\"}", "legendFormat": "p50", "refId": "A"},
        {"expr": "themis_routing_latency_seconds{quantile=\"0.95\"}", "legendFormat": "p95", "refId": "B"},
        {"expr": "themis_routing_latency_seconds{quantile=\"0.99\"}", "legendFormat": "p99", "refId": "C"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 6}
    },
    {
      "id": 6,
      "title": "Gossip RTT (p50/p95/p99)",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {"expr": "themis_gossip_roundtrip_seconds{quantile=\"0.5\"}", "legendFormat": "p50", "refId": "A"},
        {"expr": "themis_gossip_roundtrip_seconds{quantile=\"0.95\"}", "legendFormat": "p95", "refId": "B"},
        {"expr": "themis_gossip_roundtrip_seconds{quantile=\"0.99\"}", "legendFormat": "p99", "refId": "C"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 6}
    },
    {
      "id": 7,
      "title": "Gossip Peer Count",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {"expr": "themis_gossip_peer_count", "legendFormat": "peers", "refId": "A"}
      ],
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 14}
    },
    {
      "id": 8,
      "title": "Cross-Shard Joins /s",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {"expr": "sum by (strategy)(rate(themis_cross_shard_joins_total[$__rate_interval]))", "legendFormat": "{{strategy}}", "refId": "A"}
      ],
      "gridPos": {"h": 6, "w": 8, "x": 8, "y": 14}
    },
    {
      "id": 9,
      "title": "Cross-Shard Join Duration (p95)",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {"expr": "themis_cross_shard_join_duration_seconds{quantile=\"0.95\"}", "legendFormat": "p95", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}},
      "gridPos": {"h": 6, "w": 8, "x": 16, "y": 14}
    },
    {
      "id": 10,
      "title": "Content Processor Errors /s",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {"expr": "sum by (type, error)(rate(themis_content_processor_errors_total[$__rate_interval]))", "legendFormat": "{{type}} {{error}}", "refId": "A"}
      ],
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 20}
    },
    {
      "id": 11,
      "title": "Metadata Store Latency (p95)",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {"expr": "themis_metadata_store_latency_seconds{quantile=\"0.95\"}", "legendFormat": "p95", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}},
      "gridPos": {"h": 6, "w": 8, "x": 8, "y": 20}
    },
    {
      "id": 12,
      "title": "Health Check Results /s",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {"expr": "sum by (type, result)(rate(themis_health_check_results_total[$__rate_interval]))", "legendFormat": "{{type}} {{result}}", "refId": "A"}
      ],
      "gridPos": {"h": 6, "w": 8, "x": 16, "y": 20}
    },
    {
      "id": 13,
      "title": "Datacenter Latency (p95)",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {"expr": "themis_datacenter_latency_seconds{quantile=\"0.95\"}", "legendFormat": "p95", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}},
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 26}
    },
    {
      "id": 14,
      "title": "Routing Requests by Shard",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "sum by (shard_id)(rate(themis_routing_requests_total{shard_id=~\"$shard\"}[$__rate_interval]))",
          "legendFormat": "{{shard_id}}",
          "refId": "A"
        }
      ],
      "gridPos": {"h": 6, "w": 16, "x": 8, "y": 26}
    }
  ],
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "DS_PROMETHEUS",
        "label": "Prometheus",
        "query": "prometheus",
        "refresh": 1
      },
      {
        "type": "query",
        "name": "shard",
        "label": "Shard",
        "datasource": "${DS_PROMETHEUS}",
        "query": "label_values(themis_routing_requests_total, shard_id)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*"
      }
    ]
  },
  "time": {"from": "now-15m", "to": "now"},
  "timepicker": {"refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m"]},
  "annotations": {"list": []},
  "links": []
}
