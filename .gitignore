# --- Repository-wide ignores (best-practice) ------------------------------

# Build directories (CMake, Ninja, MSVC, other build outputs)
/build/
/build-*/
/out/
/bin/
/lib/
*/CMakeFiles/
CMakeCache.txt
cmake_install.cmake
CTestTestfile.cmake
Makefile
*.cmake

# vcpkg (local installs - 163k+ files!)
vcpkg_installed/
.vcpkg/
vcpkg/
packages/
downloads/
buildtrees/

# Distribution artifacts (not needed in repo)
dist/
*.tar.gz
*.zip
*.deb
*.rpm

# IDE / editor
.idea/
.vscode/
.vs/
*.suo
*.user
*.sln
*.vcxproj*
*.vcxproj.filters

# JetBrains project files
/.idea/

# OS files
.DS_Store
Thumbs.db

# Temporary / swap files
*~
*.swp
*.swo
*.tmp
*.temp

# Compiled object files / libraries / executables
*.o
*.obj
*.a
*.lib
*.so
*.dll
*.exe
*.pdb
*.ilk

# Logs and runtime files
logs/
*.log
server.pid
server.err
server.out
server_err.log
server_out.log
themis_server.log
vccdb.log
vccdb_server.log
testsserver_start.log
build_log.txt
build_final.txt
build_output.log
docker-build.log
docker_build.log
docker_build_*.log
tidy_full.log

# Local data directories (development/testing only)
data/
test_geo_integration_db/
Testing/

# Temporary test/development files
tmp_*.json
body.json
test_output*.txt
test_*.txt
CTempmetrics_from_test.txt
diff_aql.txt
geo-aql-todo
test_geo_integration_db/

# Test outputs and integration scripts (moved to tests/)
tests/outputs/
tests/integration-scripts/*.ps1
tests/standalone/test_*.cpp

# Documentation build output
docs/_build/
docs/html/
docs/latex/

# Test / coverage / profiling
.pytest_cache/
coverage/
*.gcov
*.gcda
*.gcno
*.prof
perf.data*

# Python virtualenvs / packaging
venv/
.venv/
env/
ENV/
pip-wheel-metadata/
*.egg-info/
dist/
build/
__pycache__/
*.py[cod]

# Node / JS
node_modules/
npm-debug.log*
yarn-error.log*

# Documentation build artifacts
site/
wiki-temp/
wiki/
*.wiki/

# Docker / containers
docker-compose.override.yml

# RocksDB / DB artifacts and local test data
*.db
*.sst
rocksdb/

# Jaeger artifacts
tools/jaeger/*.zip
tools/jaeger/

# Rust / Cargo (if present)
**/target/
target/

# Allow CMakeLists (explicitly)
!CMakeLists.txt

# GitHub Actions local testing secrets (never commit)
.github/act-secrets

# End of .gitignore

# Additional ignores for generated build artifacts and logs applied during stash restore
dist/
dist/**
docker-qnap-build-*.log.err
themis_server_qnap
tmp_*.json
tools/*/obj/
tools/*/bin/
**/obj/
**/bin/
tools/**/PublishOutputs.*
