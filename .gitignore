# --- Repository-wide ignores (best-practice) ------------------------------

# Build directories (CMake, Ninja, MSVC, other build outputs)
/build/
/build-*/
/out/
/bin/
/lib/
*/CMakeFiles/
CMakeCache.txt
cmake_install.cmake
CTestTestfile.cmake
Makefile
*.cmake

# vcpkg - Offline-First Strategy (v4.0.0)
# Keep: vcpkg/downloads/ (~2.5 GB source archives for offline builds)
# Ignore: build artifacts and installed packages (~15 GB)
vcpkg_installed/
vcpkg/buildtrees/
vcpkg/packages/
vcpkg/installed/
.vcpkg/

# IMPORTANT: vcpkg/downloads/ is NOT ignored (needed for offline builds)
# Exception managed via: !vcpkg/downloads/

# Distribution artifacts (not needed in repo)
dist/
*.tar.gz

# Release packages (allow in release/ directory)
*.zip
*.deb
*.rpm
!release/*.zip
!release/*.deb
!release/*.rpm
!release/**/*.zip
!release/**/*.deb
!release/**/*.rpm

# Exclude pre-created runtime directories in release packages
release/**/data/
release/**/logs/
release/**/cache/
release/**/plugins/
release/**/backups/
release/**/temp/
!release/**/data/.gitkeep
!release/**/logs/.gitkeep
!release/**/cache/.gitkeep
!release/**/plugins/.gitkeep
!release/**/backups/.gitkeep
!release/**/temp/.gitkeep

# IDE / editor
.idea/
.vscode/
.vs/
*.suo
*.user
*.sln
*.vcxproj*
*.vcxproj.filters

# JetBrains project files
/.idea/

# OS files
.DS_Store
Thumbs.db

# Temporary / swap files
*~
*.swp
*.swo
*.tmp
*.temp

# Compiled object files / libraries / executables
*.o
*.obj
*.a
*.lib
*.so
*.dll
*.exe
*.pdb
*.ilk

# Docker build artifacts
.docker/
docker/tmp/

# Local LLM source (ignored; use root clone at ./llama.cpp)
llama.cpp/

# Logs and runtime files
logs/
*.log
*.pid
*.err
*.out

# Build logs (alle Varianten)
build*.log
build*.txt
docker-build*.log
docker_build*.log
msbuild*.txt
msvc_build*.txt
cmake*.log
vcpkg*.log
tidy*.log

# Local data directories (development/testing only)
data/
test_geo_integration_db/
Testing/

# Temporary test/development files
tmp_*.json
body.json
test_output*.txt
test_*.txt
CTempmetrics_from_test.txt
diff_aql.txt
geo-aql-todo

# Test outputs and integration scripts (moved to tests/)
tests/outputs/
tests/integration-scripts/*.ps1
tests/standalone/test_*.cpp

# Documentation build output
docs/_build/
docs/html/
docs/latex/
site/
!docker/README.md
!docker/CHANGELOG.md
!docker/ROADMAP.md

# Test / coverage / profiling
.pytest_cache/
coverage/
*.gcov
*.gcda
*.gcno
*.prof
perf.data*

# Python virtualenvs / packaging
venv/
.venv/
env/
ENV/
pip-wheel-metadata/
*.egg-info/
build/
__pycache__/
*.py[cod]

# Node / JS
node_modules/
npm-debug.log*
yarn-error.log*

# Documentation build artifacts
wiki-temp/
wiki/
*.wiki/

# Docker / containers
docker-compose.override.yml

# GitHub Actions local testing secrets (never commit act secrets)
.github/act-secrets

# RocksDB / DB artifacts and local test data
*.db
*.sst
rocksdb/

# Jaeger artifacts
tools/jaeger/*.zip
tools/jaeger/

# Rust / Cargo (if present)
**/target/
target/

# Allow CMakeLists (explicitly)
!CMakeLists.txt

# vcpkg offline cache exception (WICHTIG für offline builds!)
!vcpkg/
!vcpkg/downloads/
!vcpkg/downloads/**
!vcpkg/scripts/
!vcpkg/scripts/**
!vcpkg/.vcpkg-root
!vcpkg/bootstrap-vcpkg.sh
!vcpkg/bootstrap-vcpkg.bat
!vcpkg/vcpkg
!vcpkg/vcpkg.exe

# Build tool outputs
tools/*/obj/
tools/*/bin/
**/obj/
**/bin/
tools/**/PublishOutputs.*

# End of .gitignore
 
# Local LLM source (not tracked)
llama.cpp/
