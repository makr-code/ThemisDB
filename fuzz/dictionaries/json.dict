# AFL++ Dictionary for JSON
# Basic syntax
"{"
"}"
"["
"]"
":"
","

# Values
"null"
"true"
"false"

# Strings
"\"\""
"\"a\""
"\"test\""
"\"key\""
"\"value\""
"\"name\""
"\"id\""
"\"data\""
"\"type\""
"\"items\""

# Numbers
"0"
"1"
"-1"
"0.0"
"0.5"
"-0.5"
"1e10"
"1E10"
"1e-10"
"1E-10"
"1.5e10"
"-1.5e-10"
"2147483647"
"-2147483648"
"9007199254740991"
"-9007199254740991"
"1.7976931348623157e+308"
"2.2250738585072014e-308"

# Escape sequences
"\\\""
"\\\\"
"\\/"
"\\b"
"\\f"
"\\n"
"\\r"
"\\t"
"\\u0000"
"\\u0020"
"\\u00ff"
"\\uFFFF"
"\\uD800"
"\\uDC00"
"\\uD800\\uDC00"

# Edge cases
"{}"
"[]"
"[{}]"
"{[]}"
"[[]]"
"{{}}"
"[null]"
"[true]"
"[false]"
"[0]"
"[\"\"]"

# Nested structures
"{\"a\":{}}"
"{\"a\":[]}"
"{\"a\":{\"b\":{}}}"
"[{},{},{}]"
"[[[]]]"
"{\"a\":[1,2,3]}"
"[{\"a\":1},{\"b\":2}]"

# Whitespace variations
" {"
"{ "
"{ }"
"\t{"
"\n{"
"\r\n{"
"{\n}"
"[\n]"
