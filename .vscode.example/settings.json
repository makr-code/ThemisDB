{
  "files.associations": {
    "*.aql": "sql",
    "*.proto": "proto3",
    "CMakeLists.txt": "cmake",
    "*.cmake": "cmake"
  },
  "files.exclude": {
    "**/build": true,
    "**/build-*": true,
    "**/.cmake": true,
    "**/vcpkg_installed": true,
    "**/node_modules": true
  },
  "search.exclude": {
    "**/build": true,
    "**/build-*": true,
    "**/vcpkg_installed": true,
    "**/node_modules": true,
    "**/.git": true
  },
  "editor.formatOnSave": true,
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "editor.rulers": [
    100,
    120
  ],
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.encoding": "utf8",
  "cmake.configureOnOpen": true,
  "cmake.buildDirectory": "${workspaceFolder}/build/linux-debug",
  "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
  "C_Cpp.default.cppStandard": "c++20",
  "C_Cpp.default.cStandard": "c17",
  "C_Cpp.clang_format_fallbackStyle": "LLVM",
  "C_Cpp.enableCppCodeEditingTools": true,
  "github.copilot.chat.codeGeneration.useInstructionFiles": true,
  "github.copilot.chat.localeOverride": "de",
  "[cpp]": {
    "editor.defaultFormatter": "ms-vscode.cpptools",
    "editor.formatOnSave": true
  },
  "[c]": {
    "editor.defaultFormatter": "ms-vscode.cpptools",
    "editor.formatOnSave": true
  },
  "[markdown]": {
    "editor.wordWrap": "on",
    "editor.rulers": [
      80
    ],
    "files.trimTrailingWhitespace": false
  },
  "[yaml]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true
  },
  "[json]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true
  },
  "markdown.validate.enabled": true,
  "markdown.validate.fileLinks.enabled": "warning",
  "markdown.validate.fragmentLinks.enabled": "warning",
  "markdown.validate.referenceLinks.enabled": "warning",
  "git.ignoreLimitWarning": true,
  "C_Cpp.codeAnalysis.runAutomatically": true,
  "github.copilot.chat.scope": "workspace",
  "C_Cpp.intelliSenseEngine": "default"
}
