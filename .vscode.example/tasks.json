{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cmake-configure",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-B",
        "build",
        "-S",
        ".",
        "-DCMAKE_BUILD_TYPE=Debug"
      ],
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "cmake-build-debug",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "build",
        "--config",
        "Debug",
        "--target",
        "themis_server"
      ],
      "dependsOn": ["cmake-configure"],
      "problemMatcher": ["$gcc"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "cmake-build-tests",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "build",
        "--config",
        "Debug",
        "--target",
        "themis_tests"
      ],
      "dependsOn": ["cmake-configure"],
      "problemMatcher": ["$gcc"],
      "group": "build"
    },
    {
      "label": "run-tests",
      "type": "shell",
      "command": "./build/tests/themis_tests",
      "dependsOn": ["cmake-build-tests"],
      "problemMatcher": [],
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "clean",
      "type": "shell",
      "command": "rm",
      "args": ["-rf", "build"],
      "problemMatcher": [],
      "group": "build"
    }
  ]
}
