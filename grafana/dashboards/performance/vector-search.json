        "name": "instance",
        "options": [],
        "query": { "query": "label_values(themis_vector_search_duration_seconds_bucket, instance)", "refId": "StandardVariableQuery" },
        "refresh": 2,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-3h", "to": "now" },
