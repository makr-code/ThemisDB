      "title": "Tensor Op Throughput",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "rate(themis_tensor_ops_total{instance=~\"$instance\"}[1m])",
