# Copy this file to .secrets (gitignored) and fill in real values.
# .secrets is read by act via --secret-file (configured in .actrc).

# GitHub token with repo scope (needed by gh CLI in repair-github workflow)
GITHUB_TOKEN=ghp_...

# DockerHub credentials (needed by repair-dockerhub workflow)
DOCKERHUB_USERNAME=your-dockerhub-username
DOCKERHUB_TOKEN=dckr_pat_...
