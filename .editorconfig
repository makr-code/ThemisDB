root = true

# C++ files
[*.{cpp,h,hpp,cc,cxx}]
# Suppress unused parameter warnings in IntelliSense
cpp_function_parameter_unused = false
# Suppress string constant address comparison warnings
cpp_string_literal_comparison = false

# CMake files
[CMakeLists.txt]
indent_style = space
indent_size = 2

# JSON files
[*.json]
indent_style = space
indent_size = 2
