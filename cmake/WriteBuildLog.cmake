if(NOT DEFINED LOG_DIR OR NOT DEFINED LOG_PATH)
    message(FATAL_ERROR "WriteBuildLog.cmake requires LOG_DIR and LOG_PATH to be defined.")
endif()

file(MAKE_DIRECTORY "${LOG_DIR}")

string(TIMESTAMP _THEMIS_BUILD_GENERATED_TS "%Y-%m-%dT%H:%M:%SZ" UTC)

set(_THEMIS_BUILD_LOG "${LOG_PATH}")
set(_THEMIS_BUILD_LOG_CONTENT "")

string(APPEND _THEMIS_BUILD_LOG_CONTENT "ThemisDB build log\n")
string(APPEND _THEMIS_BUILD_LOG_CONTENT "Generated: ${_THEMIS_BUILD_GENERATED_TS}\n")
string(APPEND _THEMIS_BUILD_LOG_CONTENT "Project: ${PROJECT_NAME}\n")
string(APPEND _THEMIS_BUILD_LOG_CONTENT "Build UUID: ${THEMIS_BUILD_UUID}\n")
string(APPEND _THEMIS_BUILD_LOG_CONTENT "Build Version: ${THEMIS_BUILD_VERSION_STRING}\n")
string(APPEND _THEMIS_BUILD_LOG_CONTENT "Build ID: ${THEMIS_BUILD_ID}\n")
string(APPEND _THEMIS_BUILD_LOG_CONTENT "Build Timestamp: ${THEMIS_BUILD_TIMESTAMP}\n")
string(APPEND _THEMIS_BUILD_LOG_CONTENT "Build Channel: ${THEMIS_BUILD_CHANNEL}\n")
string(APPEND _THEMIS_BUILD_LOG_CONTENT "Edition: ${THEMIS_EDITION}\n")
string(APPEND _THEMIS_BUILD_LOG_CONTENT "Generator: ${GENERATOR}\n")
string(APPEND _THEMIS_BUILD_LOG_CONTENT "Binary Dir: ${BINARY_DIR}\n")
string(APPEND _THEMIS_BUILD_LOG_CONTENT "Build Type: ${BUILD_TYPE}\n")
string(APPEND _THEMIS_BUILD_LOG_CONTENT "Version: ${VERSION}\n")
string(APPEND _THEMIS_BUILD_LOG_CONTENT "========================================\n")

file(WRITE "${_THEMIS_BUILD_LOG}" "${_THEMIS_BUILD_LOG_CONTENT}")
