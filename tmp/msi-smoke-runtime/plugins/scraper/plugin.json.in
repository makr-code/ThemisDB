{
  "name": "scraper",
  "version": "@PROJECT_VERSION@",
  "type": "INGESTION_AGENT",
  "description": "Agentic web scraper for gap-detection-driven data ingestion. Supports static HTML, JavaScript-rendered SPAs (React/Vue/Next.js), JSON REST APIs, HTML search-form discovery, result-list parsing, and a built-in catalog of German federal, Bundesland, and EU government sources.",
  "author": "ThemisDB Team",
  "license": "MIT",
  "capabilities": {
    "supports_streaming": false,
    "supports_batching": true,
    "supports_transactions": false,
    "thread_safe": false,
    "gpu_accelerated": false,
    "requires_llm": true,
    "requires_network": true
  },
  "render_modes": ["static", "js_rendered", "api_json", "api_graphql"],
  "gov_source_groups": ["bund", "bundeslaender", "eu"],
  "dependencies": {
    "yaml-cpp": ">=0.7.0",
    "pugixml": ">=1.11",
    "nlohmann_json": ">=3.10",
    "libcurl": ">=7.68"
  },
  "optional_dependencies": {
    "llama_cpp": ">=0.1.0"
  },
  "configuration": {
    "config_file": "plugins/scraper/config/scraper_urls.yaml",
    "gov_sources_catalog": "plugins/scraper/config/gov_sources.yaml"
  },
  "api_version": "1.0",
  "min_themisdb_version": "1.9.0"
}
