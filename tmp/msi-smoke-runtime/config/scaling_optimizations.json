{
  "_comment": "ThemisDB Scaling Optimizations Configuration (v1.4.0)",
  "_description": "Configuration for 10B+ record scaling with adaptive caching and WAL optimization",
  "_documentation": "See docs/performance/phase4_hnsw_layer_optimization.md and code documentation",
  
  "query_cache": {
    "_comment": "Phase 1: Adaptive Multi-Level Query Cache",
    "enabled": true,
    
    "l1_hot": {
      "_description": "In-memory, ultra-fast, <1ms latency",
      "max_entries": 10000,
      "max_entry_size": 1024,
      "ttl_seconds": 300
    },
    
    "l2_warm": {
      "_description": "Compressed in-memory, automatic promotion",
      "max_entries": 50000,
      "max_entry_size": 10240,
      "ttl_seconds": 1800,
      "compression_level": 3
    },
    
    "l3_cold": {
      "_description": "RocksDB persistent, 24h retention",
      "db_path": "./data/query_cache",
      "ttl_seconds": 86400
    },
    
    "adaptive_ttl": {
      "enabled": true,
      "min_ttl_seconds": 60,
      "max_ttl_seconds": 86400
    },
    
    "eviction": {
      "enable_frequency_weighting": true,
      "frequency_weight": 0.3
    }
  },
  
  "adaptive_indexing": {
    "_comment": "Phase 2: Cache-Aware Index Selection",
    "enabled": true,
    "l3_cache_size_mb": 20,
    "target_cache_hit_rate": 0.70,
    "min_suggestion_score": 0.5,
    "max_suggestions": 10,
    
    "pattern_tracking": {
      "enabled": true,
      "track_cache_metrics": true,
      "selectivity_sample_size": 1000
    }
  },
  
  "wal_optimization": {
    "_comment": "Phase 3: WAL Adaptive Batching & Compression",
    "enabled": true,
    
    "adaptive_batching": {
      "enabled": true,
      "base_batch_size": 100,
      "min_batch_size": 10,
      "max_batch_size": 1000,
      
      "network_latency_thresholds": {
        "very_fast": 1.0,
        "fast": 5.0,
        "slow": 20.0,
        "very_slow": 50.0
      },
      
      "cpu_utilization_thresholds": {
        "low": 0.3,
        "high": 0.8
      },
      
      "disk_iops_thresholds": {
        "low": 10000,
        "high": 50000
      }
    },
    
    "compression": {
      "enabled": true,
      "default_type": "zstd",
      "default_level": 3,
      
      "rules": {
        "min_payload_size": 4096,
        "cpu_threshold_disable": 0.85,
        "cpu_threshold_fast": 0.70,
        "prefer_zstd_for_repetitive": true
      }
    }
  },
  
  "hnsw_optimization": {
    "_comment": "Phase 4: HNSW Layer Pruning (Future - Not Yet Implemented)",
    "_documentation": "See docs/performance/phase4_hnsw_layer_optimization.md",
    "enabled": false,
    
    "layer_pruning": {
      "enabled": false,
      "threshold_multiplier": 5
    },
    
    "adaptive_layer_selection": {
      "enabled": false,
      "stats_window_size": 1000
    },
    
    "batch_insert": {
      "enabled": false,
      "batch_size": 100
    }
  },
  
  "monitoring": {
    "_comment": "Performance Monitoring & Metrics",
    "enable_metrics": true,
    "metrics_interval": 60,
    
    "cache_stats": {
      "report_hit_rates": true,
      "report_tier_utilization": true,
      "report_cache_events": true
    },
    
    "index_stats": {
      "report_suggestions": true,
      "report_cache_fit": true
    },
    
    "wal_stats": {
      "report_batch_sizes": true,
      "report_compression": true,
      "report_throughput": true
    }
  },
  
  "_presets": {
    "_description": "Ready-to-use configuration presets for common scenarios",
    
    "high_performance_olap": {
      "_description": "Query-heavy OLAP workload with large result sets",
      "query_cache.l1_hot.max_entries": 50000,
      "query_cache.l2_warm.max_entries": 200000,
      "adaptive_indexing.enabled": true,
      "wal_optimization.adaptive_batching.enabled": false
    },
    
    "real_time_indexing": {
      "_description": "Write-heavy with real-time secondary indexing",
      "query_cache.enabled": false,
      "wal_optimization.enabled": true,
      "wal_optimization.adaptive_batching.max_batch_size": 2000,
      "wal_optimization.compression.enabled": true
    },
    
    "balanced_hybrid": {
      "_description": "Balanced OLTP/OLAP hybrid workload",
      "query_cache.l1_hot.max_entries": 20000,
      "adaptive_indexing.enabled": true,
      "wal_optimization.enabled": true,
      "wal_optimization.adaptive_batching.enabled": true
    },
    
    "resource_constrained": {
      "_description": "Low-resource environment (e.g., edge devices)",
      "query_cache.l1_hot.max_entries": 5000,
      "query_cache.l2_warm.max_entries": 10000,
      "query_cache.l3_cold.db_path": "",
      "wal_optimization.compression.rules.cpu_threshold_disable": 0.70
    },
    
    "maximum_performance": {
      "_description": "High-end server with abundant resources",
      "query_cache.l1_hot.max_entries": 100000,
      "query_cache.l2_warm.max_entries": 500000,
      "adaptive_indexing.l3_cache_size_mb": 50,
      "wal_optimization.adaptive_batching.max_batch_size": 5000,
      "wal_optimization.compression.default_level": 1
    }
  },
  
  "_performance_targets": {
    "_description": "Expected performance improvements with these optimizations",
    "query_engine_10b_records": {
      "before": "200M ops/sec",
      "after": "600M ops/sec",
      "improvement": "+200%"
    },
    "wal_throughput": {
      "before": "217k items/sec",
      "after": "350k+ items/sec",
      "improvement": "+61%"
    },
    "vector_search_1b": {
      "before": "-15% overhead",
      "after": "-5% overhead",
      "improvement": "+67% efficiency"
    },
    "cache_hit_latency": {
      "before": "5-10ms",
      "after": "<1ms",
      "improvement": "-90%"
    }
  }
}
